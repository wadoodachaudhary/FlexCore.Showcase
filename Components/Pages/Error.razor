@page "/Error"
@using System.Diagnostics

@* 2026-10-17: the template page told visitors to switch the server to the Development environment; replaced with a plain
   message, the request id for support, and the same exits as the 404 page. Tracker SC-284. *@

<PageTitle>Something went wrong — FlexCore</PageTitle>

<div class="docs-page">
    <h1>Something went wrong</h1>
    <p>The server hit an error while handling this request. Reloading the page usually clears it.</p>
    @if (ShowRequestId)
    {
        <p>If it keeps happening, <a href="signup">tell us</a> or <a href="https://github.com/wadoodachaudhary/FlexCore/issues" target="_blank" rel="noopener">open an issue</a> and quote this request id: <code>@RequestId</code></p>
    }
    <p>Where to go instead:</p>
    <ul>
        <li><a href="">Home</a></li>
        <li><a href="components">All components</a></li>
        <li><a href="get-started">Get Started</a></li>
    </ul>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
