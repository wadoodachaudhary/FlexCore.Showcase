    ];

    private Supplier _supplier = new();
    private List<Contact> _contacts = [];
    private int _index;

    private PageControl? _page;
    protected override void OnInitialized() => Show(0);
    // Previous and Next sit outside the PageControl, so focus goes back into the record after them.
    private async Task ShowAndFocus(int index)
    {
        Show(index);
        await Task.Yield();   // let the new record render first
        if (_page is not null) await _page.FocusFirstNavigationTargetAsync();
    }

    private void Show(int index)
    {
        _index = Math.Clamp(index, 0, _suppliers.Count - 1);
        _supplier = _suppliers[_index];
        _contacts = AllContacts.Where(c => c.SupplierCode == _supplier.Code).ToList();
    }

