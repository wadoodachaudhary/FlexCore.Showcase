@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: moved onto FeatureDemoLayout (row 4 of the Data Grid list). Same six rows and three column sets. Changes, closing
   SC-023 and SC-128 to SC-131: the layout buttons are a ButtonGroupControl; EditSettings (Batch) added so the ColumnSpec.Editable
   flag the page already carried does something (SC-129); a readout names the selected row through RowSelected/RowDeselected so the
   one claim the page keeps (selection survives a swap) can be seen; the scroll-offset claim went (six rows never scroll, SC-130);
   the swap now goes through the grid's own SuspendRedraw(fields) scope (GridControl.razor.cs:88-135): without it a reused
   GridColumn instance with a new Field kept the old column on screen (GridColumn registers once, GridColumn.cs:311) and, once
   keyed, new fields appended after the fields the grid already knew instead of taking the declared order; the columns are keyed by
   field so added and removed columns converge in place;
   the two unused @refs went (SC-131); "legacy applications", "DOM thrashing" and "seamless" left the copy. Parameter tables are a
   later pass (SC-278). *@

<PageTitle>Column sets — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Column sets" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Swap the whole column set at runtime from a list of specs, without remounting the grid."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridColumn.cs">
    <Overview>
        <p>
            The columns inside <code>GridColumnsBase</code> are ordinary Razor markup, so a <code>@@foreach</code> over a list of column
            specs defines them. Replace the list and the grid re-reads its columns in place: a different set, order, width or
            <code>Visible</code> flag, while the component instance, its data and its selection stay. Wrap the swap in
            <code>SuspendRedraw(fields)</code>: the grid holds its rendering while the list changes, converges added and removed columns in
            place and applies the order you pass; without it, new fields append after the ones the grid already knows.
            <code>Visible="false"</code> keeps a column in the set but off the screen.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="sets" Title="Three column sets, one grid" RazorCode="@Code.Sets" CSharpCode="@Code.SetsCs">
            <Description><p>Select a row, then switch between the Default, Purchasing and Minimal sets: the selection stays while the columns change. Each set is a list of <code>ColumnSpec</code> objects; the Purchasing set also carries a hidden Category column. Qty and Price are editable in Default, Price in Purchasing (<code>EditMode.Batch</code>: double-click a cell).</p></Description>
            <Controls>
                <ButtonGroupControl Items="_layouts" Values="@(new[] { _activeLayout })"
                                    ValuesChanged="@(v => ApplyLayoutAsync(v.Count > 0 ? v[0] : "Default"))"
                                    Selection="ChoiceSelectionMode.Single" AriaLabel="Column set" />
            </Controls>
            <Demo>
                <GridControl @ref="_grid"
                             TValue="CRow"
                             DataSource="@_rows"
                             Height="340px"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowSorting="true"
                             ShowRowCountInFooter="true"
                             EditSettingsRef="@_editSettings"
                             EventsRef="@_events">
                    <GridColumnsBase>
                        @foreach (var col in _currentColumns)
                        {
                            <GridColumn @key="col.Field"
                                        Field="@col.Field"
                                        HeaderText="@col.Header"
                                        Width="@col.Width"
                                        Visible="@col.Visible"
                                        AllowEditing="@col.Editable" />
                        }
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_activeLayout set: @_currentColumns.Count(c => c.Visible) of @_currentColumns.Count columns visible@(_selected is null ? "" : $" · selected row {_selected}")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>GridColumn</code> (<code>Field</code>, <code>HeaderText</code>, <code>Width</code>, <code>Visible</code>, <code>AllowEditing</code>), <code>GridColumnsBase</code> and the selection events on <code>GridControlEvents</code> are still to be written up from <code>Grid/GridColumn.cs</code> and <code>Grid/GridControlEvents.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/dynamic-columns">Dynamic columns</a>: columns that follow the data.</li>
            <li><a href="demo/grid/reordering">Column reorder</a>: the user moves columns by dragging headers.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class CRow
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Vendor { get; set; } = string.Empty;
        public string POIndex { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public decimal Total => Qty * Price;
    }

    private readonly SelectionItem[] _layouts = { new("Default", "Default"), new("Purchasing", "Purchasing"), new("Minimal", "Minimal") };
    private GridControl<CRow>? _grid;
    private List<CRow> _rows = [];
    private string _activeLayout = "Default";
    private List<ColumnSpec> _currentColumns = [];
    private string? _selected;

    private readonly EditSettings _editSettings = new() { AllowEditing = true, Mode = EditMode.Batch };
    private readonly GridControlEvents<CRow> _events = new();

    protected override void OnInitialized()
    {
        _rows =
        [
            new CRow { Code = "01-100", Description = "Grading & Compaction", Category = "Sitework", Vendor = "Hill Country Excavation", POIndex = "PO-001", Qty = 1, Price = 4250.00m },
            new CRow { Code = "02-210", Description = "Post-Tension Foundation Cables", Category = "Concrete", Vendor = "Austin Concrete Supply", POIndex = "PO-002", Qty = 24, Price = 115.00m },
            new CRow { Code = "03-310", Description = "2x6 Exterior Wall Studs", Category = "Framing", Vendor = "Lone Star Lumber Co", POIndex = "PO-003", Qty = 450, Price = 8.75m },
            new CRow { Code = "04-120", Description = "Architectural Shingles 30yr", Category = "Roofing", Vendor = "Summit Building Materials", POIndex = "PO-004", Qty = 65, Price = 34.50m },
            new CRow { Code = "05-410", Description = "PEX Water Supply Piping", Category = "Plumbing", Vendor = "Capitol Plumbing Supply", POIndex = "PO-005", Qty = 12, Price = 145.00m },
            new CRow { Code = "06-110", Description = "200A Main Distribution Panel", Category = "Electrical", Vendor = "Apex Electric Dist", POIndex = "PO-006", Qty = 2, Price = 680.00m }
        ];

        _events.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CRow>>(this, args => _selected = args.Data?.Code);
        _events.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<CRow>>(this, _ => _selected = null);

        _currentColumns = ColumnsFor("Default");
    }

    private async Task ApplyLayoutAsync(string layoutName)
    {
        _activeLayout = layoutName;
        var columns = ColumnsFor(layoutName);
        if (_grid is null) { _currentColumns = columns; return; }
        await using (_grid.SuspendRedraw(columns.Select(c => c.Field)))
        {
            _currentColumns = columns;
        }
    }

    private static List<ColumnSpec> ColumnsFor(string layoutName)
        => layoutName switch
        {
            "Purchasing" =>
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Item Code", Width = "90px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "220px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Vendor), Header = "Assigned Vendor", Width = "200px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.POIndex), Header = "PO Index", Width = "100px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Price), Header = "Unit Price", Width = "100px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Category), Header = "Category", Width = "120px", Visible = false }
            ],
            "Minimal" =>
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Code", Width = "100px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "300px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Total), Header = "Total Cost", Width = "140px", Visible = true, Editable = false }
            ],
            _ => // Default
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Item Code", Width = "90px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "240px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Category), Header = "Category", Width = "130px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Qty), Header = "Qty", Width = "80px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Price), Header = "Price", Width = "100px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Total), Header = "Total", Width = "110px", Visible = true, Editable = false }
            ]
        };

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed); the C# tab also carries
    // ColumnSpec from Data/BenchModels.cs.
    private static class Code
    {
        public const string Sets = @"<GridControl @ref=""_grid""
             TValue=""CRow""
             DataSource=""@_rows""
             Height=""340px""
             AllowSelection=""true""
             AllowResizing=""true""
             AllowSorting=""true""
             ShowRowCountInFooter=""true""
             EditSettingsRef=""@_editSettings""
             EventsRef=""@_events"">
    <GridColumnsBase>
        @foreach (var col in _currentColumns)
        {
            <GridColumn @key=""col.Field""
                        Field=""@col.Field""
                        HeaderText=""@col.Header""
                        Width=""@col.Width""
                        Visible=""@col.Visible""
                        AllowEditing=""@col.Editable"" />
        }
    </GridColumnsBase>
</GridControl>
<p class=""result"">@_activeLayout set: @_currentColumns.Count(c => c.Visible) of @_currentColumns.Count columns visible@(_selected is null ? """" : $"" · selected row {_selected}"")</p>";
