@page "/demo/pdf-viewer"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Pdf
@using FlexCore.Showcase.Components.Shared
@inject IWebHostEnvironment Env

@* 2026-10-19: new page (SC-029; Baaria approved the Control tour split, PDF viewer first). The tour's PDF tab moved here and was
   removed there. The sample file wwwroot/pdf-viewer-sample.pdf is generated by scratchpad/mkpdf.py: three pages, an outline with
   one nested entry, a text field, a checkbox and a combo box, the word FlexCore on every page. Documentation written from
   FlexCore.Documents/Pdf/PdfViewerControl.razor, PdfViewerModels.cs and wwwroot/pdf-viewer.js (load, metadata, bookmarks, render,
   search, editedBytes, download/print); rows checked with scratchpad/vocabcheck.py. *@

<PageTitle>PDF viewer — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="PDF viewer" Category="Reports" CategoryHref="demo/reports/package-costs" ControlName="PdfViewerControl"
                   Tagline="Open, read, search, annotate and fill PDF files in the browser, and get the edited file back as bytes."
                   SourcePath="FlexCore.Documents/Pdf/PdfViewerControl.razor;FlexCore.Documents/Pdf/PdfViewerModels.cs;FlexCore.Documents/wwwroot/pdf-viewer.js">
    <Overview>
        <p>
            <code>PdfViewerControl</code> shows one page at a time on a canvas with a transparent text layer over it, so text can be selected,
            searched and highlighted. The first toolbar moves between pages, zooms from 25% to 400% in steps of 25%, rotates in quarter
            turns, downloads, prints and toggles the Details pane; the second searches the document and, when allowed, adds highlights and
            notes. The Details pane lists the document's bookmarks, the search hits, the form fields as editable controls, and the notes and
            highlights. Field values, highlights and notes are written into the file on Download, Print and <code>SaveAsync</code>; the
            document itself stays in the browser until the application asks for those bytes.
        </p>
        <p>
            The control lives in the <code>FlexCore.Documents</code> package, so a project references it alongside FlexCore. Rendering and
            editing use pdf.js 6.3.289 and pdf-lib 1.17.1, shipped inside that package as static assets; nothing is loaded from a CDN and
            no PDF content is sent to a remote service.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="viewer" Title="Full viewer" RazorCode="@Code.Viewer" CSharpCode="@Code.ViewerCs">
            <Description><p>A three-page sample loaded by URL. Open the Details pane for its bookmarks and the form on page 2; search for FlexCore to get a hit on every page; select some text and press Highlight selection, or add a note. Open PDF reads a file from your machine. Download and Print carry your edits; Save to host asks the viewer for the same bytes on the server and reports their size.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="SaveToHostAsync" Disabled="@(_viewer?.PageCount is not > 0)">Save to host</ButtonControl>
            </Controls>
            <Demo>
                <PdfViewerControl @ref="_viewer" Url="pdf-viewer-sample.pdf" FileName="flexcore-sample.pdf" Height="560px" Error="e => _saved = e" />
                <p class="result">@_saved</p>
            </Demo>
        </DemoExample>

        <DemoExample Id="reader" Title="Read-only, from bytes, driven from the page" RazorCode="@Code.Reader" CSharpCode="@Code.ReaderCs">
            <Description><p>The same file supplied as a byte array from the server, with Open, annotations, form filling and bookmarks turned off: what a report preview looks like. The buttons call the viewer's methods, and the line below is fed by <code>Loaded</code>, <code>PageChanged</code> and <code>SearchChanged</code>.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="() => _reader!.GoToPageAsync(2)" Disabled="@(_reader?.PageCount is not > 0)">Page 2</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick='() => _reader!.SearchTextAsync("FlexCore")' Disabled="@(_reader?.PageCount is not > 0)">Find FlexCore</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _reader!.SearchNextAsync()" Disabled="@(_reader?.SearchState.Matches.Count is not > 0)">Next match</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _reader!.CancelTextSearchAsync()" Disabled="@(_reader?.SearchState.Matches.Count is not > 0)">Clear</ButtonControl>
            </Controls>
            <Demo>
                <PdfViewerControl @ref="_reader"
                                  DocumentBytes="@_document"
                                  FileName="flexcore-sample.pdf"
                                  AllowOpen="false"
                                  AllowAnnotations="false"
                                  AllowFormFilling="false"
                                  ShowBookmarks="false"
                                  Height="480px"
                                  Loaded='info => _info = $"{info.Pages} pages, {info.Fields.Count} fields, {info.Bookmarks.Count} top-level bookmarks."'
                                  PageChanged="p => _page = p"
                                  SearchChanged="s => _search = s" />
                <p class="result">@_info Page @_page. @SearchText</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-pdfviewercontrol-parameters" Title="PdfViewerControl parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="PdfViewerControl parameters" Rows="Vocab.Params" />
                <p>
                <code>CssClass</code>, <code>Style</code>, <code>Id</code>, <code>Visible</code>, <code>Enabled</code> and
                <code>AdditionalAttributes</code> come from <code>FlexControlBase</code> and apply to the root <code>div</code>;
                <code>Enabled="false"</code> disables every toolbar control and the methods.
                </p>
            </DocSection>
            <DocSection Id="doc-pdfviewercontrol-events" Title="PdfViewerControl events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="PdfViewerControl events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-pdfviewercontrol-methods" Title="PdfViewerControl methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="PdfViewerControl methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-pdfviewercontrol-read-only-state" Title="PdfViewerControl read-only state" Count='@DocSection.Label(Vocab.State.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PdfViewerControl read-only state" Rows="Vocab.State" />
            </DocSection>
            <DocSection Id="doc-pdfdocumentinfo" Title="PdfDocumentInfo" Count='@DocSection.Label(Vocab.Info.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PdfDocumentInfo" Rows="Vocab.Info" />
            </DocSection>
            <DocSection Id="doc-pdfformfield" Title="PdfFormField" Count='@DocSection.Label(Vocab.Field.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PdfFormField" Rows="Vocab.Field" />
            </DocSection>
            <DocSection Id="doc-pdfbookmark" Title="PdfBookmark" Count='@DocSection.Label(Vocab.Bookmark.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PdfBookmark" Rows="Vocab.Bookmark" />
                <p>
                <code>PdfSearchState(string Query, bool MatchCase, IReadOnlyList&lt;PdfSearchMatch&gt; Matches, int CurrentIndex, bool IsTruncated)</code>
                and <code>PdfSearchMatch(int Page, string Text, int Index, int Length)</code> are records; <code>Index</code> and
                <code>Length</code> refer to the page's extracted text. A search returns at most 200 matches or 24 KB of results, and
                <code>IsTruncated</code> says when the list was cut. Forms with XFA content cannot be edited: the viewer reports it and the
                original file can still be downloaded.
                </p>
            </DocSection>
            <DocSection Id="doc-keyboard" Title="Keyboard" Count='@DocSection.Label(Vocab.Keys.Length, "keys")'>
                <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <p>
            The page buttons are labelled "Previous page" and "Next page", the search box "Search document", and the canvas
            "PDF page <em>n</em>"; the page viewport is a focusable region. Busy text and the match count use <code>role="status"</code>
            and errors <code>role="alert"</code>. Bookmarks, search hits and notes in the Details pane are buttons, and the current hit
            carries <code>aria-current</code>. Form fields in the pane are ordinary labelled controls.
        </p>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/reports/package-costs">Report writer</a>: previews a Crystal report rendered to PDF through this viewer when the Documents package is present.</li>
            <li><a href="demo/counterparts">Control tour</a>: the remaining workbenches, including the forms the viewer's Details pane is built from.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private PdfViewerControl? _viewer;
    private string _saved = "Nothing saved yet.";

    private async Task SaveToHostAsync()
    {
        if (_viewer is null) return;
        var bytes = await _viewer.SaveAsync();
        _saved = $"Saved {bytes.Length:N0} bytes on the server, with the current field values, highlights and notes.";
    }

    private PdfViewerControl? _reader;
    private byte[] _document = [];
    private string _info = "Loading…";
    private int _page = 1;
    private PdfSearchState? _search;
    private string SearchText => _search is null || _search.Query.Length == 0
        ? "No search."
        : $"{_search.Matches.Count} matches for '{_search.Query}', at {_search.CurrentIndex + 1}.";

    protected override void OnInitialized() => _document = File.ReadAllBytes(Path.Combine(Env.WebRootPath, "pdf-viewer-sample.pdf"));

    // Code tabs are verbatim copies of each Demo block and of the members behind it (scratchpad/gencode.py).
    private static class Code
    {
        public const string Viewer = @"<PdfViewerControl @ref=""_viewer"" Url=""pdf-viewer-sample.pdf"" FileName=""flexcore-sample.pdf"" Height=""560px"" Error=""e => _saved = e"" />
<p class=""result"">@_saved</p>";
        public const string ViewerCs = @"private PdfViewerControl? _viewer;

private string _saved = ""Nothing saved yet."";

private async Task SaveToHostAsync()
{
    if (_viewer is null) return;
    var bytes = await _viewer.SaveAsync();
    _saved = $""Saved {bytes.Length:N0} bytes on the server, with the current field values, highlights and notes."";
}";
        public const string Reader = @"<PdfViewerControl @ref=""_reader""
                  DocumentBytes=""@_document""
                  FileName=""flexcore-sample.pdf""
                  AllowOpen=""false""
                  AllowAnnotations=""false""
                  AllowFormFilling=""false""
                  ShowBookmarks=""false""
                  Height=""480px""
                  Loaded='info => _info = $""{info.Pages} pages, {info.Fields.Count} fields, {info.Bookmarks.Count} top-level bookmarks.""'
                  PageChanged=""p => _page = p""
                  SearchChanged=""s => _search = s"" />
<p class=""result"">@_info Page @_page. @SearchText</p>";
        public const string ReaderCs = @"private PdfViewerControl? _reader;

private byte[] _document = [];

private string _info = ""Loading…"";

private int _page = 1;

private PdfSearchState? _search;

private string SearchText => _search is null || _search.Query.Length == 0
    ? ""No search.""
