@namespace FlexCore.Showcase.Components.Shared

@if (ShowWorkhorses)
{
@* Laid out like the home page's pillars (2026-11-14): the heading sits in a green strip that straddles the top edge of an indigo
   band, and the cards sit on the band. *@
<section class="popular-components-section">
    <div class="workhorses-strip">
    <div class="doodle-head popular-head" @ref="_workhorsesHead">
        @* Two racehorses neck and neck in place of the 🐎 emoji (2026-11-13, the "ink and paper" pair), drawn like
           the site's other doodles: one solid ink, one white with an ink line, and the front one wears a saddle cloth with the FlexCore
           logo, the only color. Each is one gallop stride from Eadweard Muybridge's photographs The Horse in Motion (1878), traced to a
           smooth outline with the jockey taken off; wwwroot/images/workhorses.svg holds the 15 frames of both horses and the CSS steps
           through them. Each time the heading scrolls into view they run, with wind marks behind and the ground streaming back:
           fxToggleClassWhenVisible (App.razor) adds is-playing. The marks are drawn in the sprite's frame units, the racers placed over them. *@
        <div class="doodle horse-race" aria-hidden="true">
            <svg class="race-marks" viewBox="-40 0 412 210">
                <g class="race-wind" fill="none" stroke="#0f172a" stroke-width="4" stroke-linecap="round">
                    <path d="M-22 62 q9 -4 18 0" /><path d="M-30 84 q11 -4 22 0" /><path d="M-20 106 q8 -3 16 0" />
                </g>
                @* the last squiggle waits past the right edge, so the ground can slide one step (96) and look the same *@
                <g class="race-ground" fill="none" stroke="#0f172a" stroke-width="4" stroke-linecap="round">
                    <path d="M20 205 q14 -5 28 0 t28 0" /><path d="M116 205 q14 -5 28 0 t28 0" /><path d="M212 205 q14 -5 28 0 t28 0" />
                    <path d="M308 205 q14 -5 28 0 t28 0" /><path d="M404 205 q14 -5 28 0 t28 0" />
                </g>
            </svg>
            @* back to front, so the white horse covers the ink one *@
            <span class="racer racer-ink"></span>
            <span class="racer racer-paper"></span>
        </div>
        <h2 class="popular-title">Start with the workhorses</h2>
    </div>
    </div>
    <div class="brand-band">
    @* Tagline under the green strip (2026-11-14), in the voice of the Telerik, Syncfusion and Radzen landing pages. "High-performance"
       rests on GridControl's virtual scrolling of 100,000 rows (/demo/grid/row-selection-50k). *@
    <p class="workhorses-tagline">The high-performance core of a business app: grids, charts, reports and scheduling that keep pace as your company grows.</p>
    @* The same four cards as the home page (2026-11-13); they replaced six small tiles (Data Grid, Charts, Scheduler, Dialogs,
       Report Writer, Forms). Compact: smaller and in one row here (2026-11-13). *@
    <WorkhorseCards Compact="true" />
    </div>
</section>
}

@* Complete component directory, multi-column. *@
<section class="catalog-directory-section" id="components">
    <div class="directory-header">
        <div class="doodle-head directory-head-row" @ref="_toolboxHead">
            @* Hand-drawn toolbox in place of the 🛠️ emoji (2026-10-28), drawn like the finish flag on the home page and placed left of the heading. Each
               time the heading scrolls into view the lid flips open, a wrench, a screwdriver and a hammer pop out and wiggle, and
               everything packs away again: fxToggleClassWhenVisible (App.razor) adds is-playing and the CSS does the rest. The tools
               are drawn first so the box and lid cover them at rest. *@
            <svg class="doodle toolbox-doodle" viewBox="0 0 170 150" aria-hidden="true">
                <g class="tb-spark" fill="none" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round">
                    <path d="M40 22 l-8 -8" /><path d="M86 12 v-10" /><path d="M132 22 l8 -8" />
                </g>
                <g class="tb-tool tb-wrench">
                    <rect x="50" y="88" width="8" height="46" rx="3" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                    <path d="M45 76 v6 a9 9 0 0 0 18 0 v-6 h-5 v5 h-8 v-5 z" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" stroke-linejoin="round" />
                </g>
                <g class="tb-tool tb-screwdriver">
                    <path d="M91 100 V78" stroke="#0f172a" stroke-width="3" stroke-linecap="round" />
                    <path d="M88 78 L91 72 L94 78 Z" fill="#0f172a" />
                    <rect x="84" y="100" width="14" height="34" rx="5" fill="#0284c7" stroke="#0f172a" stroke-width="2.5" />
                </g>
                <g class="tb-tool tb-hammer">
                    <rect x="118" y="86" width="7" height="48" rx="3" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                    <rect x="106" y="74" width="31" height="12" rx="2" fill="#0f172a" />
                </g>
                <path d="M24 82 L146 81 L144 136 L26 137 Z" fill="#ffffff" stroke="#0f172a" stroke-width="3" stroke-linejoin="round" />
                <rect x="78" y="90" width="14" height="10" rx="2" fill="#0f172a" />
                <g fill="none" stroke="#0f172a" stroke-width="2" stroke-linecap="round">
                    <path d="M118 128 l8 -8" /><path d="M126 128 l8 -8" /><path d="M134 128 l6 -6" />
                </g>
                <g class="tb-lid">
                    <path d="M20 70 L148 69 L147 83 L21 84 Z" fill="#ffffff" stroke="#0f172a" stroke-width="3" stroke-linejoin="round" />
                    <path d="M66 69 C66 56 104 56 104 69" fill="none" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round" />
                </g>
                <path d="M12 143 q12 -4 24 0 t24 0" fill="none" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round" />
            </svg>
            <h2 class="directory-title">The whole toolbox</h2>
        </div>

        <div class="catalog-search-wrapper">
            <span class="bi bi-search catalog-search-icon"></span>
            <input type="text" class="catalog-search-input"
                   placeholder="Filter components (e.g. grid, chart, date, dialog, form)..."
                   @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button" class="btn-clear-search" @onclick="@(() => _searchTerm = "")" title="Clear search">
                    <span class="bi bi-x"></span>
                </button>
            }
        </div>
    </div>

    <div class="directory-columns-container">
        <!-- ── Column 1 ────────────────────────── -->
        <div class="directory-col">
            @if (MatchesCategory("DATA MANAGEMENT", _dataManagement))
            {
                <div class="cat-group" id="cat-data">
                    <h3 class="cat-title">DATA MANAGEMENT</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_dataManagement))
                        {
