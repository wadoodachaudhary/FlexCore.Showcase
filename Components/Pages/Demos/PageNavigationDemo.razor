<PageTitle>Keyboard Navigation for Blazor Forms: PageControl — FlexCore</PageTitle>

<FeatureDemoLayout Title="Page navigation" Category="Components" CategoryHref="components" ControlName="PageControl"
                   Tagline="Let users work through a form from the keyboard, as in a desktop app."
                   SourcePath="PageControl.razor;PageNavigationMap.cs;Grid/GridControl.razor.cs">
    <Overview>
        <p>
            <code>PageControl</code> gives a Blazor page desktop-style keyboard navigation: Tab and Shift+Tab follow the order you define across inputs and grids, and keyboard shortcuts jump between regions. Use it on data-entry screens such as a supplier record, so users keep their hands on the keyboard; the order is a graph of named focus nodes that can wrap at the ends, and <code>FocusFirstNodeOnLoad</code> puts the cursor in the first field when the page opens.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="supplier" Title="A supplier record worked from the keyboard" RazorCode="@Code.Supplier" CSharpCode="@Code.SupplierCs">
            <Description><p>Click into the first field and press Tab: focus walks the details, enters the grid at its first cell, leaves it for the switches, and after the last switch leaves the record for the rest of the page. Alt+D, Alt+C and Alt+S jump to a region (not on a Mac; see Keys); Previous and Next show another supplier and put focus back in the first field.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="@(() => ShowAndFocus(_index - 1))" Disabled="@(_index <= 0)">Previous</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="@(() => ShowAndFocus(_index + 1))" Disabled="@(_index >= _suppliers.Count - 1)">Next</ButtonControl>
            </Controls>
            <Demo>
                <PageControl NavigationGraph="@Graph" FocusFirstNodeOnLoad="true" EnableZoomShortcuts="false" @ref="_page">
                    <div class="supplier-head"><strong>@_supplier.Name</strong> <span class="muted">supplier @(_index + 1) of @_suppliers.Count</span></div>
                    <section id="supplier-details" class="region">
                        <h4>Details <kbd>Alt</kbd>+<kbd>D</kbd></h4>
                        <div class="fields">
                            <label>Code <TextBoxControl Value="@_supplier.Code" readonly Width="110px" aria-keyshortcuts="Alt+D" /></label>
                            <label>Name <TextBoxControl @bind-Value="_supplier.Name" /></label>
                            <label>Category <TextBoxControl @bind-Value="_supplier.Category" /></label>
                            <label>Address <TextBoxControl @bind-Value="_supplier.Address" /></label>
                            <label>City <TextBoxControl @bind-Value="_supplier.City" /></label>
                            <label>Country <TextBoxControl @bind-Value="_supplier.Country" /></label>
                            <label>Postal code <TextBoxControl @bind-Value="_supplier.PostalCode" Width="110px" /></label>
                            <label>Phone <TextBoxControl @bind-Value="_supplier.Phone" Width="150px" /></label>
                            <label>Email <TextBoxControl @bind-Value="_supplier.Email" /></label>
                        </div>
                    </section>
                    <section id="supplier-contacts" class="region">
                        <h4>Contacts <kbd>Alt</kbd>+<kbd>C</kbd></h4>
                        <GridControl TValue="Contact" DataSource="@_contacts" Height="200px" AllowSorting="true"
                                     TabNavigationMode="GridTabNavigationMode.PageControl">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(Contact.DisplayName)" HeaderText="Contact" Width="180px" />
                                <GridColumn Field="@nameof(Contact.Role)" HeaderText="Role" Width="160px" />
                                <GridColumn Field="@nameof(Contact.Phone)" HeaderText="Phone" Width="130px" />
                                <GridColumn Field="@nameof(Contact.Email)" HeaderText="Email" Width="220px" />
                                <GridColumn Field="@nameof(Contact.Active)" HeaderText="Active" Width="80px" Type="ColumnType.Boolean" TextAlign="TextAlign.Center" />
                            </GridColumnsBase>
                        </GridControl>
                    </section>
                    <section id="supplier-status" class="region">
                        <h4>Status <kbd>Alt</kbd>+<kbd>S</kbd></h4>
                        <SwitchControl @bind-Checked="_supplier.Contracted" Label="Contracted" aria-keyshortcuts="Alt+S" />
                        <SwitchControl @bind-Checked="_supplier.InsuranceOnFile" Label="Insurance on file" />
                        <SwitchControl @bind-Checked="_supplier.SendsShipNotices" Label="Sends advance ship notices" />
                    </section>
                </PageControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-pagecontrol-parameters" Title="PageControl parameters" Count='@DocSection.Label(Vocab.Page.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="PageControl parameters" Rows="Vocab.Page" />
            </DocSection>
            <DocSection Id="doc-pagenavigationnode" Title="PageNavigationNode" Count='@DocSection.Label(Vocab.Node.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PageNavigationNode" Rows="Vocab.Node" />
            </DocSection>
            <DocSection Id="doc-pagenavigationshortcut" Title="PageNavigationShortcut" Count='@DocSection.Label(Vocab.Shortcut.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PageNavigationShortcut" Rows="Vocab.Shortcut" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
                <p>
                <code>PageNavigationGraph(nodes, wrap)</code> validates the nodes once: every node needs an id and a selector, ids are unique,
                and <code>Next</code> / <code>Previous</code> must name existing nodes. <code>PageNavigationNodeMode</code> is <code>Auto</code>
                (the matched element when focusable, else its focusable descendants), <code>Element</code> or <code>Descendants</code>;
                <code>PageNavigationEntry</code> is <code>Directional</code>, <code>First</code> or <code>Last</code>;
                <code>PageShortcutAction</code> is <code>Focus</code> or <code>Activate</code>. <code>PageNavigationMap</code> is the older
                linear form, a list of named regions, which the control converts to a graph.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keys" Rows="Vocab.Keys" />
        <ul>
            <li><code>PageControl</code> renders a <code>div</code> around your markup and passes extra attributes to it; the fields inside keep their own roles and names.</li>
            <li>Tab and Shift+Tab follow the node order you define. A shortcut focuses the first target of its node, or also clicks it when its action is <code>Activate</code>.</li>
            <li><code>FocusFirstNodeOnLoad</code> puts focus in the first target when the page opens; <code>FocusFirstNavigationTargetAsync</code> does the same from code, as the example's Previous and Next buttons do.</li>
            <li>Build the graph with <code>wrap: false</code> when the page has content outside the <code>PageControl</code>, as the example does, so Tab can leave the record. <code>wrap</code> is true by default.</li>
            <li>List the shortcuts on the screen, as the example's description does, and add <code>aria-keyshortcuts</code> to the field each shortcut focuses, as the example's Code box and Contracted switch do.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/layout">Page layouts</a>: panels and a splitter around content; this control goes inside them.</li>
            <li><a href="demo/forms">Forms</a>: the fields a page like this is usually made of.</li>
            <li><a href="demo/grid">Grid overview</a>: the grid's own keyboard rules once focus is inside it.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Three nodes in page order; Alt+letter jumps to each. Each selector is a region, so the details and status nodes take their focusable
    // descendants; the grid node enters at its first data cell. No wrap: Tab past the last switch leaves the record for the rest of the page.
    private static readonly PageNavigationGraph Graph = new(
    [
        new("details", "#supplier-details", Mode: PageNavigationNodeMode.Descendants, Shortcuts: [new("d", PageShortcutModifiers.Alt)]),
        new("contacts", "#supplier-contacts", Entry: PageNavigationEntry.First, Shortcuts: [new("c", PageShortcutModifiers.Alt)]),
        new("status", "#supplier-status", Mode: PageNavigationNodeMode.Descendants, Shortcuts: [new("s", PageShortcutModifiers.Alt)]),
    ], wrap: false);

    // Four suppliers of the Forklift & Found Logistics distribution center and the people to call at each.
