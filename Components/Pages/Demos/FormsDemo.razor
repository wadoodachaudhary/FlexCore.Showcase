    private string _leaveStatus = "Not saved yet.";
    private void LeaveSaved() => _leaveStatus = $"{_leave.Reference} saved: {_leave.Name}, {_leave.LeaveType} leave, days requested: {_leave.Days}, starting {_leave.Starts:g}.";
    private void LeaveInvalid() => _leaveStatus = "Correct the fields with a message.";

    public enum LeaveType { Vacation, Sick, Parental }

    public sealed class LeaveRequest
    {
        [Display(AutoGenerateField = false)] public Guid Id { get; set; } = Guid.NewGuid();
        [Required, MinLength(2), Display(Name = "Employee", Order = 0)] public string Name { get; set; } = "Albus Door";
        [Range(1, 20), Display(Order = 1)] public int Days { get; set; } = 5;
        [Display(Order = 2)] public LeaveType LeaveType { get; set; } = LeaveType.Vacation;
        [Display(Name = "Starts on", Order = 3), DataType(DataType.DateTime)] public DateTime Starts { get; set; } = new(2026, 11, 23, 9, 0, 0);
        [Display(Order = 4)] public TimeOnly Handover { get; set; } = new(16, 0);
        [Display(Name = "Manager approval", Order = 5)] public bool? Approved { get; set; }
        [Display(Order = 6)] public bool CoverArranged { get; set; } = true;
        [Editable(false), Display(Order = 7)] public string Reference { get; set; } = "LR-0118";
        [Display(Order = 8)] public string Notes { get; set; } = "";
    }

    private FormControl? _form;
    private OpeningRequest _opening = new();
    private string _openingStatus = "Not sent.", _last = "none.";
    private void OpeningSent()
    {
        var city = string.IsNullOrWhiteSpace(_opening.Address.City) ? "" : $" in {_opening.Address.City}";
        _openingStatus = $"Request sent by {_opening.Name}{city}: {_opening.Openings} × {_opening.JobTitle}.";
    }
    private void OpeningInvalid() => _openingStatus = "Not sent: correct the fields.";

    public sealed class OpeningRequest
    {
        [Required, MinLength(2)] public string Name { get; set; } = "";
        [Required, EmailAddress] public string Email { get; set; } = "";
        public Address Address { get; set; } = new();
        [Required, Display(Name = "Job title")] public string JobTitle { get; set; } = "Reservations agent";
        [Range(1, 20)] public int Openings { get; set; } = 1;
        public string Notes { get; set; } = "";
    }

    public sealed class Address
    {
        public string City { get; set; } = "";   // the data-annotation validator checks the top-level model only, so no attribute here
    }

    private EmployeeRecord _employee = new();
    private int _changes;
    private bool _levelButtons;
    private static readonly SelectionItem[] Levels = Enum.GetNames<Level>().Select(s => new SelectionItem(s, s)).ToArray();
    private void EmployeeChanged() => _changes++;
    private void LevelChanged(IReadOnlyList<string> values)
    {
        var level = Enum.Parse<Level>(values[0]);
        if (level == _employee.Level) return;   // clicking the selected level changes nothing
        _employee.Level = level;
        _changes++;
    }

    public enum Level { Junior, Mid, Senior, Lead }

    public sealed class EmployeeRecord
    {
        [Editable(false)] public string EmployeeId { get; set; } = "EMP-0042";
        public string Name { get; set; } = "Luna Goodlove";
        public string Office { get; set; } = "Kyoto";
        public int VacationDays { get; set; } = 20;
        public decimal TrainingBudget { get; set; } = 1200.00m;
        public Level Level { get; set; } = Level.Senior;
        public bool FullTime { get; set; } = true;
        public DateTime StartDate { get; set; } = new(2024, 3, 4);
        // No setter, so the grid gives it no row.
        public string Summary => $"{EmployeeId}: {Name}, {Office}, {Level}, {VacationDays} vacation days, started {StartDate:MMM d, yyyy}, training budget {TrainingBudget:0.00}, {(FullTime ? "full time" : "part time")}.";
    }

