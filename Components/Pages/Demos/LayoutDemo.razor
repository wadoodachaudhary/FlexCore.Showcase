        public const string Dashboard = @"@* .dash is the page-scoped ancestor that ::deep rules below need *@
<div class=""dash"">
<DashboardLayoutControl Columns=""3"" CellSpacing=""@(new double[] { 12, 12 })"" CellAspectRatio=""0.35"">
    <DashboardLayoutPanels>
        @foreach (var k in _kpis)
        {
            var t = _place[k.Key];
            <DashboardLayoutPanel @key=""k.Key"" Row=""t.Row"" Column=""t.Col"" SizeX=""t.SizeX"" SizeY=""t.SizeY"">
                <TooltipControl Text=""@k.Detail"" CssClass=""tile-anchor"" Placement=""PopupPlacement.BottomStart"">
                    <div class=""tile @(_focus == k.Key ? ""focused"" : """")"" @onclick=""() => Toggle(k.Key)"" title=""Click to expand"">
                        <CardControl Elevation=""0"" CssClass=""dash-card""><ChartControl Type=""ChartType.KpiCard"" KpiValue=""@k.Value"" KpiLabel=""@k.Label"" KpiTrend=""@k.Trend"" Height=""100px"" /></CardControl>
                    </div>
                </TooltipControl>
            </DashboardLayoutPanel>
        }
        <DashboardLayoutPanel Row=""ChartsRow"" Column=""0"" SizeX=""2"" SizeY=""3"">
            <CardControl Elevation=""0"" CssClass=""dash-card""><ChartControl Type=""ChartType.Line"" Title=""Traffic"" Height=""200px"" Series=""_traffic"" /></CardControl>
        </DashboardLayoutPanel>
        <DashboardLayoutPanel Row=""ChartsRow"" Column=""2"" SizeY=""3"">
            <CardControl Elevation=""0"" CssClass=""dash-card""><ChartControl Type=""ChartType.Donut"" Title=""Sources"" Height=""200px"" InnerRadius=""0.5"" Series=""_sources"" /></CardControl>
        </DashboardLayoutPanel>
    </DashboardLayoutPanels>
</DashboardLayoutControl>
</div>
<span class=""result"">@(_focus is null ? ""Three KPI cards on row 0, charts on rows 2–4."" : $""{_kpis.First(k => k.Key == _focus).Label} spans the row; the others moved down."")</span>";
        public const string DashboardCs = @"// Dashboard: placements come from state so a click re-flows the grid.
private sealed record Kpi(string Key, string Value, string Label, string Trend, string Detail);

private readonly Kpi[] _kpis =
{
    new(""orders"", ""1,234"", ""Orders"", ""+5.2%"", ""1,234 this week, 1,173 last week""),
    new(""revenue"", ""$89K"", ""Revenue"", ""+12%"", ""$89K this week, $79K last week""),
    new(""uptime"", ""98.5%"", ""Uptime"", ""+0.1%"", ""98.5% over 30 days, 2 incidents""),
};

private string? _focus;

private Dictionary<string, (int Row, int Col, int SizeX, int SizeY)> _place = new();

private int ChartsRow => _focus is null ? 2 : 4;   // KPI rows 0–1, or 0–3 while one is expanded

protected override void OnInitialized() { _selected = _data[""Requests""][1]; Layout(); }

private void Toggle(string key) { _focus = _focus == key ? null : key; Layout(); }

private void Layout()
{
    _place.Clear();
    var col = 0;
    if (_focus is not null) _place[_focus] = (0, 0, 3, 2);            // expanded card takes the whole first row
    foreach (var k in _kpis.Where(k => k.Key != _focus))
        _place[k.Key] = (_focus is null ? 0 : 2, col++, 1, 2);        // the rest line up below it
}

private readonly List<ChartSeries> _traffic = new()
{
    new() { Name = ""Visits"", DataPoints = new() { new(""Mon"", 120), new(""Tue"", 180), new(""Wed"", 210), new(""Thu"", 190), new(""Fri"", 250), new(""Sat"", 140), new(""Sun"", 100) } }
};

private readonly List<ChartSeries> _sources = new()
{
    new() { Name = ""Traffic"", DataPoints = new() { new(""Organic"", 55), new(""Paid"", 25), new(""Referral"", 15), new(""Direct"", 5) } }
};";

        public const string GridStack = @"<div class=""summary"">
    <StackLayoutControl Orientation=""FlexOrientation.Vertical"" Gap=""14px"">
        <StackLayoutControl AlignItems=""FlexAlignment.Center"" Gap=""8px"">
            <h4>@_pkg.Name</h4>
            @if (_held)
            {
                <BadgeControl Variant=""BadgeVariant.Success"" Text=""Place held"" />
            }
        </StackLayoutControl>
        <GridLayoutControl Columns=""@GridColumns"" Gap=""12px 20px"">
            @foreach (var (label, value) in Fields)
            {
                <div><span class=""field-label"">@label</span><span class=""field-value"">@value</span></div>
            }
            <GridLayoutItemControl ColumnSpan=""_columns"">
                <span class=""field-label"">Included</span>
                <StackLayoutControl Gap=""6px"" Wrap=""_wrapTags"" CssClass=""tags"">
                    @foreach (var service in _services)
                    {
                        <BadgeControl Variant=""BadgeVariant.Light"" Text=""@service"" />
                    }
                </StackLayoutControl>
            </GridLayoutItemControl>
        </GridLayoutControl>
        <StackLayoutControl Gap=""8px"" JustifyContent=""FlexAlignment.End"" Wrap=""true"" CssClass=""actions"">
            <ButtonControl CssClass=""btn-sm"" OnClick=""NextSeason"">Next season</ButtonControl>
            <ButtonControl CssClass=""btn-sm btn-primary"" OnClick=""@(() => _held = !_held)"">@(_held ? ""Release the place"" : ""Hold a place"")</ButtonControl>
        </StackLayoutControl>
    </StackLayoutControl>
</div>
<span class=""result"">Columns @GridColumns · wrap @(_wrapTags ? ""on"" : ""off"") · @TravelData.Seasons[_season] departure, @(_held ? ""place held"" : ""no place held"")</span>";
        public const string GridStackCs = @"// Grid and stack: one package from TravelData; the column buttons, the wrap switch and the two buttons change page state.
private static readonly TravelData.Package _pkg = TravelData.Packages[0];   // Lisbon Explorer, 7 nights
private static readonly string _country = TravelData.Destinations.First(d => d.City == _pkg.City).Country;
private static readonly string[] _services = { ""Airport transfers"", ""Seven nights in a guesthouse"", ""Old-town walking tour"", ""Sintra day trip"", ""Fado evening with dinner"", ""City transport pass"" };
private int _season, _columns = 3;
private bool _wrapTags = true, _held;
private string GridColumns => $""repeat({_columns},minmax(0,1fr))"";
private (string Label, string Value)[] Fields => new[]
{
    (""Destination"", $""{_pkg.City}, {_country}""),
    (""Region"", _pkg.Region),
    (""Nights"", _pkg.Nights.ToString()),
    (""Season"", TravelData.Seasons[_season]),
    (""Group size"", ""Up to 12""),
    (""Departs"", ""Saturdays""),
};
private readonly SelectionItem[] _columnItems = { new(""1"", ""1 column""), new(""2"", ""2 columns""), new(""3"", ""3 columns"") };
private void PickColumns(IReadOnlyList<string> values) => _columns = int.Parse(values[0]);
private void NextSeason() => _season = (_season + 1) % TravelData.Seasons.Length;";
    }
