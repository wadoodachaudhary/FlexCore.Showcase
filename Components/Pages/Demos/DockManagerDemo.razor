<PageTitle>Dock manager — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Dock manager" Category="Components" CategoryHref="components" ControlName="DockManagerControl"
                   Tagline="Tabbed panes the user can split, float, unpin and close, with the whole arrangement saved as one JSON document."
                   SourcePath="Docking/DockManagerControl.razor;Docking/DockNodeView.razor;Docking/DockPanelActions.razor;Docking/DockModels.cs">
    <Overview>
        <p>
            <code>DockManagerControl</code> takes a list of <code>DockPanel</code>s, each a key, a title and a render fragment, and arranges them in
            a tree of tab groups and two-pane splits. Each pane's Dock… menu moves it into any group as a tab, or beside that
            group on its left, right, top or bottom. A pane can float as a non-modal window, unpin into a strip along the top
            that opens as a drawer, or close into a "Closed panes" menu that brings it back. Splits are <code>SplitterControl</code>s and keep their
            ratio. The arrangement is a <code>DockLayoutState</code>: the control reports it after every change, accepts one as its starting point, and
            saves or restores it as JSON.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="workspace" Title="A four-pane workspace" RazorCode="@Code.Workspace" CSharpCode="@Code.WorkspaceCs">
            <Description><p>Explorer on the left, Document and Output as tabs in the middle, Properties on the right, from a <code>State</code> built in code. Document cannot be closed and Output cannot float, so those buttons are missing on their action bars. Use Dock… to move a pane to another group or beside it, resize a split, float Properties, unpin Explorer and open it from the strip, close Output and bring it back from Closed panes. Save keeps the current layout as JSON, Restore applies it again, Reset hands the control a fresh starting state. The line below is fed by <code>StateChanged</code>.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="() => _json = _dock!.SaveLayout()">Save layout</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _dock!.RestoreLayoutAsync(_json!)" Disabled="@(_json is null)">Restore layout</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _state = Workspace()">Reset layout</ButtonControl>
            </Controls>
            <Demo>
                <DockManagerControl @ref="_dock" Panels="@_panels" State="@_state" StateChanged="s => _summary = Summarize(s)" Height="460px" />
                <p class="result">@_summary</p>
                @if (_json is not null)
                {
                    <details class="json"><summary>Saved layout, @_json.Length characters of JSON</summary><pre>@_json</pre></details>
                }
            </Demo>
        </DemoExample>

        <DemoExample Id="methods" Title="Driving it from code" RazorCode="@Code.Methods" CSharpCode="@Code.MethodsCs">
            <Description><p>Three panes that start as one tab group, the default when no <code>State</code> is given. The buttons call the public methods: Float, Unpin, Close and a Dock that puts every pane back into the first group as a tab. Log is not closable, so closing it is ignored and the counts do not move. The group's id for <code>DockAsync</code> is read from the layout the control saves.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick='() => _tools!.FloatAsync("chart")'>Float Chart</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick='() => _tools!.UnpinAsync("log")'>Unpin Log</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick='() => _tools!.CloseAsync("notes")'>Close Notes</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick='() => _tools!.CloseAsync("log")'>Close Log</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="DockAllAsync">Dock everything back</ButtonControl>
            </Controls>
            <Demo>
                <DockManagerControl @ref="_tools" Panels="@_toolPanels" StateChanged="s => _toolSummary = Summarize(s)" Height="320px" />
                <p class="result">@_toolSummary</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-dockmanagercontrol-parameters" Title="DockManagerControl parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="DockManagerControl parameters" Rows="Vocab.Params" />
            </DocSection>
            <DocSection Id="doc-dockmanagercontrol-events" Title="DockManagerControl events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="DockManagerControl events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-dockmanagercontrol-methods" Title="DockManagerControl methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="DockManagerControl methods" Rows="Vocab.Methods" />
                <p>
                <code>DockPanel(string Key, string Title, RenderFragment Content, bool Closable = true, bool Floatable = true)</code> is a record;
                <code>DockPosition</code> is <code>Tab</code>, <code>Left</code>, <code>Right</code>, <code>Top</code> or <code>Bottom</code>.
                <code>CssClass</code>, <code>Style</code>, <code>Id</code>, <code>Visible</code>, <code>Enabled</code> and <code>AdditionalAttributes</code>
                come from <code>FlexControlBase</code>; <code>Enabled="false"</code> disables every button and the methods.
                </p>
                <p>What the user can do, and where it comes from:</p>
                <ul>
                <li>Each group shows its panes as tabs; a click makes a pane active. The active pane gets an action bar with Dock…, Float (when floatable and not already floating), Unpin or Pin, and Close (when closable).</li>
                <li>Dock… opens a list of every group, named by its panes or "Empty area", each with Tab, Left, Right, Top and Bottom buttons; clicking one docks the pane there. The tabs also carry drag handlers that show the same five targets in each group while a pane is dragged, but in this release a tab does not start a drag: the control renders its <code>draggable</code> attribute empty, which browsers treat as not draggable.</li>
                <li>Docking as Tab, or into an empty group, appends the pane and makes it active. The other four positions split the target 50/50: Left and Right side by side, Top and Bottom stacked, the moved pane first for Left and Top.</li>
                <li>Floating opens the pane in a non-modal <code>DialogControl</code>, 520 by 360 px, each further floating pane offset 20 px from the one before; it can be dragged and resized while the manager is enabled, and its close icon and Escape close it only when the pane is closable.</li>
                <li>Unpinned panes sit in a strip above the groups; a click opens the pane as a drawer over the left side, and Pin docks it into the first group.</li>
                <li>Closed panes gather in a "Closed panes" menu; choosing one docks it into the first group as a tab.</li>
                <li>After every change empty splits are collapsed and the whole layout is validated before <code>StateChanged</code> is raised.</li>
                </ul>
            </DocSection>
            <DocSection Id="doc-docklayoutstate" Title="DockLayoutState" Count='@DocSection.Label(Vocab.State.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="DockLayoutState" Rows="Vocab.State" />
            </DocSection>
            <DocSection Id="doc-docklayoutstate-methods" Title="DockLayoutState methods" Count='@DocSection.Label(Vocab.StateMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="DockLayoutState methods" Rows="Vocab.StateMethods" />
            </DocSection>
            <DocSection Id="doc-docknode" Title="DockNode" Count='@DocSection.Label(Vocab.Node.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="DockNode" Rows="Vocab.Node" />
            </DocSection>
            <DocSection Id="doc-dockfloatingpane" Title="DockFloatingPane" Count='@DocSection.Label(Vocab.Floating.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="DockFloatingPane" Rows="Vocab.Floating" />
                <p>
                <code>Validate</code> refuses a layout in which a panel key is unknown, missing or placed twice; a node that has both panels and
                children or a child count other than 0 or 2; a ratio outside 5 to 95; a tree deeper than 30 levels or with a repeated node; an
                active panel that is not in its group; or a floating position that is not finite. <code>State</code> is validated against the current
                panel keys when it arrives, and so is the JSON given to <code>RestoreLayoutAsync</code>. When the panel list changes without a new
                <code>State</code>, removed panels leave the layout and added ones join the first group.
                </p>
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <p>
            Each group is a <code>tablist</code> of <code>tab</code> buttons with <code>aria-selected</code>, and its content a <code>tabpanel</code>
            named after the pane. The unpinned strip is labelled "Unpinned panes", the drawer is a <code>section</code> labelled with the pane's title,
            and floating panes are dialogs with the title as their header. The Dock… menu's buttons reach every position from the keyboard.
        </p>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/layout">Page layouts</a>: fixed page frames and splitters without user rearrangement.</li>
            <li><a href="demo/dialog">Dialogs</a>: the window a floating pane is made of.</li>
            <li><a href="demo/tabs-accordion">Tabs &amp; accordion</a>: plain tabs when the user should not move them.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private DockManagerControl? _dock;
    private DockLayoutState _state = Workspace();
    private string _summary = "No changes yet.";
    private string? _json;
    private readonly IReadOnlyList<DockPanel> _panels =
    [
        new("explorer", "Explorer", b => b.AddMarkupContent(0, "<ul><li>src/</li><li>tests/</li><li>docs/</li><li>README.md</li></ul>")),
        new("document", "Document", b => b.AddMarkupContent(0, "<p>The document pane cannot be closed, so its action bar has no Close button.</p>"), Closable: false),
        new("properties", "Properties", b => b.AddMarkupContent(0, "<dl><dt>Name</dt><dd>README.md</dd><dt>Size</dt><dd>2.1 KB</dd><dt>Modified</dt><dd>Today</dd></dl>")),
        new("output", "Output", b => b.AddMarkupContent(0, "<pre>Build started…\nBuild succeeded.</pre><p>The output pane cannot float.</p>"), Floatable: false),
    ];

    private static DockLayoutState Workspace() => new()
    {
        Root = new()
        {
            Vertical = true, Ratio = 25,
            Children =
            [
                new() { Panels = ["explorer"], ActivePanel = "explorer" },
                new()
                {
                    Vertical = true, Ratio = 70,
                    Children =
                    [
                        new() { Panels = ["document", "output"], ActivePanel = "document" },
                        new() { Panels = ["properties"], ActivePanel = "properties" },
                    ],
                },
            ],
        },
    };

    private static string Summarize(DockLayoutState s) =>
        $"{s.Nodes().Count(n => n.Children.Count == 0)} groups, {s.Floating.Count} floating, {s.AutoHidden.Count} unpinned, {s.Closed.Count} closed.";

    private DockManagerControl? _tools;
    private string _toolSummary = "No changes yet.";
    private readonly IReadOnlyList<DockPanel> _toolPanels =
    [
        new("chart", "Chart", b => b.AddMarkupContent(0, "<p>A floatable pane.</p>")),
        new("log", "Log", b => b.AddMarkupContent(0, "<p>Not closable: Close Log is ignored.</p>"), Closable: false),
        new("notes", "Notes", b => b.AddMarkupContent(0, "<p>Closable and floatable.</p>")),
    ];

    private async Task DockAllAsync()
    {
        foreach (var key in new[] { "chart", "log", "notes" })
        {
            var layout = DockLayoutState.FromJson(_tools!.SaveLayout());
            var group = layout.Nodes().First(n => n.Children.Count == 0).Id;
            await _tools.DockAsync(key, group, DockPosition.Tab);
        }
    }

