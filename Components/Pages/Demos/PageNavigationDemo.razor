        new() { Code = "SUP-003", Name = "Top It Up Bottle Co.", Category = "Drinkware", Address = "960 Canal Avenue", City = "Salt Lake City", Country = "United States",
                PostalCode = "84104", Phone = "+1 801 555 0164", Email = "orders@topitup.example", InsuranceOnFile = true, SendsShipNotices = true },
        new() { Code = "SUP-004", Name = "Lumen Being Headlamps", Category = "Lighting", Address = "5 Copper Lane", City = "Albuquerque", Country = "United States",
                PostalCode = "87102", Phone = "+1 505 555 0128", Email = "orders@lumenbeing.example", Contracted = true },
    ];

    private static readonly Contact[] AllContacts =
