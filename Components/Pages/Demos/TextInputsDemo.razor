    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
        <ul>
            <li>All five render a native <code>&lt;input&gt;</code> or <code>&lt;textarea&gt;</code>, so the browser's own caret keys, selection and screen-reader announcements apply.</li>
            <li>Name each box with a visible caption in a wrapping <code>&lt;label&gt;</code>, as this page does. <code>TextBoxControl</code> and <code>PasswordControl</code> also pass attributes such as <code>id</code>, <code>aria-label</code> and <code>aria-describedby</code> to the input. On <code>MaskedTextBoxControl</code>, set <code>AriaLabel</code> to the caption: it becomes the input's <code>aria-label</code>, which screen readers use ahead of the wrapping label.</li>
            <li><code>NumericTextBoxControl</code> sets <code>inputmode</code> to <code>numeric</code> or <code>decimal</code> for on-screen keyboards, and <code>aria-invalid="true"</code> while a <code>ValueChange</code> handler has canceled the entry.</li>
            <li><code>MaskedTextBoxControl</code> formats and checks the entry when it is committed, on leaving the box or Enter. An error appears under the box as <code>role="alert"</code> text, and the input gets <code>aria-invalid="true"</code> and an <code>aria-describedby</code> that points at it; typing clears it.</li>
            <li><code>PasswordControl</code> writes <code>autocomplete="current-password"</code>, or <code>new-password</code> in <code>Replacement</code> mode, so password managers can tell a sign-in box from a new password. Its eye button is named "Show password" or "Hide password", carries <code>aria-pressed</code>, and stays out of the Tab order (<code>tabindex="-1"</code>) so a form tabs as it would with a plain password box.</li>
            <li><code>MaxLength</code> becomes the input's <code>maxlength</code>, so typing stops at the limit. Show a count or a note near the box, as the Notes with a limit example does.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Text editors inside grid cells and the two typing transports: <a href="demo/grid/typing-modes">Typing modes</a>.</li>
            <li><code>FormControl</code> builds its text editors from <code>TextBoxControl</code> (<code>Multiline</code> for <code>FormEditorType.TextArea</code>): <a href="demo/forms">Forms</a>.</li>
            <li>Formatted text with toolbars: <a href="demo/rich-text-editor">Rich text editor</a>. Numbers picked by dragging: <a href="demo/sliders">Sliders</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Traveler details
    private static readonly TravelData.Package Trip = TravelData.Packages[2];
    private string? _name = "Albus Door";
    private string? _email;
    private int _travelers = 2;
    private decimal _budget = 3200m;
    private string? _budgetNote;
    private string TravelerCount => _travelers == 1 ? "1 traveler" : $"{_travelers} travelers";
    private decimal Floor => 250m * _travelers;
    private void CheckBudget(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> e)
    {
        if (e.Value < Floor)
        {
            e.Cancel = true;
            _budgetNote = $"Budget not accepted: at least {Floor:$#,##0} for {TravelerCount}. The box keeps your figure until you change it.";
            return;
        }
        _budget = e.Value;
        _budgetNote = null;
    }
    // Raising Travelers can leave an accepted budget under the floor.
    private string? LowBudget => _budget < Floor ? $"Raise the budget to at least {Floor:$#,##0} for {TravelerCount}." : null;

    // Notes with a limit
    private const int NoteLimit = 200;
    private static readonly string[] Phrases = { "Airport transfer requested.", "Vegetarian meals.", "Late arrival, hold the room." };
    private Fx.ControlKit.TextAreaControl? _noteBox;
    private string? _note = "Arriving on the late flight on day one. ";
    private bool _classicMenu;
    private string? _noteStatus;
    private int NoteLength => _note?.Length ?? 0;
    private async Task Insert(string phrase)
    {
        if (_noteBox is null) return;
        var inserted = await _noteBox.InsertTextAsync(phrase + " ");
        _noteStatus = inserted ? "Inserted at the caret." : $"Not inserted: the phrase would pass the {NoteLimit}-character limit.";
    }

    // Traveler portal sign-up
    private MaskedTextBoxControl? _mask;
    private string? _phone, _password, _portal;
    private bool _phoneOk;
    // OnChange runs only for a number the mask accepts.
    private void PhoneSet(MaskResult result)
    {
        _phoneOk = result.Complete;
        _portal = null;
    }
    private bool LongEnough => (_password?.Length ?? 0) >= 8;
    private bool HasDigit => _password?.Any(char.IsDigit) == true;
    private bool HasUpper => _password?.Any(char.IsUpper) == true;
    private bool CanCreate => _phoneOk && LongEnough && HasDigit && HasUpper;
    // The number may have been changed to one the mask rejects since it was accepted: check it again.
    private async Task CreateAccount()
    {
        if (_mask is null) return;
        await _mask.CommitAsync();
        if (_mask.Error is not null)
        {
            _phoneOk = false;
            _portal = "Not created: enter all ten digits of the mobile number.";
            return;
        }
        _portal = $"Account created for Albus Door; codes go to {_phone}.";
    }

    // Vocabulary rows, one per public member (FlexCore 0.2.49).
    private static class Vocab
    {
        public static readonly ApiRow[] TextBox =
        {
            new("Value", "The text. Bind with <code>@bind-Value</code>.", "string?", "null"),
            new("ValueExpression", "Set by <code>@bind-Value</code>. Server-backed edits then notify a surrounding <code>EditForm</code>'s <code>EditContext</code>. In the plain case (no <code>UpdateOnInput</code>, <code>OnKeyDown</code>, <code>InputValueChanged</code>, focus or selection options, classic menu, clear button or <code>ClientBuffered</code>) the control renders Blazor's own <code>InputText</code>, or <code>InputTextArea</code> when multi-line.", "Expression&lt;Func&lt;string?&gt;&gt;?", "null"),
            new("Placeholder", "Hint shown while the box is empty. An explicit <code>placeholder</code> attribute wins.", "string?", "null"),
            new("CssClass", "Class on the input, merged with any <code>class</code> attribute. Without one the input has no styling of its own; this page adds <code>text-field</code>.", "string?", "null"),
            new("Width", "CSS width written as an inline style, such as <code>250px</code> or <code>100%</code>. On a password box it sizes the wrapper and the input fills it.", "string?", "null"),
            new("ShowClearButton", "Adds a × button inside a single-line box whose type is <code>text</code>. It shows while the box has focus and holds text; clicking it empties the box and raises <code>ValueChanged</code> with the empty text.", "bool", "false"),
            new("Enabled", "False renders <code>disabled</code>. There is no <code>ReadOnly</code> parameter; a <code>readonly</code> attribute passes through to the input.", "bool", "true"),
            new("MaxLength", "Writes <code>maxlength</code>. A client-buffered commit is also cut to this length.", "int?", "null"),
            new("InputType", "The input's <code>type</code>: <code>email</code>, <code>tel</code>, <code>password</code> and so on. Ignored when <code>Multiline</code>; an explicit <code>type</code> attribute wins except for a password box.", "string", "\"text\""),
            new("Multiline", "Renders a <code>&lt;textarea&gt;</code> instead of an input.", "bool", "false"),
            new("Rows", "Writes the <code>rows</code> attribute: the visible lines of a multi-line box.", "int?", "null"),
            new("UpdateOnInput", "Raise <code>ValueChanged</code> on every keystroke instead of when the field changes.", "bool", "false"),
            new("TypingBehavior", "<code>ClientBuffered</code> keeps keystrokes in the browser and sends the whole value when the box loses focus; see the values table.", "TextBoxTypingBehavior", "TextBoxTypingBehavior.ServerBacked"),
            new("Uncontrolled", "The browser owns the text, so a parent re-render never writes older text back over what is being typed. False gives the controlled input whose value follows <code>Value</code> on every render.", "bool", "true"),
            new("ReseedOnOutsideChange", "When the parent sets a different <code>Value</code> from code, a browser-owned box shows it. Grid editors that push values through their own channel set this false.", "bool", "true"),
            new("AutoFocus", "Focuses the box after the first render and writes <code>autofocus</code>.", "bool", "false"),
            new("SelectOnFocus", "With <code>AutoFocus</code>, that first focus selects the text. On a later focus the control asks its script to select, and the script skips this whenever the text differs from the element's <code>value</code> attribute, which Blazor does not write, so a box holding text is not selected.", "bool", "false"),
            new("ReplaceOnFirstInput", "After the box gains focus, the first character typed replaces the whole text and the first Backspace or Delete clears it. A click inside the focused box cancels this.", "bool", "false"),
            new("SelectAllOnDoubleClick", "Double-click asks the script to select the whole text; the same <code>value</code>-attribute check as <code>SelectOnFocus</code> skips it for a box holding text.", "bool", "false"),
            new("UseClassicContextMenu", "Replaces the browser's right-click menu with the control's own Windows-style menu.", "bool", "false"),
            new("ContextMenuItems", "The items the classic menu shows; see the values table.", "TextContextMenuItems", "TextContextMenuItems.Legacy"),
            new("KeepNativeTab", "For <code>ClientBuffered</code> with an <code>OnKeyDown</code> handler: Tab commits and is reported once, but the browser still moves focus. Grid cell editors leave it false.", "bool", "false"),
            new("TypingKeysStayLocal", "Keydown events for printable keys, Backspace and Delete are not sent to the server; the text itself still is. Not used with <code>ClientBuffered</code>. For browser-owned editors whose host ignores typing keys, such as the grid's cell editor.", "bool", "false"),
            new("HtmlAttributes", "More attributes for the input, merged after the unmatched ones.", "Dictionary&lt;string, object&gt;?", "null"),
            new("ElementReferenceCaptured", "Called after each render with the input's <code>ElementReference</code>.", "Action&lt;ElementReference&gt;?", "null"),
            new("AdditionalAttributes", "Captures unmatched attributes (<code>id</code>, <code>aria-label</code>, <code>readonly</code>…) and writes them on the input.", "IDictionary&lt;string, object&gt;?", "null"),
        };
        public static readonly ApiRow[] Password =
        {
            new("ShowPasswordToggle", "Shows the eye button that reveals and hides the password.", "bool", "true"),
            new("RevealLastTypedCharacter", "Briefly draws the character just typed over the masked box. Pasted, autofilled and programmatic text stays masked.", "bool", "true"),
            new("PasswordRevealDurationMs", "How long that character shows. 0 turns it off; values above 2000 are capped at 2000.", "int", "1000"),
            new("ExistingPasswordViewable", "False starts the box blank and never renders the supplied <code>Value</code>; a blank commit before any typing is ignored. Keep the saved value on the server.", "bool", "true"),
            new("PasswordRevealUnavailableReason", "Keeps the eye visible but disabled, with this text as its label and tooltip, for example when only a hash is stored.", "string?", "null"),
        };
        public static readonly ApiRow[] TextBoxEvents =
        {
            new("ValueChanged", "When the field changes (Tab out, click away, Enter), or on every keystroke with <code>UpdateOnInput</code>. With <code>ClientBuffered</code>, when the box loses focus. Also after a classic-menu command that changed the text.", "string?"),
            new("InputValueChanged", "A plain <code>Action&lt;string?&gt;</code> called with the text on every input event, with or without <code>UpdateOnInput</code> (with <code>ClientBuffered</code>, on each commit). It does not re-render the parent.", "string?"),
            new("OnKeyDown", "Key presses in the box; while it is unset, the box sends no keydown events to the server. With <code>ClientBuffered</code> it receives the commit keys (Enter, Tab, Up, Down, the page keys) after the value has been sent, and Escape without sending it; it never sees the typing keys.", "KeyboardEventArgs"),
            new("OnBlur", "When the box loses focus, after a client-buffered draft has been sent.", null),
            new("OnPasteTruncated", "A paste was cut short by <code>MaxLength</code>. The browser trims before any input event, so this is the only notice.", "(int PastedLength, int MaxLength)"),
        };
        public static readonly ApiRow[] TextBoxMethods =
