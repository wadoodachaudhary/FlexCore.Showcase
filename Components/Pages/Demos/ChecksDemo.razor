            new("fx-switch-host · .fx-switch-disabled · fx-switch-input · fx-switch-track · fx-switch-thumb · fx-switch-label", "Label host, hidden input, 38×22px track (blue when checked), 18px thumb that slides 16px, and the text."),
            new("fx-rating · .fx-rating-readonly · .fx-rating-disabled · fx-rating-item · .fx-rating-filled / .fx-rating-empty", "Row of 20px star buttons; filled stars are amber, empty ones grey; hover scales a star by 15%."),
