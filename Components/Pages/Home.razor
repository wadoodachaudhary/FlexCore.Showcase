                    <span class=""desc-text"" title=""@r.Itinerary"">@r.Itinerary</span>
                    <button type=""button"" class=""btn-cell-popup-edit"" title=""Edit in Modal Popup""
                            @onclick=""@(() => OpenPopupEdit(r))"" @onclick:stopPropagation=""true"">
                        <span class=""bi bi-pencil-square""></span> Edit
                    </button>
                </div>
            </Template>
        </GridColumn>
    </GridColumnsBase>
