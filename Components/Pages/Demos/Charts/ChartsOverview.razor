        new() { Name = "Wed", DataPoints = new() { new("9am", 4), new("10am", 7), new("11am", 6), new("12pm", 8), new("1pm", 5), new("2pm", 9), new("3pm", 8), new("4pm", 7) } },
        new() { Name = "Thu", DataPoints = new() { new("9am", 5), new("10am", 8), new("11am", 7), new("12pm", 6), new("1pm", 7), new("2pm", 6), new("3pm", 5), new("4pm", 4) } },
        new() { Name = "Fri", DataPoints = new() { new("9am", 6), new("10am", 4), new("11am", 5), new("12pm", 3), new("1pm", 2), new("2pm", 4), new("3pm", 3), new("4pm", 2) } }
    };

    SunburstNode _sunburstDemoNode = CovidDataService.GetCovidSunburstTree();

    // Code tabs are verbatim
    private static class Code
    {
        public const string Gallery = @"<TabControl @bind-SelectedIndex=""_tab"">
