<PageTitle>Batch editing — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Batch editing" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Double-click a cell, type, press Enter: cell-by-cell editing on a 5,000-row list, written straight to the bound objects."
                   SourcePath="Grid/EditSettings.cs;Grid/GridControl.razor.cs;Grid/GridControlEvents.cs">
    <Overview>
        <p>
            <code>EditSettings</code> turns editing on and picks the mode. In <code>EditMode.Batch</code> a double-click on an editable cell,
            or Enter on the selected cell, opens an editor in that cell; Tab or Enter commits the value to the bound object and Escape
            abandons it. There is no row editor and no save button. Columns opt in with <code>AllowEditing</code>. <code>GridControlEvents</code> reports what happens: <code>OnCellEdit</code> before a cell opens (set
            <code>Cancel</code> to refuse) and <code>OnCellSave</code> when a value is written.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="edit" Title="Edit cells in place" RazorCode="@Code.Edit" CSharpCode="@Code.EditCs">
            <Description><p>Five thousand generated rows held in memory. Item Code, Phase and Phase Title are read-only; double-click any other cell, or select it and press Enter, to edit it. Enter commits and stays on the cell, Tab commits and moves the selection to the next editable cell, Escape abandons the edit. The line under the grid counts saves and names the last one.</p></Description>
            <Demo>
                <GridControl TValue="EstimatingItemRecord"
                             DataSource="@_items"
                             ShowRowCountInFooter="true"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowSearchBar="true"
                             Height="420px"
                             EditSettingsRef="@_editSettings"
                             EventsRef="@_events"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(EstimatingItemRecord.Item)" HeaderText="Item Code" Width="105px" AllowEditing="false" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.ItemDesc)" HeaderText="Description" Width="260px" AllowEditing="true" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.PhaseDesc)" HeaderText="Phase Title" Width="180px" AllowEditing="false" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.CostCategory)" HeaderText="Cost Category" Width="130px" AllowEditing="true" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.OrderUOM)" HeaderText="UOM" Width="75px" TextAlign="TextAlign.Center" AllowEditing="true" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.Price)" HeaderText="Unit Price" Width="105px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.WastePercent)" HeaderText="Waste %" Width="85px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" />
                        <GridColumn Field="@nameof(EstimatingItemRecord.POIndex)" HeaderText="PO Index" Width="100px" AllowEditing="true" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_saveCount @(_saveCount == 1 ? "cell" : "cells") saved@(_last is null ? "" : $"; last: {_last}")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>EditSettings</code>, <code>EditMode</code>, the editing parameters of <code>GridColumn</code> and the edit events on <code>GridControlEvents</code> are still to be written from <code>Grid/EditSettings.cs</code>, <code>Grid/GridColumn.cs</code> and <code>Grid/GridControlEvents.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/advanced">Frozen columns</a>: the same batch editing on a grid with pinned columns.</li>
            <li><a href="demo/grid/typing-modes">Typing modes</a> and <a href="demo/grid/unsaved-row-lock">Unsaved-row lock</a>: more on editing.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private List<EstimatingItemRecord> _items = [];
    private int _saveCount;
    private string? _last;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly GridControlEvents<EstimatingItemRecord> _events = new();

    protected override void OnInitialized()
    {
        _items = BenchData.EstimatingItems.ToList();

        _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<EstimatingItemRecord>>(this, args =>
        {
            _saveCount++;
            _last = $"{args.ColumnName} = {args.Value} on {args.Data.Item}";
        });
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed); the C# tab also carries
    // EstimatingItemRecord from Data/BenchModels.cs.
    private static class Code
    {
