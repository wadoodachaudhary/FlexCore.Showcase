private void CancelExport() => _grid?.CancelProviderExport();

private Task OnExportProgress(GridProviderExportProgress progress)
{
    _exportProgress = progress;
    return Task.CompletedTask;
}

private static List<ProviderOrder> BuildOrders()
{
    string[] regions = [""North"", ""South"", ""East"", ""West""];
    string[] categories = [""Cabinets"", ""Electrical"", ""Flooring"", ""Hardware"", ""Plumbing"", ""Windows""];
    var rows = new List<ProviderOrder>(12_000);
    for (var id = 1; id <= 12_000; id++)
    {
        rows.Add(new ProviderOrder
        {
            Id = id,
            Region = regions[id % regions.Length],
            Category = categories[(id * 7) % categories.Length],
            Customer = $""Customer {(id * 13) % 425:D3}"",
            OrderDate = new DateTime(2024, 1, 1).AddDays(id % 730),
            Quantity = 1 + id % 50,
            Amount = 25m + (id % 500) * 3.17m
        });
    }
    return rows;
}

