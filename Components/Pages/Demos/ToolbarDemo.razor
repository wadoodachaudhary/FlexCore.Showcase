@page "/demo/toolbar"
@using FlexCore.Showcase.Components.Shared

@* 2026-11-14: new page for ToolbarControl, ToolbarButtonControl, ToolbarSeparatorControl and AppBarControl, moved off the AI prompt
   page. Facts from Toolbar*Control.razor(.css), Layout/AppBarControl.razor(.css), AppBarPosition.cs (FlexCore 0.2.50).
   ToolbarButtonControl.HasDropdown only draws the arrow, so the Export panel is page markup. Code tabs are generated from the
   Demo blocks, the code sections and the stylesheet. *@

<PageTitle>Blazor Toolbar and App Bar — FlexCore</PageTitle>

<FeatureDemoLayout Title="Toolbar" Category="Components" ControlName="ToolbarControl · ToolbarButtonControl · AppBarControl"
                   Tagline="Put a window's commands in one row, with a title bar above it."
                   SourcePath="ToolbarControl.razor; ToolbarButtonControl.razor; ToolbarSeparatorControl.razor; Layout/AppBarControl.razor; Layout/AppBarPosition.cs">
    <Overview>
        <p>
            <code>ToolbarControl</code> is a Blazor toolbar: a row of command buttons with separators, an area at the right, and a checkbox that hides the button captions. Use it above a document, list or form for the commands users reach for most: <code>ToolbarButtonControl</code> draws each button with an icon and a caption, and <code>AppBarControl</code> adds a title bar with start, middle and end areas that can stay in view while the content scrolls.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="commands" Title="Commands, captions and a trailing area" RazorCode="@Code.Commands" CSharpCode="@Code.CommandsCs" CssCode="@Code.Css">
            <Description><p>Clear Captions to leave icons and tooltips; Share keeps its text because it is the button's child content. Pin is a toggle, and its pressed look comes from this page's CSS, because the library styles <code>Selected</code> only on <code>Large</code> buttons.</p></Description>
            <Controls>
                <SwitchControl @bind-Checked="_vertical" Label="Vertical buttons" />
            </Controls>
            <Demo>
                <div class="tb">
                    <ToolbarControl ShowCaptions="_captions" ShowCaptionsChanged="SetCaptions">
                        <ChildContent>
                            <ToolbarButtonControl Label="New" IconCss="bi bi-file-earmark-plus" Vertical="_vertical" OnClick="NewRequest" />
                            <ToolbarButtonControl Label="Save" IconCss="bi bi-save" Vertical="_vertical" Disabled="!_dirty" OnClick="Save" />
                            <ToolbarSeparatorControl />
                            <ToolbarButtonControl Label="Pin" Title="Pin: keep this request at the top" IconCss="bi bi-pin-angle" Vertical="_vertical"
                                                  Selected="_pinned" OnClick="TogglePin" />
                            <ToolbarButtonControl Label="Web form" IconSrc="images/toolbar-globe.svg" IconAlt="Web form" Vertical="_vertical"
                                                  OnClick='() => Act("Web form")' />
                            <ToolbarSeparatorControl />
                            <ToolbarButtonControl Title="Share" IconCss="bi bi-share" Vertical="_vertical" OnClick='() => Act("Share")'>Share</ToolbarButtonControl>
                        </ChildContent>
                        <TrailingContent>
                            <BadgeControl Text="@($"{_open} open")" Variant="BadgeVariant.Info" />
                        </TrailingContent>
                    </ToolbarControl>
                    <p class="tb-status" role="status">Last action: @_last</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="tiles" Title="Large tool tiles" RazorCode="@Code.Tiles" CSharpCode="@Code.TilesCs" CssCode="@Code.Css">
            <Description><p>Pick a tool: <code>Large</code> buttons in a toolbar with the <code>fx-toolbar--large-tools</code> class and no Captions checkbox. Select and Text use the two icons the stylesheet draws itself.</p></Description>
            <Demo>
                <div class="tools">
                    <ToolbarControl CssClass="fx-toolbar--large-tools" ShowCaptionsToggle="false">
                        @foreach (var tool in _tools)
                        {
                            <ToolbarButtonControl Large="true" Vertical="true" Label="@tool.Name" IconCss="@tool.Icon"
                                                  Selected="@(_tool == tool.Name)" OnClick="() => _tool = tool.Name" />
                        }
                    </ToolbarControl>
                    <p class="tb-status" role="status">Tool: @_tool</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="app-bar" Title="App bar over a toolbar" RazorCode="@Code.AppBar" CSharpCode="@Code.AppBarCs" CssCode="@Code.Css">
            <Description><p>Scroll the frame: the app bar stays at the top while <code>Position</code> is <code>Sticky</code>. This toolbar keeps its own captions state, and Export shows the <code>HasDropdown</code> arrow; the menu under it is page markup, closed by a click anywhere.</p></Description>
            <Controls>
                <SwitchControl @bind-Checked="_sticky" Label="Sticky app bar" />
            </Controls>
            <Demo>
                <div class="qd">
                    <AppBarControl Position="@(_sticky ? AppBarPosition.Sticky : AppBarPosition.Static)">
                        <StartContent><SvgIconControl Name="document" Size="20px" /><strong>Quote desk</strong></StartContent>
                        <ChildContent><span class="qd-sub">Lisbon desk · requests from the web form</span></ChildContent>
                        <EndContent><BadgeControl Text="@(_deskDirty ? "Unsaved" : "Saved")" Variant="@(_deskDirty ? BadgeVariant.Warning : BadgeVariant.Success)" /></EndContent>
                    </AppBarControl>
                    <ToolbarControl CaptionsToggleLabel="Labels">
                        <ToolbarButtonControl Label="New request" IconCss="bi bi-file-earmark-plus" OnClick="NewQuote" />
                        <ToolbarButtonControl Label="Save" IconCss="bi bi-save" Disabled="!_deskDirty" OnClick="SaveQuote" />
                        <ToolbarSeparatorControl />
                        <span class="qd-export">
                            <ToolbarButtonControl Label="Export" IconCss="bi bi-box-arrow-up" HasDropdown="true"
                                                  OnClick="() => _exportOpen = !_exportOpen" />
                            @if (_exportOpen)
                            {
                                <div class="qd-backdrop" @onclick="() => _exportOpen = false"></div>
                                <div class="qd-menu">
                                    <ButtonControl CssClass="qd-menu-item" OnClick='() => Desk("Export › PDF quote")'>PDF quote</ButtonControl>
                                    <ButtonControl CssClass="qd-menu-item" OnClick='() => Desk("Export › CSV itinerary")'>CSV itinerary</ButtonControl>
                                </div>
                            }
                        </span>
                        <ToolbarButtonControl Label="Print" IconCss="bi bi-printer" OnClick='() => Desk("Print")' />
                    </ToolbarControl>
                    <p class="tb-status" role="status">Last action: @_deskLast</p>
                    <div class="qd-label">Agent notes, request QD-@(_request)</div>
                    <TextBoxControl @bind-Value="_notes" @bind-Value:after="MarkDirty" Multiline="true" Rows="10" Width="100%" aria-label="Agent notes" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-toolbarcontrol-parameters" Title="ToolbarControl parameters" Count='@DocSection.Label(Vocab.Toolbar.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="ToolbarControl parameters" Rows="Vocab.Toolbar" />
                <p>
                    With captions off the root gets <code>fx-toolbar--no-captions</code>: <code>Label</code> captions are hidden, buttons shrink to 30px high
                    and lie flat even when <code>Vertical</code>, and every <code>ToolbarButtonControl</code> shows its tooltip even with <code>ShowTooltip</code>
                    false. Text passed as a button's <code>ChildContent</code> stays visible. A button with a <code>Label</code> and no icon is left empty, so
                    give every button an icon.
                </p>
            </DocSection>
            <DocSection Id="doc-toolbarbuttoncontrol-parameters" Title="ToolbarButtonControl parameters" Count='@DocSection.Label(Vocab.Button.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="ToolbarButtonControl parameters" Rows="Vocab.Button" />
            </DocSection>
            <DocSection Id="doc-toolbarseparatorcontrol-parameters" Title="ToolbarSeparatorControl parameters" Count='@DocSection.Label(Vocab.Separator.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="ToolbarSeparatorControl parameters" Rows="Vocab.Separator" />
                <p>A 1px line, 28px high (22px with captions off), with 4px either side.</p>
            </DocSection>
            <DocSection Id="doc-appbarcontrol-parameters" Title="AppBarControl parameters" Count='@DocSection.Label(Vocab.AppBar.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="AppBarControl parameters" Rows="Vocab.AppBar" />
            </DocSection>
            <DocSection Id="doc-appbarposition" Title="AppBarPosition" Count='@DocSection.Label(Vocab.Position.Length, "values")'>
                <ApiTable Kind="ApiKind.Values" Title="AppBarPosition" Rows="Vocab.Position" />
            </DocSection>
            <DocSection Id="doc-toolbar-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
                <p>The toolbar stylesheets read one variable, <code>--fx-zoom</code>, for text sizes; their colors are fixed. The app bar reads <code>--fx-surface</code> and <code>--fx-border</code>.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li><code>ToolbarControl</code> has <code>role="toolbar"</code> but no arrow-key handling, so each button is its own Tab stop. It accepts no <code>aria-label</code>, so two toolbars on one screen cannot be told apart by name. Its Captions checkbox is a native checkbox inside its label.</li>
            <li><code>ToolbarButtonControl</code> is a native button. It sets <code>aria-label</code> from <code>Title</code>, else <code>Label</code>, else <code>IconAlt</code>, so the name survives hidden captions; an <code>IconCss</code> icon is <code>aria-hidden</code>. Keyboard focus shows a dotted outline.</li>
            <li><code>Selected</code> writes <code>aria-pressed="true"</code> and leaves the attribute out when false, so a toggle that is off reads as a plain button.</li>
            <li><code>HasDropdown</code> adds no <code>aria-haspopup</code> or <code>aria-expanded</code>, and the button accepts no extra attributes to add them. The Export menu in the third example is plain page markup with no menu roles.</li>
            <li><code>ToolbarSeparatorControl</code> is <code>role="separator"</code> with <code>aria-orientation="vertical"</code>.</li>
            <li><code>AppBarControl</code> is a <code>&lt;header&gt;</code> (a banner landmark only when it is not inside <code>main</code>, <code>article</code>, <code>aside</code>, <code>nav</code> or <code>section</code>) wrapping a <code>ToolbarControl</code>, so its title and end items sit inside a <code>role="toolbar"</code>.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Menus across the top of a window: <a href="demo/menu-bar">Menu bar</a>. Commands in tabs and groups: <a href="demo/ribbon">Ribbon</a>.</li>
            <li>The bar at the foot of a window: <a href="demo/status-bar">Status bar</a>.</li>
            <li>A default action with its alternatives in a real menu: <a href="demo/split-button">Split button</a>. A button that opens its own panel: <a href="demo/buttons#dropdown">Buttons</a>.</li>
            <li>A pressed-state button outside a toolbar: <a href="demo/toggle-buttons">Toggle buttons</a>.</li>
            <li><code>EditorControl</code>'s built-in toolbar (<code>ShowToolbar</code>) is a <code>ToolbarControl</code>: <a href="demo/rich-text-editor">Rich text editor</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Commands
    private bool _captions = true, _vertical, _pinned, _dirty;
    private int _open = 3;
    private string _last = "none yet";
    private void Act(string action) => _last = action;
    private void NewRequest()
    {
        _open++;
        _dirty = true;
        Act("New");
    }
    private void Save()
    {
        _dirty = false;
        Act("Save");
    }
    private void TogglePin()
    {
        _pinned = !_pinned;
        Act(_pinned ? "Pin on" : "Pin off");
    }
    private void SetCaptions(bool on)
    {
        _captions = on;
        Act(on ? "Captions on" : "Captions off");
    }

    // Tiles
    private sealed record Tool(string Name, string Icon);
    private readonly Tool[] _tools =
    {
        new("Select", "fx-toolbar-icon-pointer"),
        new("Text", "fx-toolbar-icon-text"),
        new("Image", "bi bi-image"),
    };
    private string _tool = "Select";

    // App bar
    private bool _sticky = true, _exportOpen, _deskDirty;
    private int _request = 1042;
    private string _deskLast = "none yet";
    private string _notes = "Phoned on Monday: two adults, May 12–15, hotel within walking distance of the old town.";
    private void Desk(string action)
    {
        _exportOpen = false;
        _deskLast = action;
    }
    private void NewQuote()
    {
        Desk("New request");
        _request++;
        _notes = "";
        _deskDirty = true;
    }
    private void SaveQuote()
    {
        Desk("Save");
        _deskDirty = false;
    }
    private void MarkDirty() => _deskDirty = true;

