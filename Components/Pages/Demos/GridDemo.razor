@page "/demo/grid"
@page "/demo/grid/radzen-comparison"
@using FlexCore.Showcase.Components.Shared
@using FlexCore.Showcase.Data

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, tracker section 6). The grid and its data are unchanged;
   the hand-typed markup block became Razor and C# tabs copied from the live example. "Right-click for menu" left the copy:
   GridControl only raises OnContextMenu when the host handles it, and this page does not. Parameter tables are a later pass (SC-278). 
   2026-10-24: Documentation written: all 224 GridControl parameters in 27 purpose groups plus AggregateRow and AggregateColumn, rows in
   GridVocab.A.cs and GridVocab.B.cs (two agents, read sites checked with scratchpad/vocabcheck.py).
   2026-10-26 (Baaria: a better grid example, on open data used by several pages): the ten-employee list became the 4,009 airports
   with an IATA code and scheduled service in the OurAirports dump (public domain; Data/OurAirports, Data/AirportData.cs), grouped by
   continent with count, average elevation and longest runway in the captions; search, sort, filter, group, frozen code column. *@

<PageTitle>Data Grid — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Data Grid" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Search, sort, filter and group 4,009 real airports. Every other grid page takes one feature further."
                   SourcePath="Grid/GridControl.razor;Grid/GridControl.razor.cs;Grid/GridControl.AdvancedFeatures.cs;Grid/GridControl.PresentationFeatures.cs;Grid/GridControl.ItemsProvider.cs;Grid/GridControl.ColumnVirtualization.cs;Grid/GridControl.ProviderGrouping.cs;Grid/GridControl.ProviderExport.cs;Grid/GridModels.cs">
    <Overview>
        <p>
            <code>GridControl</code> binds a list through <code>DataSource</code> and <code>TValue</code>, declares its columns in
            <code>GridColumnsBase</code> and switches behaviours on with <code>Allow*</code> flags. This page shows the core set on real data:
            4,009 airports from <a href="https://ourairports.com/data/" target="_blank" rel="noopener">OurAirports</a>, which is in the public domain. The pages in the Data Grid menu each take one feature further, from batch editing and frozen columns to
            on-demand loading, grouping with totals and the tree grid; they are listed under Related.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="airports" Title="4,009 airports: search, sort, filter and group" RazorCode="@Code.Airports" CSharpCode="@Code.AirportsCs" CssCode="@Code.AirportsCss">
            <Description><p>Every airport with an IATA code and scheduled passenger service in the <a href="https://ourairports.com/data/" target="_blank" rel="noopener">OurAirports</a> data (public domain, snapshot of 26 October 2026). The grid opens grouped by continent, and each caption counts the airports and gives their average elevation and longest runway. Type in the search box (try <em>Lisbon</em> or <em>Iceland</em>), click a header to sort (Elevation finds the highest airports), use a header's filter icon, or drag the Continent chip out of the bar above the grid for one flat list. Scroll sideways for runways, city and the Wikipedia article: the Code column stays put. Only the rows in view are rendered.</p></Description>
            <Demo>
                <div class="airports">
                    <GridControl TValue="Airport" DataSource="@_airports"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 AllowFiltering="true"
                                 AllowGrouping="true"
                                 AllowResizing="true"
                                 EnableHover="true"
                                 ShowSearchBar="true"
                                 GroupColumns="@_groupColumns"
                                 AggregateRows="_aggregates"
                                 Height="560px">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(Airport.Code)" HeaderText="Code" Width="80px"
                                        IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                <Template Context="row">
                                    <span class="code">@(((Airport)row).Code)</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(Airport.Name)" HeaderText="Airport" Width="240px" />
                            <GridColumn Field="@nameof(Airport.Country)" HeaderText="Country" Width="140px" />
                            <GridColumn Field="@nameof(Airport.Type)" HeaderText="Type" Width="90px">
                                <Template Context="row">
                                    @{ var type = ((Airport)row).Type; }
                                    <BadgeControl Text="@type" CssClass="@($"type type-{type.ToLowerInvariant()}")" />
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(Airport.ElevationFt)" HeaderText="Elevation (ft)" Width="110px"
                                        Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(Airport.LongestRunwayFt)" HeaderText="Longest runway (ft)" Width="150px"
                                        Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(Airport.Runways)" HeaderText="Runways" Width="90px"
                                        Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(Airport.City)" HeaderText="City" Width="130px" />
                            <GridColumn Field="@nameof(Airport.Continent)" HeaderText="Continent" Width="120px" />
                            <GridColumn Field="@nameof(Airport.Wikipedia)" HeaderText="Wikipedia" Width="90px" AllowSorting="false" AllowFiltering="false">
                                <Template Context="row">
                                    @{ var link = ((Airport)row).Wikipedia; }
                                    @if (!string.IsNullOrEmpty(link))
                                    {
                                        <a href="@link" target="_blank" rel="noopener">Article</a>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumnsBase>
                    </GridControl>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            <code>GridControl</code> has 224 parameters. They are listed here in full, in eight sections you can open one at a time or all at once, with one or
            two sentences each and a pointer to the page that shows the feature; the detailed tables live there: columns on
            <a href="demo/grid/column-swap">Column sets</a> and <a href="demo/grid/dynamic-columns">Dynamic columns</a>, editing on
            <a href="demo/grid/batch-editing">Batch editing</a>, selection and detail rows on <a href="demo/grid/master-detail">Master-detail</a>,
            export on <a href="demo/grid/enterprise-suite">Export &amp; templates</a>, loading on <a href="demo/grid/provider-enterprise">On-demand loading</a>.
            Every row was checked against the place in the grid that reads the parameter; five parameters are declared but never read and
            say so.
        </p>
        <DocSections>
            <DocSection Id="doc-data" Title="Data and loading" Count="@GridVocab.Count(GridVocab.A_Data, GridVocab.B_Settings, GridVocab.B_Provider)" Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Data binding" Rows="GridVocab.A_Data" />
                <ApiTable Kind="ApiKind.Parameters" Title="Settings objects and direct row events" Rows="GridVocab.B_Settings" />
                <ApiTable Kind="ApiKind.Parameters" Title="On-demand loading" Rows="GridVocab.B_Provider" />
            </DocSection>
            <DocSection Id="doc-layout" Title="Size, layout and scrolling" Count="@GridVocab.Count(GridVocab.A_Layout, GridVocab.B_Presentation, GridVocab.A_Appearance, GridVocab.B_Scrolling)">
                <ApiTable Kind="ApiKind.Parameters" Title="Size and layout" Rows="GridVocab.A_Layout" />
                <ApiTable Kind="ApiKind.Parameters" Title="Presentation, paging and accessibility" Rows="GridVocab.B_Presentation" />
                <ApiTable Kind="ApiKind.Parameters" Title="Appearance and footer" Rows="GridVocab.A_Appearance" />
                <ApiTable Kind="ApiKind.Parameters" Title="Row windowing and scrolling" Rows="GridVocab.B_Scrolling" />
            </DocSection>
            <DocSection Id="doc-rows-columns" Title="Rows and columns" Count="@GridVocab.Count(GridVocab.A_Rows, GridVocab.A_Columns, GridVocab.B_Columns, GridVocab.B_HeaderMenu, GridVocab.B_ColumnChooser, GridVocab.A_ContextMenu)">
                <ApiTable Kind="ApiKind.Parameters" Title="Rows" Rows="GridVocab.A_Rows" />
                <ApiTable Kind="ApiKind.Parameters" Title="Columns" Rows="GridVocab.A_Columns" />
                <ApiTable Kind="ApiKind.Parameters" Title="Column generation, header bands and column virtualization" Rows="GridVocab.B_Columns" />
                <ApiTable Kind="ApiKind.Parameters" Title="Column header menu, cell menu and reorder" Rows="GridVocab.B_HeaderMenu" />
                <ApiTable Kind="ApiKind.Parameters" Title="Choose Columns, layout persistence and state" Rows="GridVocab.B_ColumnChooser" />
                <ApiTable Kind="ApiKind.Parameters" Title="Context menu" Rows="GridVocab.A_ContextMenu" />
            </DocSection>
            <DocSection Id="doc-sort-filter" Title="Sorting, filtering and paging" Count="@GridVocab.Count(GridVocab.A_Sorting, GridVocab.A_Filtering, GridVocab.B_Filtering, GridVocab.A_Paging)">
                <ApiTable Kind="ApiKind.Parameters" Title="Sorting" Rows="GridVocab.A_Sorting" />
                <ApiTable Kind="ApiKind.Parameters" Title="Filtering" Rows="GridVocab.A_Filtering" />
                <ApiTable Kind="ApiKind.Parameters" Title="Filtering and sorting, more" Rows="GridVocab.B_Filtering" />
                <ApiTable Kind="ApiKind.Parameters" Title="Paging" Rows="GridVocab.A_Paging" />
            </DocSection>
            <DocSection Id="doc-grouping" Title="Grouping and totals" Count="@GridVocab.Count(GridVocab.B_Grouping)">
                <ApiTable Kind="ApiKind.Parameters" Title="Grouping and totals" Rows="GridVocab.B_Grouping" />
                <ApiTable Kind="ApiKind.Properties" Title="AggregateRow" Rows="GridVocab.AggregateRow" />
                <ApiTable Kind="ApiKind.Properties" Title="AggregateColumn" Rows="GridVocab.AggregateColumn" />
            </DocSection>
            <DocSection Id="doc-selection" Title="Selection, keyboard and master-detail" Count="@GridVocab.Count(GridVocab.A_Selection, GridVocab.A_Keyboard, GridVocab.B_MasterDetail)">
                <ApiTable Kind="ApiKind.Parameters" Title="Selection" Rows="GridVocab.A_Selection" />
                <ApiTable Kind="ApiKind.Parameters" Title="Keyboard and focus" Rows="GridVocab.A_Keyboard" />
                <ApiTable Kind="ApiKind.Parameters" Title="Master-detail" Rows="GridVocab.B_MasterDetail" />
            </DocSection>
            <DocSection Id="doc-editing" Title="Editing" Count="@GridVocab.Count(GridVocab.A_Editing, GridVocab.B_Editing)">
                <ApiTable Kind="ApiKind.Parameters" Title="Editing" Rows="GridVocab.A_Editing" />
                <ApiTable Kind="ApiKind.Parameters" Title="Adding, cloning and validating rows" Rows="GridVocab.B_Editing" />
            </DocSection>
            <DocSection Id="doc-toolbar" Title="Toolbar, options rail, print and chart view" Count="@GridVocab.Count(GridVocab.B_Toolbar, GridVocab.B_OptionsRail, GridVocab.B_Print, GridVocab.B_Chart)">
                <ApiTable Kind="ApiKind.Parameters" Title="Toolbar" Rows="GridVocab.B_Toolbar" />
                <ApiTable Kind="ApiKind.Parameters" Title="Advanced view and options rail" Rows="GridVocab.B_OptionsRail" />
                <ApiTable Kind="ApiKind.Parameters" Title="Print and export" Rows="GridVocab.B_Print" />
                <ApiTable Kind="ApiKind.Parameters" Title="Chart view" Rows="GridVocab.B_Chart" />
            </DocSection>
        </DocSections>
        <p>
            <code>GridColumn</code> is documented on <a href="demo/grid/column-swap">Column sets</a> (layout), <a href="demo/grid/dynamic-columns">Dynamic columns</a>
            (data) and <a href="demo/grid/batch-editing">Batch editing</a> (editors). The events live on <code>GridControlEvents</code>, passed through
            <code>EventsRef</code>; the selection ones are on Master-detail and the editing ones on Batch editing.
        </p>
    </Vocabulary>

    <Related>
        @* Built from SiteNav so this list and the Data Grid menu cannot disagree. *@
        <ul>
            @foreach (var link in SiteNav.LinksOf("Data Grid"))
            {
                <li><a href="@link.Href">@link.Text</a></li>
            }
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Airports: the OurAirports snapshot (Data/AirportData.cs), grouped by continent to start. Count needs a numeric field, so it
    // counts Runways, which every airport has.
    private readonly IReadOnlyList<Airport> _airports = AirportData.Airports;

    private List<string> _groupColumns = new() { nameof(Airport.Continent) };

    private List<AggregateRow> _aggregates = new()
    {
        new AggregateRow
        {
            ShowInGroupCaption = true,
            Columns = new()
            {
                new AggregateColumn { Field = nameof(Airport.Runways), Type = AggregateType.Count,
                    GroupCaptionTemplate = "{value} airports" },
                new AggregateColumn { Field = nameof(Airport.ElevationFt), Type = AggregateType.Average, Format = "N0",
                    GroupCaptionTemplate = "avg elevation {value} ft" },
                new AggregateColumn { Field = nameof(Airport.LongestRunwayFt), Type = AggregateType.Max, Format = "N0",
                    GroupCaptionTemplate = "longest runway {value} ft" },
            }
        }
    };

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
    {
        public const string Airports = @"<div class=""airports"">
    <GridControl TValue=""Airport"" DataSource=""@_airports""
                 AllowSelection=""true""
                 AllowSorting=""true""
                 AllowFiltering=""true""
                 AllowGrouping=""true""
                 AllowResizing=""true""
                 EnableHover=""true""
                 ShowSearchBar=""true""
                 GroupColumns=""@_groupColumns""
                 AggregateRows=""_aggregates""
                 Height=""560px"">
        <GridColumnsBase>
            <GridColumn Field=""@nameof(Airport.Code)"" HeaderText=""Code"" Width=""80px""
                        IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Left"">
                <Template Context=""row"">
                    <span class=""code"">@(((Airport)row).Code)</span>
                </Template>
            </GridColumn>
            <GridColumn Field=""@nameof(Airport.Name)"" HeaderText=""Airport"" Width=""240px"" />
            <GridColumn Field=""@nameof(Airport.Country)"" HeaderText=""Country"" Width=""140px"" />
            <GridColumn Field=""@nameof(Airport.Type)"" HeaderText=""Type"" Width=""90px"">
                <Template Context=""row"">
                    @{ var type = ((Airport)row).Type; }
                    <BadgeControl Text=""@type"" CssClass=""@($""type type-{type.ToLowerInvariant()}"")"" />
                </Template>
            </GridColumn>
            <GridColumn Field=""@nameof(Airport.ElevationFt)"" HeaderText=""Elevation (ft)"" Width=""110px""
                        Type=""ColumnType.Number"" Format=""N0"" TextAlign=""TextAlign.Right"" />
            <GridColumn Field=""@nameof(Airport.LongestRunwayFt)"" HeaderText=""Longest runway (ft)"" Width=""150px""
                        Type=""ColumnType.Number"" Format=""N0"" TextAlign=""TextAlign.Right"" />
            <GridColumn Field=""@nameof(Airport.Runways)"" HeaderText=""Runways"" Width=""90px""
                        Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" />
            <GridColumn Field=""@nameof(Airport.City)"" HeaderText=""City"" Width=""130px"" />
            <GridColumn Field=""@nameof(Airport.Continent)"" HeaderText=""Continent"" Width=""120px"" />
            <GridColumn Field=""@nameof(Airport.Wikipedia)"" HeaderText=""Wikipedia"" Width=""90px"" AllowSorting=""false"" AllowFiltering=""false"">
                <Template Context=""row"">
                    @{ var link = ((Airport)row).Wikipedia; }
                    @if (!string.IsNullOrEmpty(link))
                    {
                        <a href=""@link"" target=""_blank"" rel=""noopener"">Article</a>
                    }
                </Template>
            </GridColumn>
        </GridColumnsBase>
    </GridControl>
</div>";
        public const string AirportsCs = @"// Airports: the OurAirports snapshot (Data/AirportData.cs), grouped by continent to start. Count needs a numeric field, so it
// counts Runways, which every airport has.
private readonly IReadOnlyList<Airport> _airports = AirportData.Airports;

private List<string> _groupColumns = new() { nameof(Airport.Continent) };

private List<AggregateRow> _aggregates = new()
{
    new AggregateRow
    {
        ShowInGroupCaption = true,
        Columns = new()
        {
            new AggregateColumn { Field = nameof(Airport.Runways), Type = AggregateType.Count,
                GroupCaptionTemplate = ""{value} airports"" },
            new AggregateColumn { Field = nameof(Airport.ElevationFt), Type = AggregateType.Average, Format = ""N0"",
                GroupCaptionTemplate = ""avg elevation {value} ft"" },
            new AggregateColumn { Field = nameof(Airport.LongestRunwayFt), Type = AggregateType.Max, Format = ""N0"",
                GroupCaptionTemplate = ""longest runway {value} ft"" },
        }
    }
};";
        public const string AirportsCss = @".airports ::deep .code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700; color: #0f172a; }
.airports ::deep .type { font-size: 11px; font-weight: 600; }
.airports ::deep .type-large { background: #dbeafe; color: #1e40af; }
.airports ::deep .type-medium { background: #ccfbf1; color: #115e59; }
.airports ::deep .type-small { background: #f1f5f9; color: #475569; }
.airports ::deep .fx-group-caption-agg { margin-left: 12px; color: #475569; font-weight: 400; }
.airports ::deep a { color: #0284c7; }";
    }
}
