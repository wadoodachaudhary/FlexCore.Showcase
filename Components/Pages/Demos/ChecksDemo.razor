            new("(unmatched attributes)", "Forwarded to the group <code>&lt;div&gt;</code>.", "Dictionary&lt;string,object&gt;"),
        };
        public static readonly ApiRow[] RadioItem =
        {
            new("RadioGroupItem.Value / Text / Disabled", "Positional record: <code>new(value, text, disabled)</code>. A disabled item renders but cannot be chosen.", "TValue / string / bool", "— / — / false"),
