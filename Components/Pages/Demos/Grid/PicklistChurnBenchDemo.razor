        public const string DynamicCs = @"private sealed record DynamicColumn(string Field, string Header, bool IsNumber, string? Format);

private readonly SelectionItem[] _sizes = { new(""50"", ""50 rows""), new(""500"", ""500 rows""), new(""2000"", ""2,000 rows"") };

private GridControl<ExpandoObject>? _grid;

private List<ExpandoObject> _rows = [];

private List<DynamicColumn> _columns = [];

private int _rowCount = 500;

private bool _leadTime;

protected override void OnInitialized()
{
    _rows = BuildRows(_rowCount, _leadTime);
    _columns = ColumnsFrom(_rows);
}

private Task SetRowCountAsync(int count)
{
    _rowCount = count;
    return ReloadAsync();
}

private Task SetLeadTimeAsync(bool on)
{
    _leadTime = on;
    return ReloadAsync();
}

private async Task ReloadAsync()
{
    var rows = BuildRows(_rowCount, _leadTime);
    var columns = ColumnsFrom(rows);
    if (_grid is null) { _rows = rows; _columns = columns; return; }
    await using (_grid.SuspendRedraw(columns.Select(c => c.Field)))
    {
        _rows = rows;
        _columns = columns;
    }
}

private static List<ExpandoObject> BuildRows(int count, bool leadTime)
{
    var groups = new[] { ""General"", ""Architectural"", ""Structural"", ""MEP"", ""Site"" };
    var rand = new Random(55);
    var list = new List<ExpandoObject>(count);
    for (int i = 1; i <= count; i++)
    {
        dynamic row = new ExpandoObject();
        row.Code = $""IT-{(1000 + i):D4}"";
        row.Description = $""Catalog item {i}, {groups[i % groups.Length].ToLowerInvariant()}"";
        row.Group = groups[i % groups.Length];
        row.Status = (i % 4 == 0) ? ""Pending"" : ""Active"";
        row.Rate = Math.Round((decimal)(rand.NextDouble() * 250 + 20), 2);
        if (leadTime) row.LeadTimeDays = 1 + (i * 7) % 30;
        list.Add(row);
    }
    return list;
}

private static List<DynamicColumn> ColumnsFrom(List<ExpandoObject> rows)
{
    if (rows.Count == 0) return [];
    var first = (IDictionary<string, object?>)rows[0];
    return first.Select(kv => new DynamicColumn(
        kv.Key,
        Humanize(kv.Key),
        kv.Value is decimal or int or double,
        kv.Value switch { decimal => ""N2"", int => ""N0"", _ => null })).ToList();
}

private static string Humanize(string key)
    => System.Text.RegularExpressions.Regex.Replace(key, ""(?<=[a-z])(?=[A-Z])"", "" "");";
    }

    private static class Vocab
    {
        public static readonly ApiRow[] Column =
        {
            new("Field", "The key the grid reads a cell by. On an <code>IDictionary&lt;string, object&gt;</code> or <code>IDictionary&lt;string, object?&gt;</code> row it is the entry key, matched exactly first and then case-insensitively; on any other row it is a public instance property matched case-insensitively through a cached compiled getter. There is no nested-path support, so <code>A.B</code> is looked up as one name and reads as null. It is also the header when <code>HeaderText</code> is null, the key of the column's sort and filter state, and the identity used when columns are added, removed or replaced.", "string", "\"\""),
            new("HeaderText", "The caption. Null shows <code>Field</code> itself (<code>DisplayHeader</code>); an empty string is an intentional blank header.", "string?", "null"),
            new("Type", "Picks the editor, the filter-row operators and their comparison, the sort-dialog labels, the plain-number and password display and the best-fit measure; the values are below. It does not change how a sort compares: <code>GridSortKeyComparer</code> compares the raw values by their own runtime type. Only <code>Date</code> and <code>CheckBox</code> change the default alignment, so a <code>Number</code> column stays left-aligned unless <code>TextAlign</code> is set, which is why the example sets it.", "ColumnType", "ColumnType.Text"),
            new("Format", "A .NET format string applied with the current culture when the raw value is <code>IFormattable</code> (<code>N2</code>, <code>C2</code>, <code>yyyy-MM-dd</code>). Without it a <code>Number</code> cell shows the plain invariant digits with no grouping, and a <code>Date</code> editor uses <code>MM/dd/yyyy</code>. Also the format of the aggregate footer, of the date picker in a row editor, and the number format of an exported xlsx cell.", "string?", "null"),
            new("DisplayFormatter", "Text for a non-null cell value. When set it is the display text, the search and filter text and the exported value, ahead of <code>Format</code> and <code>Type</code>; sorting still compares the raw value.", "Func&lt;object, string&gt;?", "null"),
            new("DisplayField", "A second field read through the same accessor. Its value stands in for the raw value in the display, search and filter text unless it is null, <code>DBNull</code> or blank; sorting still reads <code>Field</code>.", "string?", "null"),
            new("Formula", "A per-row expression evaluated instead of reading <code>Field</code>. Bracketed names such as <code>[Qty] * [UnitPrice]</code> go through the field accessor; bare names are matched against the row's dictionary keys or public properties. The result feeds the display text, the filter text and the export.", "string?", "null"),
            new("IsPrimaryKey", "Set by <code>AutoGenerateColumns</code> for a <code>[Key]</code> property. A generated row editor disables the cell for it.", "bool", "false"),
            new("AllowEditing", "<code>AutoGenerateColumns</code> sets it false for a <code>[Key]</code>, <code>[Editable(false)]</code> or <code>[ReadOnly(true)]</code> property and for one without a public setter; that is what keeps Item # and Extended read-only in the batch example.", "bool", "true"),
        };
        public static readonly ApiRow[] ColumnTypes =
        {
            new("Text", "The default. The cell shows the value's <code>ToString</code>; the filter row defaults to <code>Contains</code> and offers the full text operator list; the editor is a text box; the sort dialog offers A to Z."),
            new("Password", "Shown as one <code>*</code> per character; the row editor uses a password input; filters treat it as text."),
            new("Number", "Without <code>Format</code> the cell shows the plain invariant digits with no grouping. The filter row offers <code>Equals</code>, <code>DoesNotEqual</code>, the four comparisons, <code>IsEmpty</code> and <code>IsNotEmpty</code> and compares as <code>decimal</code>; the editor uses <code>inputmode=decimal</code> and a native number input only with <code>ShowNumericSpinner</code>; best fit measures the column as numeric. The default alignment is still Left."),
            new("Date", "Right-aligned by default. The row editor is a <code>DatePickerControl</code> with <code>Format</code> or <code>MM/dd/yyyy</code>, the batch editor an input of type <code>date</code>; the filter row offers the <code>Number</code> operator set and compares as dates; the sort dialog offers Oldest to Newest."),
            new("Boolean", "Edited with a <code>CheckBoxControl</code> in the row editor and without an in-cell text editor in batch mode; the filter row offers <code>Equals</code>, <code>DoesNotEqual</code>, <code>IsEmpty</code> and <code>IsNotEmpty</code> and compares as <code>bool</code>. The display cell has no special case, so it shows True or False as text, left-aligned."),
            new("CheckBox", "Renders a check box in the cell, and a click on an editable cell toggles the value in place. Centred by default; only an explicit <code>TextAlign.Right</code> overrides that. Exports write 1 or 0. Filters and editors behave as <code>Boolean</code>. A <code>CheckBox</code> column with an empty <code>Field</code> is the selection check-box column."),
        };
        public static readonly ApiRow[] RowShapes =
        {
