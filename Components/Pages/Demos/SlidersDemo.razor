        {
            new("fx-slider-host · .fx-slider-disabled", "Inline flex row, full width, 120px minimum; <code>disabled</code> adds opacity 0.5 and <code>pointer-events: none</code>."),
            new("fx-slider-range", "The input: 6px track, 18px round thumb that scales on hover."),
            new("fx-slider-value", "The readout: bold, right-aligned, 32px minimum width."),
            new("fx-range-slider", "Grid of two labelled rows (95px label column) and the <code>&lt;output&gt;</code> readout; 220px minimum width."),
