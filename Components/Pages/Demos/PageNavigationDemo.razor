        new() { SupplierCode = "SUP-002", DisplayName = "Cedric Diggle", Role = "Order desk", Phone = "+1 303 555 0118", Email = "cedric.diggle@pegtodiffer.example" },
        new() { SupplierCode = "SUP-003", DisplayName = "Nymphadora Tonic", Role = "Order desk", Phone = "+1 801 555 0165", Email = "nymphadora.tonic@topitup.example" },
        new() { SupplierCode = "SUP-003", DisplayName = "Filius Flipwick", Role = "Accounts", Phone = "+1 801 555 0166", Email = "filius.flipwick@topitup.example", Active = false },
