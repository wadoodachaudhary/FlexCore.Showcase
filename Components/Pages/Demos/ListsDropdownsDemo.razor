        public const string LookupCss = @".pair { display: flex; gap: 32px; flex-wrap: wrap; align-items: flex-start; }
.field-label, .pane-title { display: block; font-size: 12px; color: #64748b; margin: 0 0 6px; }
.result { font-size: 13px; color: #475569; margin: 14px 0 0; }
