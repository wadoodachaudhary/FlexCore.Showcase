<!-- classic look: add CssClass=""fx-dialog-classic"" ShowWindowIcon=""true"" and use fx-button-classic buttons -->
<DialogControl @bind-Visible=""_archiveOpen"" Header=""Archive project"" Width=""440px"" OnEnter=""Archive"">
    <ChildContent>
        <p>Archive <strong>Northwind rewrite</strong>? Members keep read access; nothing is deleted.</p>
    </ChildContent>
    <FooterContent>
        <ButtonControl CssClass=""btn-primary"" OnClick=""Archive"">Archive</ButtonControl>
        <ButtonControl CssClass=""btn-secondary"" OnClick=""@(() => _archiveOpen = false)"">Cancel</ButtonControl>
    </FooterContent>
</DialogControl>";
        public const string ModalCs = @"private bool _archiveOpen;
private void Archive()
{
    _archiveOpen = false;
    // ... archive the project ...
}";

        public const string Window = @"<ButtonControl CssClass=""btn-primary"" OnClick=""@(() => _winOpen = true)"">Open window</ButtonControl>

<DialogControl @bind-Visible=""_winOpen"" Header=""Inspector"" IsModal=""false"" ShowWindowIcon=""true""
               @bind-Width=""_winWidth"" @bind-Height=""_winHeight"" @bind-Position=""_winPos""
               MinResizeWidth=""360"" MinResizeHeight=""200"">
    <p>Drag the title bar, resize from any edge or corner, right-click the title for the window menu.</p>
</DialogControl>";
