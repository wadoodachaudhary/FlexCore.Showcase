@page "/demo/grid/advanced"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: on FeatureDemoLayout, generated code tabs. SC-018: Edit/Del had no handlers -> one Remove button; fixed Height.
   2026-10-18: vocabulary from GridColumn.cs, GridControl.ColumnFeatures.cs, GridColumnHeaderBand.cs, EditSettings.cs. .frozen
   carries the page CSS stopgap: scrolled columns showed through pinned ones (as on Wide grids, SC-292).
   2026-10-20: data-annotations example removed; page covers frozen columns and header bands only.
   2026-10-26: travel-theme sample data. *@

<PageTitle>Frozen Columns and Header Bands in a Blazor Grid — FlexCore</PageTitle>

<FeatureDemoLayout Title="Frozen columns" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Keep key columns in view while users scroll sideways, and label column groups."
                   SourcePath="Grid/GridControl.ColumnFeatures.cs;Grid/GridColumn.cs;Grid/GridColumnHeaderBand.cs;Grid/EditSettings.cs">
    <Overview>
        <p>
            Frozen columns keep IDs and status in view while users scroll a wide Blazor <code>GridControl</code> sideways, and header bands label each group of columns. Use them on booking or price lists with more columns than the screen holds, so the columns that identify a row never scroll away. Set <code>IsFrozen</code> and <code>FrozenPosition</code> to pin a column left or right, and give related columns the same <code>HeaderBand</code> name, or list them in <code>ColumnHeaderBands</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="frozen" Title="Header bands and frozen columns" RazorCode="@Code.Frozen" CSharpCode="@Code.FrozenCs">
            <Description><p>Scroll sideways: ID and Code stay on the left, Status and Actions on the right, and the Identity, Product, Amounts and Workflow bands span their columns; Qty, Price and Discount edit in place.</p></Description>
            <Demo>
                <div class="frozen">
                <GridControl DataSource="@_rows"
                             TValue="GridItem"
                             Height="420px"
                             AllowSorting="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             AllowSelection="true"
                             ColumnHeaderBands="@_headerBands"
                             EditSettingsRef="@_editSettings">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(GridItem.Id)" HeaderText="ID" Width="60px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" Type="ColumnType.Number" />
                        <GridColumn Field="@nameof(GridItem.Code)" HeaderText="Code" Width="100px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" />
                        <GridColumn Field="@nameof(GridItem.Name)" HeaderText="Product Name" Width="180px" />
                        <GridColumn Field="@nameof(GridItem.Category)" HeaderText="Category" Width="120px" />
                        <GridColumn Field="@nameof(GridItem.Quantity)" HeaderText="Qty" HeaderBand="Amounts" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.UnitPrice)" HeaderText="Price" HeaderBand="Amounts" Width="90px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.Discount)" HeaderText="Discount" HeaderBand="Amounts" Width="85px" Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.Status)" HeaderText="Status" Width="110px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Right" />
                        <GridColumn Field="@nameof(GridItem.Action)" HeaderText="Actions" Width="110px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Right" AllowEditing="false">
                            <Template Context="row">
                                <ButtonControl CssClass="btn-sm" OnClick="@(() => Remove((GridItem)row))">Remove</ButtonControl>
                            </Template>
                        </GridColumn>
                    </GridColumnsBase>
                </GridControl>
                </div>
                <p class="result">@_rows.Count rows</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-gridcolumn-parameters" Title="GridColumn parameters" Count='@DocSection.Label(Vocab.Column.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumn parameters" Rows="Vocab.Column" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-parameters" Title="GridControl parameters" Count='@DocSection.Label(Vocab.Grid.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridControl parameters" Rows="Vocab.Grid" />
            </DocSection>
            <DocSection Id="doc-gridcolumnheaderband" Title="GridColumnHeaderBand" Count='@DocSection.Label(Vocab.Band.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="GridColumnHeaderBand" Rows="Vocab.Band" />
            </DocSection>
            <DocSection Id="doc-editsettings-the-two-used-here" Title="EditSettings, the two used here" Count='@DocSection.Label(Vocab.Edit.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditSettings, the two used here" Rows="Vocab.Edit" />
                <p>
                The rest of <code>EditSettings</code> (adding, deleting, the confirm dialog, new-row position, click-to-edit) belongs with
                <a href="demo/grid/batch-editing">Batch editing</a>. Frozen cells carry no class: the pinning is inline style on the cell.
                The band row is <code>fx-column-header-band-row</code>; each band is a <code>fx-column-header-band-cell</code>, with
                <code>fx-column-header-band-empty</code> on the gaps above columns in no band.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the editing side of <code>EditSettings</code>.</li>
            <li><a href="demo/grid/column-virtualization">Wide grids</a>: many columns without frozen edges.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class GridItem
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public string Status { get; set; } = "Active";
        public string Action { get; set; } = "";
    }

    private List<GridItem> _rows = new();

    private readonly EditSettings _editSettings = new() { AllowEditing = true, Mode = EditMode.Batch };

    private readonly IReadOnlyList<GridColumnHeaderBand> _headerBands =
    [
        new("Identity", nameof(GridItem.Id), nameof(GridItem.Code)),
        new("Product", nameof(GridItem.Name), nameof(GridItem.Category)),
        new("Workflow", nameof(GridItem.Status), nameof(GridItem.Action))
    ];

    private void Remove(GridItem row) => _rows = _rows.Where(r => r != row).ToList();


    protected override void OnInitialized()
    {
        var list = new List<GridItem>();
        var cats = new[] { "Hotel", "Flight", "Tour", "Transfer", "Cruise", "Rail" };
        var places = new[] { "Lisbon", "Kyoto", "Cape Town", "Reykjavik", "Queenstown" };
        for (int i = 1; i <= 200; i++)
        {
            list.Add(new GridItem
            {
                Id = i,
                Code = $"SVC-{i:D5}",
                Name = $"{places[i % places.Length]} {cats[i % cats.Length].ToLowerInvariant()} #{i}",
                Category = cats[i % cats.Length],
                Quantity = 10 + (i * 7) % 150,
                UnitPrice = 15.50m + (i % 25) * 4.25m,
                Discount = (i % 5) * 2.5m,
                Status = (i % 6 == 0) ? "Pending" : "Active"
            });
        }
        _rows = list;
    }

    // Code tabs are verbatim copies of each Demo block and of the members above (generated, not typed).
    private static class Code
    {
        public const string Frozen = @"<div class=""frozen"">
<GridControl DataSource=""@_rows""
             TValue=""GridItem""
             Height=""420px""
             AllowSorting=""true""
             AllowResizing=""true""
             AllowFiltering=""true""
             AllowSelection=""true""
             ColumnHeaderBands=""@_headerBands""
             EditSettingsRef=""@_editSettings"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(GridItem.Id)"" HeaderText=""ID"" Width=""60px"" IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Left"" Type=""ColumnType.Number"" />
        <GridColumn Field=""@nameof(GridItem.Code)"" HeaderText=""Code"" Width=""100px"" IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Left"" />
        <GridColumn Field=""@nameof(GridItem.Name)"" HeaderText=""Product Name"" Width=""180px"" />
        <GridColumn Field=""@nameof(GridItem.Category)"" HeaderText=""Category"" Width=""120px"" />
        <GridColumn Field=""@nameof(GridItem.Quantity)"" HeaderText=""Qty"" HeaderBand=""Amounts"" Width=""80px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(GridItem.UnitPrice)"" HeaderText=""Price"" HeaderBand=""Amounts"" Width=""90px"" Type=""ColumnType.Number"" Format=""C2"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(GridItem.Discount)"" HeaderText=""Discount"" HeaderBand=""Amounts"" Width=""85px"" Type=""ColumnType.Number"" Format=""N1"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(GridItem.Status)"" HeaderText=""Status"" Width=""110px"" IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Right"" />
        <GridColumn Field=""@nameof(GridItem.Action)"" HeaderText=""Actions"" Width=""110px"" IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Right"" AllowEditing=""false"">
            <Template Context=""row"">
                <ButtonControl CssClass=""btn-sm"" OnClick=""@(() => Remove((GridItem)row))"">Remove</ButtonControl>
            </Template>
        </GridColumn>
    </GridColumnsBase>
</GridControl>
</div>
<p class=""result"">@_rows.Count rows</p>";
