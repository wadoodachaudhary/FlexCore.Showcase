    };

    List<ChartSeries> _heatmapSeries = new()
    {
        new() { Name = "Mon", DataPoints = new() { new("9am", 2), new("10am", 5), new("11am", 8), new("12pm", 4), new("1pm", 3), new("2pm", 7), new("3pm", 9), new("4pm", 6) } },
