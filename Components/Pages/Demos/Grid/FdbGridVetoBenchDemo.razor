            new("RowSelected", "After a row is selected by mouse, keyboard, checkbox toggle, type-ahead search or <code>AutoSelectFirstRow</code>. Not raised during drag-select or by the selection methods.", "RowSelectEventArgs&lt;TValue&gt;"),
