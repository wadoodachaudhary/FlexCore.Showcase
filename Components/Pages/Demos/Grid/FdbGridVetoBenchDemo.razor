<PageTitle>Unsaved-Row Lock in a Blazor Grid — FlexCore</PageTitle>

<FeatureDemoLayout Title="Unsaved-row lock" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Veto the move to another row while the current one has unsaved changes."
                   SourcePath="Grid/GridControlEvents.cs;Grid/GridModels.cs;Grid/SelectionSettings.cs;Grid/GridControl.razor.cs;Grid/GridControl.KeyboardSelection.cs">
    <Overview>
        <p>
            <code>RowSelecting</code> fires before the selection moves. Its <code>RowSelectEventArgs</code> carries the target row in
            <code>Data</code> and a <code>Cancel</code> flag; set it and the move is refused, whether it came from a click or from the
            keyboard. This page marks a row dirty when a cell value is written (<code>OnCellSave</code>) and refuses every move
            away from it until Save is pressed; moves within the dirty row are still allowed.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="lock" Title="Leave a row only after saving it" RazorCode="@Code.Lock" CSharpCode="@Code.LockCs">
            <Description><p>Double-click a Qty, Price or Notes cell, change it and press Enter. Now click another row, or press the Down arrow: the other row does not become selected and the line under the grid counts the refusal. Press Save and the lock lifts.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="Save" Disabled="@(!_dirty)">Save</ButtonControl>
            </Controls>
            <Demo>
                <GridControl TValue="BookingLine"
                             DataSource="@_rows"
                             ShowRowCountInFooter="true"
                             AllowSorting="false"
                             AllowSelection="true"
                             HighlightSelectedRows="true"
                             EnableHover="true"
                             Height="340px"
                             RowHeight="26"
                             MinRowHeight="26"
                             EditSettingsRef="@_editSettings"
                             SelectionSettingsRef="@_selectionSettings"
                             EventsRef="@_events"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(BookingLine.Code)" HeaderText="Line" Width="90px" AllowEditing="false" />
                        <GridColumn Field="@nameof(BookingLine.Description)" HeaderText="Description" Width="280px" AllowEditing="true" />
                        <GridColumn Field="@nameof(BookingLine.Qty)" HeaderText="Qty" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" />
                        <GridColumn Field="@nameof(BookingLine.Price)" HeaderText="Unit price" Width="100px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(BookingLine.Notes)" HeaderText="Notes" Width="260px" AllowEditing="true" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@(_dirtyRow is null ? "No unsaved changes." : $"Unsaved changes on line {_dirtyRow.Code}: {_vetoCount} {(_vetoCount == 1 ? "move" : "moves")} refused.")@(_saveCount > 0 ? $" Saved {_saveCount} {(_saveCount == 1 ? "time" : "times")}." : "")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-gridcontrolevents-selection" Title="GridControlEvents, selection" Count='@DocSection.Label(Vocab.Events.Length, "events")' Open="true">
                <ApiTable Kind="ApiKind.Events" Title="GridControlEvents, selection" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-rowselecteventargs-tvalue" Title="RowSelectEventArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.Args.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="RowSelectEventArgs&lt;TValue&gt;" Rows="Vocab.Args" />
            </DocSection>
            <DocSection Id="doc-selectionsettings-the-properties-that-ma" Title="SelectionSettings, the properties that matter here" Count='@DocSection.Label(Vocab.Settings.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="SelectionSettings, the properties that matter here" Rows="Vocab.Settings" />
            </DocSection>
            <DocSection Id="doc-gridcontrolevents-cell-editing" Title="GridControlEvents, cell editing" Count='@DocSection.Label(Vocab.CellEvents.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="GridControlEvents, cell editing" Rows="Vocab.CellEvents" />
            </DocSection>
            <DocSection Id="doc-cellsaveargs-tvalue" Title="CellSaveArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.SaveArgs.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="CellSaveArgs&lt;TValue&gt;" Rows="Vocab.SaveArgs" />
            </DocSection>
            <DocSection Id="doc-celleditargs-tvalue" Title="CellEditArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.EditArgs.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="CellEditArgs&lt;TValue&gt;" Rows="Vocab.EditArgs" />
            </DocSection>
            <DocSection Id="doc-edit-methods" Title="Edit methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Edit methods" Rows="Vocab.Methods" />
                <p>
                The selection rows are the ones on <a href="demo/grid/master-detail">Master-detail</a>, which also lists the other
                <code>SelectionSettings</code> properties, <code>SelectionChanged</code> and the selection methods. Those methods change the
                selection without raising <code>RowSelecting</code>, and so does Shift plus an arrow when <code>ModifierKeysExtendSelection</code>
                lets a <code>Single</code> selection grow. The veto stops the selection, not every edit path: a checkbox toggle on another row,
                or a dropdown or date editor that opens on mouse-down there, still runs. <code>GridControl</code> has no public member that
                cancels the open editor, says whether one is open or lists unsaved rows: Escape discards the edit inside the grid, and a page
                keeps its own dirty flag, as this one does.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the cell editing used here.</li>
            <li><a href="demo/grid/typing-modes">Typing modes</a>: how keystrokes reach the editors.</li>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public sealed class BookingLine
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    private List<BookingLine> _rows = [];
    private bool _dirty;
    private BookingLine? _dirtyRow;
    private int _vetoCount;
    private int _saveCount;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly SelectionSettings _selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single
    };

    private readonly GridControlEvents<BookingLine> _events = new();

    protected override void OnInitialized()
    {
        _rows =
        [
            new BookingLine { Code = "10", Description = "Hotel, double room, per night", Qty = 7, Price = 142.00m, Notes = "Late arrival, about 23:30" },
            new BookingLine { Code = "20", Description = "Airport transfer, private car", Qty = 2, Price = 65.00m, Notes = "Meet at arrivals, exit B" },
            new BookingLine { Code = "30", Description = "Sintra day tour, small group", Qty = 2, Price = 89.00m, Notes = "Vegetarian lunch for one" },
            new BookingLine { Code = "40", Description = "Fado dinner show", Qty = 2, Price = 75.00m, Notes = "Table near the stage" },
            new BookingLine { Code = "50", Description = "Lisbon to Porto train, first class", Qty = 2, Price = 48.50m, Notes = "Window seats requested" },
            new BookingLine { Code = "60", Description = "Travel insurance, per traveller", Qty = 2, Price = 39.00m, Notes = "Policy sent with the itinerary" }
        ];

        _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<BookingLine>>(this, args =>
        {
            _dirty = true;
            _dirtyRow = args.Data;
        });

        _events.RowSelecting = EventCallback.Factory.Create<RowSelectEventArgs<BookingLine>>(this, args =>
        {
            if (_dirty && _dirtyRow != null && !ReferenceEquals(_dirtyRow, args.Data))
            {
                args.Cancel = true;
                _vetoCount++;
            }
        });
    }

    private void Save()
    {
        _dirty = false;
        _dirtyRow = null;
        _vetoCount = 0;
        _saveCount++;
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
