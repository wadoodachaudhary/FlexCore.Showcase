@page "/demo/toggle-buttons"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page on FeatureDemoLayout; two examples (toggle button, button group) per the 1–2 examples rule. Facts checked against ToggleButtonControl.razor,
   ButtonGroupControl.razor, their stylesheets, FlexControlBase.cs and ContentModels.cs (FlexCore 0.2.48). *@

<PageTitle>Toggle buttons — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Toggle buttons" Category="Components" ControlName="ToggleButtonControl · ButtonGroupControl"
                   Tagline="A button that stays pressed, and a group that picks one value or many."
                   SourcePath="ToggleButtonControl.razor; ButtonGroupControl.razor">
    <Overview>
        <p>
            <code>ToggleButtonControl</code> is a <a href="demo/buttons">ButtonControl</a> with a pressed state: <code>Selected</code> binds
            two ways and the button reports <code>aria-pressed</code>. <code>ButtonGroupControl</code> lines up several such buttons from a
            list of <code>SelectionItem</code>s and keeps the selection for you: one value or many, horizontal or vertical, with Arrow,
            Home and End moving focus between them.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="toggle" Title="Toggle button" RazorCode="@Code.Toggle" CSharpCode="@Code.ToggleCs">
            <Description><p><code>@@bind-Selected</code> holds the state. Icon-only toggles need <code>Title</code> and <code>aria-label</code>. <code>Enabled="false"</code> disables; there is no <code>Disabled</code> parameter on this control.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ToggleButtonControl @bind-Selected="_bold" IconCss="bi bi-type-bold" Title="Bold" aria-label="Bold" />
                    <ToggleButtonControl @bind-Selected="_italic" IconCss="bi bi-type-italic" Title="Italic" aria-label="Italic" />
                    <ToggleButtonControl @bind-Selected="_underline" IconCss="bi bi-type-underline" Title="Underline" aria-label="Underline" />
                    <ToggleButtonControl @bind-Selected="_notify">Notifications @(_notify ? "on" : "off")</ToggleButtonControl>
                    <ToggleButtonControl Selected="true" Enabled="false">Locked</ToggleButtonControl>
                    <span class="result">@FormatState</span>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="group" Title="Button group" RazorCode="@Code.Group" CSharpCode="@Code.GroupCs">
            <Description><p><code>Selection="Single"</code> replaces the selection; <code>Multiple</code> toggles each value. <code>Orientation="Vertical"</code> stacks the buttons. <code>AllowEmpty</code> lets the last value go; a disabled item stays in place and is skipped by the arrow keys.</p></Description>
            <Demo>
                <div class="demo-row top">
                    <div class="stack">
                        <ButtonGroupControl Items="_alignItems" @bind-Values="_align" Selection="ChoiceSelectionMode.Single" AriaLabel="Text alignment" />
                        <span class="result">@_align[0]</span>
                    </div>
                    <div class="stack">
                        <ButtonGroupControl Items="_dayItems" @bind-Values="_days" Selection="ChoiceSelectionMode.Multiple"
                                            Orientation="FlexOrientation.Vertical" AllowEmpty="true" AriaLabel="Working days" />
                        <span class="result">@(_days.Count == 0 ? "none" : string.Join(", ", _days))</span>
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="ToggleButtonControl parameters" Rows="Vocab.Toggle" />
        <ApiTable Kind="ApiKind.Parameters" Title="ButtonGroupControl parameters" Rows="Vocab.Group" />
        <ApiTable Kind="ApiKind.Properties" Title="SelectionItem" Rows="Vocab.Item" />
        <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
        <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
        <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>Both render <code>ButtonControl</code>, so every button is a native <code>&lt;button&gt;</code>: Space and Enter toggle it.</li>
            <li>Every button carries <code>aria-pressed</code>. The group has <code>role="group"</code> and the <code>AriaLabel</code> text.</li>
            <li>In a group, Arrow Right or Down moves focus to the next button, Arrow Left or Up to the previous, Home and End to the first and last. Focus wraps and skips disabled items. Arrows move focus only; Space or Enter selects.</li>
            <li>Icon-only toggles need <code>Title</code> plus <code>aria-label</code>.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Plain and dropdown buttons: <a href="demo/buttons">Buttons</a>. Default action with alternatives: <a href="demo/split-button">Split button</a>.</li>
            <li>A labelled on/off setting: <code>SwitchControl</code> in <a href="demo/new-components">UI elements</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

