                        <GridColumn Field="@nameof(RateCardItem.Description)" HeaderText="Description" Width="215px" />
                        <GridColumn Field="@nameof(RateCardItem.Supplier)" HeaderText="Supplier" Width="185px" />
                        <GridColumn Field="@nameof(RateCardItem.Region)" HeaderText="Region" Width="115px" />
                        <GridColumn Field="@nameof(RateCardItem.Destination)" HeaderText="Destination" Width="120px" />
