@page "/demo/grid/enterprise-suite"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Components.Shared
@inject FlexCore.Showcase.Services.BenchDataStore BenchData

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, row 2 of the Data Grid list). Same 250 rows and columns.
   Changes, closing SC-019 and SC-141 to SC-145: the "Show Filter Row" button went (GridControl has no filter-row parameter); the
   "Selected" readout went (it never refreshed); AllowEditing left the columns (no EditSettings, nothing was editable); grouping,
   group count and type search left the grid (off-topic here); the Excel button now calls ExportToXlsxAsync (ExportToExcelAsync is the
   .xls HTML alias, so the old .xlsx file was HTML); the status badge is BadgeControl instead of Bootstrap classes; the buttons are
   ButtonControls. Copy dropped: "zero external JavaScript dependencies", "complete parity with high-end desktop data grids",
   ClosedXML (the grid's xlsx writer is the library's own, GridExportModels.cs BuildXlsx), multi-column sorting, checklist
   filtering and frozen columns (none configured here). Parameter tables are a later pass (SC-278).
   2026-10-24: Documentation tables (SC-278) written from Grid/GridControl.razor.cs (ExportAsync family, BuildGridExportTable, print defaults),
   Grid/GridControl.ExportOptions.cs, Grid/GridControl.ProviderExport.cs, Grid/GridExportModels.cs (GridExporter, the format builders,
   GridExportCellStyle, GridPdfPrintOptions), Grid/NativePdfDocument.cs (WriteLegacy), Excel/XlsxWriter.cs and Grid/GridColumn.cs; every row
   checked at its read site and with vocabcheck.py. The grid PDF goes through WriteLegacy with the standard Helvetica fonts; the embedded
   Liberation fonts belong to the report PDF writer (Reports/ReportPdfExport.cs).
   2026-10-25 (Baaria, SC-344): the example runs on the operator's rate card (Data/BenchModels.cs RateCardItem, BenchDataStore.RateCard)
   instead of the earlier estimating items. *@

<PageTitle>Export &amp; templates — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Export &amp; templates" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Export the rows you see to CSV or a real .xlsx workbook, and render a column through your own markup."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridControl.ExportOptions.cs;Grid/GridControl.ProviderExport.cs;Grid/GridExportModels.cs;Grid/NativePdfDocument.cs;Excel/XlsxWriter.cs;Grid/GridColumn.cs">
    <Overview>
        <p>
            The grid exports itself: <code>ExportToCsvAsync</code>, <code>ExportToXlsxAsync</code> and the other <code>ExportTo…Async</code>
            methods take the rows as currently filtered and sorted and the columns as currently visible, build the file on the server with
            the library's own writers, and hand it to the browser. Where the File System Access API exists a save dialog opens; elsewhere
            the file downloads. A <code>GridColumn</code> with a <code>Template</code> renders whatever markup you put inside it for each row,
            with <code>context</code> as the row object; the Status column here renders each line's Bookable flag as a <code>BadgeControl</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="export" Title="Export the rows you see" RazorCode="@Code.Export" CSharpCode="@Code.ExportCs">
            <Description><p>Two hundred and fifty lines of the operator's rate card: the service, its supplier, category and season, a sample quantity and the net rate, with Bookable or Suspended as a badge. Search, filter or sort first, then export: the file holds exactly the rows and columns on screen, in the same order. When the export is done the grid shows the row count in a status pill.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="ExportCsv">Export CSV</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="ExportExcel">Export Excel (.xlsx)</ButtonControl>
            </Controls>
            <Demo>
                <GridControl @ref="_grid"
                             TValue="RateCardRow"
                             DataSource="@_displayRows"
                             ShowRowCountInFooter="true"
                             AllowSorting="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowSearchBar="true"
                             Height="420px"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(RateCardRow.Code)" HeaderText="Code" Width="100px" />
                        <GridColumn Field="@nameof(RateCardRow.Description)" HeaderText="Service" Width="220px" />
                        <GridColumn Field="@nameof(RateCardRow.Supplier)" HeaderText="Supplier" Width="180px" />
                        <GridColumn Field="@nameof(RateCardRow.Category)" HeaderText="Category" Width="130px" />
                        <GridColumn Field="@nameof(RateCardRow.Season)" HeaderText="Season" Width="90px" />
                        <GridColumn Field="@nameof(RateCardRow.Status)" HeaderText="Status" Width="110px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (RateCardRow)context;
                                    var variant = row.Bookable ? BadgeVariant.Success : BadgeVariant.Secondary;
                                }
                                <BadgeControl Text="@row.Status" Variant="@variant" Size="BadgeSize.Small" />
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RateCardRow.Qty)" HeaderText="Qty" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(RateCardRow.Rate)" HeaderText="Net Rate" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(RateCardRow.Total)" HeaderText="Total" Width="120px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0.00" />
                    </GridColumnsBase>
                </GridControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            Every <code>ExportTo…Async</code> method is <code>ExportAsync</code> with a fixed <code>GridExportFormat</code>. The grid builds a
            <code>GridExportTable</code> from <code>VisibleColumns</code> and the filtered, sorted rows; <code>GridExporter</code> turns it into
            bytes with writers that live in the FlexCore assembly itself (<code>XlsxWriter</code> for .xlsx, <code>NativePdfDocument</code> for
            PDF; no ClosedXML, and the <code>FlexCore.Documents</code> project the Showcase references for its spreadsheet and PDF viewers plays
            no part); <code>GridExporter.SaveAsync</code> then hands the bytes to the browser.
        </p>
        <DocSections>
            <DocSection Id="doc-gridcontrol-export-methods" Title="GridControl export methods" Count='@DocSection.Label(Vocab.Export.Length, "methods")' Open="true">
                <ApiTable Kind="ApiKind.Methods" Title="GridControl export methods" Rows="Vocab.Export" />
            </DocSection>
            <DocSection Id="doc-provider-export-methods" Title="Provider export methods" Count='@DocSection.Label(Vocab.Provider.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Provider export methods" Rows="Vocab.Provider" />
            </DocSection>
            <DocSection Id="doc-gridexporter-static" Title="GridExporter (static)" Count='@DocSection.Label(Vocab.Exporter.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="GridExporter (static)" Rows="Vocab.Exporter" />
            </DocSection>
            <DocSection Id="doc-gridexportformat" Title="GridExportFormat" Count='@DocSection.Label(Vocab.Formats.Length, "values")'>
                <ApiTable Kind="ApiKind.Values" Title="GridExportFormat" Rows="Vocab.Formats" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-export-parameters" Title="GridControl export parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridControl export parameters" Rows="Vocab.Params" />
            </DocSection>
            <DocSection Id="doc-gridexportcellstyle" Title="GridExportCellStyle" Count='@DocSection.Label(Vocab.CellStyle.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="GridExportCellStyle" Rows="Vocab.CellStyle" />
            </DocSection>
            <DocSection Id="doc-gridpdfprintoptions" Title="GridPdfPrintOptions" Count='@DocSection.Label(Vocab.PdfOptions.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="GridPdfPrintOptions" Rows="Vocab.PdfOptions" />
            </DocSection>
            <DocSection Id="doc-gridcolumn-template-parameters" Title="GridColumn template parameters" Count='@DocSection.Label(Vocab.Templates.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumn template parameters" Rows="Vocab.Templates" />
                <p>
                <code>IsProviderExporting</code>, <code>ProviderExportProgress</code> and <code>ProviderExportLastError</code> are read-only
                properties that mirror a provider export in flight. The embedded Liberation fonts under <code>Grid/PdfFonts</code> serve the report
                PDF writer; the grid PDF draws with the standard Helvetica fonts. <code>GridControl</code> also declares
                <code>GroupFooterTemplate</code> (<code>RenderFragment&lt;object&gt;?</code>) but never reads it, and <code>GridColumn</code> has no
                footer template: an aggregate's footer text comes from <code>AggregateColumn.FooterTemplate</code>, a format string whose default is
                <code>{value}</code>.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/advanced">Frozen columns</a>: another template column, with a working button in it.</li>
            <li><a href="demo/new-components">UI elements</a>: <code>BadgeControl</code> on its own.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class RateCardRow
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Supplier { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Season { get; set; } = string.Empty;
        public bool Bookable { get; set; } = true;
        public string Status { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Rate { get; set; }
        public decimal Total => Qty * Rate;
    }

    private GridControl<RateCardRow>? _grid;
    private List<RateCardRow> _displayRows = [];

    protected override void OnInitialized()
    {
        _displayRows = BenchData.RateCard.Take(250).Select((item, idx) => new RateCardRow
        {
            Code = item.Code,
            Description = item.Description,
            Supplier = item.Supplier,
            Category = item.Category,
            Season = item.Season,
            Bookable = item.Bookable,
            Status = item.Bookable ? "Bookable" : "Suspended",
            Qty = (idx % 8) + 1,
            Rate = item.Rate
        }).ToList();
    }

    private Task ExportCsv() => _grid?.ExportToCsvAsync("rate-card.csv") ?? Task.CompletedTask;

    private Task ExportExcel() => _grid?.ExportToXlsxAsync("rate-card.xlsx") ?? Task.CompletedTask;

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
    {
        public const string Export = @"<GridControl @ref=""_grid""
             TValue=""RateCardRow""
             DataSource=""@_displayRows""
             ShowRowCountInFooter=""true""
             AllowSorting=""true""
             AllowSelection=""true""
             AllowResizing=""true""
             AllowFiltering=""true""
             ShowSearchBar=""true""
             Height=""420px""
             CssClass=""fx-grid-compact"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(RateCardRow.Code)"" HeaderText=""Code"" Width=""100px"" />
        <GridColumn Field=""@nameof(RateCardRow.Description)"" HeaderText=""Service"" Width=""220px"" />
        <GridColumn Field=""@nameof(RateCardRow.Supplier)"" HeaderText=""Supplier"" Width=""180px"" />
        <GridColumn Field=""@nameof(RateCardRow.Category)"" HeaderText=""Category"" Width=""130px"" />
        <GridColumn Field=""@nameof(RateCardRow.Season)"" HeaderText=""Season"" Width=""90px"" />
        <GridColumn Field=""@nameof(RateCardRow.Status)"" HeaderText=""Status"" Width=""110px"" TextAlign=""TextAlign.Center"">
            <Template>
                @{
                    var row = (RateCardRow)context;
                    var variant = row.Bookable ? BadgeVariant.Success : BadgeVariant.Secondary;
                }
                <BadgeControl Text=""@row.Status"" Variant=""@variant"" Size=""BadgeSize.Small"" />
            </Template>
        </GridColumn>
        <GridColumn Field=""@nameof(RateCardRow.Qty)"" HeaderText=""Qty"" Width=""80px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(RateCardRow.Rate)"" HeaderText=""Net Rate"" Width=""110px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" Format=""$#,##0.00"" />
        <GridColumn Field=""@nameof(RateCardRow.Total)"" HeaderText=""Total"" Width=""120px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" Format=""$#,##0.00"" />
    </GridColumnsBase>
</GridControl>";
        public const string ExportCs = @"public class RateCardRow
{
    public string Code { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public string Supplier { get; set; } = string.Empty;
    public string Category { get; set; } = string.Empty;
    public string Season { get; set; } = string.Empty;
    public bool Bookable { get; set; } = true;
    public string Status { get; set; } = string.Empty;
    public decimal Qty { get; set; }
    public decimal Rate { get; set; }
    public decimal Total => Qty * Rate;
}

private GridControl<RateCardRow>? _grid;
private List<RateCardRow> _displayRows = [];

protected override void OnInitialized()
{
    _displayRows = BenchData.RateCard.Take(250).Select((item, idx) => new RateCardRow
    {
        Code = item.Code,
        Description = item.Description,
        Supplier = item.Supplier,
        Category = item.Category,
        Season = item.Season,
        Bookable = item.Bookable,
        Status = item.Bookable ? ""Bookable"" : ""Suspended"",
        Qty = (idx % 8) + 1,
        Rate = item.Rate
    }).ToList();
}

private Task ExportCsv() => _grid?.ExportToCsvAsync(""rate-card.csv"") ?? Task.CompletedTask;

private Task ExportExcel() => _grid?.ExportToXlsxAsync(""rate-card.xlsx"") ?? Task.CompletedTask;";
    }

