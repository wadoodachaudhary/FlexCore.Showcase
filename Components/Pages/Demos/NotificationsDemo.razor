@page "/demo/notifications"
@using FlexCore.Showcase.Components.Shared
@inject NotificationService Notifications
@implements IDisposable

@* 2026-10-12: on FeatureDemoLayout; facts from NotificationService.cs, NotificationDisplayControl.razor(.css), FlexCore 0.2.48.
   No NotificationDisplayControl here: MainLayout has one; a second doubled every toast (removed 2026-10-06).
   2026-11-15: travel messages; second example (progress toast, Dismiss by id); text re-checked against FlexCore 0.2.50.
   2026-11-15: example story moved to the Warehouse and logistics theme. *@

<PageTitle>Blazor Toast Notifications — FlexCore</PageTitle>

<FeatureDemoLayout Title="Toasts" Category="Components" ControlName="NotificationService · NotificationDisplayControl"
                   Tagline="Tell users an action worked or failed with toasts that close themselves."
                   SourcePath="Notifications/NotificationService.cs; NotificationDisplayControl.razor">
    <Overview>
        <p>
            <code>NotificationService</code> shows Blazor toast notifications: short info, success, warning and error messages that stack in the top-right corner and close themselves. Use them to confirm a saved goods receipt or report a failed label print without interrupting work; call the service from any component, and one <code>NotificationDisplayControl</code> in the layout shows them all. An error stays ten seconds and a success four, and <code>durationMs: 0</code> keeps a toast until it is closed or removed with <code>Dismiss</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="levels" Title="Levels, detail and duration" RazorCode="@Code.Levels" CSharpCode="@Code.LevelsCs">
            <Description><p>Raise each level; the second argument is the detail line and <code>durationMs: 0</code> keeps a toast until it is closed.</p></Description>
            <Demo>
                <div class="nt">
                    <div class="demo-row">
                        <ButtonControl CssClass="btn-primary" OnClick="@(() => Notifications.Info("Pick list PICK-0318 assigned", "To Hermione Ranger, 12 lines"))">Info</ButtonControl>
                        <ButtonControl CssClass="btn-success" OnClick="@(() => Notifications.Success("Receipt for PO-2291 saved", "2 pallets, 48 cartons"))">Success</ButtonControl>
                        <ButtonControl CssClass="btn-warning" OnClick="@(() => Notifications.Warning("Bin A-12-03 is nearly full", "Room for 6 cartons, check before putaway"))">Warning</ButtonControl>
                        <ButtonControl CssClass="btn-danger" OnClick="@(() => Notifications.Error("Shipping label did not print", "Shipment SHP-0456 at Dock 4"))">Error</ButtonControl>
                        <ButtonControl CssClass="btn-outline-primary" OnClick="@(() => Notifications.Error("Pickup for shipment SHP-0457 was canceled", "Stays until you close it", durationMs: 0))">Sticky error</ButtonControl>
                        <ButtonControl OnClick="@(() => Notifications.Clear())">Clear all</ButtonControl>
                    </div>
                    <p class="result" role="status">@(_count == 0 ? "No toasts showing." : $"{_count} showing, newest on top.")</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="task" Title="Progress, then the outcome" RazorCode="@Code.Task" CSharpCode="@Code.TaskCs">
            <Description><p>Save the goods receipt: a sticky toast shows while the save runs, <code>Dismiss</code> removes it by id, and a success or an error toast takes its place. Switch on Make saves fail and every save fails until you switch it off; the error toast stays until it is closed or the next save starts.</p></Description>
            <Demo>
                <div class="nt">
                    <div class="demo-row">
                        <ButtonControl CssClass="btn-primary" IconCss="bi bi-save" Disabled="_saving" OnClick="SaveAsync">Save receipt</ButtonControl>
                        <SwitchControl @bind-Checked="_failSaves" Label="Make saves fail" />
                    </div>
                    <p class="result" role="status">@_saved saved, @_failed failed</p>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-notificationservice" Title="NotificationService" Count='@DocSection.Label(Vocab.Service.Length, "members")' Open="true">
                <ApiTable Kind="ApiKind.Methods" Title="NotificationService" Rows="Vocab.Service" />
                <p class="note">Setup: <code>builder.Services.AddScoped&lt;NotificationService&gt;()</code> and one <code>&lt;NotificationDisplayControl /&gt;</code> in the layout. This site has both.</p>
            </DocSection>
            <DocSection Id="doc-notification" Title="Notification" Count='@DocSection.Label(Vocab.Item.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="Notification" Rows="Vocab.Item" />
                <p class="note"><code>NotificationDisplayControl</code> has no parameters. It reads the service, re-renders on <code>OnChange</code>, and scales with <code>--fx-zoom</code> when a <code>ZoomService</code> is registered. Position, widths and colors are set in its stylesheet; this site moves the container below its top bar with one <code>::deep .fx-notification-container { top: 108px; }</code> rule in its layout stylesheet.</p>
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>Each toast shows its message and detail as text, with a native close <code>&lt;button&gt;</code>. Toasts stack newest first, so the newest close button comes first in the Tab order; Enter or Space closes the toast.</li>
            <li>Report an outcome that matters in the page as well, such as the <code>role="status"</code> line under each example, or use a <a href="demo/dialog">dialog</a> when the user must respond.</li>
            <li>Pass <code>durationMs: 0</code> for a message the user must read or act on; the toast stays until it is closed or removed with <code>Dismiss</code>.</li>
            <li>The container ignores pointer events except on the toasts themselves, so it never blocks the page underneath.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Messages that block until answered: <a href="demo/dialog">Dialogs</a>.</li>
            <li>Inline banners that stay in the page: <code>AlertControl</code> in <a href="demo/new-components">UI elements</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Levels: the page listens to the service to count the toasts on show
    // The page declares @inject NotificationService Notifications (namespace Fx.ControlKit.Notifications)
    // and @implements IDisposable, so Dispose() below runs and unhooks OnChange.
    private int _count;
    protected override void OnInitialized()
    {
        Notifications.OnChange += HandleChange;   // auto-dismiss fires off the render thread
        _count = Notifications.Notifications.Count;
    }
    private void HandleChange() => _ = InvokeAsync(() => { _count = Notifications.Notifications.Count; StateHasChanged(); });
    public void Dispose() => Notifications.OnChange -= HandleChange;

    // A task: a sticky progress toast, replaced by the outcome
    // Notifications is the injected NotificationService, as in the first example.
    private bool _saving, _failSaves;
    private Guid? _lastError;
    private int _saved, _failed;
    private async Task SaveAsync()
    {
        _saving = true;
        if (_lastError is Guid old) Notifications.Dismiss(old);   // a new attempt replaces the last error
        _lastError = null;
        Notifications.Info("Saving receipt for PO-2291…", durationMs: 0);
        var progress = Notifications.Notifications.First(n => n.Message == "Saving receipt for PO-2291…").Id;
        await Task.Delay(1500);   // stands in for the call that saves
        Notifications.Dismiss(progress);
        if (_failSaves)
        {
            _failed++;
            Notifications.Error("Could not save receipt for PO-2291", "The warehouse system did not answer. Try again.", durationMs: 0);
            _lastError = Notifications.Notifications.Last(n => n.Message == "Could not save receipt for PO-2291").Id;
        }
        else
        {
            _saved++;
            Notifications.Success("Receipt for PO-2291 saved");
        }
        _saving = false;
    }

