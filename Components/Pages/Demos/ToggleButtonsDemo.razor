    private readonly SelectionItem[] _statusItems =
    {
        new("todo", "To do", IconCss: "bi bi-circle"),
        new("progress", "In progress", IconCss: "bi bi-hourglass-split"),
        new("review", "In review", IconCss: "bi bi-eye"),
    };
    private IReadOnlyList<string> _status = new[] { "progress" };
    private readonly SelectionItem[] _labelItems =
    {
        new("Design", "Design"), new("Frontend", "Frontend"), new("Backend", "Backend"), new("Content", "Content"), new("QA", "QA", Disabled: true),
    };
    private IReadOnlyList<string> _labels = new[] { "Frontend", "Backend" };
    private sealed record TaskItem(string Title, string Label, string Status);
    private readonly TaskItem[] _tasks =
    {
        new("WEB-112 Menu page layout", "Design", "progress"), new("WEB-115 Navigation bar", "Frontend", "progress"),
        new("WEB-117 Order form", "Frontend", "review"), new("WEB-118 Order emails", "Backend", "progress"),
        new("WEB-120 Payment setup", "Backend", "todo"), new("WEB-121 Menu copy", "Content", "review"),
        new("WEB-123 Photo gallery", "Frontend", "progress"), new("WEB-124 Allergen icons", "Design", "todo"),
    };
    private TaskItem[] Matches => _tasks.Where(t => t.Status == _status[0] && (_labels.Count == 0 || _labels.Contains(t.Label))).ToArray();

