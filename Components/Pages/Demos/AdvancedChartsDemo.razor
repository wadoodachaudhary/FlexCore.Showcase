@page "/demo/advanced-charts"
@rendermode InteractiveServer
@using Fx.ControlKit.Charts
@using FlexCore.Showcase.Components.Pages.Demos.Charts
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12 (SC-264): on FeatureDemoLayout; six cards -> three examples.
   C# tabs (2026-10-17): the series fields, verbatim (SC-277).
   2026-10-23: charts draw on a fixed viewBox (Candlestick/OHLC 600x320, RangeColumn 600x300, Sankey 650x340, Bullet 600 x rows*60,
   radial gauge 300x300, linear 320x105) scaled to fit tile width and Height: labels follow tile width, extra Height is blank. Heights
   width-bound for a 465 px tile. RangeColumn labels max 8 characters (renderer cuts).
   2026-10-24: Documentation: ChartType rows and ChartDataPoint table from ChartsVocab (shared with the Charts page).
   2026-10-24: datasets are small stories. *@

<PageTitle>Blazor Candlestick, OHLC and Sankey Charts — FlexCore</PageTitle>

<FeatureDemoLayout Title="Financial &amp; gauges" Category="Charts" CategoryHref="demo/charts" ControlName="ChartControl"
                   Tagline="Candlestick and OHLC, bullet and range comparisons, a Sankey flow, and two gauges."
                   SourcePath="Charts/ChartControl.razor;Charts/ChartModels.cs">
    <Overview>
        <p>
            The same Blazor <code>ChartControl</code> with the types a finance or operations screen needs: candlestick and OHLC bound through <code>ChartDataPoint.Financial</code>, bullet and range comparisons, a Sankey flow and two gauge types.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="financial" Title="Candlestick and OHLC" RazorCode="@Code.Financial" CSharpCode="@Code.FinancialCs">
            <Description><p>Both charts read the same series: Candlestick fills the body, Ohlc draws ticks.</p></Description>
            <Demo>
                <div class="two">
                    <ChartControl Type="ChartType.Candlestick" UpColor="@ChartPalette.Green" DownColor="@ChartPalette.Rose" Title="BAKE, one week of trading" Series="_candlestickSeries" Height="248px" />
                    <ChartControl Type="ChartType.Ohlc" UpColor="@ChartPalette.Green" DownColor="@ChartPalette.Rose" Title="BAKE, the same week as OHLC" Series="_candlestickSeries" Height="248px" />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="comparisons" Title="Bullet, range and Sankey" RazorCode="@Code.Comparisons" CSharpCode="@Code.ComparisonsCs">
            <Description><p>Bullet shows actual against target bands, RangeColumn floats a minimum-to-maximum bar, and Sankey draws weighted flows between nodes.</p></Description>
            <Demo>
                <div class="stack">
                    <ChartControl Type="ChartType.Bullet" ColorPalette="@ChartPalette.Site" Title="Monthly budget, spent against planned" Series="_bulletSeries" Height="240px" />
                    <div class="two">
                        <ChartControl Type="ChartType.RangeColumn" ColorPalette="@ChartPalette.Site" Title="Temperature this week, low to high °C" Series="_rangeSeries" Height="232px" />
                        <ChartControl Type="ChartType.Sankey" ColorPalette="@ChartPalette.Site" Title="Recycling, kg by bin and what it becomes" Series="_sankeySeries" Height="243px" />
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="gauges" Title="Radial and linear gauges" RazorCode="@Code.Gauges" CSharpCode="@Code.GaugesCs">
            <Description><p>One series drawn as two gauge types; the standalone gauge controls have a page of their own.</p></Description>
            <Demo>
                <div class="gauges">
                    <ChartControl Type="ChartType.RadialGauge" ColorPalette="@ChartPalette.Site" Title="Rain barrel, percent full" Series="_gaugeSeries" Height="300px" />
                    <ChartControl Type="ChartType.LinearGauge" ColorPalette="@ChartPalette.Site" Title="Same reading, linear" Series="_gaugeSeries" Height="105px" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            The seven types on this page and what each reads from a <code>ChartDataPoint</code>; the full <code>ChartControl</code>,
            <code>ChartSeries</code>, <code>ChartAxis</code> and <code>ChartLegend</code> tables are on the <a href="demo/charts">Charts</a> page.
            The financial, bullet, range and Sankey points are built with the static factories listed under <code>ChartDataPoint</code>.
        </p>
        <DocSections>
            <DocSection Id="doc-chart-types-on-this-page" Title="Chart types on this page" Open="true">
                <ApiTable Kind="ApiKind.Values" Title="Chart types on this page" Rows="@ChartsVocab.TypesNamed("Candlestick", "Ohlc", "Bullet", "RangeColumn", "Sankey", "RadialGauge", "LinearGauge")" />
            </DocSection>
            <DocSection Id="doc-chartdatapoint" Title="ChartDataPoint" Count='@DocSection.Label(ChartsVocab.Point.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="ChartDataPoint" Rows="ChartsVocab.Point" />
            </DocSection>
        </DocSections>
    </Vocabulary>
</FeatureDemoLayout>

@code {

    private List<ChartSeries> _candlestickSeries = new()
    {
        // BAKE, a fictional bakery chain: one week of open, high, low, close; the axis spans lowest low to highest high
        new ChartSeries("BAKE", ChartType.Candlestick, new[]
        {
            ChartDataPoint.Financial("Mon", 120, 135, 115, 130),
            ChartDataPoint.Financial("Tue", 130, 142, 125, 138),
            ChartDataPoint.Financial("Wed", 138, 140, 122, 126),
            ChartDataPoint.Financial("Thu", 126, 132, 120, 131),
            ChartDataPoint.Financial("Fri", 131, 155, 128, 149)
        })
    };

    private List<ChartSeries> _bulletSeries = new()
    {
        // one month in dollars: bar = spent, line across it = planned
        new ChartSeries("Household budget", ChartType.Bullet, new[]
        {
            ChartDataPoint.Bullet("Groceries", 420, 400),
            ChartDataPoint.Bullet("Transport", 95, 120),
            ChartDataPoint.Bullet("Eating out", 180, 150),
            ChartDataPoint.Bullet("Savings", 300, 350)
        })
    };

    private List<ChartSeries> _rangeSeries = new()
    {
        // overnight low to afternoon high, °C; the axis spans lowest low (4) to highest high (20) in four steps
        new ChartSeries("Garden thermometer", ChartType.RangeColumn, new[]
        {
            ChartDataPoint.Range("Mon", 6, 14),
            ChartDataPoint.Range("Tue", 8, 17),
            ChartDataPoint.Range("Wed", 10, 20),
            ChartDataPoint.Range("Thu", 7, 15),
            ChartDataPoint.Range("Fri", 4, 11)
        })
    };

    private List<ChartSeries> _sankeySeries = new()
    {
        // kg per bin in a month and what it becomes; one flow per node (the renderer draws a node and label per flow)
        new ChartSeries("Recycling", ChartType.Sankey, new[]
        {
            ChartDataPoint.Sankey("Paper", "Cardboard", 120),
            ChartDataPoint.Sankey("Glass", "Bottles", 60),
            ChartDataPoint.Sankey("Cans", "Car parts", 40),
            ChartDataPoint.Sankey("Food", "Compost", 80),
            ChartDataPoint.Sankey("Plastic", "Fleece", 50)
        })
    };

    private List<ChartSeries> _gaugeSeries = new()
    {
        new ChartSeries("Rain barrel", ChartType.RadialGauge, new[]
        {
            new ChartDataPoint("Percent full", 82.5)
        })
    };

