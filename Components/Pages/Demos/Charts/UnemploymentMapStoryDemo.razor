            new("MarkerClick / ShapeClick", "Raised when a marker, or a shape or choropleth region, is clicked or activated with Enter or Space. The status bar shows the clicked marker's title and coordinates.", "EventCallback&lt;MapMarker&gt; / EventCallback&lt;MapShape&gt;"),
            new("TileUrlTemplate", "Raster tile address with <code>{z}</code>, <code>{x}</code> and <code>{y}</code>. Null draws no tiles: a plain background with a 30° grid.", "string?", "null"),
            new("Attribution", "Text in the status bar under the plain map.", "string", "\"\""),
            new("AriaLabel", "Name of the map for assistive technology.", "string", "\"Map. Use arrow keys to pan and plus or minus to zoom.\""),
        };
    }

