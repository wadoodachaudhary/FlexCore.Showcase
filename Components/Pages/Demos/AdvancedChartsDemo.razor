@page "/demo/advanced-charts"
@rendermode InteractiveServer
@using Fx.ControlKit.Charts
@using FlexCore.Showcase.Components.Pages.Demos.Charts
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: moved onto FeatureDemoLayout; six Bootstrap cards became three examples with the same charts.
   Parameter table pending (SC-264). C# tabs added 2026-10-17: the series fields, verbatim (SC-277).
   2026-10-23 (developer meeting, point 5: chart labels too small): every SVG chart type draws on a fixed viewBox (600x320 Candlestick
   and OHLC, 600x300 RangeColumn, 650x340 Sankey, 600 x rows*60 Bullet, 300x300 radial gauge, 320x105 linear gauge) and scales to
   min(tile width / viewBox width, Height / viewBox height), so label size follows tile width and a Height above the width-bound value
   only adds a blank band. Comparisons re-laid out: Bullet alone at its 600x240 design size, RangeColumn and Sankey two-up; every
   Height set to the width-bound value for a 465 px tile; RangeColumn labels kept to 8 characters because the renderer cuts longer
   ones; the Sankey data given one flow per node because the renderer draws a node and label per flow (a shared source prints once per
   link); the radial gauge tile widened to its 300 px design size and the linear gauge raised to its 105 px. 
   2026-10-24: Documentation: the page's seven ChartType rows and the ChartDataPoint table from ChartsVocab (shared with the Charts page).
   2026-10-24: the datasets became small stories: a trading week of BAKE (a fictional bakery chain), a household budget against
   plan, a week of garden temperatures, recycling by bin, a rain barrel's level. The 2026-10-23 geometry is unchanged. *@

<PageTitle>Blazor Candlestick, OHLC and Sankey Charts — FlexCore</PageTitle>

<FeatureDemoLayout Title="Financial &amp; gauges" Category="Charts" CategoryHref="demo/charts" ControlName="ChartControl"
                   Tagline="Candlestick and OHLC, bullet and range comparisons, a Sankey flow, and two gauges."
                   SourcePath="Charts/ChartControl.razor;Charts/ChartModels.cs">
    <Overview>
        <p>
            The same <code>ChartControl</code> as the <a href="demo/charts">gallery</a>, with the types a finance or operations screen
            needs. Financial series use <code>ChartDataPoint.Financial</code> for open, high, low and close; the others bind ordinary series.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="financial" Title="Candlestick and OHLC" RazorCode="@Code.Financial" CSharpCode="@Code.FinancialCs">
            <Description><p>Both read the same series; <code>Candlestick</code> fills the body, <code>Ohlc</code> draws ticks.</p></Description>
            <Demo>
                <div class="two">
                    <ChartControl Type="ChartType.Candlestick" Title="BAKE, one week of trading" Series="_candlestickSeries" Height="248px" />
                    <ChartControl Type="ChartType.Ohlc" Title="BAKE, the same week as OHLC" Series="_candlestickSeries" Height="248px" />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="comparisons" Title="Bullet, range and Sankey" RazorCode="@Code.Comparisons" CSharpCode="@Code.ComparisonsCs">
            <Description><p><code>Bullet</code> shows actual against target bands, <code>RangeColumn</code> floats a minimum to maximum bar, <code>Sankey</code> draws weighted flows between nodes.</p></Description>
            <Demo>
                <div class="stack">
                    <ChartControl Type="ChartType.Bullet" Title="Monthly budget, spent against planned" Series="_bulletSeries" Height="240px" />
                    <div class="two">
                        <ChartControl Type="ChartType.RangeColumn" Title="Temperature this week, low to high °C" Series="_rangeSeries" Height="232px" />
                        <ChartControl Type="ChartType.Sankey" Title="Recycling, kg by bin and what it becomes" Series="_sankeySeries" Height="243px" />
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="gauges" Title="Radial and linear gauges" RazorCode="@Code.Gauges" CSharpCode="@Code.GaugesCs">
            <Description><p>One series, two gauge types. The standalone <code>ArcGaugeControl</code>, <code>CircularGaugeControl</code>, <code>RadialGaugeControl</code> and <code>LinearGaugeControl</code> have <a href="demo/gauges">a page of their own</a>.</p></Description>
            <Demo>
                <div class="gauges">
                    <ChartControl Type="ChartType.RadialGauge" Title="Rain barrel, percent full" Series="_gaugeSeries" Height="300px" />
                    <ChartControl Type="ChartType.LinearGauge" Title="Same reading, linear" Series="_gaugeSeries" Height="105px" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            The seven types on this page and what each reads from a <code>ChartDataPoint</code>; the full <code>ChartControl</code>,
            <code>ChartSeries</code>, <code>ChartAxis</code> and <code>ChartLegend</code> tables are on the <a href="demo/charts">Charts</a> page.
            The financial, bullet, range and Sankey points are built with the static factories listed under <code>ChartDataPoint</code>.
        </p>
        <DocSections>
            <DocSection Id="doc-chart-types-on-this-page" Title="Chart types on this page" Open="true">
                <ApiTable Kind="ApiKind.Values" Title="Chart types on this page" Rows="@ChartsVocab.TypesNamed("Candlestick", "Ohlc", "Bullet", "RangeColumn", "Sankey", "RadialGauge", "LinearGauge")" />
            </DocSection>
            <DocSection Id="doc-chartdatapoint" Title="ChartDataPoint" Count='@DocSection.Label(ChartsVocab.Point.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="ChartDataPoint" Rows="ChartsVocab.Point" />
            </DocSection>
        </DocSections>
    </Vocabulary>
</FeatureDemoLayout>

@code {

    private List<ChartSeries> _candlestickSeries = new()
    {
        // BAKE is a fictional bakery chain; one trading week of open, high, low, close (the axis runs from the lowest low to the highest high)
        new ChartSeries("BAKE", ChartType.Candlestick, new[]
        {
            ChartDataPoint.Financial("Mon", 120, 135, 115, 130),
            ChartDataPoint.Financial("Tue", 130, 142, 125, 138),
            ChartDataPoint.Financial("Wed", 138, 140, 122, 126),
            ChartDataPoint.Financial("Thu", 126, 132, 120, 131),
            ChartDataPoint.Financial("Fri", 131, 155, 128, 149)
        })
    };

    private List<ChartSeries> _bulletSeries = new()
    {
        // one month in dollars: the dark bar is what was spent, the red line what was planned
        new ChartSeries("Household budget", ChartType.Bullet, new[]
        {
            ChartDataPoint.Bullet("Groceries", 420, 400),
            ChartDataPoint.Bullet("Transport", 95, 120),
            ChartDataPoint.Bullet("Eating out", 180, 150),
            ChartDataPoint.Bullet("Savings", 300, 350)
        })
    };

    private List<ChartSeries> _rangeSeries = new()
    {
        // overnight low to afternoon high in °C; the axis runs from the lowest low (4) to the highest high (20) in four steps
        new ChartSeries("Garden thermometer", ChartType.RangeColumn, new[]
        {
            ChartDataPoint.Range("Mon", 6, 14),
            ChartDataPoint.Range("Tue", 8, 17),
            ChartDataPoint.Range("Wed", 10, 20),
            ChartDataPoint.Range("Thu", 7, 15),
            ChartDataPoint.Range("Fri", 4, 11)
        })
    };

    private List<ChartSeries> _sankeySeries = new()
    {
        // kg collected from each bin in a month and what it is made into; one flow per node, because the renderer draws a node and label per flow
        new ChartSeries("Recycling", ChartType.Sankey, new[]
        {
            ChartDataPoint.Sankey("Paper", "Cardboard", 120),
            ChartDataPoint.Sankey("Glass", "Bottles", 60),
            ChartDataPoint.Sankey("Cans", "Car parts", 40),
            ChartDataPoint.Sankey("Food", "Compost", 80),
            ChartDataPoint.Sankey("Plastic", "Fleece", 50)
        })
    };

    private List<ChartSeries> _gaugeSeries = new()
    {
        new ChartSeries("Rain barrel", ChartType.RadialGauge, new[]
        {
            new ChartDataPoint("Percent full", 82.5)
        })
    };

