            new("Large", "Glyph at 20px above the label, 64px wide at least. Off: a 14px glyph left of the label.", "bool", "false"),
            new("Tooltip", "The button's <code>title</code>. The label when empty.", "string", "\"\""),
            new("Disabled", "Sets the <code>disabled</code> attribute and fades the button to half opacity.", "bool", "false"),
            new("CssClass", "Extra classes on the <code>&lt;button&gt;</code>, for example a pressed state.", "string", "\"\""),
            new("OnClick", "Runs on click.", "EventCallback", "none"),
        };
        public static readonly ApiRow[] Css =
        {
            new("fx-ribbon", "Outer box: light grey with a bottom border, 12px text."),
            new("fx-ribbon-tabs · fx-ribbon-tab-btn · .active", "The header strip and one header; the open header joins the body below it."),
            new("fx-ribbon-body · fx-ribbon-tab-content", "At least 92px tall; the open tab's groups in a row."),
            new("fx-ribbon-group · fx-ribbon-group-body · fx-ribbon-group-title", "One group, at least 80px wide with a divider on its right; its buttons wrap, the 10px caption sits underneath."),
            new("fx-ribbon-button · fx-ribbon-button-large · .disabled", "A button; transparent until hovered. Large stacks the glyph over the label."),
            new("fx-ribbon-button-icon · fx-ribbon-button-text", "The glyph and the label inside a button."),
        };
        public static readonly ApiRow[] Vars =
        {
            new("--fx-zoom", "Scales every font size in the ribbon, as across the library.", "1"),
        };
    }

    // Code tabs are verbatim
    private static class Code
    {
        public const string Tabs = @"<RibbonControl>
    <RibbonTab Title=""Home"">
        <RibbonGroup Title=""Clipboard"">
            <RibbonButton Text=""Paste"" Icon=""📋"" Large=""true"" Disabled=""@(_clipboard is null)"" OnClick=""@(() => Did($""Pasted {_clipboard}""))"" />
            <RibbonButton Text=""Cut"" Icon=""✂️"" OnClick=""@(() => Clip(""Cut""))"" />
            <RibbonButton Text=""Copy"" Icon=""📄"" OnClick=""@(() => Clip(""Copied""))"" />
        </RibbonGroup>
        <RibbonGroup Title=""Booking"">
            <RibbonButton Text=""New booking"" Icon=""✈️"" Large=""true"" OnClick=""@(() => Did(""Started a new booking""))"" />
            <RibbonButton Text=""Hold"" Icon=""⏸️"" Tooltip=""Hold the seats for 24 hours"" OnClick=""@(() => Did(""Held the seats""))"" />
            <RibbonButton Text=""Cancel"" Icon=""✖️"" OnClick=""@(() => Did(""Cancelled the booking""))"" />
        </RibbonGroup>
    </RibbonTab>
    <RibbonTab Title=""Extras"">
        <RibbonGroup Title=""Add to the trip"">
            <RibbonButton Text=""Transfer"" Icon=""🚐"" Large=""true"" OnClick=""@(() => Did(""Added an airport transfer""))"" />
            <RibbonButton Text=""Insurance"" Icon=""🛡️"" OnClick=""@(() => Did(""Added travel insurance""))"" />
            <RibbonButton Text=""Excursion"" Icon=""🗺️"" OnClick=""@(() => Did(""Added an excursion""))"" />
