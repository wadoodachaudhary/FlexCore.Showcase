    // Barcode
    private BarcodeType _type = BarcodeType.Code128;
    private string? _barcodeValue = "FLEX-9988";
    private bool _showText = true;
    private static readonly Dictionary<BarcodeType, string> Samples = new()
    {
        [BarcodeType.Code128] = "FLEX-9988",
        [BarcodeType.Code39] = "FLEX-9988",
        [BarcodeType.Ean13] = "4006381333931",
        [BarcodeType.UpcA] = "036000291452",
        [BarcodeType.Itf] = "12345678",
    };
    private readonly SelectionItem[] _typeItems =
    {
        new("Code128", "Code 128"), new("Code39", "Code 39"), new("Ean13", "EAN-13"), new("UpcA", "UPC-A"), new("Itf", "ITF"),
    };
    private void PickType(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _type = Enum.Parse<BarcodeType>(values[0]);
        _barcodeValue = Samples[_type];
    }

