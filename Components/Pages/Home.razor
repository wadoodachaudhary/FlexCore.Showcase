    private void LoadCostPreview()
    {
        var package = FlexCore.Showcase.Data.TravelData.Packages[0];
        var season = FlexCore.Showcase.Data.TravelData.Seasons[0];
        var table = ReportData.Execute(
            "SELECT CostGroup AS PackageCostLines_CostGroup, Amount AS Formula_Amount FROM PackageCostLines",
            new Dictionary<string, object> { ["Package"] = package.Name, ["Season"] = season });
        var blurbs = new Dictionary<string, string>
        {
            ["A"] = "Transport : Flights, transfers and rail",
            ["B"] = $"Accommodation : {package.Nights} nights with breakfast",
            ["C"] = "Experiences : Tours, tickets and a cooking class",
            ["D"] = "Services : Insurance, guide and booking fees",
        };
        _costPreviewTitle = $"{package.Name}, {season}";
        _costPreview = table.Rows.Cast<System.Data.DataRow>()
            .GroupBy(r => (string)r["PackageCostLines_CostGroup"])
            .OrderBy(g => g.Key)
            .Select(g => ($"{g.Key} {blurbs.GetValueOrDefault(g.Key, "")}", g.Sum(r => (decimal)r["Formula_Amount"])))
            .ToArray();
    }

    private void OnTripTypeChanged(TripRequest r, string? newType)
    {
        if (string.IsNullOrEmpty(newType)) return;
        r.TripType = newType;
        var lookup = _tripTypeLookup.FirstOrDefault(t => t.Code.Equals(newType, StringComparison.OrdinalIgnoreCase));
        if (lookup != null)
            r.TripTypeName = lookup.Name;
        Notifications.Success($"Updated {r.Request} trip type to {newType} via DropDownGridControl");
        StateHasChanged();
    }

    private static string Initials(string name)
    {
        var letters = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => char.ToUpperInvariant(p[0])));
        return letters.Length > 2 ? letters[..2] : letters;
    }

    // Request keys are the first three letters of the destination plus a running number, e.g. LIS-0001
    private static string RequestKey(string destination, int id)
    {
        var word = destination.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        var code = new string(word.Where(char.IsLetter).Take(3).ToArray()).ToUpperInvariant().PadRight(3, 'X');
        return $"{code}-{id:D4}";
    }

