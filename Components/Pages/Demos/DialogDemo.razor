    <Accessibility>
        <ul>
            <li>The dialog has <code>role="dialog"</code>, <code>aria-modal="true"</code> when modal, and is named by <code>AriaLabel</code> or else by its <code>Header</code>. Give <code>AriaDescribedBy</code> the id of the main message so screen readers read it with the title.</li>
            <li>With <code>AutoFocus</code> (on by default), opening moves focus into the dialog, to a text field first and to a button last; closing returns focus to the control that opened it. Tab and Shift+Tab wrap within the body and footer.</li>
            <li>Escape closes, or runs <code>OnEscape</code> when set. Alt+F4 closes. Ctrl+Enter closes when <code>CloseOnCtrlEnter</code> is on. Enter fires <code>OnEnter</code> unless the focused control keeps the key.</li>
            <li>With the mouse, the title bar's close button (named "Close") closes the dialog, and a right-click on the title bar, or the "Window menu" button that <code>ShowWindowIcon</code> adds, opens a <code>role="menu"</code> system menu with Move and Close. From the keyboard, Alt+F4 closes the dialog as that Close does.</li>
            <li>Message box: a modal <code>role="dialog"</code> named by its title. Focus goes to OK or Yes as soon as that button is enabled; the arrow keys and Tab move between the buttons, the title bar's Close included, Enter or Space presses the focused one, and Escape closes.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Buttons used in footers, and <code>DefaultButtonScope</code>: <a href="demo/buttons">Buttons</a>.</li>
            <li>Non-blocking messages: <a href="demo/notifications">Toasts</a>.</li>
            <li><code>MultiLineEditControl</code>, the long-text prompt grids open from a cell: the Notes button in the third example; see the Methods table.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Modal: the dialog edits copies, and Save writes them to the ticket
    private bool _editOpen, _classic;
    private DateTime _followUp = DateTime.Today.AddDays(2);
    private string _priority = "High";
    private string _note = "";
    private DateTime? _editFollowUp;
    private string _editPriority = "", _editNote = "";
    private readonly List<string> _priorities = new() { "Low", "Normal", "High", "Urgent" };
    private void OpenEdit()
    {
        (_editFollowUp, _editPriority, _editNote) = (_followUp, _priority, _note);
        _editOpen = true;
    }
    private void Save()
    {
        (_followUp, _priority, _note) = (_editFollowUp ?? _followUp, _editPriority, _editNote);
        _editOpen = false;
    }

    // Window
    private sealed record Ticket(string Code, string Subject, string Customer, string Details);
    private static readonly Ticket[] Tickets =
    {
        new("TKT-1042", "Router keeps restarting", "Albus Door", "Hardware queue, by phone. Restarts every evening since Monday."),
        new("TKT-1043", "Charged twice in October", "Hermione Ranger", "Billing queue, by email. Two October charges on the same card."),
        new("TKT-1044", "Cannot reset password", "Ron Measly", "Accounts queue, by chat. The reset email never arrives."),
        new("TKT-1045", "Slow connection in the evenings", "Luna Goodlove", "Connection queue, by phone. Video calls freeze after 7 PM."),
    };
    private Ticket _ticket = Tickets[0];
    private bool _winOpen;
    private string? _winWidth = "480px", _winHeight = "240px";
    private DialogPosition? _winPos;

    // Service and message box. Set-up, once per app: Program.cs registers
    //   builder.Services.AddScoped<Fx.ControlKit.Dialogs.DialogService>();
    //   builder.Services.AddScoped<Fx.ControlKit.Dialogs.IDialogService>(sp => sp.GetRequiredService<Fx.ControlKit.Dialogs.DialogService>());
    // and MainLayout.razor hosts <DialogHostControl />. This page has @inject IDialogService Dialogs at the top.
    private MessageBoxControl? _box;
    private MultiLineEditControl? _editor;
    private string _subject = "Charged twice in October", _status = "Open", _notes = "";
    private async Task Rename()
    {
        var subject = await Dialogs.PromptAsync("Subject:", "Rename ticket", _subject);
        if (!string.IsNullOrWhiteSpace(subject)) _subject = subject;
    }
    private async Task Notes()
    {
        var text = await _editor!.ShowAsync(_notes, "Ticket notes", 500, "Internal notes for the ticket; 500 characters at most.");
        if (text is not null) _notes = text;
    }
    private async Task SendReply()
    {
        if (!await Dialogs.ConfirmAsync($"{_subject}: send the reply to Hermione Ranger?", "Send reply")) return;
        _status = "Waiting on customer";
        StateHasChanged();   // show the new status behind the alert
        await Dialogs.AlertAsync("The reply is on its way. The customer has 7 days to answer.", "Reply sent");
    }
    private async Task RefundCharge()
    {
        var answer = await _box!.ShowAsync($"{_subject}: refund the duplicate charge and solve the ticket?", "Refund charge", MessageBoxButtons.OkCancel, "warning", null, "I understand this cannot be undone");
        if (answer == MessageBoxResult.Ok) _status = "Solved";
    }
    private void Restore() => (_subject, _status, _notes) = ("Charged twice in October", "Open", "");

