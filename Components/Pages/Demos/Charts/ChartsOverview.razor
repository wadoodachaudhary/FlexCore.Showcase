@page "/demo/charts"
@using Fx.ControlKit.Charts
@using FlexCore.Showcase.Services
@using FlexCore.Showcase.Components.Shared
@* 2026-10-12: wrapped in FeatureDemoLayout as one example (the tabbed gallery, unchanged). "No JavaScript
   dependencies" reworded per the claims rule. ChartControl parameter table pending (SC-264).
   2026-10-20: ?tab=<slug> opens the gallery on that tab (catalog row Sparkline Charts); slugs in TabSlugs.
   2026-10-23 (developer meeting point 5, label clutter): every SVG chart draws on a fixed viewBox (600x300; 300x300 for
   Pie, Donut, Radar, Gauge; 400x300 for Funnel) with xMidYMid meet, so rendered text = tile scale, and a tile taller
   than its width-bound height is blank. Each layout now sets CellAspectRatio so a tile is title + chart (+ legend)
   tall, and every Height is the width-bound value (226px in a 453px two-column tile, 400px full width). Dense charts
   (Histogram, Box Plot, Waterfall, Pareto, Funnel) have full-width tiles; Part-to-Whole went from 3 to 2 columns with
   the Sunburst on a SizeY=2 row that holds its 680px drawing. Scatter and Bubble put numeric x values in Label (the
   renderer parses Label as x and draws no x tick labels). Radar "JavaScript" -> "JS" (labels cut at 8). Waterfall is
   deltas only: the renderer adds every point to the running total, so "Gross Profit"/"Net Income" subtotal bars were
   drawn as further increases. Funnel values and stage names chosen so each label fits its segment. Heatmap legend
   hidden (it repeated the row labels). Gantt has 8 tasks so the rows fill the plot (rowH is capped at 30 units).
   YAxis Max/TickCount set where the default 1.1 x max gave ragged tick values. HorizontalBar has no renderer (draws
   as Bar) and is not used. The Stacked Area title and the Sunburst itself are untouched. *@

<PageTitle>Charts — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Charts" Category="Charts" CategoryHref="demo/charts" ControlName="ChartControl"
                   Tagline="One control, thirty-plus chart types, drawn in SVG from C#."
                   SourcePath="Charts/ChartControl.razor">
    <Overview>
        <p>
            <code>ChartControl</code> takes a <code>ChartType</code> and a list of <code>ChartSeries</code> and draws the result as SVG;
            there is no npm package or third-party script behind it. The gallery groups the types by the question they answer:
            comparison, trend, part-to-whole, distribution, correlation, multivariate, single values, statistics, project, heatmap and
            sparklines. Candlestick, OHLC, bullet, range, Sankey and the gauge family are on <a href="demo/advanced-charts">Financial &amp; gauges</a>;
            the drill-down sunburst has <a href="demo/charts/sunburst">its own page</a>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="gallery" Title="Gallery by purpose" RazorCode="@Code.Gallery" CSharpCode="@Code.GalleryCs">
            <Description><p>Every chart here is the same control with a different <code>Type</code>. Series data is bound; titles, heights, axes, legends and palettes are parameters.</p></Description>
            <Demo>
<TabControl @bind-SelectedIndex="_tab">
    <TabItem HeaderText="Comparison">
        <h2>Bar Charts</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.67">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Bar" Title="Vertical Bar" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 400 })"
                                  Series="@(new List<ChartSeries> { new() { Name = "Revenue", DataPoints = new() {
                                      new("Q1", 120), new("Q2", 180), new("Q3", 240), new("Q4", 310) } } })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.GroupedBar" Title="Grouped Bar" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 400 })" Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedBar" Title="Stacked Bar" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 800 })" Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedBar100" Title="100% Stacked Bar" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 100 })" Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Trend">
        <h2>Line &amp; Area Charts</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.67">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Line" Title="Line Chart" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 80 })" Series="@_lineSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Area" Title="Area Chart" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 80 })"
                                  Series="@(new List<ChartSeries> { _lineSeries[0] })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Spline" Title="Spline Chart" Height="226px"
                                  YAxis="@(new ChartAxis { Max = 80 })"
                                  Series="@(new List<ChartSeries> { _lineSeries[0] })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedArea" Title="Stacked Area" Height="226px"
                                  Series="@_lineSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Part-to-Whole">
        <h2>Pie, Donut, Funnel &amp; Sunburst</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.86">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Pie" Title="Pie Chart" Height="300px"
                                  Series="@(new List<ChartSeries> { _pieSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Donut" Title="Donut Chart" Height="300px"
                                  InnerRadius="0.55"
                                  Series="@(new List<ChartSeries> { _pieSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="2" SizeY="1">
                    <ChartControl Type="ChartType.Funnel" Title="Funnel Chart" Height="350px"
                                  Series="@(new List<ChartSeries> { _funnelSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="2" Column="0" SizeX="2" SizeY="2">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-2 pt-2">
                        <h4 class="mb-0" style="font-size: 1.1rem; font-weight: 700;">COVID-19 Radial Sunburst Chart</h4>
                        <a href="demo/charts/sunburst" class="btn btn-sm btn-primary">Open Full Interactive COVID-19 Screen ↗</a>
                    </div>
                    <SunburstChartControl RootNode="@_sunburstDemoNode" Height="420px" EnableDrilldown="true" ShowBreadcrumb="true" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Distribution">
        <h2>Histogram &amp; Box Plot</h2>
        <DashboardLayoutControl Columns="1" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.48">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Histogram" Title="Histogram" Height="400px"
                                  YAxis="@(new ChartAxis { Max = 60 })" Series="@_histogramSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.BoxPlot" Title="Box Plot" Height="400px"
                                  YAxis="@(new ChartAxis { Max = 100 })" Series="@_boxPlotSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Correlation">
        <h2>Scatter &amp; Bubble</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.67">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Scatter" Title="Scatter Plot" Height="226px"
                                  Series="@_scatterSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Bubble" Title="Bubble Chart" Height="226px"
                                  Series="@_bubbleSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Multivariate">
        <h2>Radar / Spider Chart</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Radar" Title="Skills Assessment" Height="400px"
                          Series="@_radarSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="KPI & Gauge">
        <h2>Single Value Indicators</h2>
        @* Cards span 2 rows and gauges 3: with CellAspectRatio 0.37 a card tile is about 220px tall and a gauge tile about 330px. *@
        <DashboardLayoutControl Columns="3" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.37">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="2">
                    <ChartControl Type="ChartType.KpiCard" Title="Revenue"
                                  KpiValue="$2.4M" KpiLabel="Total Revenue" KpiTrend="+12.5%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="2">
                    <ChartControl Type="ChartType.KpiCard" Title="Users"
                                  KpiValue="18,429" KpiLabel="Active Users" KpiTrend="+8.2%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="2" SizeX="1" SizeY="2">
                    <ChartControl Type="ChartType.KpiCard" Title="Churn"
                                  KpiValue="3.1%" KpiLabel="Monthly Churn" KpiTrend="-0.4%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="2" Column="0" SizeX="1" SizeY="3">
                    <ChartControl Type="ChartType.Gauge" Title="CPU Usage"
                                  GaugeValue="72" GaugeMin="0" GaugeMax="100" Height="285px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="2" Column="1" SizeX="1" SizeY="3">
                    <ChartControl Type="ChartType.Gauge" Title="Memory"
                                  GaugeValue="45" GaugeMin="0" GaugeMax="100" Height="285px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="2" Column="2" SizeX="1" SizeY="3">
                    <ChartControl Type="ChartType.Gauge" Title="Disk I/O"
                                  GaugeValue="88" GaugeMin="0" GaugeMax="100" Height="285px" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Statistical">
        <h2>Waterfall &amp; Pareto</h2>
        <DashboardLayoutControl Columns="1" CellSpacing="@(new double[] { 16, 16 })" CellAspectRatio="0.48">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Waterfall" Title="Profit Waterfall" Height="400px"
                                  YAxis="@(new ChartAxis { Max = 600 })" Series="@_waterfallSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Pareto" Title="Defect Pareto" Height="400px"
                                  YAxis="@(new ChartAxis { Max = 50, TickCount = 6 })" Series="@_paretoSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Project">
        <h2>Gantt Chart</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Gantt" Title="Project Timeline" Height="400px"
                          Series="@_ganttSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="Heatmap">
        <h2>Heatmap Matrix</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Heatmap" Title="Weekly Activity" Height="400px"
                          Legend="@(new ChartLegend { Visible = false })" Series="@_heatmapSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="Sparkline">
        <h2>Inline Sparklines</h2>
        <div class="demo-frame">
            <p>Revenue: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 10), new("", 25), new("", 18), new("", 32), new("", 28), new("", 40), new("", 35) } } })" /></p>
            <p>Users: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          ColorPalette="@(new[] { "#16a34a" })"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 5), new("", 12), new("", 8), new("", 20), new("", 18), new("", 25), new("", 30) } } })" /></p>
            <p>Errors: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          ColorPalette="@(new[] { "#dc2626" })"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 8), new("", 3), new("", 5), new("", 2), new("", 6), new("", 1), new("", 3) } } })" /></p>
        </div>
    </TabItem>
</TabControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>ChartControl</code>, <code>ChartSeries</code> and <code>ChartDataPoint</code> tables are still to be written from <code>Charts/ChartControl.razor</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/advanced-charts">Financial &amp; gauges</a>: candlestick, OHLC, bullet, range, Sankey, radial and linear gauges.</li>
            <li><a href="demo/charts/sunburst">Sunburst</a>: drill-down hierarchy on a real dataset.</li>
            <li><a href="demo/charts/map-story">Map story</a>: drill-down unemployment choropleth, world to province.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    /// <summary>Tab named in the address, e.g. demo/charts?tab=sparkline; read when the page loads, never written back.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private int _tab;
    private static readonly string[] TabSlugs =
        ["comparison", "trend", "part-to-whole", "distribution", "correlation", "multivariate", "kpi-gauge", "statistical", "project", "heatmap", "sparkline"];

    protected override void OnParametersSet()
    {
        var i = Array.IndexOf(TabSlugs, Tab?.Trim().ToLowerInvariant());
        if (i >= 0) _tab = i;
    }


    List<ChartSeries> _groupedBarSeries = new()
    {
        new() { Name = "2024", DataPoints = new() { new("Q1", 120), new("Q2", 180), new("Q3", 240), new("Q4", 310) } },
        new() { Name = "2025", DataPoints = new() { new("Q1", 150), new("Q2", 210), new("Q3", 280), new("Q4", 350) } }
    };

    List<ChartSeries> _lineSeries = new()
    {
        new() { Name = "Product A", DataPoints = new() { new("Jan", 30), new("Feb", 45), new("Mar", 38), new("Apr", 55), new("May", 62), new("Jun", 70) } },
        new() { Name = "Product B", DataPoints = new() { new("Jan", 20), new("Feb", 25), new("Mar", 35), new("Apr", 40), new("May", 48), new("Jun", 52) } }
    };

    ChartSeries _pieSeries = new()
    {
        Name = "Market Share",
        DataPoints = new() { new("Chrome", 65), new("Firefox", 12), new("Safari", 15), new("Edge", 5), new("Other", 3) }
    };

    ChartSeries _funnelSeries = new()
    {
        Name = "Conversion",
        // segment width is 320 units x value / max and a label is about 6.6 units per character, so each stage name fits its own segment
        DataPoints = new() { new("Visits", 1000), new("Leads", 720), new("Trials", 480), new("Quotes", 300), new("Won", 180) }
    };

    List<ChartSeries> _histogramSeries = new()
    {
        new() { Name = "Response Time (ms)", DataPoints = new() {
            new("0-50", 12), new("50-100", 28), new("100-150", 45), new("150-200", 38),
            new("200-250", 22), new("250-300", 15), new("300-350", 8), new("350-400", 4) } }
    };

    List<ChartSeries> _boxPlotSeries = new()
    {
        new() { Name = "Scores", DataPoints = new() {
            new("Math", 45) { Value2 = 95, Value3 = 60, Value4 = 82, Value5 = 72 },
            new("Science", 50) { Value2 = 90, Value3 = 62, Value4 = 80, Value5 = 70 },
            new("English", 40) { Value2 = 88, Value3 = 55, Value4 = 78, Value5 = 68 },
            new("History", 35) { Value2 = 92, Value3 = 58, Value4 = 85, Value5 = 74 },
