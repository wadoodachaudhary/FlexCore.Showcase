    <TreeGridColumn Field=""@nameof(StaffMember.Name)"" HeaderText=""Name"" Width=""290px"" IsFrozen=""true"">
        <Template>
            @{ var p = (StaffMember)context; }
            @if (p.Vacant) { <em class=""vacant"">Vacant</em> } else { <strong>@p.Name</strong> }
            @if (p.OnLeave) { <span class=""tag"">on leave</span> }
        </Template>
    </TreeGridColumn>
    <TreeGridColumn Field=""@nameof(StaffMember.Title)"" HeaderText=""Title"" Width=""230px"" />
    <TreeGridColumn Field=""@nameof(StaffMember.Office)"" HeaderText=""Office"" Width=""110px"" />
    <TreeGridColumn Field=""@nameof(StaffMember.Headcount)"" HeaderText=""People below"" Width=""110px"" TextAlign=""TextAlign.Right"">
        <Template>@(((StaffMember)context).Headcount is > 0 and var n ? n.ToString(""N0"") : """")</Template>
    </TreeGridColumn>
    <TreeGridColumn Field=""@nameof(StaffMember.Grade)"" HeaderText=""Grade"" Width=""70px"" TextAlign=""TextAlign.Center"" />
    <TreeGridColumn Field=""@nameof(StaffMember.Contract)"" HeaderText=""Contract"" Width=""160px"">
        <Template>
            @{ var p = (StaffMember)context; }
            @p.Contract@(p.Fte < 1 ? $"", {p.Fte:0.0} FTE"" : """")
        </Template>
    </TreeGridColumn>
    <TreeGridColumn Field=""@nameof(StaffMember.Salary)"" HeaderText=""Salary"" Width=""100px"" TextAlign=""TextAlign.Right"" Format=""C0"" />
    <TreeGridColumn Field=""@nameof(StaffMember.Rating)"" HeaderText=""Rating"" Width=""120px"">
        <Template>
            @{ var p = (StaffMember)context; }
            @if (p.Rating is { } stars) { <RatingControl Value=""@stars"" ReadOnly=""true"" /> }
            else if (!p.Vacant) { <span class=""muted"">new starter</span> }
        </Template>
    </TreeGridColumn>
    <TreeGridColumn Field=""@nameof(StaffMember.Started)"" HeaderText=""Started"" Width=""100px"" TextAlign=""TextAlign.Center"" Format=""yyyy-MM-dd"" />
    <TreeGridColumn Field=""@nameof(StaffMember.DottedLineId)"" HeaderText=""Also reports to"" Width=""190px"">
        <Template>@DottedLine((StaffMember)context)</Template>
    </TreeGridColumn>
</TreeGridControl>
<p class=""result"">@OrgStatus</p>";
        public const string OrgCs = @"// Org chart: Razor Sharp Getaways' staff (Data/TravelOrg.cs). A search keeps every match's managers, so the tree stays
// rooted.
private static readonly IReadOnlyList<StaffMember> _staff = TravelOrg.Staff;
private static readonly Dictionary<string, StaffMember> _byId = _staff.ToDictionary(p => p.Id);
private string? _search;
private List<StaffMember> _shown = _staff.ToList();
private int _orgGeneration = 1;   // @key: a new value remounts the tree grid when the list is swapped

private string OrgStatus =>
    $""{_shown.Count:N0} of {_staff.Count:N0} posts shown; {_shown.Count(p => p.Vacant)} vacant, {_shown.Count(p => p.OnLeave)} on leave."";

private static string DottedLine(StaffMember p) =>
    p.DottedLineId is { } id ? _byId[id] is { Vacant: true } v ? $""{v.Title} (vacant)"" : _byId[id].Name : """";

private void Search(string? text)
{
    _search = text?.Trim();
    var keep = _staff
        .Where(p => string.IsNullOrEmpty(_search)
                    || new[] { p.Name, p.Title, p.Office, p.Division, p.Department }.Any(v => v.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .Select(p => p.Id)
        .ToHashSet();
    foreach (var id in keep.ToList())
        for (var manager = _byId[id].ManagerId; manager is not null && keep.Add(manager); manager = _byId[manager].ManagerId) { }
    _shown = _staff.Where(p => keep.Contains(p.Id)).ToList();
    _orgGeneration++;
}

// Data/TravelOrg.cs: one post; TravelOrg.Staff generates the list from a fixed seed.
public sealed record StaffMember
{
    public required string Id { get; init; }
    public string? ManagerId { get; init; }
    public string? DottedLineId { get; init; }
    public required string Name { get; init; }        // ""Vacant"" for an open post
    public required string Title { get; init; }
    public int Grade { get; init; }                   // 1 trainee to 9 chief executive
    public required string Division { get; init; }
    public required string Department { get; init; }
    public required string Office { get; init; }
    public required string Country { get; init; }
    public required string Region { get; init; }
    public required string Contract { get; init; }    // Permanent, Fixed-term, Seasonal or Contractor
    public double Fte { get; init; } = 1;             // 1 full time; 0.5 to 0.8 part time
    public DateOnly? Started { get; init; }
    public decimal Salary { get; init; }              // USD a year at the post's FTE; the budget for a vacant post
    public int? Rating { get; init; }                 // 1 to 5; none for vacant posts and people who started under six months ago
    public string Languages { get; init; } = """";
    public string Email { get; init; } = """";
    public bool Vacant { get; init; }
    public bool OnLeave { get; init; }
    public int Level { get; init; }                   // 0 for the chief executive
    public int DirectReports { get; init; }           // posts reporting on the solid line, vacant ones included
    public int Headcount { get; init; }               // people below on the solid line, vacant posts not counted
}";
        public const string Airports = @"<TreeGridControl @ref=""_places""
                 TValue=""Place""
                 DataSource=""@_continents""
                 IdMapping=""Id""
                 ParentIdMapping=""ParentId""
                 TreeColumnIndex=""0""
                 TreatAsParent=""@(p => p.Level < 2 || (p.Level == 2 && p.Runways > 0))""
                 LoadChildren=""LoadPlacesAsync""
                 EnableCollapseAll=""true""
                 InitialExpansionPredicate=""@(p => p.Name == ""Europe"")""
                 AllowSorting=""true""
                 AllowSelection=""true""
                 Height=""440px""
                 Expanded=""@(a => _last = $""opened {a.Data?.Name}"")""
                 Collapsed=""@(a => _last = $""closed {a.Data?.Name}"")"">
    <TreeGridColumn Field=""@nameof(Place.Name)"" HeaderText=""Place"" Width=""340px"" />
    <TreeGridColumn Field=""@nameof(Place.Detail)"" HeaderText=""Type or surface"" Width=""150px"" />
    <TreeGridColumn Field=""@nameof(Place.Airports)"" HeaderText=""Airports"" Width=""80px"" TextAlign=""TextAlign.Right"" Format=""N0"" />
    <TreeGridColumn Field=""@nameof(Place.Runways)"" HeaderText=""Runways"" Width=""80px"" TextAlign=""TextAlign.Right"" Format=""N0"" />
    <TreeGridColumn Field=""@nameof(Place.LongestRunwayFt)"" HeaderText=""Longest runway (ft)"" Width=""140px"" TextAlign=""TextAlign.Right"" Format=""N0"" />
    <TreeGridColumn Field=""@nameof(Place.ElevationFt)"" HeaderText=""Elevation (ft)"" Width=""110px"" TextAlign=""TextAlign.Right"" Format=""N0"" />
</TreeGridControl>
<p class=""result"">@_loaded.ToString(""N0"") of @_total.ToString(""N0"") rows loaded@(_last is null ? """" : $"" · last {_last}"")</p>";
        public const string AirportsCs = @"// Airports: the six continents are the whole DataSource; LoadChildren supplies the rest a level at a time.
// A row's Id is its path, ""Europe|PT|LIS|03/21"", so the loader can tell from it what to return.
private TreeGridControl<Place>? _places;
private readonly List<Place> _continents = AirportData.Airports
    .GroupBy(a => a.Continent)
    .OrderBy(g => g.Key)
    .Select(g => Group(g.Key, null, g.Key, g))
    .ToList();
private int _loaded = 6;
private readonly int _total = 6 + AirportData.Airports.Select(a => (a.Continent, a.CountryCode)).Distinct().Count()
    + AirportData.Airports.Count + AirportData.Airports.Sum(a => a.Runways);
private string? _last;

private Task<IReadOnlyList<Place>> LoadPlacesAsync(Place parent, CancellationToken token)
{
    var path = parent.Id.Split('|');
    IReadOnlyList<Place> children = path.Length switch
    {
        1 => AirportData.Airports.Where(a => a.Continent == path[0])
                .GroupBy(a => (a.CountryCode, a.Country))
                .OrderBy(g => g.Key.Country)
                .Select(g => Group($""{parent.Id}|{g.Key.CountryCode}"", parent.Id, g.Key.Country, g))
                .ToList(),
        2 => AirportData.Airports.Where(a => a.Continent == path[0] && a.CountryCode == path[1])
                .OrderBy(a => a.Type).ThenBy(a => a.Code)
                .Select(a => new Place($""{parent.Id}|{a.Code}"", parent.Id, $""{a.Code} · {a.Name}"", $""{a.Type} airport"",
                    null, a.Runways, a.LongestRunwayFt, a.ElevationFt))
                .ToList(),
        _ => AirportData.RunwaysOf(path[2]).Where(r => !r.Closed)
                .OrderByDescending(r => r.LengthFt)
                .Select(r => new Place($""{parent.Id}|{r.Name}"", parent.Id, $""Runway {r.Name}"",
                    r.Lighted ? $""{r.Surface}, lighted"" : r.Surface, null, null, r.LengthFt, null))
                .ToList()
    };
    _loaded += children.Count;
    return Task.FromResult(children);
}

private static Place Group(string id, string? parentId, string name, IEnumerable<Airport> airports) =>
    new(id, parentId, name, """", airports.Count(), airports.Sum(a => a.Runways), airports.Max(a => a.LongestRunwayFt), null);

private sealed record Place(string Id, string? ParentId, string Name, string Detail,
    int? Airports, int? Runways, int? LongestRunwayFt, int? ElevationFt)
{
    public int Level => Id.Count(c => c == '|');
}";
