<PageTitle>Blazor Badge, Alert, Timeline and Progress Bar — FlexCore</PageTitle>

<FeatureDemoLayout Title="UI elements" Category="Components"
                   Tagline="The small parts: badges, alerts, skeletons, timeline, breadcrumb and progress bars."
                   SourcePath="BadgeControl.razor;BadgeModels.cs;AlertControl.razor;AlertModels.cs;SkeletonControl.razor;SkeletonModels.cs;TimelineControl.razor;TimelineItemControl.razor;TimelineModels.cs;BreadCrumbControl.razor;BreadCrumbItem.cs;FlexControlBase.cs;ProgressBarControl.razor;ChunkProgressBarControl.razor;ContentModels.cs">
    <Overview>
        <p>
            Seven small controls that have no page of their own yet, grouped by what they do: status and feedback, content, and progress. Each is shown with the parameters it is usually given; the tables under Documentation list every parameter, with what it changes.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="status" Title="Badges, alerts and skeletons" RazorCode="@Code.Status">
            <Description><p><code>BadgeControl</code> takes a <code>Variant</code>, a <code>Size</code>, or <code>IsDot</code> for a status dot. <code>AlertControl</code> is an inline banner with a <code>Severity</code> and an optional close. <code>SkeletonControl</code> holds the place of loading content.</p></Description>
            <Demo>
                <div class="demo-row">
                    <BadgeControl Text="Primary" Variant="BadgeVariant.Primary" />
                    <BadgeControl Text="Success" Variant="BadgeVariant.Success" />
                    <BadgeControl Text="Danger" Variant="BadgeVariant.Danger" />
                    <BadgeControl Text="Warning" Variant="BadgeVariant.Warning" />
                    <BadgeControl Text="Info" Variant="BadgeVariant.Info" />
                    <BadgeControl Text="Dark" Variant="BadgeVariant.Dark" />
                    <BadgeControl Text="Small" Size="BadgeSize.Small" Variant="BadgeVariant.Secondary" />
                    <BadgeControl Text="Large" Size="BadgeSize.Large" Variant="BadgeVariant.Primary" />
                    <BadgeControl IsDot="true" Variant="BadgeVariant.Success" />
                </div>
                <div class="stack mt">
                    <AlertControl Severity="AlertSeverity.Success" Title="Import finished" Text="1,204 supplier rate rows loaded; 3 skipped as duplicates." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Warning" Title="Slow connection" Text="Round trips are taking about 200 ms." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Error" Title="Sync failed" Text="The upstream server did not answer." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Info" Title="Scheduled maintenance" Text="Saturday 02:00 to 03:00 UTC." AllowClose="true" />
                </div>
                <div class="skeletons mt">
                    <SkeletonControl Variant="SkeletonVariant.Text" />
                    <SkeletonControl Variant="SkeletonVariant.Text" Animation="SkeletonAnimation.Wave" />
                    <div class="demo-row"><SkeletonControl Variant="SkeletonVariant.Circular" /><SkeletonControl Variant="SkeletonVariant.Text" Width="140px" /></div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="content" Title="Timeline and breadcrumb" RazorCode="@Code.Content" CSharpCode="@Code.ContentCs">
            <Description><p><code>TimelineControl</code> lists <code>TimelineItemControl</code>s, each with a title, a time and a coloured point. <code>BreadCrumbControl</code> takes a list of <code>BreadCrumbItem</code>s; the last one renders without a link.</p></Description>
            <Demo>
                <div class="two">
                    <TimelineControl>
                        <TimelineItemControl Title="Deposit received" Time="09:00" PointColor="BadgeVariant.Success">Booking LIS-0001 confirmed.</TimelineItemControl>
                        <TimelineItemControl Title="Tickets issued" Time="13:30" PointColor="BadgeVariant.Primary">Return flights for two travellers.</TimelineItemControl>
                        <TimelineItemControl Title="Hotel to confirm" Time="16:45" PointColor="BadgeVariant.Warning">Late arrival noted with the old-town hotel.</TimelineItemControl>
                    </TimelineControl>
                </div>
                <div class="demo-row mt">
                    <BreadCrumbControl Items="_crumbs" />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="progress" Title="Progress bars" RazorCode="@Code.Progress" CSharpCode="@Code.ProgressCs" CssCode="@Code.ProgressCss">
            <Description><p><code>ProgressBarControl</code> takes a percentage (<code>Value</code>, 0 to 100) with a bold <code>Title</code>, a <code>Status</code> after it and a <code>Detail</code> line under the bar. <code>Indeterminate</code> swaps the fill for a sweep while the import connects, <code>IsError</code> with <code>ErrorMessage</code> turns it red, and an <code>OnCancel</code> delegate adds its Cancel button. <code>ChunkProgressBarControl</code> shows the same line count in segments over its <code>Min</code> to <code>Max</code> range, here 0 to 5,000; the small one is vertical, with five segments and <code>ShowValue</code> off. The import is simulated: a timer on the page adds lines every 250 ms.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl CssClass="btn-primary" OnClick="StartImport" Disabled="Running">Start import</ButtonControl>
                    <ButtonControl OnClick="FailImport" Disabled="@(_phase != ImportPhase.Importing)">Simulate a failure</ButtonControl>
                </div>
                <div class="progress-demo mt">
                    <ProgressBarControl Value="Percent" Title="Importing supplier rates" Status="@ImportStatus" Detail="@ImportDetail"
                                        Indeterminate="Connecting" IsError="@(_phase == ImportPhase.Failed)" ErrorMessage="@_error"
                                        OnCancel="CancelCallback" CancelText="Stop import" CancelDisabled="_cancelling" />
                    <div class="chunk-col">
                        <ChunkProgressBarControl Value="_linesDone" Max="TotalLines" ChunkCount="10" Indeterminate="Connecting"
                                                 AriaLabel="Supplier rate lines imported" />
                    </div>
                    <ChunkProgressBarControl Value="_linesDone" Max="TotalLines" ChunkCount="5" Indeterminate="Connecting" ShowValue="false"
                                             Orientation="FlexOrientation.Vertical" Style="height: 120px" AriaLabel="Supplier rate lines imported, vertical" />
                </div>
            </Demo>
        </DemoExample>
