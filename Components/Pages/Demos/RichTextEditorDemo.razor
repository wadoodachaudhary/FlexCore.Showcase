    P(""passport"", ""Please check that your passport is valid for the whole stay, and send us your flight numbers so that we can confirm the transfer.""),
    P(""signoff"", ""Kind regards,<br>The Razor Sharp Getaways team""),
};

private static readonly EditorDropDownControl.EditorDropDownOption[] Fonts = { new(""Georgia"", ""Georgia""), new(""Arial"", ""Arial""), new(""Verdana"", ""Verdana"") };
private static readonly EditorDropDownControl.EditorDropDownOption[] Sizes = { new(""14"", ""14""), new(""16"", ""16""), new(""18"", ""18""), new(""20"", ""20""), new(""24"", ""24"") };
private static readonly EditorDropDownControl.EditorDropDownOption[] Widths = { new(""Narrow"", ""Narrow""), new(""Normal"", ""Normal""), new(""Wide"", ""Wide""), new(""Full"", ""Full"") };
private static readonly EditorDropDownControl.EditorDropDownOption[] Lines = { new(""1.4"", ""1.4""), new(""1.6"", ""1.6""), new(""2"", ""2"") };

private Task Format(string command) => _editor!.ExecFormatCommandAsync(command);
private Task Heading(int px) => _editor!.ApplyHeadingStyleAsync(""Georgia"", px);
private Task Align(EditorAlignment alignment) => _editor!.SetBlockAlignmentAsync(alignment);
private Task Undo() => _editor!.UndoAsync();
private Task Redo() => _editor!.RedoAsync();
private Task FindReplace() => _editor!.OpenSearchAsync();

private async Task PickFont(string font)
{
    _font = font;
    await _editor!.ApplyInlineStyleAsync(""font-family"", font);
}

private async Task PickSize(string size)
{
    _size = int.Parse(size);
    await _editor!.ApplyInlineStyleAsync(""font-size"", size + ""px"");
}

private void PickWidth(string width) => _width = Enum.Parse<EditorPageWidth>(width);

private async Task PickLine(string line)
{
    _line = line;
    await _editor!.ApplyBlockStyleAsync(""line-height"", line);
}

private async Task StartOver()
{
    await _editor!.PushAsync();
    (_words, _blocks, _changes) = (Words(Letter), Letter.Length, 0);
}

private void LetterChanged(IReadOnlyList<EditorBlock> blocks)
{
    _words = Words(blocks);
    _blocks = blocks.Count;
    _changes++;
}

private static int Words(IEnumerable<EditorBlock> blocks) =>
    blocks.Sum(b => Regex.Count(WebUtility.HtmlDecode(Regex.Replace(b.Text, ""<[^>]+>"", "" "")), @""\S+""));";
