    private static class Code
    {
        public const string Modes = @"<ButtonGroupControl Items=""_modeItems"" Values=""@(new[] { _modeKey })"" ValuesChanged=""PickMode"" Selection=""ChoiceSelectionMode.Single"" AriaLabel=""Scroll or page"" />

<GridControl @key=""@_mountGen""
