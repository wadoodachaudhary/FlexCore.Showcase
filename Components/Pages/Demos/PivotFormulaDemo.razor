<PageTitle>Blazor Pivot Table (PivotGrid) — FlexCore</PageTitle>

<FeatureDemoLayout Title="Pivot tables" Category="Data Grid" CategoryHref="demo/grid" ControlName="PivotControl"
                   Tagline="Summarize rows into a cross-tab that users rearrange by dragging fields."
                   SourcePath="Grid/PivotControl.razor;Grid/PivotControl.razor.cs;Grid/PivotSortDescriptor.cs;Grid/GridEnums.cs;Grid/GridColumn.cs;Grid/GridControl.razor.cs">
    <Overview>
        <p>
            <code>PivotControl</code> is a Blazor pivot table that summarizes rows into a cross-tab, with a sum, average, count, minimum or maximum in each cell. Use it for questions such as how many airports each continent has, by type; with <code>Interactive</code> on, users drag fields between Filters, Rows, Columns and Values, as in an Excel PivotTable. Two row fields add subtotals, and <code>GridControl</code> opens the same view through <code>AllowPivoting</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="builder" Title="Interactive builder" RazorCode="@Code.Builder" CSharpCode="@Code.BuilderCs">
            <Description><p>Drag fields between Filters, Rows, Columns and Values, set each value chip's aggregation and format, and click headers (Shift-click for a second key) to sort 4,009 airports.</p></Description>
            <Demo>
                <PivotControl TValue="AirportFacts"
                              DataSource="@_facts"
                              RowFields="@_byContinent"
                              ColumnFields="@_byType"
                              ValueField="Airports"
                              ValueFormat="N0"
                              Interactive="true"
                              FieldLabels="@_labels"
                              Height="420px" />
            </Demo>
        </DemoExample>

        <DemoExample Id="grouped" Title="Grouped rows, subtotals and two measures" RazorCode="@Code.Grouped" CSharpCode="@Code.GroupedCs">
            <Description><p>Sort by airport count or longest runway with the buttons, which set <code>SortDescriptors</code>, and switch totals on and off; each continent closes with its own Total row.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="@(() => _sorts = [MostAirports])">Most airports first</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="@(() => _sorts = [LongestRunway])">Longest runway first</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="@(() => _sorts = [])">Clear sort</ButtonControl>
                <ToggleButtonControl Selected="@_grand" SelectedChanged="v => _grand = v">Grand totals</ToggleButtonControl>
                <ToggleButtonControl Selected="@_sub" SelectedChanged="v => _sub = v">Subtotals</ToggleButtonControl>
            </Controls>
            <Demo>
                <PivotControl TValue="Airport"
                              DataSource="@AirportData.Airports"
                              RowFields="@_byContinentAndCountry"
                              ColumnFields="@_byType"
                              ValueFields="@_measures"
                              SortDescriptors="@_sorts"
                              SortDescriptorsChanged="s => _sorts = s"
                              ShowGrandTotals="@_grand"
                              ShowSubTotals="@_sub"
                              Height="480px" />
                <p class="result">Sort: @SortText</p>
            </Demo>
        </DemoExample>

        <DemoExample Id="formulas" Title="Formula columns in a grid" RazorCode="@Code.Formulas" CSharpCode="@Code.FormulasCs">
            <Description><p>Elevation (m) is a column <code>Formula</code>, <code>[ElevationFt] * 0.3048</code>, worked out per row; Longest runway (km) holds cell values that start with <code>=</code>, evaluated because <code>AllowCellFormulas</code> is on.</p></Description>
            <Demo>
                <GridControl TValue="Hub" DataSource="@_hubs"
                             AllowCellFormulas="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowResizing="true"
                             Height="400px">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(Hub.Code)" HeaderText="Code" Width="80px" />
                        <GridColumn Field="@nameof(Hub.City)" HeaderText="City" Width="150px" />
                        <GridColumn Field="@nameof(Hub.Country)" HeaderText="Country" Width="160px" />
                        <GridColumn Field="@nameof(Hub.ElevationFt)" HeaderText="Elevation (ft)" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" Width="120px" />
                        <GridColumn Field="ElevationM" HeaderText="Elevation (m)" Formula="[ElevationFt] * 0.3048" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" Width="120px" />
                        <GridColumn Field="@nameof(Hub.LongestRunwayFt)" HeaderText="Longest runway (ft)" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" Width="160px" />
                        <GridColumn Field="@nameof(Hub.RunwayKmFormula)" HeaderText="Longest runway (km)" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" Width="160px" />
                    </GridColumnsBase>
                </GridControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-pivotcontrol-tvalue-parameters" Title="PivotControl&lt;TValue&gt; parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="PivotControl&lt;TValue&gt; parameters" Rows="Vocab.Params" />
            </DocSection>
            <DocSection Id="doc-pivotcontrol-events" Title="PivotControl events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="PivotControl events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-pivotcontrol-methods" Title="PivotControl methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="PivotControl methods" Rows="Vocab.Methods" />
                <p>
                <code>PivotSortDescriptor(string Field, SortDirection Direction)</code> is a record: <code>Field</code> is a row field, a column
                field or the generated name of a value column, which the control writes into each header's <code>data-sort-field</code> attribute.
                <code>AggregateType</code> is <code>Sum</code>, <code>Average</code>, <code>Count</code>, <code>Min</code> or <code>Max</code>.
                </p>
            </DocSection>
            <DocSection Id="doc-pivotvalueconfig" Title="PivotValueConfig" Count='@DocSection.Label(Vocab.Measure.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="PivotValueConfig" Rows="Vocab.Measure" />
            </DocSection>
            <DocSection Id="doc-formula-cells-on-gridcontrol" Title="Formula cells on GridControl" Count='@DocSection.Label(Vocab.Formula.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="Formula cells on GridControl" Rows="Vocab.Formula" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The pivot is an HTML <code>&lt;table&gt;</code>. Its column headers are <code>&lt;th&gt;</code> cells in a <code>&lt;thead&gt;</code> that span levels with <code>colspan</code> and <code>rowspan</code>.</li>
            <li>With <code>AllowSorting</code> on, each header holds a button titled "Sort <em>header</em>", and the header cell carries <code>aria-sort</code> while it is sorted. Row and column chips in the builder have sort buttons too, each titled "Sort <em>field</em>" and showing a symbol for the sort state.</li>
            <li>In the builder, each chip's remove button, the aggregation dropdown and the format box are native controls in the Tab order; the format box's title gives format examples.</li>
            <li>A field dropped on Filters adds a native <code>&lt;select&gt;</code> above the table, after the field name, listing (All) and each value of that field.</li>
            <li>Set <code>FieldLabels</code>, and <code>Label</code> on each <code>PivotValueConfig</code>, so chips, headers and filters show readable names instead of property names.</li>
            <li>With <code>Interactive</code> off, the layout comes from <code>RowFields</code>, <code>ColumnFields</code> and <code>ValueFields</code>, so buttons or selects beside the pivot can offer keyboard users other layouts.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/grid/grouping">Grouping &amp; totals</a>: the same aggregates as group captions and footers inside a grid.</li>
            <li><a href="demo/grid">Grid overview</a>: the grid that can switch into the embedded pivot view, opening on the same airports.</li>
            <li><a href="demo/charts/map-story#airports">Map story</a>: the airports counted per country on a heat map.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Builder: the airports cut down to the fields worth pivoting on.
    private static readonly List<AirportFacts> _facts = AirportData.Airports
        .Select(a => new AirportFacts(a.Continent, a.Type, RunwayClass(a.LongestRunwayFt), a.Latitude >= 0 ? "North" : "South",
            a.Runways, a.LongestRunwayFt, a.ElevationFt))
        .ToList();
    private readonly string[] _byContinent = ["Continent"];
    private readonly string[] _byType = ["Type"];
    private readonly Dictionary<string, string> _labels = new()
    {
        ["Runway"] = "Runway class",
        ["LongestRunwayFt"] = "Longest runway (ft)",
        ["ElevationFt"] = "Elevation (ft)"
    };

    // As text these sort longest first, with Unknown last.
    private static string RunwayClass(int? longestFt) => longestFt switch
    {
        null => "Unknown",
        >= 10_000 => "10,000 ft or more",
        >= 6_000 => "6,000 to 9,999 ft",
        _ => "Under 6,000 ft"
    };

    private sealed record AirportFacts(string Continent, string Type, string Runway, string Hemisphere,
        int Runways, int? LongestRunwayFt, int? ElevationFt)
    {
        public int Airports => 1;
    }

    // Grouped: Continent and Country on the full Airport records.
    private readonly string[] _byContinentAndCountry = ["Continent", "Country"];
    private readonly PivotValueConfig[] _measures =
    [
        new() { Field = "Code", Aggregation = AggregateType.Count, Format = "N0", Label = "Airports" },
        new() { Field = "LongestRunwayFt", Aggregation = AggregateType.Max, Format = "N0", Label = "Longest runway (ft)" }
    ];
    // A Total column's field name is "__Total_" + the measure's Field + "_" + its Aggregation.
    private bool _grand = true, _sub = true;
    private static readonly PivotSortDescriptor MostAirports = new("__Total_Code_Count", SortDirection.Descending);
    private static readonly PivotSortDescriptor LongestRunway = new("__Total_LongestRunwayFt_Max", SortDirection.Descending);
    private IReadOnlyList<PivotSortDescriptor> _sorts = [MostAirports];
    private string SortText => _sorts.Count == 0 ? "none." : string.Join(", ", _sorts.Select(s => $"{s.Field} {s.Direction}")) + ".";

    // Formulas: twelve airports from below sea level to La Paz.
    private static readonly string[] _hubCodes = ["AMS", "LHR", "LIS", "KEF", "DXB", "HND", "SYD", "DEN", "JNB", "MEX", "BOG", "LPB"];
    private readonly List<Hub> _hubs = _hubCodes
        .Select(code => AirportData.Airports.First(a => a.Code == code))
        .Select(a => new Hub(a.Code, a.City, a.Country, a.ElevationFt, a.LongestRunwayFt))
        .ToList();

    private sealed record Hub(string Code, string City, string Country, int? ElevationFt, int? LongestRunwayFt)
    {
        public string RunwayKmFormula => "=[LongestRunwayFt] * 0.0003048";
    }

