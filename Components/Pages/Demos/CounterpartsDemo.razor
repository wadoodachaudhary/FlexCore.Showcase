@page "/demo/counterparts"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Layout
@using Fx.ControlKit.AI
@using FlexCore.Showcase.Components.Shared
@* 2026-10-12: wrapped in FeatureDemoLayout as one example; the workbenches are unchanged and ?tab= still
   opens one. Phase 2 (SC-028..) splits them into pages; vocabulary pending until then (SC-264).
   2026-10-19: the Gantt tab moved to its own page, /demo/gantt (SC-030), the PDF tab to /demo/pdf-viewer (SC-029), the Forms tab to /demo/forms (SC-028) the Selection tab to /demo/pickers, the Charts tab to /demo/gauges and the Docking tab to /demo/dock-manager; the AI prompt is the last tab left. *@

<PageTitle>Control tour — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Control tour" Category="Components"
                   Tagline="One working slice left: the AI prompt.">
    <Overview>
        <p>
            One working screen is left here: the AI prompt control with a local stub provider. The <a href="demo/forms">forms</a>, the
            <a href="demo/pickers">pickers</a>, the <a href="demo/gauges">gauges and stock chart</a>, the <a href="demo/dock-manager">dock manager</a>,
            the <a href="demo/gantt">Gantt chart</a> and the <a href="demo/pdf-viewer">PDF viewer</a> already have pages of their own; this one will follow.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="tour" Title="Workbenches" RazorCode="@Code.Tour" CSharpCode="@Code.TourCs">
            <Description><p>Pick a tab. The status line under the toolbar reports what each control just did.</p></Description>
            <Demo>
<div class="counterparts-demo">
    <AppBarControl>
        <StartContent><SvgIconControl Name="sparkles" Size="24px" /><strong>Control tour</strong></StartContent>
        <ChildContent>Shared foundations, independent controls</ChildContent>
        <EndContent><FontIconControl Glyph="◆" Label="Component gallery" /></EndContent>
    </AppBarControl>
    <ToolbarControl ShowCaptionsToggle="false">
        @foreach(var name in _sections){<ToggleButtonControl Selected="@(_section==name)" OnClick="()=>_section=name">@name</ToggleButtonControl>}
    </ToolbarControl>
    <p role="status" id="demo-status">@_status</p>
    @switch(_section)
    {
        case "AI prompt":
            <p>This example uses a local demonstration provider. Applications connect their own provider through the Generate callback.</p>
            <AIPromptControl Prompt="Summarize the project schedule" Suggestions="@_suggestions" Commands="@_commands" Generate="DemoGenerateAsync" Apply="r=>_status=r.Output" />
            break;
    }
</div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending">Parameter tables arrive with the split into pages. Controls on this tour: <code>AIPromptControl</code>, plus <code>AppBarControl</code>, <code>ToolbarControl</code> and <code>GridLayoutControl</code> for the frame.</p>
    </Vocabulary>
</FeatureDemoLayout>

@code {
    private readonly string[] _sections=["AI prompt"];
    private string _section="AI prompt",_status="Ready.";
    // ?tab=ai-prompt opens that tab (2026-10-12, catalog deep links). Case and dashes ignored.
    [Parameter, SupplyParameterFromQuery(Name="tab")] public string? Tab {get;set;}
    protected override void OnParametersSet(){ if(!string.IsNullOrWhiteSpace(Tab)){ var hit=_sections.FirstOrDefault(n=>Norm(n)==Norm(Tab)); if(hit is not null)_section=hit; } }
    private static string Norm(string v)=>v.Replace(" ","").Replace("-","").ToLowerInvariant();
    private string[] _suggestions=["Summarize the project schedule","Draft a progress update"];
    private AIPromptCommand[] _commands=[new("shorten","Shorten","Use one sentence."),new("expand","Expand","Include supporting detail.")];
    private static async Task<string> DemoGenerateAsync(AIPromptRequest request,CancellationToken cancellation){await Task.Delay(750,cancellation);return $"Demo response: {request.Prompt}. {(request.Command?.Instruction??"Connect a provider to generate a live response.")}";}
    // Code tabs are verbatim copies of the Demo block and of this @code block (2026-10-13).
    private static class Code
    {
        public const string Tour = @"<div class=""counterparts-demo"">
    <AppBarControl>
        <StartContent><SvgIconControl Name=""sparkles"" Size=""24px"" /><strong>Control tour</strong></StartContent>
        <ChildContent>Shared foundations, independent controls</ChildContent>
        <EndContent><FontIconControl Glyph=""◆"" Label=""Component gallery"" /></EndContent>
    </AppBarControl>
    <ToolbarControl ShowCaptionsToggle=""false"">
        @foreach(var name in _sections){<ToggleButtonControl Selected=""@(_section==name)"" OnClick=""()=>_section=name"">@name</ToggleButtonControl>}
    </ToolbarControl>
    <p role=""status"" id=""demo-status"">@_status</p>
    @switch(_section)
    {
        case ""AI prompt"":
            <p>This example uses a local demonstration provider. Applications connect their own provider through the Generate callback.</p>
            <AIPromptControl Prompt=""Summarize the project schedule"" Suggestions=""@_suggestions"" Commands=""@_commands"" Generate=""DemoGenerateAsync"" Apply=""r=>_status=r.Output"" />
            break;
    }
</div>";
        public const string TourCs = @"private readonly string[] _sections=[""AI prompt""];

private string _section=""AI prompt"",_status=""Ready."";

// ?tab=ai-prompt opens that tab (2026-10-12, catalog deep links). Case and dashes ignored.
[Parameter, SupplyParameterFromQuery(Name=""tab"")] public string? Tab {get;set;}

protected override void OnParametersSet(){ if(!string.IsNullOrWhiteSpace(Tab)){ var hit=_sections.FirstOrDefault(n=>Norm(n)==Norm(Tab)); if(hit is not null)_section=hit; } }

private static string Norm(string v)=>v.Replace("" "","""").Replace(""-"","""").ToLowerInvariant();

private string[] _suggestions=[""Summarize the project schedule"",""Draft a progress update""];

private AIPromptCommand[] _commands=[new(""shorten"",""Shorten"",""Use one sentence.""),new(""expand"",""Expand"",""Include supporting detail."")];

private static async Task<string> DemoGenerateAsync(AIPromptRequest request,CancellationToken cancellation){await Task.Delay(750,cancellation);return $""Demo response: {request.Prompt}. {(request.Command?.Instruction??""Connect a provider to generate a live response."")}"";}";
    }
}
