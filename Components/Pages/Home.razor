@code {
    // The window hosts the Quick Start project's pages (quickstart/RazorSharpGetaways/Components/Getaways); this block keeps only the
    // site's own state: which page is open, the code tabs, and the handing over of a request to open.
    private string _page = "dashboard";
    private GetawaysPage CurrentPage => GetawaysPages.Find(_page);
    // Addresses in the wild still name the pages by their old keys
    private static readonly Dictionary<string, string> TabAliases = new() { ["grid"] = "requests", ["bookings"] = "itinerary", ["reports"] = "invoices" };

    /// <summary>App page named in the address, e.g. ?tab=itinerary; read on load, never written back.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        var tab = Tab?.Trim().ToLowerInvariant();
        if (tab is null) return;
        if (TabAliases.TryGetValue(tab, out var key)) tab = key;
        if (GetawaysPages.All.Any(p => p.Key == tab)) _page = tab;
    }

    // The Settings page raises Changed; the window repaints with the new scheme, text size and menu width
    protected override void OnInitialized() => Settings.Changed += StateHasChanged;
    public void Dispose() => Settings.Changed -= StateHasChanged;

    // The menu button shrinks the menu to icons on wide screens and opens it over the page on phones; CSS shows the one that applies
    private bool _navOpen;
    private void ToggleMenu()
    {
        Settings.SidebarIcons = !Settings.SidebarIcons;
        _navOpen = !_navOpen;
    }

    private void Go(string key)
    {
        _page = key;
        SetCodeTab(0);
        _navOpen = false;
    }

    private void ShowRequests(string view)
    {
        Settings.RequestsView = view;
        Settings.NotifyChanged();
        Go("requests");
    }

    // A request to open, or a new one to start, is handed to the Trip Requests page through its parameters and cleared after the
    // render that delivers it, so the next bell click or + press is a fresh change (the download does the same through the address)
    private int? _openRequestId;
    private bool _startNew;

    private void OpenRequest(TripRequest request)
    {
        _openRequestId = request.Id;
        Go("requests");
    }

    private void NewRequest()
    {
        _startNew = true;
        Go("requests");
    }

    private void ItineraryEntry()
    {
        Go("itinerary");
        Notifications.Info("New itinerary entry", "Double-click an empty slot on the itinerary to add an entry.");
    }

    // Example | Razor | C# over the app window (2026-10-29, Baaria): the open code tab carries an X that goes back to Example
    private int _codeTab;
    private readonly List<TabStripItem> _viewTabs = [new("Example", "bi bi-window"), new("Razor", "bi bi-code-slash"), new("C#", "bi bi-filetype-cs")];
    private void SetCodeTab(int index)
    {
        _codeTab = index;
        for (var i = 0; i < _viewTabs.Count; i++) _viewTabs[i].Closable = i > 0 && i == index;
    }
    private bool _copiedInstall = false;
    private bool _copiedCode = false;

    // Finish flag left of "Everything you need to cross the finish line": 5 columns of 4 chequered cells whose corners are nudged by
    // -1, 0 or +1 px so the drawing looks hand-made. Whole numbers only, so the points never depend on the server's culture.
    private const int FlagColumns = 5;
    private static readonly (int Col, string Points, bool Dark)[] _flagCells = BuildFlagCells();
    private ElementReference _workhorsesHead;

    private static (int Col, string Points, bool Dark)[] BuildFlagCells()
    {
        const int left = 44, top = 22, w = 22, h = 17;
        static int Nudge(int col, int row, int corner) => (col * 7 + row * 13 + corner * 5) % 3 - 1;
        var cells = new List<(int, string, bool)>();
        for (var col = 0; col < FlagColumns; col++)
            for (var row = 0; row < 4; row++)
            {
                int x = left + col * w, y = top + row * h;
                cells.Add((col,
                    $"{x + Nudge(col, row, 0)},{y + Nudge(col, row, 1)} {x + w + Nudge(col, row, 2)},{y + Nudge(col, row, 3)} " +
                    $"{x + w + Nudge(col, row, 4)},{y + h + Nudge(col, row, 5)} {x + Nudge(col, row, 6)},{y + h + Nudge(col, row, 7)}",
                    (col + row) % 2 == 0));
            }
        return cells.ToArray();
    }

    // The four doodle headings (flag, crane, scale, rocket) play each time they scroll into view.
    private ElementReference _pillarsHead;
    private ElementReference _compareHead;
    private ElementReference _ctaHead;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            foreach (var head in new[] { _workhorsesHead, _pillarsHead, _compareHead, _ctaHead })
                await JS.InvokeVoidAsync("fxToggleClassWhenVisible", head, "is-playing");
        }
        if (_openRequestId is not null || _startNew)
        {
            _openRequestId = null;
            _startNew = false;
            StateHasChanged();
        }
    }

    private async Task CopyInstallCommand()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", "dotnet add package FlexCore");
            _copiedInstall = true;
            Notifications.Info("Install command copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2000);
            _copiedInstall = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task CopyActiveCode()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", GetActiveCodeSnippet());
            _copiedCode = true;
            Notifications.Info("Code snippet copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2000);
            _copiedCode = false;
            StateHasChanged();
        }
        catch { }
    }

    // Each page's Razor and C# come from the Quick Start project's files as built (AppSource; FlexCore.Showcase.csproj embeds them),
    // so a tab always shows the page as it runs here and as it is in the download.
    private string GetActiveCodeSnippet() => (_page, _codeTab) switch
    {
        ("requests", 2) => AppSource.Code("GetawaysRequests.razor"),
        ("requests", _) => AppSource.Markup("GetawaysRequests.razor"),
        ("itinerary", 2) => AppSource.Code("GetawaysBookings.razor"),
        ("itinerary", _) => AppSource.Markup("GetawaysBookings.razor"),
        ("invoices", 2) => AppSource.Code("GetawaysInvoices.razor"),
        ("invoices", _) => AppSource.Markup("GetawaysInvoices.razor"),
        ("settings", 2) => AppSource.Code("GetawaysSettings.razor") + "\n\n" + AppSource.Region("GetawaysAppSettings.cs", "settings"),
        ("settings", _) => AppSource.Markup("GetawaysSettings.razor"),
        (_, 2) => AppSource.Code("GetawaysDashboard.razor"),
        _ => AppSource.Markup("GetawaysDashboard.razor"),
    };
}
