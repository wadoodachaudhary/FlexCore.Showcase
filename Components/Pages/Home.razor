    private static List<TripRequest> GenerateRequests(int count)
    {
        var destinations = new[]
        {
            "Lisbon", "Kyoto", "Reykjavik", "Cape Town", "Queenstown", "Marrakech",
            "Vancouver", "Santorini", "Banff", "Hoi An", "Patagonia", "Amalfi Coast"
        };

        var tripTypes = new (string Code, string Name, int Low, int High, string ItineraryA, string ItineraryB)[]
        {
            ("BEACH", "Beach & island resorts", 1800, 5200,
                "Seven nights in a sea-view room, two adults, late August",
                "Overwater bungalow for five nights with a snorkelling day trip"),
            ("CITY", "City breaks & culture", 600, 2400,
                "Long weekend with museum passes and a guided food tour",
                "Four nights near the old town with an opera ticket for two"),
            ("SKI", "Ski & snowboard", 2200, 6800,
                "Ski-in ski-out chalet for six, lessons for two beginners",
                "Week of lift passes with a half-day guided off-piste tour"),
            ("SAFARI", "Safari & wildlife", 5500, 14500,
                "Four nights on safari with a hot-air balloon flight at dawn",
                "Gorilla trekking permit for two with three nights at the lodge"),
            ("CRUISE", "Ocean & river cruises", 2800, 9800,
                "Ten-night river cruise, balcony cabin, all excursions included",
                "Fjords cruise for two with a glacier hike and the drinks package"),
            ("RAIL", "Scenic rail journeys", 1500, 5400,
                "First-class rail pass with two overnight sleeper legs",
                "Mountain railway loop with three nights in alpine villages"),
            ("FAMILY", "Family holidays", 2400, 7600,
                "Half-term beach week with a kids' club and a family suite",
                "Theme park passes for four with a connecting-rooms hotel"),
            ("HONEYMOON", "Honeymoons & celebrations", 4200, 12800,
                "Private villa with a sunset catamaran and a couples' spa day",
                "Two islands in ten nights, seaplane transfer, champagne on arrival")
        };

        var firstNames = new[] { "Clementine", "Barnaby", "Juniper", "Mortimer", "Petunia", "Thaddeus", "Winifred", "Archibald", "Lavender", "Ebenezer", "Delphine", "Rufus" };
        var lastNames = new[] { "Thistlewood", "Marmalade", "Gooseberry", "Snodgrass", "Bumblesby", "Applebottom", "Featherstone", "Higglebottom", "Pennywhistle", "Wobblesworth", "Peppercorn", "Puddleby" };
        var statuses = new[] { "New", "New", "Quoted", "Booked", "Declined" };
        var notes = new[]
        {
            "Flexible on dates by a few days", "Prefers a morning departure", "Repeat client, knows the agent",
            "Asked for a travel insurance quote", "Needs an accessible room", "Travelling with an infant"
        };

        var rnd = new Random(42);
        var list = new List<TripRequest>(count);
        var startDate = new DateTime(2026, 1, 1);

        for (int i = 1; i <= count; i++)
        {
            var agent = Agents[rnd.Next(Agents.Length)];
            var destination = destinations[rnd.Next(destinations.Length)];
            var type = tripTypes[rnd.Next(tripTypes.Length)];
            var quote = rnd.Next(type.Low / 10, type.High / 10) * 10m;
            var requested = startDate.AddMinutes(rnd.Next(0, 180 * 24 * 60));
            var travellers = type.Code switch { "FAMILY" => rnd.Next(3, 7), "HONEYMOON" => 2, _ => rnd.Next(1, 5) };

            // five weekly fare samples for the route; the last one is the quote
            var first = (int)(quote * (100 + rnd.Next(-12, 13)) / 100);
            var fares = new List<int> { first };
            for (int k = 1; k < 4; k++)
                fares.Add(first + (int)(((int)quote - first) * k / 4m) + rnd.Next(-150, 151));
            fares.Add((int)quote);
            int delta = (int)Math.Round((fares[4] - fares[0]) / (decimal)Math.Max(1, fares[0]) * 100);

            list.Add(new TripRequest
            {
                Id = i,
                Request = RequestKey(destination, i),
                Agent = agent.Name,
                AvatarInitials = agent.Initials,
                AvatarBg = agent.Color,
                DateRequested = requested,
                Destination = destination,
                Traveller = $"{firstNames[rnd.Next(firstNames.Length)]} {lastNames[rnd.Next(lastNames.Length)]}",
                Travellers = travellers,
                Departure = requested.Date.AddDays(rnd.Next(30, 200)),
                TripType = type.Code,
                TripTypeName = type.Name,
                Itinerary = rnd.Next(2) == 0 ? type.ItineraryA : type.ItineraryB,
                Notes = notes[rnd.Next(notes.Length)],
                Quote = quote,
                Status = statuses[rnd.Next(statuses.Length)],
                FareHistory = fares,
                FareDeltaPercent = delta
            });
        }

        return list;
    }

    protected override void OnInitialized()
    {
        _requests = GenerateRequests(1000);
        _selectedRequest = _requests.FirstOrDefault();

        _gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<TripRequest>>(this, e =>
        {
            _selectedRequest = e.Data;
            StateHasChanged();
        });

        // A typed quote becomes the route's latest fare sample, so the sparkline, its percentage and the totals follow it
        _gridEvents.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<TripRequest>>(this, e =>
        {
            if (e.ColumnName == nameof(TripRequest.Quote)) ApplyQuoteToFares(e.Data);
        });

        LoadCostPreview();

        _gridEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<TripRequest>>(this, e =>
        {
            if (e.Data != null)
            {
                _selectedRequest = e.Data;
                OpenPopupEdit(e.Data);
            }
        });
    }

    private IEnumerable<TripRequest> FilteredRequests
    {
        get
        {
            var list = _requests.AsEnumerable();

            if (_selectedTripType != "All")
                list = list.Where(r => r.TripType.Equals(_selectedTripType, StringComparison.OrdinalIgnoreCase));

            if (_selectedView != "All")
            {
                var status = _selectedView == "New requests" ? "New" : _selectedView;
                list = list.Where(r => r.Status == status);
            }

            if (!string.IsNullOrWhiteSpace(_gridSearchTerm))
            {
                var term = _gridSearchTerm.Trim();
                list = list.Where(r =>
                    r.Request.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.Agent.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.Traveller.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.Destination.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.Itinerary.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    r.TripType.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return list;
        }
    }

    private record SparklineCoord(string PolylinePoints, string AreaPoints, double LastX, double LastY);

    private SparklineCoord GetSparklinePoints(List<int> values, double width, double height)
    {
        if (values == null || values.Count < 2)
            return new SparklineCoord("0,11 68,11", "0,11 68,11 68,22 0,22", 68, 11);

        int min = values.Min();
        int max = values.Max();
        int range = Math.Max(1, max - min);
        double padY = 3.0;
        double usableHeight = height - (padY * 2);

        var coords = new List<(double X, double Y)>();
        for (int i = 0; i < values.Count; i++)
        {
            double x = (i / (double)(values.Count - 1)) * (width - 6) + 3;
            double norm = (values[i] - min) / (double)range;
            double y = (height - padY) - (norm * usableHeight);
            coords.Add((Math.Round(x, 1), Math.Round(y, 1)));
        }

        string polyline = string.Join(" ", coords.Select(c => $"{c.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{c.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
        string area = $"{polyline} {coords.Last().X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{height.ToString(System.Globalization.CultureInfo.InvariantCulture)} {coords.First().X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{height.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

        return new SparklineCoord(polyline, area, coords.Last().X, coords.Last().Y);
    }

