                <RibbonButton Text=""Italic"" Icon=""I"" CssClass=""@On(_italic)"" OnClick=""@(() => _italic = !_italic)"" />
                <RibbonButton Text=""Highlight"" Icon=""🖍️"" CssClass=""@On(_highlight)"" OnClick=""@(() => _highlight = !_highlight)"" />
            </RibbonGroup>
