@page "/demo/new-components"
@rendermode InteractiveServer
@using Fx.ControlKit
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: moved onto FeatureDemoLayout. The four Bootstrap cards became three examples; the existing
   demos were kept, a breadcrumb was added (the catalog listed one here), the split button moved to its own
   page, and copy that made library claims was replaced with neutral sample text. Vocabulary pending (SC-264). Code tabs added 2026-10-13.
   2026-10-24: Documentation written from BadgeControl.razor, BadgeModels.cs, AlertControl.razor, AlertModels.cs, SkeletonControl.razor,
   SkeletonModels.cs, TimelineControl.razor, TimelineItemControl.razor, TimelineModels.cs, BreadCrumbControl.razor, BreadCrumbItem.cs and
   FlexControlBase.cs, with the five .razor.css files for what each class does; rows checked with scratchpad/vocabcheck.py (enum members and
   the OnClose payload by grep). Two example facts are stated in the tables: the dot badge's Title is never read, and the Home crumb's empty
   Href renders as text (SC-264). 
   2026-10-24 (later): the dot badge lost a Title attribute the control never reads (no tooltip rendered), and the Home crumb got a real
   href (an empty one renders as text, not a link); the Overview no longer says the tables follow later. Tabs regenerated. *@

<PageTitle>UI elements — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="UI elements" Category="Components"
                   Tagline="The small parts: badges, alerts, skeletons, timeline and breadcrumb."
                   SourcePath="BadgeControl.razor;BadgeModels.cs;AlertControl.razor;AlertModels.cs;SkeletonControl.razor;SkeletonModels.cs;TimelineControl.razor;TimelineItemControl.razor;TimelineModels.cs;BreadCrumbControl.razor;BreadCrumbItem.cs;FlexControlBase.cs">
    <Overview>
        <p>
            Five small controls that have no page of their own yet, grouped by what they do: status and feedback, and content. Each is shown with the parameters it is usually given; the tables under Documentation list every parameter, with what it changes.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="status" Title="Badges, alerts and skeletons" RazorCode="@Code.Status">
            <Description><p><code>BadgeControl</code> takes a <code>Variant</code>, a <code>Size</code>, or <code>IsDot</code> for a status dot. <code>AlertControl</code> is an inline banner with a <code>Severity</code> and an optional close. <code>SkeletonControl</code> holds the place of loading content.</p></Description>
            <Demo>
                <div class="demo-row">
                    <BadgeControl Text="Primary" Variant="BadgeVariant.Primary" />
                    <BadgeControl Text="Success" Variant="BadgeVariant.Success" />
                    <BadgeControl Text="Danger" Variant="BadgeVariant.Danger" />
                    <BadgeControl Text="Warning" Variant="BadgeVariant.Warning" />
                    <BadgeControl Text="Info" Variant="BadgeVariant.Info" />
                    <BadgeControl Text="Dark" Variant="BadgeVariant.Dark" />
                    <BadgeControl Text="Small" Size="BadgeSize.Small" Variant="BadgeVariant.Secondary" />
                    <BadgeControl Text="Large" Size="BadgeSize.Large" Variant="BadgeVariant.Primary" />
                    <BadgeControl IsDot="true" Variant="BadgeVariant.Success" />
                </div>
                <div class="stack mt">
                    <AlertControl Severity="AlertSeverity.Success" Title="Import finished" Text="1,204 vendor rows loaded; 3 skipped as duplicates." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Warning" Title="Slow connection" Text="Round trips are taking about 200 ms." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Error" Title="Sync failed" Text="The upstream server did not answer." AllowClose="true" />
                    <AlertControl Severity="AlertSeverity.Info" Title="Scheduled maintenance" Text="Saturday 02:00 to 03:00 UTC." AllowClose="true" />
                </div>
                <div class="skeletons mt">
                    <SkeletonControl Variant="SkeletonVariant.Text" />
                    <SkeletonControl Variant="SkeletonVariant.Text" Animation="SkeletonAnimation.Wave" />
                    <div class="demo-row"><SkeletonControl Variant="SkeletonVariant.Circular" /><SkeletonControl Variant="SkeletonVariant.Text" Width="140px" /></div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="content" Title="Timeline and breadcrumb" RazorCode="@Code.Content" CSharpCode="@Code.ContentCs">
            <Description><p><code>TimelineControl</code> lists <code>TimelineItemControl</code>s, each with a title, a time and a coloured point. <code>BreadCrumbControl</code> takes a list of <code>BreadCrumbItem</code>s; the last one renders without a link.</p></Description>
            <Demo>
                <div class="two">
                    <TimelineControl>
                        <TimelineItemControl Title="Contract signed" Time="09:00" PointColor="BadgeVariant.Success">Initial phase authorised.</TimelineItemControl>
                        <TimelineItemControl Title="Materials dispatched" Time="13:30" PointColor="BadgeVariant.Primary">Lumber and concrete en route.</TimelineItemControl>
                        <TimelineItemControl Title="Quality inspection" Time="16:45" PointColor="BadgeVariant.Warning">Compliance check scheduled.</TimelineItemControl>
                    </TimelineControl>
                </div>
                <div class="demo-row mt">
                    <BreadCrumbControl Items="_crumbs" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            Read from the six component files and their stylesheets. <code>BadgeControl</code>, <code>AlertControl</code>, <code>SkeletonControl</code>,
            <code>TimelineControl</code> and <code>BreadCrumbControl</code> inherit <code>FlexControlBase</code>; its <code>CssClass</code>, <code>Style</code>
            and unmatched attributes land on each root element and are listed once, in the last table, together with the base parameters these controls
            never read. <code>TimelineItemControl</code> does not inherit it: it has no <code>CssClass</code> or <code>Style</code>, and an attribute it
            does not declare is a runtime error.
        </p>
        <ApiTable Kind="ApiKind.Parameters" Title="BadgeControl" Rows="Vocab.Badge" />
        <ApiTable Kind="ApiKind.Values" Title="BadgeVariant" Rows="Vocab.BadgeVariants" />
        <ApiTable Kind="ApiKind.Values" Title="BadgeSize" Rows="Vocab.BadgeSizes" />
        <ApiTable Kind="ApiKind.Parameters" Title="AlertControl" Rows="Vocab.Alert" />
        <ApiTable Kind="ApiKind.Events" Title="AlertControl events" Rows="Vocab.AlertEvents" />
        <ApiTable Kind="ApiKind.Values" Title="AlertSeverity" Rows="Vocab.AlertSeverities" />
        <ApiTable Kind="ApiKind.Parameters" Title="SkeletonControl" Rows="Vocab.Skeleton" />
        <ApiTable Kind="ApiKind.Values" Title="SkeletonVariant" Rows="Vocab.SkeletonVariants" />
        <ApiTable Kind="ApiKind.Values" Title="SkeletonAnimation" Rows="Vocab.SkeletonAnimations" />
        <ApiTable Kind="ApiKind.Parameters" Title="TimelineControl" Rows="Vocab.Timeline" />
        <ApiTable Kind="ApiKind.Values" Title="TimelineOrientation" Rows="Vocab.TimelineOrientations" />
        <ApiTable Kind="ApiKind.Values" Title="TimelinePosition" Rows="Vocab.TimelinePositions" />
        <ApiTable Kind="ApiKind.Parameters" Title="TimelineItemControl" Rows="Vocab.TimelineItem" />
        <ApiTable Kind="ApiKind.Parameters" Title="BreadCrumbControl" Rows="Vocab.BreadCrumb" />
        <ApiTable Kind="ApiKind.Properties" Title="BreadCrumbItem" Rows="Vocab.CrumbItem" />
        <p>
            <code>BreadCrumbItem</code> has a parameterless constructor and <code>BreadCrumbItem(string text, string? href = null, string? iconCss = null)</code>.
            The example passes an empty string as the Home crumb's <code>Href</code>, which the control treats like no <code>Href</code>: Home renders as
            text, not as a link.
        </p>
        <ApiTable Kind="ApiKind.Parameters" Title="Inherited from FlexControlBase" Rows="Vocab.FlexBase" />
    </Vocabulary>

    <Related>
        <ul>
            <li>Buttons of every kind: <a href="demo/buttons">Buttons</a>, <a href="demo/split-button">Split button</a>, <a href="demo/toggle-buttons">Toggle buttons</a>.</li>
            <li>Messages that pop up rather than sit in the page: <a href="demo/notifications">Toasts</a> and <a href="demo/dialog">Dialogs</a>.</li>
            <li>Moved to their own pages: <a href="demo/cards">Cards</a>, <a href="demo/checks">Checks &amp; switches</a>, <a href="demo/sliders">Sliders</a>, <a href="demo/security-code">Security code</a>, <a href="demo/date-time">Date &amp; time</a>, <a href="demo/tabs-accordion">Tabs &amp; accordion</a>, <a href="demo/barcodes">Barcodes &amp; QR</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

