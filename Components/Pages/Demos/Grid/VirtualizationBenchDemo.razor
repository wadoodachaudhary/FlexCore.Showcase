@using FlexCore.Showcase.Components.Shared
@* Retitled 2026-10-06 to match the site nav. The second route is the retired optimizer page's address.
   2026-10-20: rebuilt on FeatureDemoLayout (developer meeting, point 2; the old file is docs/retired-pages/VirtualizationBenchDemo.razor.txt).
   Gone: a constant "1.2 ms", a render counter incremented by hand, "60 FPS", "near-zero memory", "zero external JavaScript",
   a dropdown editor that did not exist, a Pivot mode (Pivot tables has its own page) and a documentation table with the wrong
   defaults. Now: one example with a three-way switch (scroll, 25 per page, 100 per page), the same two timings as 50k rows,
   the edit count from OnCellSave and the page from PageChanged. Facts checked against GridControl.razor.cs (PageSize, PageSizes,
   AllowPaging, BatchEditBehavior, GoToPageAsync), GridControl.PresentationFeatures.cs (PagerPosition), GridControlEvents.cs and
   GridModels.cs (PageChangeEventArgs). *@

<PageTitle>Scroll vs paging — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Scroll vs paging" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="The same thousand rows scrolled through a row window or paged: what each costs on the server, measured here."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridControl.PresentationFeatures.cs;Grid/GridControlEvents.cs">
    <Overview>
        <p>
            Without paging the grid scrolls: it renders the rows in view plus an overscan band and lets spacer rows stand in for the rest,
            so a thousand rows or fifty thousand cost about the same per frame (the window parameters are on
            <a href="demo/grid/row-selection-50k">50k rows</a>). With <code>AllowPaging</code> it renders one page of <code>PageSize</code>
            rows and a pager, placed by <code>PagerPosition</code>, that also offers the <code>PageSizes</code>. Sorting, filtering, grouping,
            the search box and batch editing work the same way in both.
        </p>
        <p>
            Two timings are taken here, both on the server with <code>Stopwatch</code>: building the thousand rows in C#, and the first render
            after a switch, from the click to the component's next <code>OnAfterRender</code>. The line under the grid keeps the latest value
            for each mode so they can be compared. Browser layout and paint are not included, so the wait you see is a little longer.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="modes" Title="One grid, three ways to show a thousand rows" RazorCode="@Code.Modes" CSharpCode="@Code.ModesCs">
            <Description><p>Switch between scrolling, 25 per page and 100 per page; each switch remounts the grid and records its first render time. Sort, filter, group by Category or type in the search box in any mode. Select several rows with Ctrl or Shift and edit one Quantity: the grid's default <code>MultiRow</code> batch behaviour writes the value to every selected row, and the count of saved cells comes from <code>OnCellSave</code>. In a paged mode the current page comes from <code>PageChanged</code>.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_modeItems" Values="@(new[] { _modeKey })" ValuesChanged="PickMode" Selection="ChoiceSelectionMode.Single" AriaLabel="Scroll or page" />
            </Controls>
            <Demo>
                <GridControl @key="@_mountGen"
                             TValue="VRow"
                             DataSource="@_rows"
                             Height="460px"
                             AllowPaging="@_paging"
                             PageSize="@_pageSize"
                             PageSizes="@(new[] { 25, 100 })"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowGrouping="true"
                             AllowResizing="true"
                             AllowColumnReorder="true"
                             ShowSearchBar="true"
                             EnableTypeSearch="true"
                             ShowRowSelectionEditColumnCue="true"
                             ShowRowCountInFooter="true"
                             SelectionSettingsRef="@_selection"
                             EditSettingsRef="@_edit"
                             EventsRef="@_events">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(VRow.Code)" HeaderText="Code" Width="95px" AllowEditing="false" />
                        <GridColumn Field="@nameof(VRow.Description)" HeaderText="Description" Width="260px" />
                        <GridColumn Field="@nameof(VRow.Category)" HeaderText="Category" Width="140px" />
                        <GridColumn Field="@nameof(VRow.Qty)" HeaderText="Quantity" Width="95px" Type="ColumnType.Number" TextAlign="TextAlign.Right" SelectAllOnEdit="true" />
                        <GridColumn Field="@nameof(VRow.Price)" HeaderText="Unit Price" Width="110px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" SelectAllOnEdit="true" />
                        <GridColumn Field="@nameof(VRow.Total)" HeaderText="Total Cost" Width="120px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" AllowEditing="false" />
                        <GridColumn Field="@nameof(VRow.InStock)" HeaderText="In Stock" Width="85px" Type="ColumnType.Boolean" TextAlign="TextAlign.Center" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@Summary</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="GridControl parameters used here" Rows="Vocab.Grid" />
        <ApiTable Kind="ApiKind.Events" Title="GridControlEvents used here" Rows="Vocab.Events" />
        <ApiTable Kind="ApiKind.Methods" Title="Paging method" Rows="Vocab.Methods" />
        <p>
            The row window's own parameters (<code>WindowOverscanRows</code>, <code>WindowOverscanCellBudget</code>,
            <code>EnableGroupedRowWindowing</code>) are documented on <a href="demo/grid/row-selection-50k">50k rows</a>; selection and
            editing options on <a href="demo/grid/batch-editing">Batch editing</a>.
        </p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/row-selection-50k">50k rows</a>: the same window at fifty times the size, with the overscan switch.</li>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the editing side of <code>EditSettings</code>.</li>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class VRow
    {
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public decimal Total => Qty * Price;
        public bool InStock { get; set; }
    }

    private readonly SelectionItem[] _modeItems = { new("scroll", "Scroll"), new("page25", "25 per page"), new("page100", "100 per page") };
    private List<VRow> _rows = [];
    private string _modeKey = "scroll";
    private bool _paging;
    private int _pageSize = 25;
    private int _mountGen;                       // @key: every switch remounts the grid, so each timing starts from an empty grid

    private readonly SelectionSettings _selection = new() { Type = SelectionType.Multiple, Mode = SelectionMode.Row };
    private readonly EditSettings _edit = new() { AllowEditing = true, Mode = EditMode.Batch };
    private readonly GridControlEvents<VRow> _events = new();

    // Timings: build is the C# loop; render is from the switch to the component's next OnAfterRender, i.e. the server side of
    // the first render after the swap, kept per mode. Browser layout and paint are not included.
    private readonly Stopwatch _swap = new();
    private bool _swapPending;
    private double _buildMs;
    private readonly Dictionary<string, double> _renderMs = new();
    private int _editCount, _page;

    private string Summary
    {
        get
        {
            string Ms(string key) => _renderMs.TryGetValue(key, out var ms) ? $"{ms:0} ms" : "not yet";
            var page = _paging && _page > 0 ? $" Page {_page}." : "";
            return $"{_rows.Count:N0} rows built in {_buildMs:0.0} ms. First render after the switch, on the server: "
                 + $"scroll {Ms("scroll")} · 25 per page {Ms("page25")} · 100 per page {Ms("page100")}. "
                 + $"{_editCount} cell{(_editCount == 1 ? "" : "s")} saved.{page}";
        }
    }

    protected override void OnInitialized()
    {
        _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<VRow>>(this, _ => { _editCount++; StateHasChanged(); });
        _events.PageChanged = EventCallback.Factory.Create<PageChangeEventArgs>(this, e => { _page = e.CurrentPage; StateHasChanged(); });

        var sw = Stopwatch.StartNew();
        var categories = new[] { "Structural", "Mechanical", "Electrical", "Finishing", "Plumbing", "Masonry" };
        var rand = new Random(101);
        var list = new List<VRow>(1000);
        for (var i = 1; i <= 1000; i++)
        {
            var cat = categories[i % categories.Length];
            list.Add(new VRow
            {
                Code = $"V-{i:D4}", Description = $"{cat} Material Component #{i}", Category = cat,
                Qty = rand.Next(1, 150), Price = Math.Round((decimal)(rand.NextDouble() * 320 + 8.5), 2), InStock = i % 3 != 0,
            });
        }
        _rows = list;
        _buildMs = sw.Elapsed.TotalMilliseconds;
        Remount();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_swapPending) return;
        _swapPending = false;
        _renderMs[_modeKey] = _swap.Elapsed.TotalMilliseconds;
        _ = InvokeAsync(StateHasChanged);   // show the number; this render has no pending swap, so it ends here
    }

    private void PickMode(IReadOnlyList<string> values)
    {
        if (values.Count == 0 || values[0] == _modeKey) return;
        _modeKey = values[0];
        _paging = _modeKey != "scroll";
        _pageSize = _modeKey == "page100" ? 100 : 25;
        _page = 0;
        Remount();
    }

    private void Remount()
    {
        _mountGen++;
        _swap.Restart();
        _swapPending = true;
    }

