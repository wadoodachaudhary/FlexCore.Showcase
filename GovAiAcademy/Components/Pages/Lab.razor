@page "/learn/{CourseId}"
@inject AcademyStore Store
@inject AcademyAuthState Auth
@inject NotificationService Notifications

<PageTitle>Lab — Gov AI Academy</PageTitle>

@if (_course is null)
{
    <h1>Lab not found</h1>
    <p><a href="catalog">Back to courses</a></p>
}
else if (!Auth.IsSignedIn || Auth.Current is null)
{
    <h1>@_course.Title</h1>
    <AlertControl Severity="AlertSeverity.Info" Title="Sign in to use the lab">
        The lab saves notes and exercise checks on the sample account you choose.
    </AlertControl>
    <p><a class="text-link" href="signin">Sign in</a></p>
}
else if (_progress is null)
{
    <BreadCrumbControl Items="_crumbs" />
    <h1>@_course.Title</h1>
    <AlertControl Severity="AlertSeverity.Warning" Title="You need a seat first">
        Request a seat on the course page. Labs are for people in a class group.
    </AlertControl>
    <p><a class="text-link" href="@($"courses/{_course.Id}")">Course details</a></p>
}
else
{
    <BreadCrumbControl Items="_crumbs" />
    <h1>Lab: @_course.Title</h1>
    <p class="lede">@_progress.PlainSummary</p>
    <ProgressBarControl Value="@_progress.Percent" Title="Completion" Status="@(_progress.Complete ? "Complete" : "Not complete yet")" />

    <AlertControl Severity="AlertSeverity.Warning" Title="Keep sensitive information out">
        Use the fictional packet or a redacted sample your instructor cleared. Do not paste personal data, non-public procurement files, or live operational logs.
    </AlertControl>

    <div class="lab-layout">
        <div class="stack">
            <h2>Work packet</h2>
            <div class="note-box">
                <p>@_course.LabPacket</p>
                <p><strong>Your tools.</strong> @_course.ToolsContext</p>
            </div>
            <h2>Your rewrite</h2>
            <p>Write in your own words. The editor is for the exercise, not a connection to an outside model.</p>
            <EditorControl @ref="_editor"
                           Blocks="_blocks"
                           ShowToolbar="true"
                           EnableHistory="true"
                           AriaLabel="Your rewritten work" />
            <div class="button-row">
                <ButtonControl CssClass="btn-primary" OnClick="SaveNotes">Save my rewrite</ButtonControl>
                <a href="@($"courses/{_course.Id}")">Back to the course</a>
            </div>
        </div>
        <div class="stack">
            <h2>Exercise checklist</h2>
            @foreach (var exercise in _course.Exercises)
            {
                var id = exercise.Id;
                <div class="note-box">
                    <CheckBoxControl Checked="@Store.IsExerciseComplete(Auth.Current.Id, id)"
                                     CheckedChanged="@(done => Toggle(id, done))"
                                     Label="@exercise.Title" />
                    <p>@exercise.Brief</p>
                </div>
            }
            <h2>Meetings</h2>
            <ul class="fact-list">
                @foreach (var row in _meetings)
                {
                    <li>@row.SessionDate.ToString("MMMM d") — @row.SessionTitle: @row.Status</li>
                }
            </ul>
        </div>
    </div>
}

@code {
    [Parameter] public string CourseId { get; set; } = "";

    private Course? _course;
    private LearnerCourseProgress? _progress;
    private List<RosterRow> _meetings = [];
    private IList<BreadCrumbItem> _crumbs = [];
    private List<EditorBlock> _blocks = [];
    private EditorControl? _editor;

    protected override void OnParametersSet()
    {
        _course = Store.FindCourse(CourseId);
        _crumbs =
        [
            new("Home", "/"),
            new("My learning", "/learn"),
            new(_course?.Title ?? "Lab")
        ];
        if (_course is null || Auth.Current is null)
            return;

        _progress = Store.Progress(Auth.Current.Id, _course.Id);
        _meetings = Store.AttendanceFor(Auth.Current.Id)
            .Where(r => r.CourseId == _course.Id)
            .ToList();
        var saved = Store.NotesFor(Auth.Current.Id, _course.Id);
        var body = string.IsNullOrWhiteSpace(saved)
            ? "Write the version you would actually send. Note what you refused to take from a draft."
            : saved;
        _blocks =
        [
            new EditorBlock("lab-heading", EditorBlockKind.SectionHeading, "Your rewrite"),
            new EditorBlock("lab-body", EditorBlockKind.Paragraph, body)
        ];
    }

    private async Task SaveNotes()
    {
        if (_editor is null || Auth.Current is null || _course is null)
            return;
        var blocks = await _editor.ReadBlocksAsync();
        _blocks = blocks.ToList();
        var text = string.Join("\n\n", blocks.Select(b => b.Text).Where(t => !string.IsNullOrWhiteSpace(t)));
        Store.SaveNotes(Auth.Current.Id, _course.Id, text);
        Notifications.Success("Rewrite saved on this sample account. It stays in memory until the app restarts.");
    }

    private void Toggle(string exerciseId, bool done)
    {
        if (Auth.Current is null || _course is null)
            return;
        Store.SetExerciseComplete(Auth.Current.Id, exerciseId, done);
        _progress = Store.Progress(Auth.Current.Id, _course.Id);
    }
}
