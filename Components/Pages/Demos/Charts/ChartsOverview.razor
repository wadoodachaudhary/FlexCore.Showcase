@code {
    /// <summary>Tab named in the address, e.g. demo/charts?tab=sparkline; read when the page loads, never written back.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private int _tab;
    private static readonly string[] TabSlugs =
        ["comparison", "trend", "part-to-whole", "distribution", "correlation", "multivariate", "kpi", "statistical", "heatmap", "sparkline"];

    protected override void OnParametersSet()
    {
        var i = Array.IndexOf(TabSlugs, Tab?.Trim().ToLowerInvariant());
        if (i >= 0) _tab = i;
    }


    // Combo: the first series draws as bars, the second as a line
    List<ChartSeries> _comboSeries = new()
    {
        new() { Name = "Rooms sold", DataPoints = new() { new("Jan", 310), new("Feb", 290), new("Mar", 350), new("Apr", 420), new("May", 480), new("Jun", 560) } },
        new() { Name = "Average rate", DataPoints = new() { new("Jan", 95), new("Feb", 92), new("Mar", 110), new("Apr", 128), new("May", 140), new("Jun", 165) } }
    };
    // Range points carry the minimum in Value and the maximum in Value2 (ChartDataPoint.Range)
    ChartSeries _transferRanges = new() { Name = "Minutes", DataPoints = new() {
        ChartDataPoint.Range("Harbour", 15, 25), ChartDataPoint.Range("Hilltop", 30, 55), ChartDataPoint.Range("Old Town", 20, 40),
        ChartDataPoint.Range("Beach", 45, 70), ChartDataPoint.Range("Airport", 5, 10) } };
    ChartSeries _heaterSeries = new() { Name = "Setting", DataPoints = new() {
        new("06:00", 24), new("08:00", 26), new("10:00", 28), new("12:00", 29), new("14:00", 29), new("16:00", 28), new("18:00", 27), new("20:00", 25), new("22:00", 23) } };
    List<ChartSeries> _deskSeries = new()
    {
        new() { Name = "Boston", DataPoints = new() { new("W1", 42), new("W2", 48), new("W3", 51), new("W4", 47), new("W5", 58), new("W6", 63) } },
        new() { Name = "Lisbon", DataPoints = new() { new("W1", 30), new("W2", 34), new("W3", 39), new("W4", 45), new("W5", 44), new("W6", 52) } },
        new() { Name = "Kyoto", DataPoints = new() { new("W1", 18), new("W2", 22), new("W3", 25), new("W4", 31), new("W5", 36), new("W6", 35) } }
    };
    ChartSeries _lisbonRanges = new() { Name = "°C", DataPoints = new() {
        ChartDataPoint.Range("Jan", 8, 15), ChartDataPoint.Range("Mar", 10, 18), ChartDataPoint.Range("May", 14, 23),
        ChartDataPoint.Range("Jul", 18, 29), ChartDataPoint.Range("Sep", 17, 27), ChartDataPoint.Range("Nov", 11, 18) } };
    // HighLow draws Value2 (high) to Value3 (low) of a Financial point; open and close are not drawn
    ChartSeries _kyotoWeek = new() { Name = "°C", DataPoints = new() {
        ChartDataPoint.Financial("Mon", 19, 24, 16, 20), ChartDataPoint.Financial("Tue", 20, 26, 17, 22), ChartDataPoint.Financial("Wed", 21, 27, 18, 23),
