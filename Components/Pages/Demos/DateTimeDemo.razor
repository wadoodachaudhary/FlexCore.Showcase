@code {
    // Appointment
    private DateTime? _date = DateTime.Today.AddDays(1);
    private TimeOnly? _time = new(9, 30);
    private TimeSpan? _duration = TimeSpan.FromMinutes(90);
    private string Appointment => _date is { } d && _time is { } t
        ? $"{d:ddd d MMM yyyy}, {t:h:mm tt} – {t.Add(_duration ?? TimeSpan.Zero):h:mm tt}"
        : "Pick a date and a start time.";

    // Date range
    private CalendarRange _trip = new(DateTime.Today.AddDays(7), DateTime.Today.AddDays(10));
    private string TripDates => _trip is { Start: { } s, End: { } e } && e >= s
        ? $"{(e - s).Days} night{((e - s).Days == 1 ? "" : "s")}, {s:ddd d MMM} to {e:ddd d MMM}"
        : "Pick a start and an end date.";

    // Calendar
    private IReadOnlyList<DateTime> _departures = Weekdays(DateTime.Today.AddDays(1), 5).Where((_, i) => i % 2 == 0).ToArray();
    private static bool Weekend(DateTime d) => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
    private static List<DateTime> Weekdays(DateTime from, int count)
    {
        var list = new List<DateTime>();
        for (var d = from.Date; list.Count < count; d = d.AddDays(1))
            if (!Weekend(d)) list.Add(d);
        return list;
    }
    private string Departures => _departures.Count == 0
        ? "No departures picked."
        : $"{_departures.Count} departure{(_departures.Count == 1 ? "" : "s")}: {string.Join(", ", _departures.OrderBy(d => d).Select(d => d.ToString("ddd d MMM")))}";

