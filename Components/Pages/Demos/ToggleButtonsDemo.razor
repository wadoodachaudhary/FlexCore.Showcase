                <ApiTable Kind="ApiKind.Parameters" Title="ButtonGroupControl parameters" Rows="Vocab.Group" />
            </DocSection>
            <DocSection Id="doc-segmentedcontrol-parameters" Title="SegmentedControl parameters" Count='@DocSection.Label(Vocab.Segmented.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="SegmentedControl parameters" Rows="Vocab.Segmented" />
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
