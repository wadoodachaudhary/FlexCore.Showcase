// Every view is re-read from the same frame, so filter and sort reach all three at once.
private void Refresh()
{
    _rows = _frame.ToGridRows().ToList();
    _series = _frame.ToChartSeries(""Order"", ""Amount"");
    _csv = _frame.ToCsv();
}";
    }
