        public const string OrdersCs = @"private GridControl<ProviderOrder>? _grid;

private readonly List<ProviderOrder> _orders = BuildOrders();

private readonly List<string> _groups =
[
    nameof(ProviderOrder.Region),
    nameof(ProviderOrder.Category)
];

private GridProviderExportProgress? _exportProgress;

private int _requestCount;

private string _lastRequest = ""Waiting for the first request…"";

private readonly List<AggregateRow> _aggregates =
[
    new AggregateRow
    {
        ShowInGroupCaption = true,
        ShowInFooter = true,
