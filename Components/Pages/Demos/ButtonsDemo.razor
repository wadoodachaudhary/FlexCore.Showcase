            new("ButtonType", "Native <code>type</code>: button, submit or reset.", "string", "\"button\""),
            new("Title", "Native tooltip. Required on icon-only buttons.", "string?", "null"),
            new("Style", "Inline style. Useful for per-button CSS variables.", "string?", "null"),
            new("TabIndex", "Native <code>tabindex</code>.", "int?", "null"),
