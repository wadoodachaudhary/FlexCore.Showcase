@page "/demo/reports/model-costs"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Reports
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Components.Shared
@inject IWebHostEnvironment Env

@* 2026-10-18: moved onto FeatureDemoLayout (Saturday list). Same report, same auto-run on first paint. Changes, closing SC-220 to
   SC-223 and SC-225: the copy says four group levels (the XML defines Community, Model, Group and Phase; the old intro said four
   and the bullet list said three); "HomeFront's real Crystal Report", "@DivisionID" and the stub class names left the copy, which
   now says what the control does before how this page wires it; the logger and its typo went; title, h1 and menu label all read
   "Report writer". The model and community pickers are DropDownListControls and Run is a ButtonControl; the inline <style> block
   became a scoped stylesheet.
   2026-10-18: vocabulary written from ReportWriterControl.razor (the six parameters, public state, the public methods and their doc
   comments, the @inject list, the toolbar export items), ReportNativeExport.cs, ReportOptions.cs and the five host interfaces; rows
   checked with scratchpad/vocabcheck.py. ShowReportAsync seeds a literal "DivisionID" from the session context (lines ~1317 and ~1549),
   a host name inside the library; noted in SC-253. *@

<PageTitle>Report writer — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Report writer" Category="Reports" CategoryHref="demo/reports/model-costs" ControlName="ReportWriterControl"
                   Tagline="Paginated, grouped reports from a Crystal-style XML definition, with a group tree, search, print and export."
                   SourcePath="Reports/ReportWriterControl.razor;Reports/CrystalXmlReportLoader.cs;Reports/ReportOptions.cs;Reports/IReportDataExecutor.cs;Reports/IReportSessionContext.cs;Reports/IReportPickListProvider.cs;Reports/IReportExporter.cs;Reports/IReportViewerSettings.cs">
    <Overview>
        <p>
            <code>ReportWriterControl</code> renders a <code>ReportDefinition</code> as paginated HTML pages with Crystal-style group headers
            and footers, a clickable group tree and drill-down tabs. The definition is built in code or loaded from a Crystal XML export by
            <code>CrystalXmlReportLoader</code>, which reads the tables, joins, groups, formulas and field placement. The control has no data
            access of its own: the host registers <code>IReportDataExecutor</code>, <code>IReportSessionContext</code> and
            <code>IReportPickListProvider</code> in dependency injection, and optionally an <code>IReportExporter</code>. The toolbar prints,
            exports, searches the report text and zooms the pages.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="report" Title="Model costs by community, model, group and phase" RazorCode="@Code.Report" CSharpCode="@Code.ReportCs">
            <Description><p>The bundled XML defines four group levels, each with a sum in its footer. Pick a model and a community and press Run; the report loads on arrival too. This site's data executor ignores the SQL in the definition and synthesises rows from the demo data, so every choice returns a report. Open the group tree on the left to jump between groups, or search the report text from the toolbar.</p></Description>
            <Controls>
                <DropDownListControl TItem="string" TValue="string" DataSource="@_models" @bind-Value="_model" AriaLabel="Model" Width="160px" />
                <DropDownListControl TItem="string" TValue="string" DataSource="@_communities" @bind-Value="_community" AriaLabel="Community" Width="200px" />
                <ButtonControl CssClass="btn-sm" OnClick="RunReport" Disabled="@_running">@(_running ? "Running…" : "Run")</ButtonControl>
            </Controls>
            <Demo>
                <div class="report-frame">
                    <ReportWriterControl @ref="_writer" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="ReportWriterControl parameters" Rows="Vocab.Params" />
        <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
        <ApiTable Kind="ApiKind.Properties" Title="State" Rows="Vocab.State" />
        <ApiTable Kind="ApiKind.Properties" Title="Host services, resolved from dependency injection" Rows="Vocab.Services" />
        <p>
            The toolbar's Print / Save as PDF uses the browser's print dialog, and its HTML, CSV and Excel data exports are the control's own
            (<code>ReportNativeExport</code>), so none of them need <code>IReportExporter</code>. This site registers
            <code>ReportOptions</code> with an empty schema prefix and DivisionID and UserId as session parameters, its own data executor and
            session context, the empty pick-list provider, the in-memory viewer settings and a no-op exporter.
        </p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/counterparts?tab=pdf">Control tour</a>: <code>PdfViewerControl</code> for finished PDFs.</li>
            <li><a href="demo/grid/enterprise-suite">Export &amp; templates</a>: the grid's own CSV and Excel export.</li>
            <li><a href="demo/grid/grouping">Grouping &amp; totals</a>: group sums in a grid instead of a report.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private ReportWriterControl? _writer;
    private readonly string[] _models = DemoData.HouseModels.Select(m => m.Name).ToArray();
    private readonly string[] _communities = { "Showcase Estates", "Riverbend Hills", "Northbrook Crossing" };
    private string _model = DemoData.HouseModels[0].Name;
    private string _community = "Showcase Estates";
    private bool _running;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Run on first paint so visitors land on a populated report.
            await RunReport();
        }
    }

    private async Task RunReport()
    {
        if (_writer is null) return;
        _running = true;
        StateHasChanged();
        try
        {
            var path = Path.Combine(Env.WebRootPath, "reports", "Model Costs v1.xml");
            await _writer.ShowXmlReport(path, new Dictionary<string, object>
            {
                ["Model"] = _model,
                ["Community"] = _community,
            });
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed). The data executor this site
    // registers is Services/ShowcaseReportDataExecutor.cs; Program.cs shows the registrations.
    private static class Code
    {
        public const string Report = @"<div class=""report-frame"">
    <ReportWriterControl @ref=""_writer"" />
</div>";
        public const string ReportCs = @"private ReportWriterControl? _writer;

private readonly string[] _models = DemoData.HouseModels.Select(m => m.Name).ToArray();

private readonly string[] _communities = { ""Showcase Estates"", ""Riverbend Hills"", ""Northbrook Crossing"" };

private string _model = DemoData.HouseModels[0].Name;

private string _community = ""Showcase Estates"";

private bool _running;

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        // Run on first paint so visitors land on a populated report.
        await RunReport();
    }
}

private async Task RunReport()
{
    if (_writer is null) return;
    _running = true;
    StateHasChanged();
    try
    {
        var path = Path.Combine(Env.WebRootPath, ""reports"", ""Model Costs v1.xml"");
        await _writer.ShowXmlReport(path, new Dictionary<string, object>
        {
            [""Model""] = _model,
            [""Community""] = _community,
        });
    }
    finally
    {
        _running = false;
        StateHasChanged();
    }
}";
    }

