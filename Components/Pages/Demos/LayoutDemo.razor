        new Item(""AMF-0002 Brennan"", ""9 lines · Booked · $6,240"", new[] { (""Traveller"", ""Liam Brennan""), (""Status"", ""Booked""), (""Lines"", ""9""), (""Total"", ""$6,240"") }),
