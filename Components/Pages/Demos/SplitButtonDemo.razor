@page "/demo/split-button"
@using FlexCore.Showcase.Components.Shared



<PageTitle>Blazor Split Button — FlexCore</PageTitle>

<FeatureDemoLayout Title="Split button" Category="Components" ControlName="SplitButtonControl"
                   Tagline="One click for the usual action, the caret for its alternatives."
                   SourcePath="SplitButtonControl.razor">
    <Overview>
        <p>
            <code>SplitButtonControl</code> is a Blazor split button: one click on the main half runs the usual action, and the caret opens a menu of alternatives. Use it when one action is the default and the rest are variants, such as Save with Save as and Save a copy: one button replaces several in a crowded toolbar. The main half raises <code>OnClick</code>, each menu item <code>OnItemClick</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="basic" Title="Default action with alternatives" RazorCode="@Code.Basic" CSharpCode="@Code.BasicCs">
            <Description><p>Click the left half to save, the caret for the other ways to save; the grayed menu entry is disabled. The second button is <code>Disabled</code> as a whole.</p></Description>
            <Demo>
                <div class="demo-row">
                    <SplitButtonControl Text="Save" IconCss="bi bi-save" Items="_saveItems"
                                        OnClick="@(() => _saved = "Saved")" OnItemClick="@(i => _saved = i.Text)" />
                    <SplitButtonControl Text="Save" IconCss="bi bi-save" Items="_saveItems" Disabled="true" />
                    @if (_saved is not null) { <span class="result">@_saved</span> }
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="menu-content" Title="Custom menu content" RazorCode="@Code.MenuContent" CSharpCode="@Code.MenuContentCs">
            <Description><p>Check Notify subscribers or Pin to top inside the menu before publishing; <code>MenuContent</code> renders after the items and stays open while you click in it.</p></Description>
            <Demo>
                <div class="demo-row">
                    <SplitButtonControl Text="Publish" IconCss="bi bi-cloud-upload" Items="_publishItems"
                                        OnClick="@(() => Publish("now"))" OnItemClick="@(i => Publish(i.Text))">
                        <MenuContent>
                            <div class="menu-options">
                                <CheckBoxControl @bind-Checked="_notify" Label="Notify subscribers" />
                                <CheckBoxControl @bind-Checked="_pin" Label="Pin to top" />
                            </div>
                        </MenuContent>
                    </SplitButtonControl>
                    @if (_published is not null) { <span class="result">@_published</span> }
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="child-content" Title="Custom main half" RazorCode="@Code.ChildContent" CSharpCode="@Code.ChildContentCs">
            <Description><p>Leave <code>Text</code> unset and put your own markup in the main half; set <code>Title</code> so both halves still have a name.</p></Description>
            <Demo>
                <div class="demo-row">
                    <SplitButtonControl Title="Send" Items="_sendItems" OnClick="@(() => _sent = "Sent to all 3")" OnItemClick="@(i => _sent = i.Text)">
                        <span class="bi bi-send"></span> Send <span class="count">3</span>
                    </SplitButtonControl>
                    @if (_sent is not null) { <span class="result">@_sent</span> }
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-splitbuttonitem" Title="SplitButtonItem" Count='@DocSection.Label(Vocab.Item.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="SplitButtonItem" Rows="Vocab.Item" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
            <DocSection Id="doc-css-variables" Title="CSS variables" Count='@DocSection.Label(Vocab.Vars.Length, "variables")'>
                <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>Both halves are native <code>&lt;button&gt;</code>s: Tab reaches each, Space and Enter activate.</li>
            <li>The caret half sets <code>aria-haspopup="true"</code>, and <code>aria-expanded</code> reads <code>"true"</code> while the menu is open and <code>"false"</code> when closed.</li>
            <li>Menu entries are native buttons: Tab moves through them, Enter or Space picks. There is no arrow-key or Escape handling; a pick or click-away closes the menu.</li>
            <li><code>Disabled</code> sets the native <code>disabled</code> attribute on both halves and ignores pointer events on the host.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>One button with a menu: <a href="demo/buttons#dropdown">ButtonControl dropdown mode</a>.</li>
            <li><code>ToolbarButtonControl</code> with <code>HasDropdown</code>, which draws the arrow and leaves the menu to the page: <a href="demo/toolbar#app-bar">Toolbar</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Basic
    private readonly List<SplitButtonItem> _saveItems = new()
    {
        new("Save as…", "bi bi-file-earmark"),
        new("Save a copy", "bi bi-files"),
        new("Save and close", "bi bi-box-arrow-right"),
        new("Save as template", "bi bi-file-earmark-lock", disabled: true),
    };
    private string? _saved;

    // Menu content
    private readonly List<SplitButtonItem> _publishItems = new() { new("Schedule…", "bi bi-calendar-event") };
    private bool _notify = true, _pin;
    private string? _published;
    private void Publish(string how) => _published = $"Publish {how} (notify {(_notify ? "on" : "off")}, pin {(_pin ? "on" : "off")})";

    // Child content
    private readonly List<SplitButtonItem> _sendItems = new() { new("Send to me only", "bi bi-person"), new("Send later…", "bi bi-clock") };
    private string? _sent;

