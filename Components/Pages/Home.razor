    // New Request opens the same editor on a blank request; Save adds it to the top of the list
    private void CreateNewRequest()
    {
        var agent = Agents[0];
        _originalRequestRef = null;
        _editingRequest = new TripRequest
        {
            Agent = agent.Name, AvatarInitials = agent.Initials, AvatarBg = agent.Color,
            DateRequested = DateTime.Today, Departure = DateTime.Today.AddDays(90),
            Destination = "Lisbon", TripType = "CITY", TripTypeName = "City breaks & culture",
            Travellers = 2, Status = "New"
        };
        _isNewRequest = true;
        _isPopupEditorOpen = true;
        StateHasChanged();
    }

    private void SavePopupEdit()
    {
        if (_editingRequest != null)
        {
            var saved = _editingRequest;
            saved.TripTypeName = _tripTypeLookup.FirstOrDefault(t => t.Code.Equals(saved.TripType, StringComparison.OrdinalIgnoreCase))?.Name ?? saved.TripType;
            saved.AvatarInitials = Initials(saved.Agent);
            var known = Agents.FirstOrDefault(a => a.Name.Equals(saved.Agent, StringComparison.OrdinalIgnoreCase));
            if (known.Name != null) saved.AvatarBg = known.Color;

            if (_isNewRequest)
            {
                saved.Id = _requests.Count + 1;
                saved.Request = RequestKey(saved.Destination, saved.Id);
                saved.FareHistory = Enumerable.Repeat((int)saved.Quote, 5).ToList();
                saved.FareDeltaPercent = 0;
                _requests.Insert(0, saved);
                _selectedRequest = saved;
                Notifications.Success($"Added request {saved.Request} for {saved.Destination}.");
            }
            else if (_originalRequestRef != null)
            {
                var o = _originalRequestRef;
                o.Agent = saved.Agent;
                o.AvatarInitials = saved.AvatarInitials;
                o.AvatarBg = saved.AvatarBg;
                o.Destination = saved.Destination;
                o.Traveller = saved.Traveller;
                o.Travellers = saved.Travellers;
                o.TripType = saved.TripType;
                o.TripTypeName = saved.TripTypeName;
                o.Quote = saved.Quote;
                ApplyQuoteToFares(o);
                o.Status = saved.Status;
                o.DateRequested = saved.DateRequested;
                o.Itinerary = saved.Itinerary;
                o.Notes = saved.Notes;
                Notifications.Success($"Saved request {o.Request}.");
            }
        }
        _isPopupEditorOpen = false;
        _isNewRequest = false;
        _editingRequest = null;
        _originalRequestRef = null;
        StateHasChanged();
    }

    private void ClosePopupEdit()
    {
        _isPopupEditorOpen = false;
        _isNewRequest = false;
        _editingRequest = null;
        _originalRequestRef = null;
        StateHasChanged();
    }

    // The last of the five weekly fare samples is the quote, so a new quote moves the sparkline's end and its percentage
    private static void ApplyQuoteToFares(TripRequest r)
    {
        if (r.FareHistory.Count == 0) return;
        r.FareHistory[^1] = (int)r.Quote;
        r.FareDeltaPercent = (int)Math.Round((r.FareHistory[^1] - r.FareHistory[0]) / (decimal)Math.Max(1, r.FareHistory[0]) * 100);
    }

    // Reports tab preview (2026-10-26): the report page's default sheet, from the same query, so its figures are the report's own
    private string _costPreviewTitle = "";
