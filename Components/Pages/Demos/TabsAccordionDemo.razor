@page "/demo/tabs-accordion"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page on FeatureDemoLayout; three examples (tab control, tab strip, accordion). Facts checked against Navigation/TabControl.razor,
   Navigation/TabItem.razor, TabStripControl.razor, TabStripModels.cs, AccordionControl.razor, AccordionItemControl.razor and their stylesheets
   (FlexCore 0.2.48). The accordion moved here from UI elements. *@

@* 2026-10-26 (Baaria, review comment: "more like tabs, with an outline and an x to close, in FlexCore style"): both tab examples sit
   in a .folder-tabs wrapper whose page CSS draws outlined folder tabs (grey resting tabs, a white active tab joined to its pane by a
   blue top edge); the CSS tab shows it. TabControl has no close button, so the closable tabs are the tab strip's, now laid out like
   a document workspace: a pinned Home tab and closable documents. Sample data moved from a kitchen estimate to the site's travel
   theme. *@

<PageTitle>Tabs & accordion — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Tabs & accordion" Category="Components" ControlName="TabControl · TabStripControl · AccordionControl"
                   Tagline="Three ways to show one section at a time: tabs with their own panes, a bare tab strip you wire up yourself, and stacked headers that expand."
                   SourcePath="Navigation/TabControl.razor; TabStripControl.razor; AccordionControl.razor">
    <Overview>
        <p>
            <code>TabControl</code> owns its content: each <code>TabItem</code> declares a header and a pane, and <code>SelectedIndex</code> binds
            two ways. <code>TabStripControl</code> is the header row alone, driven by a list of <code>TabStripItem</code>s with icons, disabled
            and closable tabs, for cases where the content lives elsewhere, such as open documents or routes. <code>AccordionControl</code> stacks
            <code>AccordionItemControl</code> headers and expands one at a time, or several with <code>Multiple</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="tabs" Title="Tab control" RazorCode="@Code.Tabs" CSharpCode="@Code.TabsCs" CssCode="@Code.FolderCss">
            <Description><p>Panes are declared inline; only the selected one renders, so the Lines table is not in the page until its tab is chosen. The <code>TabItems</code> wrapper is optional. The outlined look is page CSS on a wrapper around the control (CSS tab); <code>TabControl</code> has no close button.</p></Description>
            <Demo>
                <div class="folder-tabs">
                    <TabControl @bind-SelectedIndex="_tab">
                        <TabItems>
                            <TabItem HeaderText="Summary">
                                <dl class="summary">
                                    <dt>Request</dt><dd>LIS-0001 Lisbon city break</dd>
                                    <dt>Status</dt><dd>Quoted, 3 lines</dd>
                                    <dt>Total</dt><dd>$1,720</dd>
                                </dl>
                            </TabItem>
                            <TabItem HeaderText="Lines">
                                <table class="lines">
                                    <thead><tr><th>Item</th><th>Qty</th><th class="num">Amount</th></tr></thead>
                                    <tbody>
                                        <tr><td>Return flights</td><td>2 seats</td><td class="num">$420</td></tr>
                                        <tr><td>Old-town hotel</td><td>4 nights</td><td class="num">$1,120</td></tr>
                                        <tr><td>Guided food tour</td><td>2 people</td><td class="num">$180</td></tr>
                                    </tbody>
                                </table>
                            </TabItem>
                            <TabItem HeaderText="Notes">
                                <p class="m0">Quote valid 14 days. The travellers prefer a morning flight; the hotel holds the rooms until Friday.</p>
                            </TabItem>
                        </TabItems>
                    </TabControl>
                </div>
                <p class="result">Tab @(_tab + 1) of 3 selected</p>
            </Demo>
        </DemoExample>

        <DemoExample Id="strip" Title="Document tabs" RazorCode="@Code.Strip" CSharpCode="@Code.StripCs" CssCode="@Code.FolderCss">
            <Description><p>A tab strip laid out as a document workspace: Home is not <code>Closable</code>, so it has no ×; the documents are, and their × raises <code>OnTabClose</code> with the index, after which the page removes the item. The strip renders headers only; the page shows the selected item's <code>Tag</code> underneath. A disabled tab ignores clicks.</p></Description>
            <Demo>
                <div class="folder-tabs">
                    <TabStripControl Items="_docs" @bind-SelectedIndex="_doc" OnTabClose="CloseDoc" />
                    <div class="strip-pane">@(_docs.Count == 0 ? "No documents open." : _docs[Math.Clamp(_doc, 0, _docs.Count - 1)].Tag)</div>
                </div>
                <div class="strip-actions">
                    <ButtonControl CssClass="btn-sm" OnClick="Reopen" Disabled="@(_closed.Count == 0)">Reopen last closed</ButtonControl>
                    <span class="result">@_docs.Count open, @_closed.Count closed</span>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="accordion" Title="Accordion" RazorCode="@Code.Accordion">
            <Description><p><code>Multiple="true"</code> lets several sections stay open; without it, opening one closes the rest. <code>InitiallyExpanded</code> opens a section on first render and <code>Disabled</code> greys its header.</p></Description>
            <Demo>
                <div class="acc">
                    <AccordionControl Multiple="true">
                        <AccordionItemControl Title="Traveller" IconCss="bi bi-person" InitiallyExpanded="true">Emma Moreau, two adults, repeat client.</AccordionItemControl>
                        <AccordionItemControl Title="Flights" IconCss="bi bi-airplane">Return to Lisbon, morning departure, one checked bag each.</AccordionItemControl>
                        <AccordionItemControl Title="Notes" IconCss="bi bi-sticky">Quote valid 14 days.</AccordionItemControl>
                        <AccordionItemControl Title="Attachments (none)" IconCss="bi bi-paperclip" Disabled="true">—</AccordionItemControl>
                    </AccordionControl>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-tabcontrol-parameters" Title="TabControl parameters" Count='@DocSection.Label(Vocab.TabControl.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="TabControl parameters" Rows="Vocab.TabControl" />
            </DocSection>
            <DocSection Id="doc-tabitem-parameters" Title="TabItem parameters" Count='@DocSection.Label(Vocab.TabItem.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="TabItem parameters" Rows="Vocab.TabItem" />
            </DocSection>
            <DocSection Id="doc-tabstripcontrol-parameters" Title="TabStripControl parameters" Count='@DocSection.Label(Vocab.Strip.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="TabStripControl parameters" Rows="Vocab.Strip" />
            </DocSection>
            <DocSection Id="doc-tabstripitem" Title="TabStripItem" Count='@DocSection.Label(Vocab.StripItem.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="TabStripItem" Rows="Vocab.StripItem" />
            </DocSection>
            <DocSection Id="doc-accordioncontrol-parameters" Title="AccordionControl parameters" Count='@DocSection.Label(Vocab.Accordion.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="AccordionControl parameters" Rows="Vocab.Accordion" />
            </DocSection>
            <DocSection Id="doc-accordionitemcontrol-parameters" Title="AccordionItemControl parameters" Count='@DocSection.Label(Vocab.AccordionItem.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="AccordionItemControl parameters" Rows="Vocab.AccordionItem" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
            <DocSection Id="doc-css-variables-tabstripcontrol-only" Title="CSS variables (TabStripControl only)" Count='@DocSection.Label(Vocab.Vars.Length, "variables")'>
                <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables (TabStripControl only)" Rows="Vocab.Vars" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li><code>TabControl</code> headers are native buttons: Tab moves between them and Enter or Space selects. There are no <code>tablist</code>, <code>tab</code> or <code>tabpanel</code> roles and no arrow-key handling.</li>
            <li><code>TabStripControl</code> tabs are <code>&lt;div&gt;</code>s with click handlers only; they are not keyboard-focusable. Use <code>TabControl</code> where keyboard access matters.</li>
            <li>Each accordion header is a button with <code>aria-expanded</code>; the body is a <code>role="region"</code>. A disabled header is a disabled button.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Tabbed document workspaces with closable pages and a tab well: <code>PageControl</code> in <a href="demo/workspace/page-control-bench">the page control bench</a>.</li>
            <li>Side-by-side and collapsible regions: <a href="demo/layout">Page layouts</a>. A navigation tree: <a href="demo/tree/treeview-explorer">Tree view</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Tab control
    private int _tab;

    // Tab strip
    private int _doc;
    private readonly List<TabStripItem> _docs = new()
    {
        new("Home", "bi bi-house") { Tag = "Today: new trip requests, quotes waiting for a reply and departures this week." },
        new("Quote LIS-0001", "bi bi-file-earmark-text", closable: true) { Tag = "Lisbon city break for two, four nights, quoted at $1,720." },
        new("Itinerary KYO-0001", "bi bi-map", closable: true) { Tag = "Kyoto long weekend with museum passes and a guided food tour." },
        new("Suppliers", "bi bi-building", closable: true) { Tag = "Hotels, airlines and guides the desk books with." },
        new("Invoice", "bi bi-receipt") { Disabled = true, Tag = "Not issued yet." },
    };
    private readonly Stack<TabStripItem> _closed = new();

    private void CloseDoc(int index)
    {
        _closed.Push(_docs[index]);
        _docs.RemoveAt(index);
        // Keep the same document selected when one before it closes; fall back a step when the last one closes.
        if (index < _doc || _doc >= _docs.Count) _doc = Math.Max(0, _doc - 1);
    }

    private void Reopen()
    {
        if (_closed.Count == 0) return;
        _docs.Add(_closed.Pop());
        _doc = _docs.Count - 1;
    }

