<PageTitle>Blazor Dialog, Window and Message Box — FlexCore</PageTitle>

<FeatureDemoLayout Title="Dialogs" Category="Components" ControlName="DialogControl"
                   Tagline="Ask users to confirm, enter a value or edit a record in a movable, resizable window."
                   SourcePath="DialogControl.razor; Dialogs/MessageBoxControl.razor; Dialogs/IDialogService.cs">
    <Overview>
        <p>
            <code>DialogControl</code> is a Blazor dialog window, modal or non-modal, that users can move and resize, with a default button for Enter and Escape to close. Use modal for a decision the page must wait for, such as refunding a charge, and non-modal for a tool window users keep open while they work. For a quick confirm, alert or prompt, any component can await one call on <code>IDialogService</code>, such as <code>ConfirmAsync</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="modal" Title="Modal dialog with a default button" RazorCode="@Code.Modal" CSharpCode="@Code.ModalCs">
            <Description><p>Edit the ticket and press Enter anywhere in the dialog: <code>OnEnter</code> fires the default button, and the card behind takes the new values; Cancel leaves it as it was. The Classic look button applies the classic Win32 frame.</p></Description>
            <Controls>
                <ToggleButtonControl @bind-Selected="_classic">Classic look</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="tk-card" role="status">
                    <div>
                        <strong>TKT-1042 · Albus Door · Router keeps restarting</strong>
                        <div class="result">Follow up @_followUp.ToString("ddd MMM d") · @_priority priority · Note: @(string.IsNullOrWhiteSpace(_note) ? "none" : _note)</div>
                    </div>
                    <ButtonControl CssClass="btn-primary" OnClick="OpenEdit">Edit ticket</ButtonControl>
                </div>
                @* Classic: the frame class, the window icon, classic buttons; .dlg-host lets page CSS gray the footer. *@
                <div class="dlg-host">
                    <DialogControl @bind-Visible="_editOpen" Header="Edit ticket TKT-1042" Width="440px" OnEnter="Save"
                                   CssClass="@(_classic ? "fx-dialog-classic" : null)" ShowWindowIcon="@_classic">
                        <ChildContent>
                            <p class="dlg-text">Change the ticket for <strong>Albus Door</strong>, then press Enter or Save.</p>
                            <div style="display:grid; grid-template-columns:auto 1fr; gap:6px 10px; align-items:center;">
                                <span>Follow up</span><DatePickerControl @bind-Value="_editFollowUp" MinDate="DateTime.Today" />
                                <span>Priority</span><DropDownListControl TItem="string" TValue="string" DataSource="@_priorities" @bind-Value="_editPriority" Width="180px" />
                                <span>Note</span><TextBoxControl @bind-Value="_editNote" TypingBehavior="TextBoxTypingBehavior.ClientBuffered" Placeholder="Optional note" />
                            </div>
                        </ChildContent>
                        <FooterContent>
                            <ButtonControl CssClass="@(_classic ? "fx-button-classic" : "btn-primary")" OnClick="Save">Save</ButtonControl>
                            <ButtonControl CssClass="@(_classic ? "fx-button-classic" : "btn-secondary")" OnClick="@(() => _editOpen = false)">Cancel</ButtonControl>
                        </FooterContent>
                    </DialogControl>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="window" Title="Non-modal window" RazorCode="@Code.Window" CSharpCode="@Code.WindowCs">
            <Description><p>Open the ticket details and keep clicking tickets: a non-modal window leaves the page live and follows the selection. Drag or resize it and the bound size and position report back.</p></Description>
            <Demo>
                <div class="demo-row">
                    @foreach (var ticket in Tickets)
                    {
                        <ButtonControl CssClass="@(ticket == _ticket ? "btn-sm btn-primary" : "btn-sm")" OnClick="() => _ticket = ticket">@ticket.Code</ButtonControl>
                    }
                    <ButtonControl OnClick="@(() => _winOpen = true)" Disabled="_winOpen">Open ticket details</ButtonControl>
                    <span class="result" role="status">@_winWidth × @_winHeight, @(_winPos is null ? "centered" : $"moved {_winPos.X:0}, {_winPos.Y:0}")</span>
                </div>
                <DialogControl @bind-Visible="_winOpen" Header="@($"Ticket details: {_ticket.Code}")" IsModal="false" ShowWindowIcon="true"
                               @bind-Width="_winWidth" @bind-Height="_winHeight" @bind-Position="_winPos"
                               MinResizeWidth="360" MinResizeHeight="200">
                    <p class="dlg-text"><strong>@_ticket.Subject</strong>, reported by @_ticket.Customer</p>
                    <p class="dlg-text">@_ticket.Details</p>
                    <p class="dlg-text result">Pick another ticket on the page: this window stays open and follows it.</p>
                </DialogControl>
            </Demo>
        </DemoExample>

        <DemoExample Id="service" Title="Message box, prompt and the dialog service" RazorCode="@Code.Service" CSharpCode="@Code.ServiceCs">
            <Description><p>Each button awaits an answer from <code>IDialogService</code> or a <code>MessageBoxControl</code>, and the ticket above follows: rename it with a prompt, send the reply after a confirmation, and refund the charge only after checking the acknowledgment box. Notes opens a multi-line prompt.</p></Description>
            <Demo>
                <div class="tk-card" role="status">
                    <div>
                        <strong>TKT-1043 · Hermione Ranger · @_subject</strong>
                        <div class="result">Status: @_status · Notes: @_notes.Length characters</div>
                    </div>
                </div>
                <div class="demo-row mt">
                    <ButtonControl OnClick="Rename" Disabled="@(_status == "Solved")">Rename ticket</ButtonControl>
                    <ButtonControl OnClick="Notes" Disabled="@(_status == "Solved")">Notes, multi-line</ButtonControl>
                    <ButtonControl OnClick="SendReply" Disabled="@(_status != "Open")">Send reply</ButtonControl>
                    <ButtonControl CssClass="btn-danger" OnClick="RefundCharge" Disabled="@(_status == "Solved")">Refund charge</ButtonControl>
                    <ButtonControl OnClick="Restore" Disabled="@(_status == "Open" && _subject == "Charged twice in October" && _notes.Length == 0)">Start over</ButtonControl>
                </div>
                <MessageBoxControl @ref="_box" />
                <MultiLineEditControl @ref="_editor" />
            </Demo>
        </DemoExample>
    </Examples>

