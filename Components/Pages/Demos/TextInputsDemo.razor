                <ApiTable Kind="ApiKind.Methods" Title="MaskedTextBoxControl method and property" Rows="Vocab.MaskedMethods" />
            </DocSection>
            <DocSection Id="doc-mask-characters" Title="Mask characters" Count='@DocSection.Label(Vocab.MaskChars.Length, "characters")'>
                <ApiTable Kind="ApiKind.Values" Title="Mask characters" Rows="Vocab.MaskChars" />
            </DocSection>
