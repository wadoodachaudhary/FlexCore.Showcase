            _originalQuoteRef.Category = _editingQuote.Category;
            _originalQuoteRef.CategoryDesc = _categoryLookup.FirstOrDefault(c => c.Code.Equals(_editingQuote.Category, StringComparison.OrdinalIgnoreCase))?.Name ?? _editingQuote.Category;
            _originalQuoteRef.EstimateAmount = _editingQuote.EstimateAmount;
            _originalQuoteRef.Status = _editingQuote.Status;
            _originalQuoteRef.DateRequested = _editingQuote.DateRequested;
            _originalQuoteRef.Description = _editingQuote.Description;
            _originalQuoteRef.Comments = _editingQuote.Comments;

            var initials = string.Join("", _originalQuoteRef.Salesperson.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
