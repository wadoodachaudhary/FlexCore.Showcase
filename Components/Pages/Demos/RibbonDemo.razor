    private string? _clipboard, _last;

    private bool _hidden, _showCanceled, _autoSave = true;

    private RibbonButton? _send;

    // The front desk's clipboard holds the booking on screen
    private void Clip(string verb)
    {
        _clipboard = "booking LIS-0001";
        _last = $"{verb} {_clipboard}";
    }

    private void Did(string what) => _last = what;

    private void Send(string document)
    {
        _last = $"Emailed the {document.ToLowerInvariant()}";
        _send?.CloseDropDown();
    }

    // Toggles, disabled groups and hidden tabs
