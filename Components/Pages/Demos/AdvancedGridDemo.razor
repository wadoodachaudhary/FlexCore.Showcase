@page "/demo/grid/advanced"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, tracker section 6); the two grids became two examples with
   generated code tabs. Changes to the live page (SC-018): the Edit and Del buttons had no handlers, so the Actions column now holds one
   working Remove button (ButtonControl) and a row count below the grid; "auto-sizing" left the intro because nothing configures it.
   Height="100%" became the fixed heights the old cards gave the grids (420px, 300px). Parameter tables are a later pass (SC-278). *@

<PageTitle>Frozen columns — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Frozen columns" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Columns pinned to either edge, header bands over column groups, and columns generated from data annotations."
                   SourcePath="Grid/GridControl.ColumnFeatures.cs;Grid/GridColumn.cs;Grid/GridColumnHeaderBand.cs">
    <Overview>
        <p>
            A column with <code>IsFrozen</code> stays in view while the rest scroll sideways; <code>FrozenPosition</code> puts it on the
            left or the right edge. <code>ColumnHeaderBands</code> draws a second header row that spans named groups of columns, and a
            column's <code>HeaderBand</code> joins a band by name. With <code>AutoGenerateColumns</code> the grid reads the columns from the
            row type instead: <code>Display</code>, <code>DisplayName</code>, <code>DisplayFormat</code>, <code>Editable</code> and
            <code>Key</code> attributes set the header, band, order, format and whether a cell can be edited.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="frozen" Title="Header bands and frozen columns" RazorCode="@Code.Frozen" CSharpCode="@Code.FrozenCs">
            <Description><p>Two hundred rows. ID and Code are frozen on the left, Status and Actions on the right; scroll the grid sideways and they stay put. The bands Identity, Product, Amounts and Workflow span their columns. Qty, Price and Discount accept edits in place (<code>EditMode.Batch</code>). Remove drops the row and the count below updates.</p></Description>
            <Demo>
                <GridControl DataSource="@_rows"
                             TValue="GridItem"
                             Height="420px"
                             AllowSorting="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             AllowSelection="true"
                             ColumnHeaderBands="@_headerBands"
                             EditSettingsRef="@_editSettings">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(GridItem.Id)" HeaderText="ID" Width="60px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" Type="ColumnType.Number" />
                        <GridColumn Field="@nameof(GridItem.Code)" HeaderText="Code" Width="100px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" />
                        <GridColumn Field="@nameof(GridItem.Name)" HeaderText="Product Name" Width="180px" />
                        <GridColumn Field="@nameof(GridItem.Category)" HeaderText="Category" Width="120px" />
                        <GridColumn Field="@nameof(GridItem.Quantity)" HeaderText="Qty" HeaderBand="Amounts" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.UnitPrice)" HeaderText="Price" HeaderBand="Amounts" Width="90px" Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.Discount)" HeaderText="Discount" HeaderBand="Amounts" Width="85px" Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(GridItem.Status)" HeaderText="Status" Width="110px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Right" />
                        <GridColumn Field="@nameof(GridItem.Action)" HeaderText="Actions" Width="110px" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Right" AllowEditing="false">
                            <Template Context="row">
                                <ButtonControl CssClass="btn-sm" OnClick="@(() => Remove((GridItem)row))">Remove</ButtonControl>
                            </Template>
                        </GridColumn>
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_rows.Count rows</p>
            </Demo>
        </DemoExample>

        <DemoExample Id="annotations" Title="Columns from data annotations" RazorCode="@Code.Annotations" CSharpCode="@Code.AnnotationsCs">
            <Description><p>No column markup: the grid builds its columns from the attributes on <code>AnnotatedGridItem</code>. <code>Display</code> gives Item #, SKU, Unit price and Extended their headers, order and bands; <code>DisplayName</code> labels the description; <code>DisplayFormat</code> formats the money; <code>Key</code> and <code>Editable(false)</code> keep Item # and Extended read-only; <code>AutoGenerateField = false</code> hides InternalCode.</p></Description>
            <Demo>
                <GridControl DataSource="@_annotatedRows"
                             TValue="AnnotatedGridItem"
                             AutoGenerateColumns="true"
                             Height="300px"
                             AllowSorting="true"
                             AllowFiltering="true"
                             EditSettingsRef="@_editSettings" />
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>GridColumn</code> frozen and band parameters, <code>GridColumnHeaderBand</code>, <code>EditSettings</code> and the annotation mapping are still to be written from <code>Grid/GridControl.ColumnFeatures.cs</code>, <code>Grid/GridColumn.cs</code> and <code>Grid/GridModels.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the editing side of <code>EditSettings</code>.</li>
            <li><a href="demo/grid/column-virtualization">Wide grids</a>: many columns without frozen edges.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class GridItem
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public string Status { get; set; } = "Active";
        public string Action { get; set; } = "";
    }

    private List<GridItem> _rows = new();

    private readonly EditSettings _editSettings = new() { AllowEditing = true, Mode = EditMode.Batch };

    private readonly IReadOnlyList<GridColumnHeaderBand> _headerBands =
    [
        new("Identity", nameof(GridItem.Id), nameof(GridItem.Code)),
        new("Product", nameof(GridItem.Name), nameof(GridItem.Category)),
        new("Workflow", nameof(GridItem.Status), nameof(GridItem.Action))
    ];

    private void Remove(GridItem row) => _rows = _rows.Where(r => r != row).ToList();

    public sealed class AnnotatedGridItem
    {
        [Key]
        [Display(Name = "Item #", Order = 0, GroupName = "Identity")]
        public int Id { get; set; }

        [Display(Name = "SKU", Order = 1, GroupName = "Identity")]
        public string Code { get; set; } = "";

        [DisplayName("Product description")]
        public string Description { get; set; } = "";

        [Display(Name = "Unit price", Order = 2, GroupName = "Amounts")]
        [DisplayFormat(DataFormatString = "{0:C2}")]
        public decimal UnitPrice { get; set; }

        [Display(Name = "Extended", Order = 3, GroupName = "Amounts")]
        [DisplayFormat(DataFormatString = "{0:C2}")]
        [Editable(false)]
        public decimal Total { get; set; }

        [Display(AutoGenerateField = false)]
        public string InternalCode { get; set; } = "";
    }

    private List<AnnotatedGridItem> _annotatedRows = new();

    protected override void OnInitialized()
    {
        var list = new List<GridItem>();
        var cats = new[] { "Electronics", "Hardware", "Lumber", "Paint", "Plumbing", "Electrical" };
        for (int i = 1; i <= 200; i++)
        {
            list.Add(new GridItem
            {
                Id = i,
                Code = $"SKU-{i:D5}",
                Name = $"Material Item #{i}",
                Category = cats[i % cats.Length],
                Quantity = 10 + (i * 7) % 150,
                UnitPrice = 15.50m + (i % 25) * 4.25m,
                Discount = (i % 5) * 2.5m,
                Status = (i % 6 == 0) ? "Pending" : "Active"
            });
        }
        _rows = list;

        _annotatedRows = list.Take(12)
            .Select(row => new AnnotatedGridItem
            {
                Id = row.Id,
                Code = row.Code,
                Description = row.Name,
                UnitPrice = row.UnitPrice,
                Total = row.Quantity * row.UnitPrice,
                InternalCode = $"INTERNAL-{row.Id}"
            })
            .ToList();
    }

    // Code tabs are verbatim copies of each Demo block and of the members above (generated, not typed).
