@page "/components"

<PageTitle>Component Catalog — FlexCore</PageTitle>

<div class="catalog-page">
    <h1>Component Catalog</h1>
    <p class="catalog-lede">
        FlexCore ships <strong>@_categories.Sum(c => c.Components.Length) components</strong> across
        @_categories.Length categories — all application-agnostic Blazor controls. PDF rendering uses locally bundled browser libraries.
    </p>

    @foreach (var cat in _categories)
    {
        <section class="cat-section">
            <h2>@cat.Title</h2>
            <div class="cat-grid">
                @foreach (var comp in cat.Components)
                {
                    <div class="comp-card">
                        <h3>@comp.Name</h3>
                        <p>@comp.Description</p>
                        @if (comp.DemoHref is not null)
                        {
                            <a href="@comp.DemoHref">View demo &rarr;</a>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

