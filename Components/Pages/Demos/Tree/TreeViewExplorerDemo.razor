<PageTitle>Blazor TreeView — FlexCore</PageTitle>

<FeatureDemoLayout Title="Tree view" Category="Components" ControlName="TreeViewControl"
                   Tagline="A hierarchical tree with folder icons, checkboxes, editing, drag and drop, and a classic VB6 look."
                   SourcePath="TreeViewControl.razor;TreeViewControl.Appearance.cs;TreeViewControl.Operations.cs;TreeViewModels.cs;TreeViewData.cs;wwwroot/browser-capabilities.js">
    <Overview>
        <p>
            <code>TreeViewControl</code> renders a list of <code>TreeNode</code>s with nested <code>Children</code>. Nodes expand on click,
            report selection through <code>SelectedNodeChanged</code>, and can carry a <code>Tag</code> for your own data. Two folder icon sets
            and <code>UseVb6TreeStyle</code>, which draws the dotted connector lines of the Windows common control, cover modern and
            migrated screens. Checkboxes, multi-select, inline editing, drag and drop, lazy loading and virtualization are parameters
            on the same control; this page shows the basics.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="explorer" Title="Programme explorer with a node inspector" RazorCode="@Code.Explorer" CSharpCode="@Code.ExplorerCs">
            <Description><p>Click a node to select it and read its properties on the right; click a folder to expand it. The switches change the folder icons and the connector lines.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_styleItems" @bind-Values="_styleValues" Selection="ChoiceSelectionMode.Single" AriaLabel="Folder style" />
                <ToggleButtonControl @bind-Selected="_useVb6Style">VB6 lines</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="explorer">
                    <div class="tree">
                        <TreeViewControl Nodes="@_treeNodes"
                                         SelectedNode="@_selectedNode"
                                         SelectedNodeChanged="HandleNodeSelected"
                                         ToggleOnNodeClick="true"
                                         ShowIcons="true"
                                         UseVb6TreeStyle="@_useVb6Style"
                                         FolderStyle="@FolderStyle"
                                         TreeIndentPixels="16"
                                         Height="100%" />
                    </div>
                    <div class="inspector">
                        <h4>Selected node</h4>
                        @if (_selectedNode is not null)
                        {
                            <dl class="props">
                                <dt>Id</dt><dd><code>@_selectedNode.Id</code></dd>
                                <dt>Text</dt><dd>@_selectedNode.Text</dd>
                                <dt>Children</dt><dd>@_selectedNode.Children.Count</dd>
                                <dt>Expanded</dt><dd>@(_selectedNode.IsExpanded ? "yes" : "no")</dd>
                                <dt>Tag</dt><dd>@(_selectedNode.Tag?.ToString() ?? "none")</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="muted">Click a node to inspect it.</p>
                        }
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-treenode" Title="TreeNode" Count='@DocSection.Label(Vocab.Node.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="TreeNode" Rows="Vocab.Node" />
            </DocSection>
            <DocSection Id="doc-keyboard" Title="Keyboard" Count='@DocSection.Label(Vocab.Keys.Length, "keys")'>
                <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
            </DocSection>
            <DocSection Id="doc-aria-output" Title="ARIA output" Count='@DocSection.Label(Vocab.Aria.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="ARIA output" Rows="Vocab.Aria" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <p>
            One tab stop: the root <code>div</code> has <code>role="tree"</code>, <code>tabindex</code> from <code>TabIndex</code>,
            <code>aria-label</code> from <code>AriaLabel</code> (default "Tree") and <code>aria-activedescendant</code> naming the current row,
            which is outlined while the tree has focus. Rows are flat <code>role="treeitem"</code> elements carrying <code>aria-level</code>,
            <code>aria-posinset</code> and <code>aria-setsize</code>; there is no nested <code>role="group"</code>. Arrows and checkboxes are
            not focusable, so the Keyboard table under Documentation is the whole model. A row's accessible name is its <code>Text</code>
            only; Outline captions, secondary lines and badges are visible but not read as part of the name.
        </p>
    </Accessibility>

    <Related>
        <ul>
            <li>Rows with columns and totals under a tree: <a href="demo/grid/tree-grid">Tree grid</a>.</li>
            <li>Side navigation that collapses: <a href="demo/layout">Page layouts</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

