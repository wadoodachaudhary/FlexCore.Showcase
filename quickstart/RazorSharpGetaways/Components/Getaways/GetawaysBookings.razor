@* The Itinerary: one booked trip, LIS-0586, laid out in SchedulerControl from the flight out to the flight home. SchedulerEvent has
   no colour of its own (colour comes only from Resources, and each resource takes a column per day), so every entry starts with an
   emoji for its kind and getaways.css colours the blocks by it. The view comes from the Settings page. *@
@namespace RazorSharpGetaways.Components.Getaways
@using Fx.ControlKit.Scheduling
@using RazorSharpGetaways.Data
@inject TripRequestStore Store
@inject GetawaysAppSettings Settings

<div class="gw-itinerary">
    <div class="gw-trip-head">
        <div>
            <h3 class="gw-trip-title">@_trip.Request · @_trip.Destination honeymoon</h3>
            <p class="gw-trip-sub">@_trip.Traveller, @_trip.Travellers travelling · @_trip.Departure.ToString("ddd d MMM") to @_trip.Departure.AddDays(_trip.Nights).ToString("ddd d MMM") · Agent: @_trip.Agent</p>
        </div>
        <ul class="gw-legend" aria-label="Kinds of entry">
            <li class="k-flight">✈️ Flight</li>
            <li class="k-transfer">🚐 Transfer</li>
            <li class="k-hotel">🏨 Hotel</li>
            <li class="k-activity">🗺️ Activity</li>
            <li class="k-meal">🍽️ Meal</li>
        </ul>
    </div>
    @* The whole trip in one multi-day view; click an entry to edit it, double-click an empty slot to add one *@
    <SchedulerControl @bind-Events="_plan" @bind-Date="_date" @bind-View="Settings.ItineraryView" MultiDayCount="@(_trip.Nights + 1)"
                      StartHour="7" EndHour="23" Height="560px" />
</div>

@code {
    // The plan below is LIS-0586's five nights; the trip's own Nights drives the view and the hotel stay
    private TripRequest _trip = new();
    private IReadOnlyList<SchedulerEvent> _plan = [];
    private DateTime _date;

    // Day of the trip, start, end, entry; the emoji at the start of each title is its kind
    private static readonly (int Day, string From, string To, string Title)[] Plan =
    [
        (0, "07:40", "11:55", "✈️ Flight to Lisbon"),
        (0, "12:30", "13:15", "🚐 Transfer to the hotel in Alfama"),
        (0, "14:00", "15:00", "🏨 Check in"),
        (0, "19:30", "21:30", "🍽️ Welcome dinner on the terrace"),
        (1, "10:00", "12:30", "🗺️ Old town walk with a guide"),
        (1, "13:00", "14:00", "🍽️ Lunch at the market hall"),
        (1, "20:00", "22:30", "🍽️ Fado dinner"),
        (2, "09:00", "17:00", "🗺️ Day in Sintra: palaces and gardens"),
        (2, "18:30", "20:30", "🍽️ Seafood dinner in Cascais"),
        (3, "10:00", "12:30", "🗺️ Spa morning for two"),
        (3, "18:00", "20:00", "🗺️ Sunset sail on the Tagus"),
        (4, "10:00", "13:00", "🗺️ Belém tower and monastery"),
        (4, "13:30", "14:30", "🍽️ Custard tarts in Belém"),
        (4, "16:00", "19:00", "🍽️ Cooking class for two"),
        (5, "09:30", "10:15", "🏨 Check out"),
        (5, "10:15", "11:00", "🚐 Transfer to the airport"),
        (5, "12:20", "16:30", "✈️ Flight home"),
    ];

    protected override void OnInitialized()
    {
        _trip = Store.ItineraryTrip ?? new TripRequest { Departure = DateTime.Today, Nights = 5 };
        var day0 = _trip.Departure.Date;
        _date = day0;
        var entries = Plan.Select(p => new SchedulerEvent
        {
            Title = p.Title,
            Start = day0.AddDays(p.Day) + TimeSpan.Parse(p.From, System.Globalization.CultureInfo.InvariantCulture),
            End = day0.AddDays(p.Day) + TimeSpan.Parse(p.To, System.Globalization.CultureInfo.InvariantCulture)
        }).ToList();
        entries.Insert(0, new SchedulerEvent { Title = $"🏨 {_trip.Nights} nights in Alfama", Start = day0, End = day0.AddDays(_trip.Nights), AllDay = true });
        _plan = entries;
    }
}
