            </DocSection>
            <DocSection Id="doc-detail-row-events" Title="Detail-row events" Count='@DocSection.Label(Vocab.DetailEvents.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Detail-row events" Rows="Vocab.DetailEvents" />
            </DocSection>
            <DocSection Id="doc-detail-row-methods" Title="Detail-row methods" Count='@DocSection.Label(Vocab.DetailMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Detail-row methods" Rows="Vocab.DetailMethods" />
                <p>
                <code>GridControlEvents</code> also carries the sorting, filtering, paging, editing, grouping, resizing, reordering and cell
                events; those belong with the pages that use them. The methods above change the selection without raising
                <code>RowSelecting</code> or <code>RowSelected</code>; they raise <code>SelectionChanged</code> with the source
                <code>Programmatic</code>. A detail template turns off the grid's row windowing, so the grid renders every row of the current
                page; keep a master list to pages or a few hundred rows.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

