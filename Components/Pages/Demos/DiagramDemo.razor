    };

    private readonly List<DiagramConnector> _workflowConnectors = new()
    {
        new() { Id = "wf-1", SourceId = "request", TargetId = "quote" },
        new() { Id = "wf-2", SourceId = "quote", TargetId = "decide" },
        new() { Id = "wf-3", SourceId = "decide", TargetId = "booked", Label = "accepted", StrokeColor = "#15803d", LabelColor = "#15803d" },
        new() { Id = "wf-4", SourceId = "decide", TargetId = "declined", Label = "declined", StrokeColor = "#b91c1c", LabelColor = "#b91c1c", DashArray = "6,4" },
        new() { Id = "wf-5", SourceId = "booked", TargetId = "deposit" },
        new() { Id = "wf-6", SourceId = "deposit", TargetId = "documents" },
    };

    private string _currentId = "request";

    private int Index => _workflowNodes.FindIndex(n => n.Id == _currentId);

    private DiagramNode Current => _workflowNodes[Index];

    private Step CurrentStep => Steps[_currentId];

    protected override void OnInitialized() => ShowStep("request");

    private void OnStepClicked(DiagramNodeClickEventArgs e) => ShowStep(e.Node.Id);

    private void Move(int delta) => ShowStep(_workflowNodes[Math.Clamp(Index + delta, 0, _workflowNodes.Count - 1)].Id);   // main path, then the declined branch; no wrap

    private void ShowStep(string id)
    {
        _currentId = id;
        foreach (var node in _workflowNodes)
            node.CssClass = node.Id == id ? "wf-current" : null;
    }

    // Shapes, connectors and links
    private bool _followLinks;

    private string _status = "No node clicked yet.";

    private readonly List<DiagramNode> _shapeNodes = new()
