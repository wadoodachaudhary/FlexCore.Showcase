<PageTitle>Unsaved-row lock — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Unsaved-row lock" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Veto the move to another row while the current one has unsaved changes."
                   SourcePath="Grid/GridControlEvents.cs;Grid/GridModels.cs;Grid/GridControl.razor.cs">
    <Overview>
        <p>
            <code>RowSelecting</code> fires before the selection moves. Its <code>RowSelectEventArgs</code> carries the target row in
            <code>Data</code> and a <code>Cancel</code> flag; set it and the move is refused, whether it came from a click or from the
            keyboard. This page marks a row dirty when a cell value is written (<code>OnCellSave</code>) and refuses every move
            away from it until Save is pressed; moves within the dirty row are still allowed.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="lock" Title="Leave a row only after saving it" RazorCode="@Code.Lock" CSharpCode="@Code.LockCs">
            <Description><p>Double-click a Qty, Price or Notes cell, change it and press Enter. Now click another row, or press the Down arrow: the other row does not become selected and the line under the grid counts the refusal. Press Save and the lock lifts.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="Save" Disabled="@(!_dirty)">Save</ButtonControl>
            </Controls>
            <Demo>
                <GridControl TValue="OrderLine"
                             DataSource="@_rows"
                             ShowRowCountInFooter="true"
                             AllowSorting="false"
                             AllowSelection="true"
                             HighlightSelectedRows="true"
                             EnableHover="true"
                             Height="340px"
                             RowHeight="26"
                             MinRowHeight="26"
                             EditSettingsRef="@_editSettings"
                             SelectionSettingsRef="@_selectionSettings"
                             EventsRef="@_events"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(OrderLine.Code)" HeaderText="Line" Width="90px" AllowEditing="false" />
                        <GridColumn Field="@nameof(OrderLine.Description)" HeaderText="Description" Width="280px" AllowEditing="true" />
                        <GridColumn Field="@nameof(OrderLine.Qty)" HeaderText="Qty" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" />
                        <GridColumn Field="@nameof(OrderLine.Price)" HeaderText="Unit price" Width="100px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(OrderLine.Notes)" HeaderText="Notes" Width="260px" AllowEditing="true" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@(_dirtyRow is null ? "No unsaved changes." : $"Unsaved changes on line {_dirtyRow.Code}: {_vetoCount} {(_vetoCount == 1 ? "move" : "moves")} refused.")@(_saveCount > 0 ? $" Saved {_saveCount} {(_saveCount == 1 ? "time" : "times")}." : "")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>RowSelecting</code> / <code>RowSelected</code>, <code>RowSelectEventArgs</code>, <code>OnCellSave</code> and <code>SelectionSettings</code> are still to be written up from <code>Grid/GridControlEvents.cs</code> and <code>Grid/GridModels.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the cell editing used here.</li>
            <li><a href="demo/grid/typing-modes">Typing modes</a>: how keystrokes reach the editors.</li>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public sealed class OrderLine
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    private List<OrderLine> _rows = [];
    private bool _dirty;
    private OrderLine? _dirtyRow;
    private int _vetoCount;
    private int _saveCount;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly SelectionSettings _selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Single
    };

    private readonly GridControlEvents<OrderLine> _events = new();

    protected override void OnInitialized()
    {
        _rows =
        [
            new OrderLine { Code = "10", Description = "Ready-mix concrete 4000 psi", Qty = 24, Price = 142.00m, Notes = "Pump truck on site 6:30" },
            new OrderLine { Code = "20", Description = "#4 rebar, 20 ft", Qty = 180, Price = 11.25m, Notes = "Tie wire included" },
            new OrderLine { Code = "30", Description = "2x6 studs, 92 5/8 in", Qty = 450, Price = 8.75m, Notes = "Deliver to lot 14" },
            new OrderLine { Code = "40", Description = "Architectural shingles, 30 yr", Qty = 65, Price = 34.50m, Notes = "Match sample board" },
            new OrderLine { Code = "50", Description = "PEX supply pipe, 3/4 in", Qty = 12, Price = 145.00m, Notes = "Red and blue coils" },
            new OrderLine { Code = "60", Description = "200 A main panel", Qty = 2, Price = 680.00m, Notes = "Inspection before cover" }
        ];

        _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<OrderLine>>(this, args =>
        {
            _dirty = true;
            _dirtyRow = args.Data;
        });

        _events.RowSelecting = EventCallback.Factory.Create<RowSelectEventArgs<OrderLine>>(this, args =>
        {
            if (_dirty && _dirtyRow != null && !ReferenceEquals(_dirtyRow, args.Data))
            {
                args.Cancel = true;
                _vetoCount++;
            }
        });
    }

    private void Save()
    {
        _dirty = false;
        _dirtyRow = null;
        _vetoCount = 0;
        _saveCount++;
    }

