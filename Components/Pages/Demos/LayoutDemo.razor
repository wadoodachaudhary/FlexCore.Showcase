</div>
<span class=""result"">List pane @_listSize.ToString(""0"") px, @_commits @(_commits == 1 ? ""commit"" : ""commits"") · navigation @(_leftCollapsed ? ""hidden"" : ""shown""), properties @(_rightCollapsed ? ""hidden"" : ""shown"")</span>";
        public const string ShellCs = @"private bool _leftCollapsed, _rightCollapsed;

private double _listSize = 200;

private int _commits;

// Shell data: three sections, each a short list; the detail pane and properties follow the selection.
