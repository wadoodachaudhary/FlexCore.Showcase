@page "/demo/grid"
@page "/demo/grid/radzen-comparison"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, tracker section 6). The grid and its data are unchanged;
   the hand-typed markup block became Razor and C# tabs copied from the live example. "Right-click for menu" left the copy:
   GridControl only raises OnContextMenu when the host handles it, and this page does not. Parameter tables are a later pass (SC-278). *@

<PageTitle>Data Grid — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Data Grid" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Sort, filter, group and resize a bound list. Every other grid page takes one feature further."
                   SourcePath="Grid/GridControl.razor;Grid/GridControl.razor.cs">
    <Overview>
        <p>
            <code>GridControl</code> binds a list through <code>DataSource</code> and <code>TValue</code>, declares its columns in
            <code>GridColumnsBase</code> and switches behaviours on with <code>Allow*</code> flags. This page shows the core set on a
            ten-row list. The pages in the Data Grid menu each take one feature further, from batch editing and frozen columns to
            on-demand loading, grouping with totals and the tree grid; they are listed under Related.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="people" Title="Sort, filter, group and resize" RazorCode="@Code.People" CSharpCode="@Code.PeopleCs">
            <Description><p>Click a header to sort. Use the filter icon in a header to filter. Drag a header into the bar above the grid to group by it, drag a header edge to resize, and drag a header sideways to reorder (<code>AllowColumnReorder</code> is on by default).</p></Description>
            <Demo>
                <GridControl TValue="Person" DataSource="@_people"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowGrouping="true"
                             AllowResizing="true"
                             EnableHover="true"
                             Height="420px">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(Person.Id)"        HeaderText="ID"          Width="60px"
                                    Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(Person.Name)"      HeaderText="Name"        Width="160px" />
                        <GridColumn Field="@nameof(Person.Department)" HeaderText="Department" Width="160px" />
                        <GridColumn Field="@nameof(Person.Role)"      HeaderText="Role"        Width="160px" />
                        <GridColumn Field="@nameof(Person.Salary)"    HeaderText="Salary"      Width="120px"
                                    Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(Person.HireDate)"  HeaderText="Hire Date"   Width="120px"
                                    Type="ColumnType.Date" Format="d" />
                    </GridColumnsBase>
                </GridControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>GridControl</code>, <code>GridColumn</code> and <code>AggregateRow</code> tables are still to be written from <code>Grid/GridControl.razor.cs</code> and its partial files.</p>
    </Vocabulary>

    <Related>
        @* Built from SiteNav so this list and the Data Grid menu cannot disagree. *@
        <ul>
            @foreach (var link in SiteNav.LinksOf("Data Grid"))
            {
                <li><a href="@link.Href">@link.Text</a></li>
            }
        </ul>
    </Related>
</FeatureDemoLayout>

