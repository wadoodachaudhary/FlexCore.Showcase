                <ApiTable Kind="ApiKind.Methods" Title="IDialogService" Rows="Vocab.Service" />
            </DocSection>
            <DocSection Id="doc-messageboxcontrol-parameters" Title="MessageBoxControl parameters" Count='@DocSection.Label(Vocab.MessageBox.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="MessageBoxControl parameters" Rows="Vocab.MessageBox" />
            </DocSection>
            <DocSection Id="doc-inputdialogcontrol-parameters" Title="InputDialogControl parameters" Count='@DocSection.Label(Vocab.Input.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="InputDialogControl parameters" Rows="Vocab.Input" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
