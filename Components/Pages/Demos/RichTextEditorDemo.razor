        <ButtonControl CssClass=""btn-primary btn-sm"" Disabled=""@NoteEmpty"" OnClick=""SaveNote"">Save note</ButtonControl>
        <span class=""note-count"" role=""status"">@_saved.Count note@(_saved.Count == 1 ? """" : ""s"") on the task</span>
    </div>
