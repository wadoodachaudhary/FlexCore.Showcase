            new("MoveNodeAsync(string id, string targetId, TreeDropPosition position = Inside)", "Moves a node as a drop does: <code>CanDrop</code> and <code>NodeMoving</code> can refuse it, then <code>NodeMoved</code> is raised. Throws for an unknown node.", "Task"),
        };
        public static readonly ApiRow[] Keys =
        {
            new("Tab", "Enters or leaves the tree. The root element is the single tab stop; the current node is named through <code>aria-activedescendant</code> and outlined while the tree has focus. Expander arrows and checkboxes are not tab stops."),
            new("Down / Up arrow", "Moves to the next or previous visible enabled node and selects it. With Ctrl or Cmd only the focus moves; with Shift and <code>AllowMultiSelect</code> the selection extends."),
            new("Right arrow", "On a collapsed parent, expands it. On an expanded parent, moves to its first child. On a leaf, nothing."),
            new("Left arrow", "On an expanded node, collapses it. Otherwise moves to the parent; on a collapsed root it stays."),
            new("Home / End", "First or last visible node, selected unless Ctrl or Cmd is held."),
            new("Space", "With <code>ShowCheckboxes</code>, toggles the focused node's check (an indeterminate node becomes checked). Otherwise selects the focused node with the Ctrl and Shift rules of a click."),
            new("Enter", "Raises <code>OnNodeActivated</code>, or <code>OnNodeDoubleClick</code> when no activated handler is set. It does not expand the node or start a rename."),
            new("F2", "Starts an inline rename when <code>AllowEditing</code> is on; otherwise nothing."),
            new("Ctrl+A / Cmd+A", "With <code>AllowMultiSelect</code>, selects every visible enabled node."),
            new("A printable character", "Type-ahead: moves to the next visible node after the current one whose <code>Text</code> starts with that character, ignoring case, wrapping to the top, and selects it. One character at a time, no multi-character buffer. With Ctrl or Alt held the key is ignored."),
            new("Enter / Escape in the rename box", "Commit or cancel the rename. While the box is open the tree ignores every other key."),
        };
        public static readonly ApiRow[] Aria =
        {
            new("role tree", "The root <code>div</code>, with <code>tabindex</code> from <code>TabIndex</code>, <code>aria-label</code> from <code>AriaLabel</code> and <code>aria-multiselectable</code> true or false from <code>AllowMultiSelect</code>. The key handler is here."),
            new("aria-activedescendant", "On the root: the element id of the current node, so one tab stop serves the whole tree. Omitted only when no enabled node is visible."),
            new("role treeitem", "Every visible row. The rows are flat children of the tree, not nested. The row's <code>aria-label</code> is the node <code>Text</code>, so a template, caption, secondary line or badge is not part of its name."),
            new("aria-level / aria-posinset / aria-setsize", "On every row: depth from 1, position among the siblings from 1, and the sibling count. They carry the hierarchy, since the rows are not nested."),
            new("aria-expanded", "true or false on a row with children, or with children still to load; omitted on a leaf. While a filter is active it reflects the filtered view, not <code>IsExpanded</code>."),
            new("aria-selected", "true or false on every row, from <code>IsSelected</code>."),
            new("aria-checked", "Only with <code>ShowCheckboxes</code>: mixed, true or false on the row. In the Standard mode the checkbox input inside repeats it and has <code>tabindex</code> -1."),
            new("aria-disabled", "true or false on every row, from <code>IsDisabled</code>."),
            new("aria-busy", "true on a row while <code>LoadChildren</code> runs for it, with a <code>role status</code> span reading Loading… in the row; omitted otherwise."),
            new("role button", "The expander arrow of a parent in Standard mode and the chevron in Outline mode, labeled Expand or Collapse plus the node text. Neither is focusable; they are mouse targets. A leaf's arrow is <code>aria-hidden</code>."),
            new("aria-hidden", "Node icons, status circles and dots, the rail and leaf arrows."),
            new("role search", "The wrapper of the built-in search box; the input is <code>type=search</code> with <code>aria-label</code> from <code>SearchPlaceholder</code>."),
            new("role status", "The <code>EmptyFilterText</code> message when the search box filter matches nothing, and the Loading… span of a lazy row."),
            new("role alert", "The <code>AlertControl</code> that shows an <code>Error</code> message under the tree."),
            new("Rename box", "The inline editor's input is labeled Rename node; Save and Cancel are buttons."),
            new("Not emitted", "No <code>role group</code> around children and no <code>aria-owns</code>; the hierarchy is in the level, posinset and setsize attributes only. No <code>aria-describedby</code> or <code>aria-current</code>."),
        };
    }

