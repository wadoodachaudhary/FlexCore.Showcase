    </GridColumnsBase>
</GridControl>
<p class=""result"">@_activeLayout set: @_currentColumns.Count(c => c.Visible) of @_currentColumns.Count columns visible@(_selected is null ? """" : $"" · selected row {_selected}"")</p>";
