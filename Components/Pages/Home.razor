@page "/"
@inject IJSRuntime JS
@inject NotificationService Notifications

<PageTitle>FlexCore — Enterprise Blazor Component Suite for .NET</PageTitle>

<div class="landing-container">
    <!-- ── 1. Catchy One-Liner Before Grid ────────────────────────── -->
    <div class="top-hero-compact">
        <div class="hero-tagline-badge">
            <span class="badge-pulse"></span>
            <span>FlexCore v0.2.31 Enterprise Suite &bull; .NET 10 &bull; C# and SVG rendering &bull; No npm or third-party JavaScript</span>
        </div>
        <h1 class="hero-oneliner">
            High-throughput enterprise Blazor data grid with sub-millisecond 60 FPS virtualization, instant in-grid editing, and native ClosedXML Excel export.
        </h1>
    </div>

    <!-- ── 2. Grid Brought Right to the Top ───────────────────────── -->
    <section id="live-showcase" class="showcase-section">
        <div class="showcase-shell">
            <!-- Window Titlebar (Desktop App / Telerik Style) -->
            <div class="window-titlebar">
                <div class="window-controls">
                    <span class="window-dot dot-red"></span>
                    <span class="window-dot dot-yellow"></span>
                    <span class="window-dot dot-green"></span>
                </div>
                <div class="window-title">
                    <span class="bi bi-window-sidebar"></span>
                    <span>Inbox — Custom Quotes (HomeFront Precision Estimating)</span>
                </div>
                <div class="window-tags">
                    <span>FlexCore Grid v0.2.31 • .NET 10 • 1,000 Rows Virtualized</span>
                </div>
            </div>

            <!-- Hint Subtitle Banner -->
            <div class="grid-banner-hint">
                <span class="bi bi-info-circle-fill" style="color: #0284c7;"></span>
                <span><strong>Prepare quotes for custom requests:</strong> Double click on a request to build the quote. Requests can also be declined.</span>
            </div>

            <!-- Showcase Top Bar / Tabs -->
            <div class="showcase-header">
                <div class="showcase-tabs">
                    <button type="button" class="@($"tab-btn {(_activeTab == "grid" ? "active" : "")}")" @onclick="@(() => _activeTab = "grid")">
                        <span class="bi bi-table"></span> FlexGrid (Custom Quotes)
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "charts" ? "active" : "")}")" @onclick="@(() => _activeTab = "charts")">
                        <span class="bi bi-bar-chart-line"></span> 30+ SVG Charts
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "ribbon" ? "active" : "")}")" @onclick="@(() => _activeTab = "ribbon")">
                        <span class="bi bi-menu-button-wide"></span> Office Ribbon
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "reports" ? "active" : "")}")" @onclick="@(() => _activeTab = "reports")">
                        <span class="bi bi-file-earmark-spreadsheet"></span> Enterprise Reporting
                    </button>
                </div>

                <div class="showcase-controls">
                    <button type="button" class="btn-code-toggle" @onclick="@(() => _showCode = !_showCode)">
                        <span class="bi bi-code-slash"></span> @(_showCode ? "Hide Code" : "View Razor Code")
                    </button>
                </div>
            </div>

            <!-- Showcase Active Tab Content -->
            <div class="showcase-body">
                @if (_activeTab == "grid")
                {
                    <div class="grid-card-toolbar">
                        <div class="toolbar-left">
                            <div class="view-select-group">
                                <label class="view-label">View:</label>
                                <DropDownListControl TValue="string" TItem="ViewOption"
                                                     DataSource="@ViewOptions"
                                                     Value="@_selectedView"
                                                     ValueChanged="@(v => { _selectedView = v ?? "All"; StateHasChanged(); })"
                                                     TextFieldName="Label"
                                                     ValueFieldName="Key"
                                                     Width="210px"
                                                     CssClass="view-flex-dropdown" />
                            </div>

                            <div class="search-input-wrapper">
                                <span class="bi bi-search search-icon"></span>
                                <TextBoxControl Value="@_gridSearchTerm"
                                                ValueChanged="@(v => { _gridSearchTerm = v ?? ""; StateHasChanged(); })"
                                                placeholder="Search quotes, jobs, salespeople..."
                                                CssClass="grid-search-input" />
                            </div>
                        </div>

                        <div class="toolbar-right">
                            <button type="button" class="btn-grid-action btn-excel" @onclick="ExportToExcel">
                                <span class="bi bi-file-earmark-excel"></span> Export to Excel
                            </button>
                            <button type="button" class="btn-grid-action btn-new" @onclick="CreateNewQuote">
                                <span class="bi bi-plus-lg"></span> New Request
                            </button>
                        </div>
                    </div>

                    <div class="category-filter-bar">
                        <span class="filter-bar-label">Category:</span>
                        @foreach (var cat in _quoteCategories)
                        {
                            <button type="button"
                                    class="@($"btn-filter-pill {(_selectedCategory == cat ? "active" : "")}")"
                                    @onclick="@(() => _selectedCategory = cat)">
                                @cat
                            </button>
                        }
                    </div>

                    <!-- HIGH-PERFORMANCE HIGHLIGHTS BANNER -->
                    <div class="grid-perf-highlights">
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">⚡</span>
                            <div class="perf-badge-text">
                                <strong>1,000 Rows Live Virtualized</strong>
                                <span>Ultra-smooth 60 FPS scrolling with zero DOM lag</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">⌨️</span>
                            <div class="perf-badge-text">
                                <strong>Instant In-Grid Typing</strong>
                                <span>Click any Estimate cell to type directly — keystrokes stay in the browser until commit</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">🎛️</span>
                            <div class="perf-badge-text">
                                <strong>DropDownGridControl</strong>
                                <span>Multi-column category picker with search &amp; sort</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">✏️</span>
                            <div class="perf-badge-text">
                                <strong>Modal Popup Editor</strong>
                                <span>Click [✏ Edit] on Description for full quote editor</span>
                            </div>
                        </div>
                    </div>

                    <GridControl TValue="CustomQuote" DataSource="@FilteredQuotes"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 AllowFiltering="true"
                                 AllowResizing="true"
                                 EnableHover="true"
                                 CssClass="telerik-grid-theme"
                                 EditSettingsRef="@_editSettings"
                                 EventsRef="@_gridEvents"
                                 Height="440px">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(CustomQuote.Job)" HeaderText="Job" Width="90px"
                                        IsPrimaryKey="true" AllowEditing="false"
                                        IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                <Template Context="row">
                                    @{ var q = (CustomQuote)row; }
                                    <BadgeControl Text="@q.Job" CssClass="grid-job-code" />
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(CustomQuote.Salesperson)" HeaderText="Salesperson" Width="145px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var q = (CustomQuote)row; }
                                    <div class="salesperson-cell">
                                        <span class="salesperson-avatar" style="background:@q.AvatarBg">@q.AvatarInitials</span>
                                        <span class="salesperson-name">@q.Salesperson</span>
                                    </div>
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(CustomQuote.Community)" HeaderText="Community" Width="130px" AllowEditing="false" />

                            <!-- IN-CELL DROP DOWN GRID CONTROL (Multi-column lookup) -->
                            <GridColumn HeaderText="Category (DropDownGrid)" Width="190px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var q = (CustomQuote)row; }
                                    <div class="grid-cell-dropdowngrid">
                                        <DropDownGridControl TItem="CategoryLookup" TValue="string"
                                                             DataSource="@_categoryLookup"
                                                             Value="@q.Category"
                                                             ValueChanged="@(val => OnCategoryChanged(q, val))"
                                                             TextFieldName="@nameof(CategoryLookup.Name)"
                                                             ValueFieldName="@nameof(CategoryLookup.Code)"
                                                             ClosedTextFieldName="@nameof(CategoryLookup.Code)"
                                                             PopupWidth="410px"
                                                             PopupHeight="220px"
                                                             RowHeight="24"
                                                             ShowSearch="true"
                                                             SearchPlaceholder="Search trades..."
                                                             AllowClear="false"
                                                             Placeholder="Select category...">
                                            <Columns>
                                                <GridColumn Field="@nameof(CategoryLookup.Code)" HeaderText="Code" Width="95px" />
                                                <GridColumn Field="@nameof(CategoryLookup.Name)" HeaderText="Category Name" Width="170px" />
                                                <GridColumn Field="@nameof(CategoryLookup.Trade)" HeaderText="Trade" Width="110px" />
                                            </Columns>
                                        </DropDownGridControl>
                                    </div>
                                </Template>
                            </GridColumn>

                            <!-- IN-GRID FAST TYPING CELL (Click to edit directly) -->
                            <GridColumn Field="@nameof(CustomQuote.EstimateAmount)" HeaderText="Estimate (Fast Typing)" Width="140px"
                                        Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                        AllowEditing="true" SelectAllOnEdit="true" />

                            <!-- INLINE SVG SPARKLINE CHART CELL TEMPLATE -->
                            <GridColumn HeaderText="Cost Trend" Width="135px" AllowSorting="false" AllowFiltering="false" AllowEditing="false">
                                <Template Context="row">
                                    @{
                                        var q = (CustomQuote)row;
                                        var spark = GetSparklinePoints(q.TrendHistory, 68, 22);
                                        var isUp = q.TrendDeltaPercent >= 0;
                                        var color = isUp ? "#10b981" : "#ef4444";
                                        var fill = isUp ? "rgba(16, 185, 129, 0.16)" : "rgba(239, 68, 68, 0.16)";
                                        var deltaClass = isUp ? "delta-up" : "delta-down";
                                        var titleText = $"5-Month Cost Trend: {(isUp ? "+" : "")}{q.TrendDeltaPercent}%";
                                        var deltaSign = isUp ? "▲" : "▼";
                                    }
                                    <div class="sparkline-cell" title="@titleText">
                                        <svg width="68" height="22" viewBox="0 0 68 22" class="sparkline-svg">
                                            <polygon points="@spark.AreaPoints" fill="@fill" />
                                            <polyline points="@spark.PolylinePoints" fill="none" stroke="@color" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                            <circle cx="@spark.LastX" cy="@spark.LastY" r="2.5" fill="@color" />
                                        </svg>
                                        <span class="sparkline-delta @deltaClass">
                                            @deltaSign@Math.Abs(q.TrendDeltaPercent)%
                                        </span>
                                    </div>
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(CustomQuote.Status)" HeaderText="Status" Width="110px" AllowEditing="false">
                                <Template Context="row">
                                    @{
                                        var q = (CustomQuote)row;
                                        var statusBadge = GetStatusBadgeClass(q.Status);
                                    }
                                    <BadgeControl Text="@q.Status" CssClass="@($"grid-badge {statusBadge}")" />
                                </Template>
                            </GridColumn>

                            <!-- POPUP EDITABLE DESCRIPTION COLUMN -->
                            <GridColumn HeaderText="Description (Popup Edit)" Width="280px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var q = (CustomQuote)row; }
                                    <div class="desc-cell-wrapper">
                                        <span class="desc-text" title="@q.Description">@q.Description</span>
                                        <button type="button" class="btn-cell-popup-edit" title="Edit in Modal Popup"
                                                @onclick="@(() => OpenPopupEdit(q))" @onclick:stopPropagation="true">
                                            <span class="bi bi-pencil-square"></span> Edit
                                        </button>
                                    </div>
                                </Template>
                            </GridColumn>
                        </GridColumnsBase>
                    </GridControl>

                    <div class="grid-status-footer">
                        <div class="status-left">
                            <span>Showing <strong>@FilteredQuotes.Count()</strong> of <strong>@_quotes.Count</strong> quotes (Virtual Scrolling 60 FPS)</span>
                            @if (_selectedQuote != null)
                            {
                                <span class="status-selected-highlight">
                                    • Selected: <strong>@_selectedQuote.Job</strong> (@_selectedQuote.Community) — <strong>@_selectedQuote.EstimateAmount.ToString("C2")</strong>
                                </span>
                            }
                        </div>
                        <div class="status-right">
                            <span>Total Pipeline: <strong>@FilteredQuotes.Sum(q => q.EstimateAmount).ToString("C2")</strong></span>
                        </div>
                    </div>

                    <!-- POPUP EDIT MODAL DIALOG -->
                    @if (_isPopupEditorOpen && _editingQuote != null)
                    {
                        <div class="modal-backdrop-blur" @onclick="ClosePopupEdit">
                            <div class="edit-modal-card" @onclick:stopPropagation="true">
                                <div class="modal-card-header">
                                    <div class="modal-header-titles">
                                        <BadgeControl Text="@_editingQuote.Job" CssClass="modal-badge-job" />
                                        <div>
                                            <h3 class="modal-h3">Edit Quote Specifications</h3>
                                            <p class="modal-sub">@_editingQuote.Customer • @_editingQuote.Community</p>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close-modal" @onclick="ClosePopupEdit" title="Close">&times;</button>
                                </div>

                                <div class="modal-card-body">
                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Salesperson</label>
                                            <TextBoxControl CssClass="modal-input" Value="@_editingQuote.Salesperson" ValueChanged="@(v => _editingQuote.Salesperson = v ?? "")" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Community</label>
                                            <TextBoxControl CssClass="modal-input" Value="@_editingQuote.Community" ValueChanged="@(v => _editingQuote.Community = v ?? "")" />
                                        </div>
                                    </div>

                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Category</label>
                                            <DropDownListControl TValue="string" TItem="CategoryLookup"
                                                                 Width="100%"
                                                                 DataSource="@_categoryLookup"
                                                                 Value="@_editingQuote.Category"
                                                                 ValueChanged="@(v => _editingQuote.Category = v ?? "")"
                                                                 TextFieldName="Display"
                                                                 ValueFieldName="Code"
                                                                 CssClass="modal-flex-dropdown" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Estimate Amount ($)</label>
                                            <NumericTextBoxControl TValue="decimal" Step="10" Width="100%" CssClass="modal-input" Value="@_editingQuote.EstimateAmount" ValueChanged="@(v => _editingQuote.EstimateAmount = v)" />
                                        </div>
                                    </div>

                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Status</label>
                                            <DropDownListControl TValue="string" TItem="string"
                                                                 Width="100%"
                                                                 DataSource="@_statusOptions"
                                                                 Value="@_editingQuote.Status"
                                                                 ValueChanged="@(v => _editingQuote.Status = v ?? "")"
                                                                 CssClass="modal-flex-dropdown" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Date Requested</label>
                                            <DatePickerControl Value="@_modalDateRequested"
                                                               ValueChanged="@(dt => { if (_editingQuote != null && dt.HasValue) _editingQuote.DateRequested = dt.Value; })"
                                                               Format="MM/dd/yyyy"
                                                               CssClass="modal-flex-datepicker" />
                                        </div>
                                    </div>

                                    <div class="modal-field">
                                        <label>Description &amp; Scope of Work</label>
                                        <TextBoxControl Multiline="true" Rows="3" CssClass="modal-textarea" Value="@_editingQuote.Description" ValueChanged="@(v => _editingQuote.Description = v ?? "")" />
                                    </div>

                                    <div class="modal-field">
                                        <label>Field Notes / Comments</label>
                                        <TextBoxControl CssClass="modal-input" Value="@_editingQuote.Comments" ValueChanged="@(v => _editingQuote.Comments = v ?? "")" />
                                    </div>
                                </div>

                                <div class="modal-card-footer">
                                    <button type="button" class="btn-modal-cancel" @onclick="ClosePopupEdit">Cancel</button>
                                    <button type="button" class="btn-modal-save" @onclick="SavePopupEdit">
                                        <span class="bi bi-check-lg"></span> Save Quote Specs
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (_activeTab == "charts")
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
                        <div>
                            <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; color: #0f172a;">Quarterly Revenue vs. Target (Pure SVG)</h4>
                            <ChartControl Type="ChartType.Bar" Title="Performance Overview" Height="280px" Series="@_quarterlySeries" />
                        </div>
                        <div>
                            <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; color: #0f172a;">Material Distribution Breakdown</h4>
                            <ChartControl Type="ChartType.Pie" Title="Inventory Allocation" Height="280px" Series="@_pieSeries" />
                        </div>
                    </div>
                }
                else if (_activeTab == "ribbon")
                {
                    <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                        <RibbonControl>
                            <RibbonTab Title="Home">
                                <RibbonGroup Title="Clipboard">
                                    <RibbonButton Text="Paste" Icon="bi-clipboard" OnClick="@OnPaste" />
                                    <RibbonButton Text="Copy" Icon="bi-files" OnClick="@OnCopy" />
                                </RibbonGroup>
                                <RibbonGroup Title="Actions">
                                    <RibbonButton Text="New Order" Icon="bi-plus-circle" OnClick="@OnNewOrder" />
                                    <RibbonButton Text="Save Batch" Icon="bi-save" OnClick="@OnSaveBatch" />
                                </RibbonGroup>
                                <RibbonGroup Title="Export">
                                    <RibbonButton Text="Excel (XLSX)" Icon="bi-file-earmark-excel" OnClick="@OnExportRibbonExcel" />
                                    <RibbonButton Text="Print PDF" Icon="bi-printer" OnClick="@OnPrintPdf" />
                                </RibbonGroup>
                            </RibbonTab>
                            <RibbonTab Title="View &amp; Filter">
                                <RibbonGroup Title="Display Options">
                                    <RibbonButton Text="Toggle Grid" Icon="bi-table" OnClick="@OnToggleGrid" />
                                    <RibbonButton Text="Freeze Headers" Icon="bi-pin-angle" OnClick="@OnFreezeHeaders" />
                                </RibbonGroup>
                            </RibbonTab>
                        </RibbonControl>
                        <div style="padding: 24px; background: #fafbfc; text-align: center; color: #64748b;">
                            <p style="margin: 0; font-size: 14px;">
                                💡 <strong>Interactive Ribbon:</strong> Click any of the ribbon buttons above to see live event handling and toast notifications!
                            </p>
                        </div>
                    </div>
                }
                else if (_activeTab == "reports")
                {
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                            <div>
                                <h3 style="margin: 0 0 4px; font-size: 18px; color: #0f172a;">Crystal Reports &amp; Paginated Print Engine</h3>
                                <p style="margin: 0; font-size: 13px; color: #64748b;">
                                    Load Crystal Reports (.rpt XML), bind session parameters, and stream to screen or print without Crystal runtime dependencies.
                                </p>
                            </div>
                            <a href="demo/reports/model-costs" class="btn-filter-pill" style="background:#0284c7; color:#fff; text-decoration:none;">
                                Open Full Report Demo &rarr;
                            </a>
                        </div>
                        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 18px; font-family: monospace; font-size: 13px; color: #334155;">
                            <div style="color: #0d3b66; font-weight: 700; border-bottom: 2px solid #0d3b66; padding-bottom: 6px; margin-bottom: 12px; display: flex; justify-content: space-between;">
                                <span>MODEL COSTS &amp; ESTIMATING SUMMARY</span>
                                <span>Division: 0100 | As of: @DateTime.Today.ToString("d")</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #f1f5f9;">
                                <span>100-FRAMING : Structural Timber &amp; Trusses</span>
                                <span style="font-weight: 600;">$42,850.00</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #f1f5f9;">
                                <span>200-PLUMBING : Rough-in &amp; Copper Mains</span>
                                <span style="font-weight: 600;">$18,420.00</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #f1f5f9;">
                                <span>300-ELECTRICAL : Panel 200A &amp; Romex Circuits</span>
                                <span style="font-weight: 600;">$21,650.00</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; padding: 6px 0; margin-top: 8px; border-top: 2px solid #cbd5e1; font-weight: 700; color: #0f172a;">
                                <span>TOTAL MODEL ESTIMATE:</span>
                                <span>$82,920.00</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Code Drawer -->
            @if (_showCode)
            {
                <div class="code-drawer">
                    <div class="code-header">
                        <span>Razor Markup for @(_activeTab.ToUpper()) Component</span>
                        <button type="button" class="btn-copy-code" @onclick="CopyActiveCode">
                            @(_copiedCode ? "✓ Copied!" : "📋 Copy Code")
                        </button>
                    </div>
                    <pre><code>@GetActiveCodeSnippet()</code></pre>
                </div>
            }
        </div>
    </section>

    <!-- ── 3. Most Popular UI Components & Component Directory ── -->
    <ComponentCatalogDirectory />


    <!-- ── 5. Why Choose FlexCore: Key Architectural Pillars ───────── -->
    <section class="pillars-section">
        <div class="section-header">
            <span class="section-tag">Enterprise Architecture</span>
            <h2 class="section-title">Engineered for Enterprise Demand</h2>
            <p class="section-desc">
                Everything you need to deliver high-performance applications with the familiar productivity of desktop controls and the modern power of Blazor.
            </p>
        </div>

        <div class="pillars-grid">
            <div class="pillar-card">
                <div class="pillar-icon blue">⚡</div>
                <h3 class="pillar-title">Ultra-Fast Virtualization</h3>
                <p class="pillar-desc">
                    Virtual scrolling handles tens of thousands of rows at 60 FPS without memory leaks or DOM bloat. Excel-like keyboard navigation and instant sort/filter.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon purple">🛡️</div>
                <h3 class="pillar-title">No Third-Party JavaScript</h3>
                <p class="pillar-desc">
                    Rendering is C# and SVG. No npm packages or webpack. The library ships its own interop scripts for focus, scrolling and clipboard, loaded on demand.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon green">🏢</div>
                <h3 class="pillar-title">Legacy VB / WinForms Migration</h3>
                <p class="pillar-desc">
                    Engineered with 1-to-1 paradigm compatibility for VB6, WinForms, ActiveX grids, and Crystal Reports modernizations. Migrate decades of logic without rewrites.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon amber">📊</div>
                <h3 class="pillar-title">Excel-Grade Grid Power</h3>
                <p class="pillar-desc">
                    Frozen columns, hierarchical TreeGrids, column reordering, aggregate footers, inline cell editing, and native ClosedXML Excel export out of the box.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon rose">🎨</div>
                <h3 class="pillar-title">Adaptive Layout &amp; MDI</h3>
                <p class="pillar-desc">
                    IDE-style collapsible Left/Right panels, splitters, tab strips, and multi-document MDI window management designed for power-user desktop web apps.
                </p>
            </div>

            <div class="pillar-card">
                <div class="pillar-icon cyan">🔌</div>
                <h3 class="pillar-title">Pluggable &amp; Host-Agnostic</h3>
                <p class="pillar-desc">
                    Every external dependency is exposed as a clean C# interface. Easily wire your own EF Core, Dapper, SQL Server, session context, or custom reporting backend.
                </p>
            </div>
        </div>
    </section>

    <!-- ── 6. Comparison Matrix (Side-by-Side Evaluation) ─────────── -->
    <section class="comparison-section">
        <div class="section-header">
            <span class="section-tag">Feature Comparison</span>
