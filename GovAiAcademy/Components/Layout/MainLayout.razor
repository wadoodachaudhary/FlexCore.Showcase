@inherits LayoutComponentBase
@inject AcademyAuthState Auth
@inject NavigationManager Nav

<a class="skip-link" href="#main">Skip to main content</a>

<div class="academy-shell">
    <div class="sample-banner">
        <strong>Sample training application.</strong>
        This is not an official government website. Do not paste sensitive, personal, or procurement-sensitive information into this demo.
    </div>
    <header class="top-bar">
        <a class="brand" href="">
            <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
                <rect width="32" height="32" rx="4" fill="#0b3a5b" />
                <path d="M7 23V9h5.2c2.7 0 4.4 1.4 4.4 3.6 0 1.5-.8 2.6-2.1 3.1 1.6.5 2.5 1.7 2.5 3.5 0 2.4-1.8 3.8-4.8 3.8H7zm2.4-8h2.2c1.2 0 1.9-.6 1.9-1.5s-.7-1.5-1.9-1.5H9.4V15zm0 5.6h2.4c1.4 0 2.2-.6 2.2-1.7s-.8-1.6-2.2-1.6H9.4v3.3z" fill="#fff" />
            </svg>
            Gov AI Academy
        </a>
        <nav class="nav-links" aria-label="Primary">
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="catalog">Courses</NavLink>
            <NavLink href="curriculum">How courses are designed</NavLink>
            <NavLink href="security">Security</NavLink>
            <NavLink href="learn">My learning</NavLink>
            <NavLink href="instruct">Instructor desk</NavLink>
        </nav>
        <div class="who">
            @if (Auth.IsSignedIn && Auth.Current is not null)
            {
                <span>@Auth.Current.DisplayName, @AcademyLabels.Persona(Auth.Current.Role)</span>
                <ButtonControl CssClass="btn-secondary" OnClick="SignOut">Sign out</ButtonControl>
            }
            else
            {
                <a class="text-link" href="signin">Sign in</a>
            }
        </div>
    </header>

    <main id="main" class="page">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                Gov AI Academy helps public-sector teams run instructor-led AI classes.
                Sample data only. Names and offices are fictional.
            </div>
            <div>
                <a href="catalog">Courses</a>
                <a href="curriculum">Design notes</a>
                <a href="security">Security</a>
                <a href="signin">Sign in</a>
            </div>
        </div>
    </footer>
    <NotificationDisplayControl />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Dismiss</span>
</div>

@code {
    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("signin");
    }
}
