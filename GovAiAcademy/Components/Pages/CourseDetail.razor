@page "/courses/{CourseId}"
@inject AcademyStore Store
@inject AcademyAuthState Auth
@inject NotificationService Notifications

<PageTitle>@(_course?.Title ?? "Course") — Gov AI Academy</PageTitle>

@if (_course is null)
{
    <h1>Course not found</h1>
    <p>That course is not in the sample catalog.</p>
    <p><a class="text-link" href="catalog">Back to courses</a></p>
}
else
{
    <BreadCrumbControl Items="_crumbs" />
    <div class="badge-row">
        <ApprovalBadge Status="_course.Approval" />
        <BadgeControl Text="@AcademyLabels.Level(_course.Level)" Variant="BadgeVariant.Primary" />
        <BadgeControl Text="@AcademyLabels.Role(_course.Role)" Variant="BadgeVariant.Info" />
        <BadgeControl Text="@AcademyLabels.Delivery(_course.Delivery)" Variant="BadgeVariant.Secondary" />
        <BadgeControl Text="@($"{_course.ContactHours} contact hours")" Variant="BadgeVariant.Dark" />
    </div>
    <h1>@_course.Title</h1>
    <p class="lede">@_course.Summary</p>

    @if (_course.Approval == ApprovalStatus.Approved)
    {
        <AlertControl Severity="AlertSeverity.Success" Title="Approved for instructor-led delivery">
            This course is above baseline AI literacy. Learners practice in their own role, with an instructor, and completion is checked by attendance.
        </AlertControl>
    }
    else
    {
        <AlertControl Severity="AlertSeverity.Warning" Title="Not approved">
            This offering is listed so teams can see the bar. It is not open for enrollment.
            <ul class="fact-list">
                @foreach (var gap in _gaps)
                {
                    <li>@gap</li>
                }
            </ul>
        </AlertControl>
    }

    <TabControl>
        <TabItem HeaderText="Outcomes">
            <h2>Who it is for</h2>
            <p>@_course.Audience</p>
            <h2>Workplace scenario</h2>
            <p>@_course.Scenario</p>
            <h2>Tools and operations</h2>
            <p>@_course.ToolsContext</p>
            <h2>What you will be able to do</h2>
            <ul class="fact-list">
                @foreach (var outcome in _course.Outcomes)
                {
                    <li>@outcome</li>
                }
            </ul>
            <h2>Before you start</h2>
            @if (_course.Prerequisites.Count == 0)
            {
                <p>No prerequisites are listed. That is one reason this offering is not approved.</p>
            }
            else
            {
                <ul class="fact-list">
                    @foreach (var item in _course.Prerequisites)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
            <h2>Above baseline literacy</h2>
            <p>@(string.IsNullOrWhiteSpace(_course.AboveBaselineNote) ? "This offering does not make a case for role proficiency." : _course.AboveBaselineNote)</p>
            <h2>Agency customization</h2>
            <p>@(string.IsNullOrWhiteSpace(_course.EmployerCustomization) ? "No path is given for an agency to insert its own tools or templates." : _course.EmployerCustomization)</p>
        </TabItem>
        <TabItem HeaderText="Labs">
            <p>@_course.LabPacket</p>
            <h2>Modules</h2>
            @if (_course.Modules.Count > 1)
            {
                <StepperControl Steps="_moduleSteps" @bind-Value="_moduleIndex" Linear="false" AriaLabel="Modules" />
                <div class="note-box" style="margin-top:12px;">
                    <h3>@_course.Modules[_moduleIndex].Title</h3>
                    <p><strong>Purpose.</strong> @_course.Modules[_moduleIndex].Purpose</p>
                    <p><strong>Guided practice.</strong> @_course.Modules[_moduleIndex].Practice</p>
                </div>
            }
            else if (_course.Modules.Count == 1)
            {
                <p>@_course.Modules[0].Title — @_course.Modules[0].Practice</p>
            }
            <h2>Exercise checklist</h2>
            @if (_course.Exercises.Count == 0)
            {
                <p>There are no exercises.</p>
            }
            <AccordionControl Multiple="true">
                @foreach (var exercise in _course.Exercises)
                {
                    <AccordionItemControl Title="@exercise.Title" InitiallyExpanded="true">
                        <p>@exercise.Brief</p>
                        <p class="muted">@(exercise.RequiredForCompletion ? "Required for completion." : "Optional practice.")</p>
                    </AccordionItemControl>
                }
            </AccordionControl>
            @if (Auth.IsSignedIn)
            {
                <p><a class="text-link" href="@($"learn/{_course.Id}")">Open the lab workspace</a></p>
            }
        </TabItem>
        <TabItem HeaderText="Schedule">
            <h2>Class groups</h2>
            @if (_cohorts.Count == 0)
            {
                <p>No class group is scheduled. This offering is not open.</p>
            }
            @foreach (var cohort in _cohorts)
            {
                var cohortId = cohort.Id;
                var seats = Store.EnrollmentCount(cohortId);
                <div class="note-box" style="margin-bottom:12px;">
                    <h3>@cohort.Name</h3>
                    <p>@cohort.ScheduleNote</p>
                    <p>@seats of @cohort.Capacity seats taken. Instructor: @_instructorName.</p>
                    <ul class="fact-list">
                        @foreach (var session in cohort.Sessions.OrderBy(s => s.Starts))
                        {
                            <li>@session.Starts.ToString("dddd, MMMM d, yyyy") — @session.Title (@session.DurationMinutes minutes, @session.Place)</li>
                        }
                    </ul>
                    @if (_course.Approval == ApprovalStatus.Approved)
                    {
                        <ButtonControl CssClass="btn-primary" OnClick="@(() => Enroll(cohortId))">Request a seat</ButtonControl>
                    }
                </div>
            }
        </TabItem>
        <TabItem HeaderText="Attendance policy">
            <p>@_course.AttendancePolicy</p>
            <p>A course is complete only when every required meeting is marked present or excused and every required exercise is checked. The instructor records the meeting. Learners do not self-certify attendance.</p>
        </TabItem>
        <TabItem HeaderText="Framework map">
            <h2>DOL content areas</h2>
            <ul class="fact-list">
                @foreach (var area in _course.DolContentAreas)
                {
                    <li>@area</li>
                }
            </ul>
            <h2>DOL delivery principles</h2>
            <ul class="fact-list">
                @foreach (var principle in _course.DolDeliveryPrinciples)
                {
                    <li>@principle</li>
                }
            </ul>
            <p class="muted">Names follow U.S. Department of Labor TEN 07-25. This page does not reprint that notice. <a href="curriculum">Read the design notes</a>.</p>
        </TabItem>
    </TabControl>
}

@code {
    [Parameter] public string CourseId { get; set; } = "";

    private Course? _course;
    private List<string> _gaps = [];
    private List<Cohort> _cohorts = [];
    private List<WizardStepDescriptor> _moduleSteps = [];
    private IList<BreadCrumbItem> _crumbs = [];
    private int _moduleIndex;
    private string _instructorName = "Amira Solano";

    protected override void OnParametersSet()
    {
        _course = Store.FindCourse(CourseId);
        _crumbs =
        [
            new BreadCrumbItem("Home", "/"),
            new BreadCrumbItem("Courses", "/catalog"),
            new BreadCrumbItem(_course?.Title ?? "Course")
        ];
        if (_course is null)
            return;

        _gaps = PedagogyRules.Violations(_course).ToList();
        _cohorts = Store.CohortsForCourse(_course.Id).ToList();
        _moduleSteps = _course.Modules.Select((m, i) => new WizardStepDescriptor
        {
            Key = i.ToString(),
            Title = m.Title,
            Description = m.Purpose
        }).ToList();
        _moduleIndex = 0;
        var instructorId = _cohorts.FirstOrDefault()?.InstructorId;
        if (instructorId is not null)
            _instructorName = Store.FindPerson(instructorId)?.DisplayName ?? _instructorName;
    }

    private void Enroll(string cohortId)
    {
        if (!Auth.IsSignedIn || Auth.Current is null)
        {
            Notifications.Info("Sign in with a sample learner account before you request a seat.");
            return;
        }

        var result = Store.Enroll(Auth.Current.Id, cohortId);
        var message = result switch
        {
            EnrollmentAttempt.Enrolled => "You have a seat. Open My learning to see the roster.",
            EnrollmentAttempt.AlreadyEnrolled => "You are already in this course.",
            EnrollmentAttempt.Full => "That class group is full.",
            EnrollmentAttempt.NotOpen => "This course is not open for enrollment.",
            _ => "That class group could not be found."
        };
        if (result == EnrollmentAttempt.Enrolled)
            Notifications.Success(message);
        else
            Notifications.Warning(message);
    }
}
