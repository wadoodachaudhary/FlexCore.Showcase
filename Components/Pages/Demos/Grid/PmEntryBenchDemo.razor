@page "/demo/grid/pm-entry"
@page "/demo/grid/typing-modes"
@rendermode InteractiveServer
@using System.Diagnostics
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@* Retitled 2026-10-06 to match the site nav; copy unchanged. *@

<PageTitle>Typing modes — FlexCore Showcase</PageTitle>

<SyncfusionDemoLayout Title="Typing modes"
                      Category="DataGrid"
                      BadgeText="Keystroke Transport"
                      RazorCode="@_razorSourceCode"
                      CSharpCode="@_csharpSourceCode"
                      CSharpTabName="ProjectManagerRow.cs">
    <Summary>
        <p>
            Replicating HomeFront's <strong>Project Managers</strong> entry grid, this benchmark evaluates keyboard responsiveness, editor transport mechanisms, and typing latency.
        </p>
        <p>
            The grid offers two editor transport modes:
            <strong>ClientBuffered</strong> holds keystrokes locally in browser memory until cell blur/Enter, sending zero intermediate WebSocket messages, whereas 
            <strong>ServerBacked</strong> dispatches each character across the circuit.
            Simulate network delays to see how <code>ClientBuffered</code> provides a seamless, lag-free desktop editing experience even under degraded WAN conditions.
        </p>
    </Summary>

    <DemoControls>
        <div style="display:flex;gap:14px;align-items:center;font-size:13px;flex-wrap:wrap;">
            <span><strong>Editor Transport:</strong></span>
            <label class="d-flex align-items-center gap-1 cursor-pointer">
                <input type="radio" name="transportMode" checked="@_clientBuffered" @onchange="() => SetTransport(true)" />
                <b>ClientBuffered (Zero Network Lag)</b>
            </label>
            <label class="d-flex align-items-center gap-1 cursor-pointer">
                <input type="radio" name="transportMode" checked="@(!_clientBuffered)" @onchange="() => SetTransport(false)" />
                ServerBacked (Key Dispatch)
            </label>

            <span class="ms-3"><strong>Simulated Latency:</strong></span>
            @foreach (var ms in new[] { 0, 50, 150, 300 })
            {
                <button class="btn btn-sm @(ms == _simulatedLatency ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetLatency(ms)">@(ms == 0 ? "Off (Local)" : $"{ms} ms")</button>
            }

            <span class="text-muted ms-2">
                Keystrokes: <b>@_keystrokes</b> |
                Server Commits: <b>@_serverCommits</b> |
                Simulated Latency: <b>@_simulatedLatency ms</b>
            </span>
        </div>
    </DemoControls>

    <DemoContent>
        <div style="width:100%;">
            <GridControl @ref="_grid"
                         TValue="PMRow"
                         DataSource="@_rows"
                         Height="360px"
                         AllowSelection="true"
                         AllowSorting="true"
                         TextEditorTypingBehavior="@(_clientBuffered ? TextBoxTypingBehavior.ClientBuffered : TextBoxTypingBehavior.ServerBacked)"
                         EditSettingsRef="@_editSettings"
                         EventsRef="@_events"
                         CssClass="fx-grid-compact">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(PMRow.ID)" HeaderText="PM ID" Width="85px" AllowEditing="false" />
                    <GridColumn Field="@nameof(PMRow.FullName)" HeaderText="Full Name" Width="200px" AllowEditing="true" />
                    <GridColumn Field="@nameof(PMRow.Email)" HeaderText="Email Address" Width="220px" AllowEditing="true" />
                    <GridColumn Field="@nameof(PMRow.Phone)" HeaderText="Direct Phone" Width="130px" AllowEditing="true" />
                    <GridColumn Field="@nameof(PMRow.IsAdmin)" HeaderText="Admin" Width="80px" Type="ColumnType.Boolean" TextAlign="TextAlign.Center" AllowEditing="true" />
                    <GridColumn Field="@nameof(PMRow.POLimit)" HeaderText="PO Limit" Width="130px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" Format="$#,##0" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </DemoContent>

    <DocumentationContent>
        <h3>Transport Architecture Comparison</h3>
        <ul>
            <li><strong>ClientBuffered:</strong> The HTML input element manages typing natively inside browser memory without dispatching SignalR server events for each keystroke. Upon Tab, Enter, or Click away, the full committed value is sent in a single compact packet.</li>
            <li><strong>ServerBacked:</strong> Dispatches each keystroke through Blazor's event system. Useful when real-time server-side validation, autocomplete, or formatting masks must execute synchronously on each character.</li>
            <li><strong>Bandwidth &amp; Latency Immunity:</strong> ClientBuffered cuts WebSocket network payload by up to 95% in intensive data entry forms.</li>
        </ul>
    </DocumentationContent>
</SyncfusionDemoLayout>

@code {
    public class PMRow
    {
        public string ID { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public bool IsAdmin { get; set; }
        public decimal POLimit { get; set; }
    }

    private GridControl<PMRow>? _grid;
    private List<PMRow> _rows = [];
    private bool _clientBuffered = true;
    private int _simulatedLatency = 0;
    private int _keystrokes = 0;
    private int _serverCommits = 0;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly GridControlEvents<PMRow> _events = new();

    protected override void OnInitialized()
    {
        _events.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<PMRow>>(this, args =>
        {
            _keystrokes++;
            _serverCommits++;
            StateHasChanged();
        });

        _rows =
        [
            new PMRow { ID = "PM-01", FullName = "Marcus Vance", Email = "m.vance@builder.com", Phone = "(512) 555-0142", IsAdmin = true, POLimit = 250000m },
            new PMRow { ID = "PM-02", FullName = "Sarah Jenkins", Email = "s.jenkins@builder.com", Phone = "(512) 555-0189", IsAdmin = false, POLimit = 50000m },
            new PMRow { ID = "PM-03", FullName = "Robert Chen", Email = "r.chen@builder.com", Phone = "(512) 555-0233", IsAdmin = false, POLimit = 75000m },
            new PMRow { ID = "PM-04", FullName = "Amanda Blake", Email = "a.blake@builder.com", Phone = "(512) 555-0287", IsAdmin = true, POLimit = 500000m },
            new PMRow { ID = "PM-05", FullName = "Daniel Torres", Email = "d.torres@builder.com", Phone = "(512) 555-0312", IsAdmin = false, POLimit = 60000m }
        ];
    }

    private void SetTransport(bool clientBuffered)
    {
        _clientBuffered = clientBuffered;
        StateHasChanged();
    }

    private void SetLatency(int ms)
    {
        _simulatedLatency = ms;
        StateHasChanged();
    }

    private const string _razorSourceCode = @"@using Fx.ControlKit
@using Fx.ControlKit.Grid

<GridControl TValue=""PMRow""
             DataSource=""@ProjectManagers""
             Height=""360px""
             AllowSelection=""true""
             TextEditorTypingBehavior=""TextBoxTypingBehavior.ClientBuffered""
             EditSettingsRef=""@_editSettings"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(PMRow.ID)"" HeaderText=""PM ID"" Width=""85px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(PMRow.FullName)"" HeaderText=""Full Name"" Width=""200px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(PMRow.Email)"" HeaderText=""Email Address"" Width=""220px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(PMRow.Phone)"" HeaderText=""Phone"" Width=""130px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(PMRow.IsAdmin)"" HeaderText=""Admin"" Width=""80px"" Type=""ColumnType.Boolean"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(PMRow.POLimit)"" HeaderText=""PO Limit"" Width=""130px"" Type=""ColumnType.Number"" Format=""$#,##0"" AllowEditing=""true"" />
    </GridColumnsBase>
</GridControl>";

    private const string _csharpSourceCode = @"namespace FlexCore.Showcase.Models;

public class PMRow
{
    public string ID { get; set; } = string.Empty;
    public string FullName { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;
    public string Phone { get; set; } = string.Empty;
    public bool IsAdmin { get; set; }
    public decimal POLimit { get; set; }
}";
}
