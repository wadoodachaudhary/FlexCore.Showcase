        ["unload"] = new("Receiving team", "30 minutes", "Pallets come off the trailer at the assigned dock and are counted against the delivery note."),
        ["inspect"] = new("Receiving lead", "15 minutes", "Cartons are checked for damage and the count is compared with the purchase order; the lead accepts or rejects the delivery."),
        ["received"] = new("Receiving team", "Same shift", "The accepted quantities are posted to the purchase order and every pallet gets a putaway label."),
        ["putaway"] = new("Forklift drivers", "Within 4 hours", "Each pallet goes to a bin in the Ambient, Chilled or Bulk zone and is scanned into that location."),
        ["available"] = new("Inventory control", "Right after putaway", "The stock shows as available to pick and the purchase order line is closed."),
        ["rejected"] = new("Dock office", "Same day", "The office records the reason on the purchase order and the pallets are reloaded for return to the supplier."),
    };

    private readonly List<DiagramNode> _workflowNodes = new()
    {
        new() { Id = "arrival", Label = "Truck checked in", Shape = DiagramControlShape.Stadium, OffsetX = 100, OffsetY = 24, Width = 170, Height = 44, FillColor = "#0f766e", StrokeColor = "#134e4a" },
        new() { Id = "unload", Label = "Pallets unloaded", OffsetX = 100, OffsetY = 104, Width = 170, Height = 48, FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "inspect", Label = "Goods inspected", Shape = DiagramControlShape.Diamond, OffsetX = 100, OffsetY = 202, Width = 170, Height = 80, FillColor = "#fbbf24", StrokeColor = "#b45309", TextColor = "#1f2937" },
        new() { Id = "received", Label = "Receipt posted", OffsetX = 100, OffsetY = 344, Width = 170, Height = 48, FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "putaway", Label = "Put away", OffsetX = 100, OffsetY = 426, Width = 170, Height = 48, FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "available", Label = "Stock available", Shape = DiagramControlShape.Stadium, OffsetX = 100, OffsetY = 506, Width = 170, Height = 44, FillColor = "#0f766e", StrokeColor = "#134e4a" },
        new() { Id = "rejected", Label = "Sent back", Shape = DiagramControlShape.Stadium, OffsetX = 380, OffsetY = 202, Width = 120, Height = 44, FillColor = "#fee2e2", StrokeColor = "#b91c1c", TextColor = "#991b1b" },
    };

    private readonly List<DiagramConnector> _workflowConnectors = new()
    {
        new() { Id = "wf-1", SourceId = "arrival", TargetId = "unload" },
        new() { Id = "wf-2", SourceId = "unload", TargetId = "inspect" },
        new() { Id = "wf-3", SourceId = "inspect", TargetId = "received", Label = "accepted", StrokeColor = "#15803d", LabelColor = "#15803d" },
        new() { Id = "wf-4", SourceId = "inspect", TargetId = "rejected", Label = "rejected", StrokeColor = "#b91c1c", LabelColor = "#b91c1c", DashArray = "6,4" },
        new() { Id = "wf-5", SourceId = "received", TargetId = "putaway" },
        new() { Id = "wf-6", SourceId = "putaway", TargetId = "available" },
    };

    private string _currentId = "arrival";

    private int Index => _workflowNodes.FindIndex(n => n.Id == _currentId);

    private DiagramNode Current => _workflowNodes[Index];

    private Step CurrentStep => Steps[_currentId];

    protected override void OnInitialized() => ShowStep("arrival");

    private void OnStepClicked(DiagramNodeClickEventArgs e) => ShowStep(e.Node.Id);

    private void Move(int delta) => ShowStep(_workflowNodes[Math.Clamp(Index + delta, 0, _workflowNodes.Count - 1)].Id);   // main path, then the rejected branch; no wrap

    private void ShowStep(string id)
    {
        _currentId = id;
        foreach (var node in _workflowNodes)
            node.CssClass = node.Id == id ? "wf-current" : null;
    }

    // Shapes, connectors and links
    private bool _followLinks;

    private string _status = "No node clicked yet.";

    private readonly List<DiagramNode> _shapeNodes = new()
    {
        new() { Id = "scan", Label = "Bin tag scanned", SubLabel = "Stadium", Shape = DiagramControlShape.Stadium, OffsetX = 75, OffsetY = 45, Width = 150, Height = 50,
                FillColor = "#0f766e", StrokeColor = "#134e4a", NavigateUrl = "demo/barcodes#barcode", Tooltip = "Opens the bin tag example on the Barcodes & QR page" },
        new() { Id = "quantity", Label = "Quantity entered", SubLabel = "Parallelogram", Shape = DiagramControlShape.Parallelogram, OffsetX = 275, OffsetY = 45, Width = 150, Height = 50,
                FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "chilled", Label = "Chilled item?", SubLabel = "Diamond", Shape = DiagramControlShape.Diamond, OffsetX = 475, OffsetY = 45, Width = 150, Height = 84,
                FillColor = "#fbbf24", StrokeColor = "#b45309", TextColor = "#1f2937" },
        new() { Id = "coldpack", Label = "Cold pack added", SubLabel = "Rectangle, radius 0", OffsetX = 475, OffsetY = 200, Width = 150, Height = 50, CornerRadius = 0,
                FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "slip", Label = "Packing slip", SubLabel = "RoundedRectangle", Icon = "✉", Shape = DiagramControlShape.RoundedRectangle, OffsetX = 275, OffsetY = 200, Width = 150, Height = 60, CornerRadius = 14,
                FillColor = "#2563eb", StrokeColor = "#1e3a8a" },
        new() { Id = "shipped", Label = "Shipped", SubLabel = "Ellipse", Icon = "✔", Shape = DiagramControlShape.Ellipse, OffsetX = 75, OffsetY = 200, Width = 150, Height = 64,
                FillColor = "#0f766e", StrokeColor = "#134e4a", Tooltip = "Pickup times are on the dock schedule" },
        new() { Id = "proof", Label = "Proof of delivery", SubLabel = "Enabled = false", Shape = DiagramControlShape.RoundedRectangle, OffsetX = 75, OffsetY = 300, Width = 150, Height = 50,
                FillColor = "#475569", StrokeColor = "#334155", Enabled = false },
    };

    private readonly List<DiagramConnector> _shapeConnectors = new()
    {
        new() { Id = "sh-1", SourceId = "scan", TargetId = "quantity" },
        new() { Id = "sh-2", SourceId = "quantity", TargetId = "chilled", ArrowStyle = ArrowStyle.Closed },
        new() { Id = "sh-3", SourceId = "chilled", TargetId = "coldpack", Label = "yes" },
        new() { Id = "sh-4", SourceId = "chilled", TargetId = "slip", Label = "no", Type = ConnectorType.Straight, SourcePort = DiagramPort.Bottom, TargetPort = DiagramPort.Top },
        new() { Id = "sh-5", SourceId = "coldpack", TargetId = "slip", DashArray = "6,4" },
        new() { Id = "sh-6", SourceId = "slip", TargetId = "shipped", StrokeColor = "#0f766e", StrokeWidth = 3 },
        new() { Id = "sh-7", SourceId = "shipped", TargetId = "proof", IsBroken = true },
    };

    private void OnShapeClicked(DiagramNodeClickEventArgs e)
    {
        e.Handled = !_followLinks;
        _status = e.Node.NavigateUrl is { } url && e.Handled
            ? $"{e.Node.Label}: Handled is true, so {url} did not open."
            : $"{e.Node.Label} clicked.";
    }

