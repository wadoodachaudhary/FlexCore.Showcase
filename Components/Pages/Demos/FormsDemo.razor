    private OrderRequest _order = new();
    private string _orderStatus = "Not saved yet.";
    private void OrderSaved() => _orderStatus = $"Saved: {_order.Quantity} for {_order.Name}, {_order.Priority} priority, from {_order.Effective:g}.";
    private void OrderInvalid() => _orderStatus = "Correct the highlighted fields.";

    public enum Priority { Low, Normal, High }

    public sealed class OrderRequest
    {
        [Display(AutoGenerateField = false)] public Guid Id { get; set; } = Guid.NewGuid();
        [Required, MinLength(2), Display(Name = "Customer name", Order = 0)] public string Name { get; set; } = "Clementine Marmalade";
        [Range(1, 20), Display(Order = 1)] public int Quantity { get; set; } = 1;
        [Display(Order = 2)] public Priority Priority { get; set; } = Priority.Normal;
        [Display(Name = "Effective from", Order = 3), DataType(DataType.DateTime)] public DateTime Effective { get; set; } = new(2026, 11, 2, 9, 0, 0);
        [Display(Order = 4)] public TimeOnly Appointment { get; set; } = new(9, 0);
        [Display(Name = "Gift wrap", Order = 5)] public bool? GiftWrap { get; set; }
        [Display(Order = 6)] public bool Active { get; set; } = true;
        [Editable(false), Display(Order = 7)] public string Reference { get; set; } = "ORD-2026-1142";
        [Display(Order = 8)] public string Notes { get; set; } = "";
    }

    private FormControl? _form;
