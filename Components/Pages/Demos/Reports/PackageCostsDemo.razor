<PageTitle>Report writer — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Report writer" Category="Reports" CategoryHref="demo/reports/package-costs" ControlName="ReportWriterControl"
                   Tagline="Paginated, grouped reports from a Crystal-style XML definition, with a group tree, search, print and export."
                   SourcePath="Reports/ReportWriterControl.razor;Reports/CrystalXmlReportLoader.cs;Reports/ReportOptions.cs;Reports/IReportDataExecutor.cs;Reports/IReportSessionContext.cs;Reports/IReportPickListProvider.cs;Reports/IReportExporter.cs;Reports/IReportViewerSettings.cs">
    <Overview>
        <p>
            <code>ReportWriterControl</code> renders a <code>ReportDefinition</code> as paginated HTML pages with Crystal-style group headers
            and footers, a clickable group tree and drill-down tabs. The definition is built in code or loaded from a Crystal XML export by
            <code>CrystalXmlReportLoader</code>, which reads the tables, joins, groups, formulas and field placement. The control has no data
            access of its own: the host registers <code>IReportDataExecutor</code>, <code>IReportSessionContext</code> and
            <code>IReportPickListProvider</code> in dependency injection, and optionally an <code>IReportExporter</code>. The toolbar prints,
            exports, searches the report text and zooms the pages.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="report" Title="Package costs by region, package, cost group and supplier" RazorCode="@Code.Report" CSharpCode="@Code.ReportCs">
            <Description><p>The bundled XML is a tour operator's cost sheet: four group levels (region, package, cost group, supplier), a sum in the package, cost group and supplier footers and a grand total at the end. Pick a package and a departure season and press Run; the report loads on arrival too. This site's data executor ignores the SQL in the definition and synthesises the supplier lines for the chosen package and season, so every choice returns a report. Press <strong>Parameters</strong> in the report's toolbar and the writer opens its own parameter dialog with the packages and seasons the XML lists; it reruns the report with what you pick there (the two pickers above belong to this page and do not follow the dialog). Open the group tree on the left to jump between groups, or search the report text from the toolbar.</p></Description>
            <Controls>
                <DropDownListControl TItem="string" TValue="string" DataSource="@_packages" @bind-Value="_package" AriaLabel="Package" Width="210px" />
                <DropDownListControl TItem="string" TValue="string" DataSource="@_seasons" @bind-Value="_season" AriaLabel="Season" Width="120px" />
                <ButtonControl CssClass="btn-sm" OnClick="RunReport" Disabled="@_running">@(_running ? "Running…" : "Run")</ButtonControl>
            </Controls>
            <Demo>
                <div class="report-frame">
                    <ReportWriterControl @ref="_writer" />
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-reportwritercontrol-parameters" Title="ReportWriterControl parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="ReportWriterControl parameters" Rows="Vocab.Params" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-state" Title="State" Count='@DocSection.Label(Vocab.State.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="State" Rows="Vocab.State" />
            </DocSection>
            <DocSection Id="doc-host-services-resolved-from-dependency-i" Title="Host services, resolved from dependency injection" Count='@DocSection.Label(Vocab.Services.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="Host services, resolved from dependency injection" Rows="Vocab.Services" />
                <p>
                The toolbar's Print / Save as PDF uses the browser's print dialog, and its HTML, CSV and Excel data exports are the control's own
                (<code>ReportNativeExport</code>), so none of them need <code>IReportExporter</code>. This site registers
                <code>ReportOptions</code> with an empty schema prefix and DivisionID and UserId as session parameters, its own data executor and
                session context, the empty pick-list provider, the in-memory viewer settings and a no-op exporter.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/pdf-viewer">PDF viewer</a>: <code>PdfViewerControl</code> for finished PDFs.</li>
            <li><a href="demo/grid/enterprise-suite">Export &amp; templates</a>: the grid's own CSV and Excel export.</li>
            <li><a href="demo/grid/grouping">Grouping &amp; totals</a>: group sums in a grid instead of a report.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private ReportWriterControl? _writer;
    private readonly string[] _packages = TravelData.Packages.Select(p => p.Name).ToArray();
    private readonly string[] _seasons = TravelData.Seasons;
    private string _package = TravelData.Packages[0].Name;
    private string _season = TravelData.Seasons[0];
    private bool _running;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Run on first paint so visitors land on a populated report.
            await RunReport();
        }
    }

    private async Task RunReport()
    {
        if (_writer is null) return;
        _running = true;
        StateHasChanged();
        try
        {
            var path = Path.Combine(Env.WebRootPath, "reports", "Package Cost Sheet.xml");
            await _writer.ShowReportAsync(path, new Dictionary<string, string>
            {
                ["Package"] = _package,
                ["Season"] = _season,
            });
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed). The data executor this site
    // registers is Services/ShowcaseReportDataExecutor.cs; Program.cs shows the registrations.
    private static class Code
    {
        public const string Report = @"<div class=""report-frame"">
    <ReportWriterControl @ref=""_writer"" />
</div>";
        public const string ReportCs = @"private ReportWriterControl? _writer;
private readonly string[] _packages = TravelData.Packages.Select(p => p.Name).ToArray();
private readonly string[] _seasons = TravelData.Seasons;
private string _package = TravelData.Packages[0].Name;
private string _season = TravelData.Seasons[0];
private bool _running;

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        // Run on first paint so visitors land on a populated report.
        await RunReport();
    }
}

private async Task RunReport()
{
    if (_writer is null) return;
    _running = true;
    StateHasChanged();
    try
    {
        var path = Path.Combine(Env.WebRootPath, ""reports"", ""Package Cost Sheet.xml"");
        await _writer.ShowReportAsync(path, new Dictionary<string, string>
        {
            [""Package""] = _package,
            [""Season""] = _season,
        });
    }
    finally
    {
        _running = false;
        StateHasChanged();
    }
}";
    }

