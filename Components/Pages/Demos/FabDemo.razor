@page "/demo/fab"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page; facts from FabMenu*, BadgeModels.cs (FlexCore 0.2.50). The control is position:fixed, so each card pins
   it in a stage (CSS tab).
   2026-11-15: examples rebuilt around a trip board and a help desk; text re-checked.
   2026-11-15: example story moved to the Support desk theme.
   2026-11-16: pre-deploy review fixes. *@

<PageTitle>Blazor Floating Action Button (FAB) — FlexCore</PageTitle>

<FeatureDemoLayout Title="Floating action button" Category="Components" ControlName="FabMenuControl"
                   Tagline="Keep a screen's main actions within reach in a round corner button."
                   SourcePath="FabMenuControl.razor">
    <Overview>
        <p>
            <code>FabMenuControl</code> is a Blazor floating action button: a round button fixed to the bottom-right corner of the screen that fans out a speed dial of actions. Use it for the few things users do most on a screen, such as a new ticket or a call to the help desk; it stays in place while the page scrolls. Give it <code>Items</code> to fan out, an <code>IconCss</code> for the trigger and any extra markup as <code>ChildContent</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="menu" Title="Action menu" RazorCode="@Code.Menu" CSharpCode="@Code.MenuCs">
            <Description><p>Click the plus over the Loose Wire Help Desk board and pick an action: the list and the counts change with each pick, and a click on the board outside the fan closes it without running anything. The Disabled toggle disables the trigger.</p></Description>
            <Controls>
                <ToggleButtonControl @bind-Selected="_disabled">Disabled</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="fab-stage">
                    <div class="board-head"><span class="bi bi-list-task" aria-hidden="true"></span>Today's board</div>
                    <ul class="board">
                        @foreach (var row in _board)
                        {
                            <li><span class="bi @(row.Kind == "Callback" ? "bi-telephone" : "bi-ticket-perforated")" aria-hidden="true"></span><span class="subject">@row.Subject</span><BadgeControl Text="@row.Kind" Variant="@(row.Kind == "Callback" ? BadgeVariant.Success : BadgeVariant.Info)" /></li>
                        }
                    </ul>
                    <FabMenuControl Items="Actions" Disabled="@_disabled" Title="Add to the board" />
                </div>
                <span class="result" role="status">@_board.Count on today's board, @_agents agents on shift. Last action: @_last</span>
            </Demo>
        </DemoExample>

        <DemoExample Id="custom" Title="Trigger icon and extra content" RazorCode="@Code.Custom" CSharpCode="@Code.CustomCs">
            <Description><p>Open the help desk button on a customer's ticket list: <code>IconCss</code> swaps the plus for a headset, and <code>ChildContent</code> adds a note to the fan; one rule on this page, <code>::deep .fx-fab-open .fx-fab-trigger-icon { transform: none; }</code>, keeps the headset from turning 45 degrees as the fan opens. Press Urgent inside the note and the fan stays open; then pick how to get in touch.</p></Description>
            <Demo>
                <div class="fab-stage short">
                    <div class="board-head"><span class="bi bi-inbox" aria-hidden="true"></span>Your open tickets</div>
                    <ul class="board">
                        <li><span class="bi bi-ticket-perforated" aria-hidden="true"></span><span class="subject">Router keeps restarting</span><span class="ref">TKT-1042</span></li>
                        <li><span class="bi bi-ticket-perforated" aria-hidden="true"></span><span class="subject">Wi-Fi does not reach the garage</span><span class="ref">TKT-1038</span></li>
                        <li><span class="bi bi-ticket-perforated" aria-hidden="true"></span><span class="subject">Change the name on the account</span><span class="ref">TKT-1031</span></li>
                    </ul>
                    <FabMenuControl IconCss="bi bi-headset" Items="Help" Title="Help desk">
                        <div class="fab-note">
                            <span class="dot"></span> 3 agents online
                            <ToggleButtonControl @bind-Selected="_urgent" CssClass="btn-sm">Urgent</ToggleButtonControl>
                        </div>
                    </FabMenuControl>
                </div>
                <span class="result" role="status">@_contact</span>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-fabmenuitem" Title="FabMenuItem" Count='@DocSection.Label(Vocab.Item.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="FabMenuItem" Rows="Vocab.Item" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
                <p class="note">Colors, sizes and the 2rem corner offset are fixed in the control's stylesheet; it reads no <code>--fx-*</code> variables. There are no public methods.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The trigger is a native <code>&lt;button&gt;</code> with <code>aria-expanded</code> ("true" or "false"); Enter or Space opens and closes the menu.</li>
            <li>Set <code>Title</code> to name the trigger: it shows only an icon, and <code>Title</code> is written as its <code>title</code>.</li>
            <li>Each action is a native button named by its item's <code>Title</code>, which also shows as the label beside it. Give every item a <code>Title</code>.</li>
            <li>Once the menu is open, the actions come before the trigger in the Tab order: Shift+Tab from the trigger moves to them, and picking one closes the menu.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A menu on a button in the page flow: <a href="demo/buttons#dropdown">ButtonControl dropdown mode</a> or <a href="demo/split-button">Split button</a>.</li>
            <li>Pressed-state buttons: <a href="demo/toggle-buttons">Toggle buttons</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Action menu
    private bool _disabled;
    private int _agents = 3;
    private string _last = "none yet";
    private sealed record Row(string Subject, string Kind);
    private readonly List<Row> _board = new() { new("Router keeps restarting", "Callback"), new("Charged twice in October", "Ticket") };
    private static readonly string[] Subjects = { "Router light is red", "Invoice not received", "Cannot reset password", "No signal since noon" };
    private List<FabMenuItem>? _actions;
    private List<FabMenuItem> Actions => _actions ??= new()
    {
        Action("New ticket", "bi bi-ticket-perforated", BadgeVariant.Primary, _ => Add("Ticket")),
        Action("New callback", "bi bi-telephone", BadgeVariant.Success, _ => Add("Callback")),
        Action("Add agent", "bi bi-person-plus", BadgeVariant.Info, t => { _agents++; _last = t; }),
        Action("Clear added", "bi bi-trash", BadgeVariant.Danger, t => { _board.RemoveRange(0, _board.Count - 2); _agents = 3; _last = t; }),
    };
    private void Add(string kind)
    {
        if (_board.Count >= 6) { _last = "none, the board is full"; return; }
        _board.Insert(0, new(Subjects[_board.Count % Subjects.Length], kind));
        _last = $"New {kind.ToLowerInvariant()}";
    }

    // Trigger icon and extra content
    private bool _urgent;
    private string _contact = "No request yet";
    private List<FabMenuItem>? _help;
    private List<FabMenuItem> Help => _help ??= new()
    {
        Action("Chat with an agent", "bi bi-chat-text", BadgeVariant.Primary, Ask),
        Action("Call me back", "bi bi-telephone", BadgeVariant.Success, Ask),
        Action("Send an email", "bi bi-envelope", BadgeVariant.Secondary, Ask),
    };
    private void Ask(string what) => _contact = _urgent ? $"{what}: marked urgent" : what;

    // FabMenuItem(title, iconCss, color); OnClick is a settable EventCallback.
    private FabMenuItem Action(string title, string icon, BadgeVariant color, Action<string> pick) =>
        new(title, icon, color) { OnClick = EventCallback.Factory.Create(this, () => pick(title)) };

    // Vocabulary rows, one per public member (0.2.50). Base-class parameters marked (base).
    private static class Vocab
    {
        public static readonly ApiRow[] Parameters =
        {
            new("Items", "The actions shown when the fan opens, the first nearest the trigger.", "IList&lt;FabMenuItem&gt;?", "null"),
            new("IconCss", "Trigger icon. Default is a plus that rotates into a cross while open; a custom icon rotates too.", "string?", "null"),
            new("ChildContent", "Your own markup in the fan after the items, such as a note or a toggle; clicks inside it keep the fan open.", "RenderFragment?", "null"),
            new("Disabled", "Disables the trigger, so the menu cannot open, and closes a menu that is open. The trigger looks the same; only the hover effect stops.", "bool", "false"),
            new("Title (base)", "Tooltip and accessible name of the trigger.", "string?", "null"),
            new("CssClass / Style (base)", "On the host element.", "string?", "null"),
            new("Visible / Enabled (base)", "Accepted but have no effect. Use <code>Disabled</code> to disable the trigger.", "bool", "true"),
            new("Id / Tag / Data / Parent (base)", "Accepted but not rendered. A written <code>id</code> binds to <code>Id</code>, so it does not reach the host.", "", "null"),
            new("(unmatched attributes)", "Forwarded to the host <code>&lt;div&gt;</code>.", "Dictionary&lt;string,object&gt;"),
        };
        public static readonly ApiRow[] Item =
        {
            new("Title", "The label chip beside the action and its tooltip. Left empty, there is no chip and the button has no accessible name.", "string", "\"\""),
            new("IconCss", "Classes for the icon in the round button; a dot (•) when empty.", "string?", "null"),
            new("Color", "Fill: Primary, Secondary, Success, Danger, Warning, Info or Dark. <code>Light</code> has no rule in the stylesheet: the button keeps the browser's default gray and the white icon barely shows.", "BadgeVariant", "Primary"),
            new("OnClick", "Runs after the menu closes.", "EventCallback", "none"),
            new("ctor", "<code>new(title, iconCss, color)</code>; set <code>OnClick</code> in an initializer.", "", null),
        };
        public static readonly ApiRow[] Css =
        {
            new("fx-fab-host · .fx-fab-open", "Fixed 2rem from the bottom-right, z-index 1050. <code>fx-fab-open</code> while the menu is showing."),
            new("fx-fab-trigger · .disabled", "56px blue circle with a shadow; grows 5% on hover unless disabled. <code>disabled</code> is added while <code>Disabled</code> is true and has no rule in the stylesheet."),
            new("fx-fab-trigger-icon", "Wraps the trigger icon; rotates 45° over 0.2s while the menu is open."),
            new("fx-fab-backdrop", "Full-screen 25% black layer; click closes the menu."),
            new("fx-fab-actions", "Column of actions above the trigger; slides in over 0.2s."),
            new("fx-fab-action-row · fx-fab-action-label · fx-fab-action-btn", "One action: white label chip plus a 42px circle that grows 10% on hover."),
            new("fx-fab-color-primary … fx-fab-color-dark", "Seven fills, one per <code>BadgeVariant</code> except Light."),
        };
    }

    // Code tabs are verbatim
    private static class Code
    {
        public const string Menu = @"<ToggleButtonControl @bind-Selected=""_disabled"">Disabled</ToggleButtonControl>

<div class=""fab-stage"">
    <div class=""board-head""><span class=""bi bi-list-task"" aria-hidden=""true""></span>Today's board</div>
    <ul class=""board"">
        @foreach (var row in _board)
        {
            <li><span class=""bi @(row.Kind == ""Callback"" ? ""bi-telephone"" : ""bi-ticket-perforated"")"" aria-hidden=""true""></span><span class=""subject"">@row.Subject</span><BadgeControl Text=""@row.Kind"" Variant=""@(row.Kind == ""Callback"" ? BadgeVariant.Success : BadgeVariant.Info)"" /></li>
        }
    </ul>
    <FabMenuControl Items=""Actions"" Disabled=""@_disabled"" Title=""Add to the board"" />
</div>
<span class=""result"" role=""status"">@_board.Count on today's board, @_agents agents on shift. Last action: @_last</span>";
        public const string MenuCs = @"// Action menu
private bool _disabled;
private int _agents = 3;
private string _last = ""none yet"";
private sealed record Row(string Subject, string Kind);
private readonly List<Row> _board = new() { new(""Router keeps restarting"", ""Callback""), new(""Charged twice in October"", ""Ticket"") };
private static readonly string[] Subjects = { ""Router light is red"", ""Invoice not received"", ""Cannot reset password"", ""No signal since noon"" };
private List<FabMenuItem>? _actions;
private List<FabMenuItem> Actions => _actions ??= new()
{
    Action(""New ticket"", ""bi bi-ticket-perforated"", BadgeVariant.Primary, _ => Add(""Ticket"")),
    Action(""New callback"", ""bi bi-telephone"", BadgeVariant.Success, _ => Add(""Callback"")),
    Action(""Add agent"", ""bi bi-person-plus"", BadgeVariant.Info, t => { _agents++; _last = t; }),
    Action(""Clear added"", ""bi bi-trash"", BadgeVariant.Danger, t => { _board.RemoveRange(0, _board.Count - 2); _agents = 3; _last = t; }),
};
private void Add(string kind)
{
    if (_board.Count >= 6) { _last = ""none, the board is full""; return; }
