    private bool MatchesCategory(string catName, DirectoryItem[] items)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        if (catName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) return true;
        return items.Any(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<DirectoryItem> FilterItems(DirectoryItem[] items)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return items;
        var term = _searchTerm.Trim();
        return items.Where(i => i.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
    }
