<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* 2026-10-28: site font Inter (variable weight, optical size); app.css keeps the system stack as fallback. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Home page app window (the Quick Start project): quickstart/RazorSharpGetaways/wwwroot/getaways.css (2026-11-04) *@
    <link rel="stylesheet" href="@Assets["getaways.css"]" />
    <link rel="stylesheet" href="@Assets["FlexCore.Showcase.styles.css"]" />
    <ImportMap />
    @* 2026-10-26: tab icon is the top-bar FlexCore mark: SVG, 32 px PNG fallback; @Assets fingerprints both to bust the cached
       old icon. *@
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["favicon.png"]" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="@Assets["favicon.svg"]" />
    @* InteractiveServer like <Routes> (2026-10-17, SC-303): a static HeadOutlet keeps the prerendered title after navigation. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* InteractiveServer globally: event handlers need a live SignalR circuit; without it pages render static. *@
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.fxPositionDropdownGrid = function (container, popup) {
            if (!container || !popup) return;

            // Elevate parent table row and cell to stack above all subsequent rows
            const tr = container.closest('tr');
            if (tr) {
                tr.style.setProperty('z-index', '1000', 'important');
                tr.style.setProperty('position', 'relative', 'important');
            }
            const td = container.closest('td');
            if (td) {
                td.style.setProperty('z-index', '1000', 'important');
                td.style.setProperty('position', 'relative', 'important');
            }

            const rect = container.getBoundingClientRect();
            const popupWidth = popup.offsetWidth || 410;
            const popupHeight = popup.offsetHeight || 220;
            const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

            let left = rect.left;
            if (left + popupWidth > viewportWidth - 10) {
                left = Math.max(10, viewportWidth - popupWidth - 10);
            }

            let top = rect.bottom + 2;
            if (top + popupHeight > viewportHeight - 10 && rect.top - popupHeight - 2 > 10) {
                top = rect.top - popupHeight - 2;
            }

            popup.style.position = "fixed";
            popup.style.top = Math.max(8, top) + "px";
            popup.style.left = Math.max(8, left) + "px";
            popup.style.zIndex = "10001";
            popup.style.visibility = "visible";
        };

        window.fxResetDropdownGrid = function (container) {
            if (!container) return;
            const tr = container.closest('tr');
            if (tr) {
                tr.style.removeProperty('z-index');
                tr.style.removeProperty('position');
            }
            const td = container.closest('td');
            if (td) {
                td.style.removeProperty('z-index');
                td.style.removeProperty('position');
            }
        };

        // Class on while most of el is visible, off once it has left, so a CSS animation keyed on it replays on each scroll into
        // view (home page finish flag, 2026-10-28).
        window.fxToggleClassWhenVisible = function (el, cls) {
            if (!el) return;
            if (!('IntersectionObserver' in window)) { el.classList.add(cls); return; }
            new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.intersectionRatio >= 0.6) e.target.classList.add(cls);
                    else if (!e.isIntersecting) e.target.classList.remove(cls);
                });
            }, { threshold: [0, 0.6] }).observe(el);
        };
    </script>
</body>

</html>
