                FooterTemplate = ""Total {value}""
            }
        ]
    }
];

private string ExportText => _exportProgress is not { } p ? """" :
    $""· Export: {p.ExportedRows:N0}"" + (p.TotalRows is { } total ? $"" of {total:N0}"" : """")
    + (p.IsCanceled ? "" (cancelled)"" : p.IsCompleted ? "" (complete)"" : """");

private async ValueTask<GridItemsResult<ProviderOrder>> LoadOrdersAsync(GridItemsRequest request)
{
    await Task.Delay(request.Purpose == GridItemsRequestPurpose.Export ? 60 : 90, request.CancellationToken);
    var filtered = ApplyQuery(_orders, request.Query).ToList();
    var scoped = ApplyGroupKeys(filtered, request.GroupRequest?.ParentKeys).ToList();
    var totals = request.GroupRequest is null ? filtered : scoped;   // the grid stores a child page's aggregates on the parent group
    var under = request.GroupRequest is { } parent
        ? "" under "" + string.Join("" / "", parent.ParentKeys.Select(key => key.Value))
        : """";
    _lastRequest = $""Request {++_requestCount}: {request.Purpose}{under}, start {request.StartIndex:N0}, count {request.Count:N0}."";
    await InvokeAsync(StateHasChanged);

    if (request.Purpose is GridItemsRequestPurpose.Groups or GridItemsRequestPurpose.GroupChildren)
    {
        var level = request.Purpose == GridItemsRequestPurpose.Groups
            ? 0
            : request.GroupRequest!.Level + 1;
        var descriptor = request.Query.Groups[level];
        var groups = scoped
            .GroupBy(row => GetFieldValue(row, descriptor.Field))
            .Select(group => new
            {
                Key = group.Key,
                Rows = group.ToList()
            });
        groups = descriptor.Direction == SortDirection.Descending
            ? groups.OrderByDescending(group => Convert.ToString(group.Key, CultureInfo.CurrentCulture))
            : groups.OrderBy(group => Convert.ToString(group.Key, CultureInfo.CurrentCulture));
        var groupList = groups.ToList();
        var page = groupList
            .Skip(request.StartIndex)
            .Take(request.Count)
            .Select(group => new GridProviderGroup<ProviderOrder>(
                descriptor.Field,
                group.Key,
                Convert.ToString(group.Key, CultureInfo.CurrentCulture),
                group.Rows.Count)
            {
                HasChildren = group.Rows.Count > 0,
                Aggregates = BuildAggregates(group.Rows, request.Query.Aggregates)
            })
            .ToList();

        return new GridItemsResult<ProviderOrder>(Array.Empty<ProviderOrder>(), filtered.Count)
        {
            Groups = page,
            ResultSetCount = groupList.Count,
            HasMore = request.StartIndex + page.Count < groupList.Count,
            Aggregates = BuildAggregates(totals, request.Query.Aggregates)
        };
    }

    var sorted = ApplySorts(scoped, request.Query.Sorts).ToList();
    var items = sorted.Skip(request.StartIndex).Take(request.Count).ToList();
    return new GridItemsResult<ProviderOrder>(items, filtered.Count)
    {
        ResultSetCount = sorted.Count,
        HasMore = request.StartIndex + items.Count < sorted.Count,
        Aggregates = BuildAggregates(totals, request.Query.Aggregates)
    };
}

private static IEnumerable<ProviderOrder> ApplyQuery(
    IEnumerable<ProviderOrder> source,
    GridQueryDescriptor query)
{
    var rows = source;
    if (!string.IsNullOrWhiteSpace(query.SearchText))
    {
        var comparison = query.CaseSensitive
            ? StringComparison.CurrentCulture
            : StringComparison.CurrentCultureIgnoreCase;
        rows = rows.Where(row =>
            row.Customer.Contains(query.SearchText, comparison)
            || row.Region.Contains(query.SearchText, comparison)
            || row.Category.Contains(query.SearchText, comparison));
    }
    return rows;
}

private static IEnumerable<ProviderOrder> ApplyGroupKeys(
    IEnumerable<ProviderOrder> source,
    IReadOnlyList<GridProviderGroupKey>? keys)
{
    if (keys is null)
        return source;
    foreach (var key in keys)
    {
        source = source.Where(row => Equals(
            Convert.ToString(GetFieldValue(row, key.Field), CultureInfo.InvariantCulture),
            Convert.ToString(key.Value, CultureInfo.InvariantCulture)));
    }
    return source;
}

private static IEnumerable<ProviderOrder> ApplySorts(
    IEnumerable<ProviderOrder> source,
    IReadOnlyList<GridSortDescriptor> sorts)
{
    IOrderedEnumerable<ProviderOrder>? ordered = null;
    foreach (var sort in sorts)
    {
        Func<ProviderOrder, object?> selector = row => GetFieldValue(row, sort.Field);
        ordered = ordered is null
            ? sort.Direction == SortDirection.Descending
                ? source.OrderByDescending(selector)
                : source.OrderBy(selector)
            : sort.Direction == SortDirection.Descending
                ? ordered.ThenByDescending(selector)
                : ordered.ThenBy(selector);
    }
    return ordered ?? source.OrderBy(row => row.Id);
}

private static object? GetFieldValue(ProviderOrder row, string field) => field switch
{
    nameof(ProviderOrder.Id) => row.Id,
    nameof(ProviderOrder.Region) => row.Region,
    nameof(ProviderOrder.Category) => row.Category,
    nameof(ProviderOrder.Customer) => row.Customer,
    nameof(ProviderOrder.OrderDate) => row.OrderDate,
    nameof(ProviderOrder.Quantity) => row.Quantity,
    nameof(ProviderOrder.Amount) => row.Amount,
    _ => null
};

private static IReadOnlyList<GridAggregateResult> BuildAggregates(
    IReadOnlyCollection<ProviderOrder> rows,
    IReadOnlyList<GridAggregateQueryDescriptor> requested)
{
    return requested.Select(aggregate =>
    {
        object? value = (aggregate.Field, aggregate.Type) switch
        {
            (nameof(ProviderOrder.Amount), AggregateType.Sum) => rows.Sum(row => row.Amount),
            (nameof(ProviderOrder.Amount), AggregateType.Average) when rows.Count > 0 => rows.Average(row => row.Amount),
            (nameof(ProviderOrder.Amount), AggregateType.Min) when rows.Count > 0 => rows.Min(row => row.Amount),
            (nameof(ProviderOrder.Amount), AggregateType.Max) when rows.Count > 0 => rows.Max(row => row.Amount),
            (_, AggregateType.Count) => rows.Count,
            _ => null
        };
        return new GridAggregateResult(aggregate.Field, aggregate.Type, value);
    }).ToList();
}

