private List<FabMenuItem>? _help;
private List<FabMenuItem> Help => _help ??= new()
{
    Action(""Chat with an agent"", ""bi bi-chat-text"", BadgeVariant.Primary, Ask),
    Action(""Call me back"", ""bi bi-telephone"", BadgeVariant.Success, Ask),
