<PageTitle>Blazor Tabs, TabStrip and Accordion — FlexCore</PageTitle>

<FeatureDemoLayout Title="Tabs & accordion" Category="Components" ControlName="TabControl · TabStripControl · AccordionControl"
                   Tagline="Show one section at a time with tabs, document tabs or an accordion."
                   SourcePath="Navigation/TabControl.razor; TabStripControl.razor; AccordionControl.razor">
    <Overview>
        <p>
            <code>TabControl</code> is a Blazor tab control: users switch between sections of a page, and only the selected pane renders. Use <code>TabStripControl</code> for document tabs users close, with the content kept elsewhere, and <code>AccordionControl</code> for stacked sections that expand in place, as on a narrow settings page. Both tab controls come in five themes and let users change orientation from a right-click menu.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="tabs" Title="Tab control" RazorCode="@Code.Tabs" CSharpCode="@Code.TabsCs">
            <Description><p>Switch between the Summary, Lines and Notes of a leave request; only the selected pane renders. Review the lines sets the bound <code>SelectedIndex</code> from the page, and the Notes pane holds a button of its own. Pick a theme and a layout with the buttons (One row and Wrapping rows differ only when the tabs overflow), or right-click the tabs: every tab control carries that menu, and <code>&#64;bind-Theme</code> and <code>&#64;bind-Orientation</code> keep the page in step.</p></Description>
            <Controls>
                <div class="pickers">
                    <ButtonGroupControl Items="_themeItems" Values="@(new[] { _tabTheme.ToString() })" ValuesChanged="SetTabTheme" Selection="ChoiceSelectionMode.Single" AriaLabel="Tab theme" />
                    <ButtonGroupControl Items="_layoutItems" Values="@(new[] { _tabLayout.ToString() })" ValuesChanged="SetTabLayout" Selection="ChoiceSelectionMode.Single" AriaLabel="Tab layout" />
                </div>
            </Controls>
            <Demo>
                <div class="ta">
                    <div class="leave-tabs">
                        <TabControl @bind-SelectedIndex="_tab" @bind-Theme="_tabTheme" @bind-Orientation="_tabLayout">
                            <TabItems>
                                <TabItem HeaderText="Summary">
                                    <dl class="summary">
                                        <dt>Request</dt><dd>LR-0112 December leave</dd>
                                        <dt>Employee</dt><dd>Albus Door, Tour Operations</dd>
                                        <dt>Status</dt><dd>Awaiting approval, 3 lines</dd>
                                        <dt>Total</dt><dd>8 days</dd>
                                    </dl>
                                    <ButtonControl CssClass="btn-sm" OnClick="() => _tab = 1">Review the lines</ButtonControl>
                                </TabItem>
                                <TabItem HeaderText="Lines">
                                    <table class="lines">
                                        <thead><tr><th>Leave type</th><th>Dates</th><th class="num">Days</th></tr></thead>
                                        <tbody>
                                            <tr><td>Vacation</td><td>Dec 14 to 18</td><td class="num">5</td></tr>
                                            <tr><td>Training day</td><td>Dec 21</td><td class="num">1</td></tr>
                                            <tr><td>Vacation</td><td>Dec 22 to 23</td><td class="num">2</td></tr>
                                        </tbody>
                                    </table>
                                </TabItem>
                                <TabItem HeaderText="Notes">
                                    <Content>
                                        <ul class="notes">
                                            @foreach (var note in _notes)
                                            {
                                                <li>@note</li>
                                            }
                                        </ul>
                                        <ButtonControl CssClass="btn-sm" Disabled="@(_notes.Count == 4)" OnClick="AddNote">Add a note</ButtonControl>
                                    </Content>
                                </TabItem>
                            </TabItems>
                        </TabControl>
                    </div>
                    <p class="result" role="status">Tab @(_tab + 1) of 3 selected · @_notes.Count notes · @_tabTheme, @_tabLayout</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="strip" Title="Document tabs" RazorCode="@Code.Strip" CSharpCode="@Code.StripCs">
            <Description><p>Open leave requests with the buttons above the tabs: each opens as a closable tab, and one that is already open is selected instead of opened twice. Close a tab with its ×, reopen the last one, and right-click the strip to change its theme or orientation; when the tabs no longer fit, <code>EnableOverflowNavigation</code> adds Previous and Next buttons. Payroll is a <code>Disabled</code> tab.</p></Description>
            <Demo>
                <div class="ta">
                    <div class="strip-actions">
                        <span class="result">Open a request:</span>
                        @foreach (var request in Requests)
                        {
                            <ButtonControl CssClass="btn-sm" OnClick="() => Open(request)">@request.Code</ButtonControl>
                        }
                    </div>
                    <div class="@(_orientation == TabOrientation.Vertical ? "docs docs-vertical" : "docs")">
                        <TabStripControl Items="_docs" @bind-SelectedIndex="_doc" OnTabClose="CloseDoc" @bind-Theme="_docTheme" @bind-Orientation="_orientation" EnableOverflowNavigation="true" AriaLabel="Open leave requests" />
                        <div class="strip-pane">@_docs[Math.Clamp(_doc, 0, _docs.Count - 1)].Tag</div>
                    </div>
                    <div class="strip-actions">
                        <ButtonControl CssClass="btn-sm" OnClick="Reopen" Disabled="@(_closed.Count == 0)">Reopen last closed</ButtonControl>
                        <span class="result" role="status">@(_docs.Count - 2) request@(_docs.Count == 3 ? "" : "s") open, @_closed.Count closed · @_docTheme, @_orientation</span>
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="accordion" Title="Accordion" RazorCode="@Code.Accordion" CSharpCode="@Code.AccordionCs">
            <Description><p>Work down the onboarding checklist: checking a step changes the badge in its header, written with <code>HeaderContent</code>, and Sign-off stays <code>Disabled</code> until the three steps are done. Without <code>Multiple</code>, opening one section closes the rest; the switch rebuilds the accordion with it on, so Contract opens again. Unchecking a step while Sign-off is open closes it, because <code>&#64;key</code> rebuilds that item.</p></Description>
            <Controls>
                <SwitchControl @bind-Checked="_several" Label="Several open" />
            </Controls>
            <Demo>
                <div class="ta">
                    <div class="acc">
                        <AccordionControl @key="_several" Multiple="_several">
                            <AccordionItemControl InitiallyExpanded="true">
                                <HeaderContent><span class="acc-head"><span class="bi bi-file-earmark-text"></span> Contract <BadgeControl Text="@Step(_contract)" Variant="@Color(_contract)" Size="BadgeSize.Small" /></span></HeaderContent>
                                <ChildContent><CheckBoxControl @bind-Checked="_contract" Label="Signed contract received from Cedric Diggle" /></ChildContent>
                            </AccordionItemControl>
                            <AccordionItemControl>
                                <HeaderContent><span class="acc-head"><span class="bi bi-laptop"></span> Equipment <BadgeControl Text="@Step(_equipment)" Variant="@Color(_equipment)" Size="BadgeSize.Small" /></span></HeaderContent>
                                <ChildContent><CheckBoxControl @bind-Checked="_equipment" Label="Laptop and headset ordered from IT" /></ChildContent>
                            </AccordionItemControl>
                            <AccordionItemControl>
                                <HeaderContent><span class="acc-head"><span class="bi bi-building"></span> Office <BadgeControl Text="@Step(_office)" Variant="@Color(_office)" Size="BadgeSize.Small" /></span></HeaderContent>
                                <ChildContent><CheckBoxControl @bind-Checked="_office" Label="Desk assigned in the Lisbon office" /></ChildContent>
                            </AccordionItemControl>
                            <AccordionItemControl @key="Ready" Title="@(Ready ? "Sign-off" : "Sign-off (finish the steps above)")" IconCss="bi bi-check2-circle" Disabled="@(!Ready)">
                                Confirm the December 1 start for Cedric Diggle (EMP-0058) and send the welcome email.
                            </AccordionItemControl>
                        </AccordionControl>
                    </div>
                    <p class="result" role="status">@Done of 3 steps done@(Ready ? ": sign-off is unlocked" : "")</p>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-tabcontrol-parameters" Title="TabControl parameters" Count='@DocSection.Label(Vocab.TabControl.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="TabControl parameters" Rows="Vocab.TabControl" />
            </DocSection>
            <DocSection Id="doc-tabitem-parameters" Title="TabItem parameters" Count='@DocSection.Label(Vocab.TabItem.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="TabItem parameters" Rows="Vocab.TabItem" />
            </DocSection>
            <DocSection Id="doc-tabstripcontrol-parameters" Title="TabStripControl parameters" Count='@DocSection.Label(Vocab.Strip.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="TabStripControl parameters" Rows="Vocab.Strip" />
            </DocSection>
            <DocSection Id="doc-tabstripitem" Title="TabStripItem" Count='@DocSection.Label(Vocab.StripItem.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="TabStripItem" Rows="Vocab.StripItem" />
            </DocSection>
            <DocSection Id="doc-accordioncontrol-parameters" Title="AccordionControl parameters" Count='@DocSection.Label(Vocab.Accordion.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="AccordionControl parameters" Rows="Vocab.Accordion" />
            </DocSection>
            <DocSection Id="doc-accordionitemcontrol-parameters" Title="AccordionItemControl parameters" Count='@DocSection.Label(Vocab.AccordionItem.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="AccordionItemControl parameters" Rows="Vocab.AccordionItem" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
            <DocSection Id="doc-css-variables-tabstripcontrol-only" Title="CSS variables (TabStripControl only)" Count='@DocSection.Label(Vocab.Vars.Length, "variables")'>
                <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables (TabStripControl only)" Rows="Vocab.Vars" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li><code>TabControl</code> draws its headers with a <code>TabStripControl</code>, so both render the same tab list: a <code>tablist</code> with <code>aria-orientation</code>, <code>role="tab"</code> headers with <code>aria-selected</code> and <code>aria-disabled</code>, and the selected tab as the single Tab stop.</li>
            <li>On a tab, Left or Up selects the previous enabled tab and Right or Down the next; Home and End select the first and last enabled tab. Focus moves with the selection and shows an outline.</li>
            <li>A closable tab's close button is named "Close <em>tab text</em>" and stays out of the Tab order; Delete on the tab raises <code>OnTabClose</code> as the button does.</li>
            <li>A <code>TabStripControl</code> takes its accessible name from <code>AriaLabel</code>, "Tabs" by default. Set it to what the tabs switch between, as the Document tabs example does with "Open leave requests".</li>
            <li>Each accordion header is a native button with <code>aria-expanded</code> set to "true" or "false", and its arrow is <code>aria-hidden</code>. An open item's body is a <code>role="region"</code>; a <code>Disabled</code> item's header is a disabled button.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Dockable tab groups the user can split and float: <a href="demo/dock-manager">Dock manager</a>. Keyboard focus order across the controls of a page: <a href="demo/page-navigation">Page navigation</a>.</li>
            <li>Side-by-side and collapsible regions: <a href="demo/layout">Page layouts</a>. A navigation tree: <a href="demo/tree/treeview-explorer">Tree view</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Tab control
    private int _tab;
    private TabTheme _tabTheme = TabTheme.FolderTabs;
    private TabOrientation _tabLayout = TabOrientation.Horizontal;
    private readonly SelectionItem[] _themeItems =
    {
        new("WindowsClassic", "Windows"), new("FolderTabs", "Folder"), new("ColorfulCards", "Cards"), new("Minimal", "Minimal"), new("Dark", "Dark")
    };
    private readonly SelectionItem[] _layoutItems =
    {
        new("Horizontal", "One row"), new("HybridVertical", "Wrapping rows"), new("Vertical", "Side rail")
    };
    private readonly List<string> _notes = new() { "Rubeus Haggle covers for Albus in Tour Operations.", "The training day is a first aid course." };
    private static readonly string[] MoreNotes = { "Manager approval is due by Friday.", "Six vacation days remain after this request." };
    private void AddNote() => _notes.Add(MoreNotes[_notes.Count - 2]);
    private void SetTabTheme(IReadOnlyList<string> values)
    {
        if (values.Count > 0) _tabTheme = Enum.Parse<TabTheme>(values[0]);
    }
    private void SetTabLayout(IReadOnlyList<string> values)
    {
        if (values.Count > 0) _tabLayout = Enum.Parse<TabOrientation>(values[0]);
    }

    // Tab strip
    private sealed record LeaveRequest(string Code, string Summary);
    private static readonly LeaveRequest[] Requests =
    {
        new("LR-0112", "December leave for Albus Door, Tour Operations: eight days from December 14, awaiting approval."),
        new("LR-0113", "Sick leave for Minerva McGadget, Finance: two days, November 12 and 13, approved."),
        new("LR-0114", "Parental leave for Nymphadora Tonic, Marketing: twelve weeks from January 4, approved."),
        new("LR-0115", "Training day for Neville Longbutton, IT: one day on November 20, awaiting approval."),
        new("LR-0116", "Vacation for Ginny Measly, Reservations: five days from November 30, draft."),
    };
    private int _doc;
    private readonly List<TabStripItem> _docs = new()
    {
        new("Today", "bi bi-house") { Tag = "Today: new leave requests, requests awaiting approval and absences this week." },
        new("LR-0112", "bi bi-calendar-event", closable: true) { Tag = Requests[0].Summary },
        new("Payroll", "bi bi-receipt") { Disabled = true, Tag = "Not run yet." },
    };
    private readonly Stack<TabStripItem> _closed = new();
    private TabTheme _docTheme = TabTheme.FolderTabs;
    private TabOrientation _orientation = TabOrientation.Horizontal;
    // A request that is already open is selected; a new one goes in before the disabled Payroll tab.
    private void Open(LeaveRequest request)
    {
        var at = _docs.FindIndex(d => d.Text == request.Code);
        if (at < 0)
        {
            at = _docs.Count - 1;
            _docs.Insert(at, new(request.Code, "bi bi-calendar-event", closable: true) { Tag = request.Summary });
        }
        _doc = at;
    }
    private void CloseDoc(int index)
    {
        _closed.Push(_docs[index]);
        _docs.RemoveAt(index);
        // Keep the same tab selected when one before it closes, and step back past the disabled tab.
        if (index < _doc || _doc >= _docs.Count) _doc = Math.Max(0, _doc - 1);
        while (_doc > 0 && _docs[_doc].Disabled) _doc--;
    }
    private void Reopen()
    {
        if (_closed.Count == 0) return;
        var item = _closed.Pop();
        var open = _docs.FindIndex(d => d.Text == item.Text);
        if (open >= 0) { _doc = open; return; }   // reopened from the buttons already: select it
        _docs.Insert(_docs.Count - 1, item);
        _doc = _docs.Count - 2;
    }

    // Accordion
    private bool _several, _contract = true, _equipment, _office;
    private int Done => (_contract ? 1 : 0) + (_equipment ? 1 : 0) + (_office ? 1 : 0);
    private bool Ready => Done == 3;
    private static string Step(bool done) => done ? "Done" : "To do";
    private static BadgeVariant Color(bool done) => done ? BadgeVariant.Success : BadgeVariant.Secondary;

    // Vocabulary rows, one per public member (0.2.50).
    private static class Vocab
    {
        public static readonly ApiRow[] TabControl =
        {
            new("SelectedIndex", "Index of the visible pane. Two-way with <code>@bind-SelectedIndex</code>.", "int", "0"),
            new("SelectedIndexChanged", "Fires when a different header is selected, by a click or by the arrow keys, Home or End.", "EventCallback&lt;int&gt;"),
            new("ChildContent", "<code>TabItem</code>s, optionally inside a <code>TabItems</code> wrapper. Order follows declaration for items present on the first render. An item rendered later is added at the end, and one removed from the markup keeps its header and pane.", "RenderFragment?"),
            new("CssClass", "Appended to the <code>fx-tabs</code> root. There is no <code>Style</code>; this control does not derive from <code>FlexControlBase</code>.", "string?", "null"),
            new("Orientation", "Layout of the header strip, passed to its <code>TabStripControl</code>: <code>HybridVertical</code> wraps the headers onto rows, <code>Horizontal</code> keeps one scrolling row, <code>Vertical</code> puts a rail beside the pane, 220 px wide or 35% of the control if that is less. Two-way with <code>@bind-Orientation</code>. The strip's right-click menu and overflow buttons are always on here; the control has no switch for them.", "TabOrientation", "TabOrientation.HybridVertical"),
