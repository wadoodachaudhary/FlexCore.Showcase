@code {
    private List<SecurityGroup> _groups = [];
    private List<UserListItem> _users = [];
    private List<UserListItem> _members = [];
    private SecurityGroup? _selectedGroup;

    private readonly SelectionSettings _singleRow = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };
    private readonly GridControlEvents<SecurityGroup> _groupEvents = new();

    protected override void OnInitialized()
    {
        _groups = BenchData.SecurityGroups.ToList();
        _users = BenchData.Users.ToList();
        _groupEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<SecurityGroup>>(this, args => Show(args.Data));
        Show(_groups.FirstOrDefault());
    }

    private void Show(SecurityGroup? group)
    {
        _selectedGroup = group;
        _members = group is null ? [] : _users.Where(u => u.GroupID == group.GroupID).ToList();
    }

    private GridControl<InventoryProduct>? _grid;
    private readonly List<InventoryProduct> _products = BenchDataStore.GetInventoryProducts();
    private List<InventoryProduct>? _shown;
    private List<InventoryProduct> Shown => _shown ??= _products.ToList();
    private SelectionItem[]? _categoryItems;
    private SelectionItem[] CategoryItems => _categoryItems ??= [new("All", "All"), .. _products.Select(p => p.Category).Distinct().Select(c => new SelectionItem(c, c))];
    private string _category = "All";
    private InventoryProduct? _open;

    private async Task Filter(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _category = values[0];
        _shown = _category == "All" ? _products.ToList() : _products.Where(p => p.Category == _category).ToList();
        if (_open is not null && !_shown.Contains(_open) && _grid is not null) await _grid.CollapseRow(_open);
    }

    private void Opened(InventoryProduct product) => _open = product;

    private void Closed(InventoryProduct product)
    {
        if (ReferenceEquals(_open, product)) _open = null;
    }

    private static void Receive(InventoryProduct product)
    {
        var stock = product.WarehouseDetails.MaxBy(w => w.IncomingShipmentQty);
        if (stock is null || stock.IncomingShipmentQty == 0) return;
        stock.QuantityOnHand += stock.IncomingShipmentQty;
        product.TotalOnHand += stock.IncomingShipmentQty;
        stock.IncomingShipmentQty = 0;
    }

    private static void Reserve(InventoryProduct product)
    {
        var stock = product.WarehouseDetails.FirstOrDefault(w => w.AvailableQuantity >= 10);
        if (stock is null) return;
        stock.ReservedQuantity += 10;
        product.TotalReserved += 10;
    }

