@page "/demo/pivot-formulas"
@using Fx.ControlKit.Grid

<PageTitle>Pivot Tables - FlexCore</PageTitle>

<div class="docs-page pivot-docs">
    <h1>Multi-Level Pivot Table</h1>
    <p>
        <code>PivotControl</code> builds Excel-style pivot tables with multi-level column headers,
        row-level grouping with subtotals, drag-and-drop field configuration, report filters,
        and multiple value fields. It also integrates with <code>GridControl</code> formula columns.
    </p>

    @* ════════════════════════════════════════════════════════════════
       Section 1 — Interactive Pivot Builder
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>Interactive Pivot Builder</h2>
        <p>
            Drag fields from the <strong>Available Fields</strong> list into the
            <strong>Rows</strong>, <strong>Columns</strong>, <strong>Values</strong>, or
            <strong>Filters</strong> areas. The pivot table updates instantly. Change the
            aggregation type on value fields using the dropdown.
        </p>
        <div class="demo-frame" style="min-height:540px;">
            <PivotControl TValue="SaleRecord"
                          DataSource="@_interactiveSales"
                          RowFields="@(new[] { "Country" })"
                          ColumnFields="@(new[] { "Quarter" })"
                          ValueField="Amount"
                          Aggregation="AggregateType.Sum"
                          ValueFormat="C0"
                          Interactive="true"
                          ShowSubTotals="true"
                          ShowGrandTotals="true"
                          FieldLabels="@_fieldLabels"
                          Height="420px" />
        </div>
        <pre><code>&lt;PivotControl TValue="SaleRecord"
              DataSource="@@_sales"
              RowFields="@@(new[] { "Country" })"
              ColumnFields="@@(new[] { "Quarter" })"
              ValueField="Amount"
              Interactive="true"
              ShowSubTotals="true"
              ShowGrandTotals="true" /&gt;</code></pre>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 2 — How It Works (Documentation)
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>How the Pivot Builder Works</h2>
        <p>
            The interactive builder mirrors Excel's PivotTable Fields pane.
            Each field in your data model can be placed into one of four areas:
        </p>
        <div class="api-grid api-grid-2">
            <article>
                <h3>≡ Rows</h3>
                <p>
                    Row fields define the left-hand labels of the pivot table.
                    With multiple row fields, the first field groups rows with
                    <code>rowspan</code> and subtotals are inserted per group.
                </p>
            </article>
            <article>
                <h3>⊞ Columns</h3>
                <p>
                    Column fields create the horizontal dimension. With multiple
                    column fields, multi-level headers are rendered using
                    <code>colspan</code> — the first field spans the second.
                </p>
            </article>
            <article>
                <h3>Σ Values</h3>
                <p>
                    Value fields supply the numbers. Each value field can use a
                    different aggregation: <strong>Sum</strong>, <strong>Count</strong>,
                    <strong>Average</strong>, <strong>Min</strong>, or <strong>Max</strong>.
                    Multiple value fields add sub-columns under each column key.
                </p>
            </article>
            <article>
                <h3>⊞ Filters</h3>
                <p>
                    Filter fields add dropdown selectors above the pivot. Choosing a
                    value narrows the data before grouping — like Excel's Report Filter area.
                </p>
            </article>
        </div>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 3 — Multiple Row Fields
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>Multiple Row Fields</h2>
        <p>
            When two or more fields are in the <strong>Rows</strong> area, the first field
            becomes a group header. Its cell spans all detail rows plus the subtotal row.
            This is equivalent to Excel's "Group and Outline" for pivot row labels.
        </p>
        <div class="demo-frame">
            <PivotControl TValue="SaleRecord"
                          DataSource="@_interactiveSales"
                          RowFields="@(new[] { "Country", "Category" })"
                          ColumnFields="@(new[] { "Quarter" })"
                          ValueField="Amount"
                          Aggregation="AggregateType.Sum"
                          ValueFormat="C0"
                          ShowSubTotals="true"
                          ShowGrandTotals="true"
                          Height="480px" />
        </div>
        <pre><code>&lt;PivotControl TValue="SaleRecord"
              RowFields="@@(new[] { "Country", "Category" })"
              ColumnFields="@@(new[] { "Quarter" })"
              ValueField="Amount"
              ShowSubTotals="true" /&gt;</code></pre>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 4 — Multiple Column Fields (Multi-Level Headers)
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>Multiple Column Fields</h2>
        <p>
            Placing two fields in <strong>Columns</strong> creates multi-level headers.
            The first column field (<code>Quarter</code>) spans the values of the second
            field (<code>Category</code>). This matches Excel's nested column labels.
        </p>
        <div class="demo-frame">
            <PivotControl TValue="SaleRecord"
                          DataSource="@_interactiveSales"
                          RowFields="@(new[] { "Country" })"
                          ColumnFields="@(new[] { "Quarter", "Category" })"
                          ValueField="Amount"
                          Aggregation="AggregateType.Sum"
                          ValueFormat="C0"
                          ShowGrandTotals="true"
                          Height="300px" />
        </div>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 5 — Multiple Value Fields
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>Multiple Value Fields</h2>
        <p>
            Use the <code>ValueFields</code> parameter to aggregate more than one
            measure. Each value field can have its own aggregation and format.
            Below, <strong>Sum of Amount</strong> and <strong>Count of Quantity</strong>
            appear side by side under each column group.
        </p>
        <div class="demo-frame">
            <PivotControl TValue="SaleRecord"
                          DataSource="@_interactiveSales"
                          RowFields="@(new[] { "Country" })"
                          ColumnFields="@(new[] { "Quarter" })"
                          ValueFields="@_multiValueFields"
                          ShowGrandTotals="true"
                          Height="300px" />
        </div>
        <pre><code>&lt;PivotControl TValue="SaleRecord"
              RowFields="@@(new[] { "Country" })"
              ColumnFields="@@(new[] { "Quarter" })"
              ValueFields="@@_multiValueFields" /&gt;

@@code {
    PivotValueConfig[] _multiValueFields = [
        new() { Field = "Amount",   Aggregation = Sum,   Format = "C0" },
        new() { Field = "Quantity", Aggregation = Count, Format = "N0" }
    ];
}</code></pre>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 6 — Grid Formula Cells
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>Grid Formula Cells</h2>
        <p>
            <code>GridControl</code> supports computed columns via <code>GridColumn.Formula</code>
            and cell-level <code>=</code> formulas when <code>AllowCellFormulas</code> is enabled.
        </p>
        <div class="demo-frame">
            <GridControl TValue="Sale" DataSource="@_sales.Take(8).ToList()"
                         AllowCellFormulas="true"
                         AllowSorting="true"
                         AllowFiltering="true"
                         AllowResizing="true"
                         Height="360px">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(Sale.Region)" HeaderText="Region" Width="120px" />
                    <GridColumn Field="@nameof(Sale.Rep)" HeaderText="Rep" Width="140px" />
                    <GridColumn Field="@nameof(Sale.Product)" HeaderText="Product" Width="120px" />
                    <GridColumn Field="@nameof(Sale.Revenue)" HeaderText="Revenue" Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" Width="120px" />
                    <GridColumn Field="@nameof(Sale.Cost)" HeaderText="Cost" Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" Width="120px" />
                    <GridColumn Field="GrossMargin" HeaderText="Gross Margin" Formula="[Revenue] - [Cost]" Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" Width="140px" />
                    <GridColumn Field="MarginPct" HeaderText="Margin %" Formula="([Revenue] - [Cost]) / [Revenue]" Type="ColumnType.Number" Format="P1" TextAlign="TextAlign.Right" Width="120px" />
                    <GridColumn Field="@nameof(Sale.CommissionFormula)" HeaderText="Commission" Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" Width="130px" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </section>

    @* ════════════════════════════════════════════════════════════════
       Section 7 — API Reference
       ════════════════════════════════════════════════════════════════ *@
    <section>
        <h2>PivotControl API</h2>
        <div class="api-grid">
            <article>
                <h3>RowFields / ColumnFields</h3>
                <p>String arrays naming the data fields used for row labels and column headers.</p>
            </article>
            <article>
                <h3>ValueField / ValueFields</h3>
                <p>Single field + aggregation, or a list of <code>PivotValueConfig</code> for multiple measures.</p>
            </article>
            <article>
                <h3>Interactive</h3>
                <p>Set <code>true</code> to show the drag-and-drop field builder panel alongside the table.</p>
            </article>
            <article>
                <h3>ShowSubTotals / ShowGrandTotals</h3>
                <p>Insert per-group subtotal rows and a grand total row at the bottom.</p>
            </article>
            <article>
                <h3>FieldLabels</h3>
                <p>Optional <code>Dictionary&lt;string, string&gt;</code> mapping field names to friendly display labels.</p>
            </article>
            <article>
                <h3>Aggregation Types</h3>
                <p>Sum, Count, Average, Min, Max — set per value field in <code>PivotValueConfig</code>.</p>
            </article>
        </div>
    </section>
</div>

