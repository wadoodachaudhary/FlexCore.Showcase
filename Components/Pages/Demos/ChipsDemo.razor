@page "/demo/chips"
@using FlexCore.Showcase.Components.Shared

@* 2026-11-14: new page for ChipListControl and ChipControl. Facts from ChipListControl.razor, ChipControl.razor(.css),
   ContentModels.cs, FlexControlBase.cs (FlexCore 0.2.50).
   2026-11-15: examples rebuilt (trip filter, special requests, flight quote); events in their own table.
   2026-11-15: example story moved to the Project management theme. *@

<PageTitle>Blazor Chip and Chip List — FlexCore</PageTitle>

<FeatureDemoLayout Title="Chips" Category="Components" ControlName="ChipListControl · ChipControl"
                   Tagline="Let users filter a view, pick tags or toggle options with compact chips."
                   SourcePath="ChipListControl.razor; ChipControl.razor">
    <Overview>
        <p>
            <code>ChipListControl</code> is a Blazor chip list: small pills users pick to filter a view or choose tags, and remove with one click. Use it, rather than a dropdown, when the options should stay in sight, such as task-label filters or a task's review notes; <code>&#64;bind-SelectedIds</code> keeps the picks and <code>&#64;bind-Items</code> the removals up to date. Use <code>ChipControl</code> on its own for a single toggle, action or dismissible pill.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="filter" Title="Filter chips" RazorCode="@Code.Filter" CSharpCode="@Code.FilterCs">
            <Description><p>Pick labels to filter the task list, and pick one again to drop it; with none picked, all six tasks show: <code>ChoiceSelectionMode.Multiple</code> allows several chips, <code>Removable="false"</code> hides the ×, and QA is disabled through its <code>ChipItem</code>.</p></Description>
            <Demo>
                <div class="ch">
                    <ChipListControl Items="_labels" @bind-SelectedIds="_picked" Selection="ChoiceSelectionMode.Multiple" Removable="false" AriaLabel="Task label" />
                    <ul class="tasks">
                        @foreach (var task in Shown)
                        {
                            <li><span class="task-icon @_labels.First(l => l.Id == task.Label).IconCss" aria-hidden="true"></span><span class="task-name">@task.Name</span><span class="task-label">@task.Label</span></li>
                        }
                    </ul>
                    <span class="result" role="status">@(_picked.Count == 0 ? $"Showing all {_tasks.Length} tasks" : $"Showing {Shown.Length} of {_tasks.Length} tasks: {string.Join(", ", _picked)}")</span>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="tags" Title="Removable tags" RazorCode="@Code.Tags" CSharpCode="@Code.TagsCs">
            <Description><p>Add a review note, remove one with ×, and pick the ones the developer has fixed: <code>&#64;bind-Items</code> tracks the list, <code>&#64;bind-SelectedIds</code> the picks, and Remove fixed calls <code>RemoveAsync</code> from code.</p></Description>
            <Demo>
                <div class="ch">
                    <div class="lbl"><span class="bi bi-card-checklist" aria-hidden="true"></span>WEB-117 Order form: review notes from Hermione Ranger</div>
                    <ChipListControl @ref="_list" @bind-Items="_notes" @bind-SelectedIds="_fixed" AriaLabel="Review notes" />
                    <form class="demo-row mt" @onsubmit="AddNote">
                        <TextBoxControl @bind-Value="_new" UpdateOnInput="true" Placeholder="Add a note" Width="200px" aria-label="New note" />
                        <ButtonControl ButtonType="submit" CssClass="btn-primary btn-sm" Disabled="@string.IsNullOrWhiteSpace(_new)">Add</ButtonControl>
                        <ButtonControl CssClass="btn-sm" Disabled="@(_fixed.Count == 0)" OnClick="RemoveFixedAsync">Remove fixed</ButtonControl>
                        <ButtonControl CssClass="btn-sm" OnClick="ResetNotes">Reset</ButtonControl>
                    </form>
                    <span class="result" role="status">Review notes: @_notes.Count, fixed by the developer: @_fixed.Count</span>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="chip" Title="Single chips" RazorCode="@Code.Chip" CSharpCode="@Code.ChipCs">
            <Description><p>Use <code>ChipControl</code> alone on a change request estimate: a toggle, an action with <code>Selectable="false"</code> and its own label markup, a discount that can be dismissed and applied again, and a disabled chip.</p></Description>
            <Demo>
                <div class="ch">
                    <div class="demo-row">
                        <ChipControl Text="Rush delivery" IconCss="bi bi-lightning-charge" @bind-Selected="_rush" />
                        <ChipControl IconCss="bi bi-file-earmark-plus" Selectable="false" OnClick="@(() => _pages++)">Add a page · <strong>@_pages</strong></ChipControl>
                        @if (_discount)
                        {
                            <ChipControl Text="Repeat client discount" IconCss="bi bi-tag" Selectable="false" Removable="true" OnRemove="@(() => _discount = false)" />
                        }
                        else
                        {
                            <ChipControl Text="Apply discount" IconCss="bi bi-plus-lg" Selectable="false" OnClick="@(() => _discount = true)" />
                        }
                        <ChipControl Text="Sprint 8: full" Enabled="false" />
                    </div>
                    <span class="result" role="status">Change request for Green Fork Cafe: @_pages extra pages@(_rush ? ", rush delivery" : "")@(_discount ? ", 10% off" : "") = @Estimate.ToString("C0")</span>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-chiplistcontrol-parameters" Title="ChipListControl parameters" Count='@DocSection.Label(Vocab.List.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="ChipListControl parameters" Rows="Vocab.List" />
            </DocSection>
            <DocSection Id="doc-chipcontrol-parameters" Title="ChipControl parameters" Count='@DocSection.Label(Vocab.Chip.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="ChipControl parameters" Rows="Vocab.Chip" />
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-chipitem" Title="ChipItem" Count='@DocSection.Label(Vocab.Item.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="ChipItem" Rows="Vocab.Item" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The list is a <code>role="group"</code> named by <code>AriaLabel</code> ("Chips" by default); set it to say what the chips stand for.</li>
            <li>A chip's label is a native <code>&lt;button&gt;</code> with <code>aria-pressed</code>, "true" when picked (left out when <code>Selectable="false"</code>); Space and Enter toggle it. A picked chip also turns blue.</li>
            <li>The × is a second native button named "Remove" plus the chip's <code>Text</code>. Enter or Space on it raises <code>OnRemove</code>, and in a <code>ChipListControl</code> the chip is removed.</li>
            <li>Tab moves through every chip and every ×; the buttons of a disabled chip are skipped.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>One choice or several from buttons: <a href="demo/toggle-buttons">Toggle buttons</a> (ButtonGroupControl and SegmentedControl).</li>
            <li>A status label that is not clickable: <code>BadgeControl</code> in <a href="demo/new-components#status">UI elements</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Filter
    private readonly ChipItem[] _labels =
    {
        new("Design", "Design", IconCss: "bi bi-palette"),
        new("Frontend", "Frontend", IconCss: "bi bi-code-slash"),
        new("Content", "Content", IconCss: "bi bi-file-text"),
        new("QA", "QA", Disabled: true, IconCss: "bi bi-bug"),
    };
    private IReadOnlyList<string> _picked = new[] { "Frontend" };
    private sealed record TaskItem(string Name, string Label);
    private readonly TaskItem[] _tasks =
    {
        new("WEB-101 Style guide", "Design"), new("WEB-102 Logo refresh", "Design"), new("WEB-113 Site footer", "Frontend"),
        new("WEB-117 Order form", "Frontend"), new("WEB-121 Menu copy", "Content"), new("WEB-122 About page", "Content"),
    };
    private TaskItem[] Shown => _tasks.Where(t => _picked.Count == 0 || _picked.Contains(t.Label)).ToArray();

    // Tags
    private static readonly ChipItem[] Seed =
    {
        new("contrast", "Button contrast"), new("alt", "Missing alt text"), new("mobile", "Cramped on mobile"), new("error", "Vague error text"),
    };
    private ChipListControl? _list;
    private IReadOnlyList<ChipItem> _notes = Seed;
    private IReadOnlyList<string> _fixed = new[] { "alt" };
    private string? _new;
    private int _next;
    private void AddNote()
    {
        if (string.IsNullOrWhiteSpace(_new)) return;
        _notes = _notes.Append(new ChipItem($"new{_next++}", _new.Trim())).ToList();
        _new = null;
    }
    private async Task RemoveFixedAsync()
    {
        foreach (var id in _fixed.ToArray()) await _list!.RemoveAsync(id);
    }
    private void ResetNotes()
    {
        _notes = Seed;
        _fixed = new[] { "alt" };
    }

    // Single chips
    private bool _rush = true, _discount = true;
    private int _pages = 2;
    private decimal Estimate => _pages * (400 + (_rush ? 50 : 0)) * (_discount ? 0.9m : 1m);

