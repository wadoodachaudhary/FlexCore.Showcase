            new Item("AMF-0002 Brennan", "9 lines · Booked · $6,240", new[] { ("Traveller", "Liam Brennan"), ("Status", "Booked"), ("Lines", "9"), ("Total", "$6,240") }),
        },
        ["Suppliers"] = new[]
        {
            new Item("Meridian Airways", "Net 30 · 3 open bookings", new[] { ("Contact", "J. Ortiz"), ("Terms", "Net 30"), ("Open bookings", "3") }),
            new Item("Hotel Lisbon Central", "Net 15 · 1 open booking", new[] { ("Contact", "P. Reyes"), ("Terms", "Net 15"), ("Open bookings", "1") }),
            new Item("Lisbon Walks", "Prepaid · no open bookings", new[] { ("Contact", "M. Chen"), ("Terms", "Prepaid"), ("Open bookings", "0") }),
        },
        ["Settings"] = new[]
        {
            new Item("Company", "Showcase Travel · USD · fiscal year starts in July", new[] { ("Currency", "USD"), ("Fiscal year", "July"), ("Users", "12") }),
            new Item("Numbering", "Requests by destination code (LIS-####, KYO-####), invoices INV-####", new[] { ("Requests", "City code-####"), ("Invoices", "INV-####") }),
        },
    };
    private string _section = "Requests";
    private Item _selected = null!;
    private void Go(string section) { _section = section; _selected = _data[section][0]; }

    // Dashboard: placements come from state so a click re-flows the grid.
    private sealed record Kpi(string Key, string Value, string Label, string Trend, string Detail);
    private readonly Kpi[] _kpis =
    {
        new("orders", "1,234", "Orders", "+5.2%", "1,234 this week, 1,173 last week"),
        new("revenue", "$89K", "Revenue", "+12%", "$89K this week, $79K last week"),
        new("uptime", "98.5%", "Uptime", "+0.1%", "98.5% over 30 days, 2 incidents"),
    };
    private string? _focus;
    private Dictionary<string, (int Row, int Col, int SizeX, int SizeY)> _place = new();
    private int ChartsRow => _focus is null ? 2 : 4;   // KPI rows 0–1, or 0–3 while one is expanded
    protected override void OnInitialized() { _selected = _data["Requests"][1]; Layout(); }
    private void Toggle(string key) { _focus = _focus == key ? null : key; Layout(); }
    private void Layout()
    {
        _place.Clear();
        var col = 0;
        if (_focus is not null) _place[_focus] = (0, 0, 3, 2);            // expanded card takes the whole first row
        foreach (var k in _kpis.Where(k => k.Key != _focus))
            _place[k.Key] = (_focus is null ? 0 : 2, col++, 1, 2);        // the rest line up below it
    }

    private readonly List<ChartSeries> _traffic = new()
    {
        new() { Name = "Visits", DataPoints = new() { new("Mon", 120), new("Tue", 180), new("Wed", 210), new("Thu", 190), new("Fri", 250), new("Sat", 140), new("Sun", 100) } }
    };
    private readonly List<ChartSeries> _sources = new()
    {
        new() { Name = "Traffic", DataPoints = new() { new("Organic", 55), new("Paid", 25), new("Referral", 15), new("Direct", 5) } }
    };

    // Grid and stack: one package from TravelData; the column buttons, the wrap switch and the two buttons change page state.
    private static readonly TravelData.Package _pkg = TravelData.Packages[0];   // Lisbon Explorer, 7 nights
    private static readonly string _country = TravelData.Destinations.First(d => d.City == _pkg.City).Country;
    private static readonly string[] _services = { "Airport transfers", "Seven nights in a guesthouse", "Old-town walking tour", "Sintra day trip", "Fado evening with dinner", "City transport pass" };
    private int _season, _columns = 3;
    private bool _wrapTags = true, _held;
    private string GridColumns => $"repeat({_columns},minmax(0,1fr))";
    private (string Label, string Value)[] Fields => new[]
    {
        ("Destination", $"{_pkg.City}, {_country}"),
        ("Region", _pkg.Region),
        ("Nights", _pkg.Nights.ToString()),
        ("Season", TravelData.Seasons[_season]),
        ("Group size", "Up to 12"),
        ("Departs", "Saturdays"),
    };
    private readonly SelectionItem[] _columnItems = { new("1", "1 column"), new("2", "2 columns"), new("3", "3 columns") };
    private void PickColumns(IReadOnlyList<string> values) => _columns = int.Parse(values[0]);
    private void NextSeason() => _season = (_season + 1) % TravelData.Seasons.Length;

