@page "/demo/charts"
@using Fx.ControlKit.Charts
@using FlexCore.Showcase.Services
@* Retitled 2026-10-06 to match the site nav; copy unchanged. *@

<PageTitle>Charts — FlexCore Showcase</PageTitle>

<h1>Charts</h1>
<p>Pure SVG charting with 30+ visualization types — no JavaScript dependencies. Configure via <code>ChartType</code> enum and <code>Series</code> data binding.</p>

<TabControl>
    <TabItem HeaderText="Comparison">
        <h2>Bar Charts</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Bar" Title="Vertical Bar" Height="250px"
                                  Series="@(new List<ChartSeries> { new() { Name = "Revenue", DataPoints = new() {
                                      new("Q1", 120), new("Q2", 180), new("Q3", 240), new("Q4", 310) } } })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.GroupedBar" Title="Grouped Bar" Height="250px"
                                  Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedBar" Title="Stacked Bar" Height="250px"
                                  Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedBar100" Title="100% Stacked Bar" Height="250px"
                                  Series="@_groupedBarSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Trend">
        <h2>Line &amp; Area Charts</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Line" Title="Line Chart" Height="250px"
                                  Series="@_lineSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Area" Title="Area Chart" Height="250px"
                                  Series="@(new List<ChartSeries> { _lineSeries[0] })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Spline" Title="Spline Chart" Height="250px"
                                  Series="@(new List<ChartSeries> { _lineSeries[0] })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.StackedArea" Title="Stacked Area" Height="250px"
                                  Series="@_lineSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Part-to-Whole">
        <h2>Pie, Donut, Funnel &amp; Sunburst</h2>
        <DashboardLayoutControl Columns="3" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Pie" Title="Pie Chart" Height="280px"
                                  Series="@(new List<ChartSeries> { _pieSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Donut" Title="Donut Chart" Height="280px"
                                  InnerRadius="0.55"
                                  Series="@(new List<ChartSeries> { _pieSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="2" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Funnel" Title="Funnel Chart" Height="280px"
                                  Series="@(new List<ChartSeries> { _funnelSeries })" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="3" SizeY="1">
                    <div class="d-flex justify-content-between align-items-center mb-2 px-2 pt-2">
                        <h4 class="mb-0" style="font-size: 1.1rem; font-weight: 700;">COVID-19 Radial Sunburst Chart</h4>
                        <a href="demo/charts/sunburst" class="btn btn-sm btn-primary">Open Full Interactive COVID-19 Screen ↗</a>
                    </div>
                    <SunburstChartControl RootNode="@_sunburstDemoNode" Height="420px" EnableDrilldown="true" ShowBreadcrumb="true" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Distribution">
        <h2>Histogram &amp; Box Plot</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Histogram" Title="Histogram" Height="280px"
                                  Series="@_histogramSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.BoxPlot" Title="Box Plot" Height="280px"
                                  Series="@_boxPlotSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Correlation">
        <h2>Scatter &amp; Bubble</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Scatter" Title="Scatter Plot" Height="280px"
                                  Series="@_scatterSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Bubble" Title="Bubble Chart" Height="280px"
                                  Series="@_bubbleSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Multivariate">
        <h2>Radar / Spider Chart</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Radar" Title="Skills Assessment" Height="350px"
                          Series="@_radarSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="KPI & Gauge">
        <h2>Single Value Indicators</h2>
        <DashboardLayoutControl Columns="3" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.KpiCard" Title="Revenue"
                                  KpiValue="$2.4M" KpiLabel="Total Revenue" KpiTrend="+12.5%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.KpiCard" Title="Users"
                                  KpiValue="18,429" KpiLabel="Active Users" KpiTrend="+8.2%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="2" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.KpiCard" Title="Churn"
                                  KpiValue="3.1%" KpiLabel="Monthly Churn" KpiTrend="-0.4%" Height="180px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Gauge" Title="CPU Usage"
                                  GaugeValue="72" GaugeMin="0" GaugeMax="100" Height="200px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Gauge" Title="Memory"
                                  GaugeValue="45" GaugeMin="0" GaugeMax="100" Height="200px" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="1" Column="2" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Gauge" Title="Disk I/O"
                                  GaugeValue="88" GaugeMin="0" GaugeMax="100" Height="200px" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Statistical">
        <h2>Waterfall &amp; Pareto</h2>
        <DashboardLayoutControl Columns="2" CellSpacing="@(new double[] { 16, 16 })">
            <DashboardLayoutPanels>
                <DashboardLayoutPanel Row="0" Column="0" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Waterfall" Title="Profit Waterfall" Height="280px"
                                  Series="@_waterfallSeries" />
                </DashboardLayoutPanel>
                <DashboardLayoutPanel Row="0" Column="1" SizeX="1" SizeY="1">
                    <ChartControl Type="ChartType.Pareto" Title="Defect Pareto" Height="280px"
                                  Series="@_paretoSeries" />
                </DashboardLayoutPanel>
            </DashboardLayoutPanels>
        </DashboardLayoutControl>
    </TabItem>

    <TabItem HeaderText="Project">
        <h2>Gantt Chart</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Gantt" Title="Project Timeline" Height="300px"
                          Series="@_ganttSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="Heatmap">
        <h2>Heatmap Matrix</h2>
        <div class="demo-frame">
            <ChartControl Type="ChartType.Heatmap" Title="Weekly Activity" Height="300px"
                          Series="@_heatmapSeries" />
        </div>
    </TabItem>

    <TabItem HeaderText="Sparkline">
        <h2>Inline Sparklines</h2>
        <div class="demo-frame">
            <p>Revenue: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 10), new("", 25), new("", 18), new("", 32), new("", 28), new("", 40), new("", 35) } } })" /></p>
            <p>Users: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          ColorPalette="@(new[] { "#16a34a" })"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 5), new("", 12), new("", 8), new("", 20), new("", 18), new("", 25), new("", 30) } } })" /></p>
            <p>Errors: <ChartControl Type="ChartType.Sparkline" Width="120px" Height="24px"
                          ColorPalette="@(new[] { "#dc2626" })"
                          Series="@(new List<ChartSeries> { new() { DataPoints = new() {
                              new("", 8), new("", 3), new("", 5), new("", 2), new("", 6), new("", 1), new("", 3) } } })" /></p>
        </div>
    </TabItem>
</TabControl>

