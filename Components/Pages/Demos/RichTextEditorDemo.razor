@page "/demo/rich-text-editor"
@using System.Net
@using System.Text.RegularExpressions

@* 2026-10-25: new page on FeatureDemoLayout (SC-347); two examples (document, comment). Facts checked against EditorControl.razor,
   EditorControl.razor.cs, EditorControl.Commands.cs, EditorCommandModels.cs, EditorModels.cs, FormatControl.razor and its stylesheet,
   EditorDropDownControl.razor, EditorButtonControl.razor, EditorLiteControl.razor, EditorLiteControl.razor.cs, EditorLiteModels.cs and
   wwwroot/editor-control.js in FlexCore 0.2.49 (main 58a62e0). Nothing in the library calls FormatControl; the wiring below follows the
   control's titles ("applies to the current selection", "applies to the whole document") and EditorControl's public methods.
   The letter uses one-word font names: the browser writes a multi-word family with double quotes, which the read-back drops. *@

<PageTitle>Rich text editor — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Rich text editor" Category="Components" ControlName="EditorControl · FormatControl · EditorLiteControl"
                   Tagline="A block editor for letters and long documents, a formatting toolbar to drive it, and a light editor for notes."
                   SourcePath="EditorControl.razor.cs; EditorControl.Commands.cs; FormatControl.razor; EditorLiteControl.razor.cs; editor-control.js">
    <Overview>
        <p>
            Three controls from <code>Fx.ControlKit.Editor</code>. <code>EditorControl</code> takes a list of <code>EditorBlock</code> records
            (paragraphs, two heading levels, images and page breaks), writes them into one <code>contenteditable</code> element, and from then on
            the browser owns the text. <code>ReadBlocksAsync</code> and <code>OnBlocksChanged</code> hand it back as blocks, with inline markup cut
            down to bold, italic, underline, <code>s</code>, line breaks and styled spans. <code>FormatControl</code> is a formatting toolbar with no
            editor of its own: it raises callbacks, and the page calls the editor. <code>EditorLiteControl</code> is a smaller editor with its own
            toolbar and lists, bound to an HTML string.
        </p>
        <p>
            Selection, formatting, undo snapshots and search for <code>EditorControl</code>, and paste cleanup and format conversion for
            <code>EditorLiteControl</code>, run in the library's <code>editor-control.js</code>. Both controls import it as a module on their first
            render, so the page needs no script tag.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="document" Title="A document with its formatting toolbar" RazorCode="@Code.Document" CSharpCode="@Code.DocumentCs" CssCode="@Code.DocumentCss">
            <Description>
                <p>
                    <code>FormatControl</code> only raises callbacks, so each one is connected to an <code>EditorControl</code> method: B, I, U and S
                    to <code>ExecFormatCommandAsync</code>, Font and Size to <code>ApplyInlineStyleAsync</code>, which acts only on selected text, Line to
                    <code>ApplyBlockStyleAsync</code>, the alignment buttons to <code>SetBlockAlignmentAsync</code>, and Width to the
                    <code>PageWidth</code> parameter. H1 and H2 call <code>ApplyHeadingStyleAsync</code>, which gives the selected text a heading's font,
                    size and weight but leaves the paragraph a paragraph. The letter is one chapter heading, two section headings and paragraphs; there is
                    no list block, so the day-by-day plan is three paragraphs.
                </p>
                <p>
                    With <code>EnableHistory</code> on, Undo and Redo follow <code>HistoryChanged</code>, and the line under the letter is recounted from
                    every <code>OnBlocksChanged</code>. Find and replace, or Ctrl+F (⌘F) in the letter, opens the control's search panel; Start over calls
                    <code>PushAsync</code>, which writes the original blocks back and clears the history.
                </p>
            </Description>
            <Demo>
                <div class="doc">
                    <div class="doc-bar">
                        <ButtonControl Disabled="@(!_history.CanUndo)" OnClick="Undo">Undo (@_history.UndoCount)</ButtonControl>
                        <ButtonControl Disabled="@(!_history.CanRedo)" OnClick="Redo">Redo (@_history.RedoCount)</ButtonControl>
                        <ButtonControl OnClick="FindReplace">Find and replace</ButtonControl>
                        <ButtonControl OnClick="StartOver">Start over</ButtonControl>
                    </div>
                    <FormatControl FontFamily="@_font" FontSizePx="_size" PageWidth="@_width.ToString()" LineHeight="@_line"
                                   FontFamilyOptions="Fonts" FontSizeOptions="Sizes" PageWidthOptions="Widths" LineHeightOptions="Lines"
                                   OnFontFamilyChanged="PickFont" OnFontSizeChanged="PickSize"
                                   OnPageWidthChanged="PickWidth" OnLineHeightChanged="PickLine"
                                   OnBoldClicked='() => Format("bold")' OnItalicClicked='() => Format("italic")'
                                   OnUnderlineClicked='() => Format("underline")' OnStrikeClicked='() => Format("strikeThrough")'
                                   OnHeading1Clicked="() => Heading(26)" OnHeading2Clicked="() => Heading(20)"
                                   OnAlignLeftClicked="() => Align(EditorAlignment.Left)" OnAlignCenterClicked="() => Align(EditorAlignment.Center)"
                                   OnAlignRightClicked="() => Align(EditorAlignment.Right)" OnAlignJustifyClicked="() => Align(EditorAlignment.Justify)" />
                    <div class="doc-page">
                        <EditorControl @ref="_editor" Blocks="Letter" PageWidth="_width" FontFamily="Georgia" FontSizePx="16" LineHeight="1.6"
                                       EnableHistory="true" HistoryChanged="h => _history = h" OnBlocksChanged="LetterChanged"
                                       AriaLabel="Letter to a Lisbon Explorer traveller" />
                    </div>
                    <p class="doc-status">Words: @_words · Blocks: @_blocks · OnBlocksChanged calls: @_changes</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="comment" Title="A light editor for short text" RazorCode="@Code.Comment" CSharpCode="@Code.CommentCs" CssCode="@Code.CommentCss">
            <Description>
                <p>
                    A booking note. <code>EditorLiteControl</code> brings its own toolbar (text style, bold, italic, underline, two kinds of list, link,
                    clear formatting) and binds <code>Value</code> as HTML. Every keystroke and toolbar action raises <code>ValueChanged</code> with the
                    sanitised HTML, which the box below prints. The placeholder is drawn by CSS while the note is empty and is not part of the value.
                </p>
            </Description>
            <Demo>
                <EditorLiteControl @bind-Value="_note" MinHeight="120px"
                                   Placeholder="A note for the Lisbon desk: dietary needs, mobility, a birthday to mark…" />
                <div class="note-label">Value</div>
                <pre class="note-out">@(_note.Length > 0 ? _note : "(empty)")</pre>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-editorcontrol-parameters" Title="EditorControl parameters" Count='@DocSection.Label(Vocab.Editor.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="EditorControl parameters" Rows="Vocab.Editor" />
                <p>
                    <code>EditorHistoryState</code> is <code>(bool CanUndo, bool CanRedo, int UndoCount, int RedoCount)</code>.
                    <code>EditorSelectionInfo</code> is <code>(string Text, string BlockId, double Top, double Left, double Width, double Bottom)</code>;
                    <code>Top</code> and <code>Bottom</code> include that ancestor's scroll offset.
                </p>
            </DocSection>
            <DocSection Id="doc-editorcontrol-methods" Title="EditorControl methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="EditorControl methods" Rows="Vocab.Methods" />
                <p>
                    <code>EditorSearchMatch</code> is <code>(int Index, string BlockId, int Start, int Length, string Text, string Preview)</code>, with
                    <code>Start</code> and <code>Length</code> counted in characters of the block's text, not its HTML. <code>EditorCaretInfo</code> is
                    <code>(string BlockId, int Offset)</code>.
                </p>
            </DocSection>
            <DocSection Id="doc-editorblock" Title="EditorBlock" Count='@DocSection.Label(Vocab.Block.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditorBlock" Rows="Vocab.Block" />
            </DocSection>
            <DocSection Id="doc-formatcontrol-parameters" Title="FormatControl parameters" Count='@DocSection.Label(Vocab.Format.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="FormatControl parameters" Rows="Vocab.Format" />
                <p>
                    The B, I, U, S and alignment groups are always drawn. The stylesheet takes its colours from <code>--surface</code>,
                    <code>--border</code>, <code>--ink</code>, <code>--accent</code> and <code>--muted</code>, with built-in fallbacks; the first example sets
                    them on its wrapper (CSS tab), and <code>EditorControl</code> reads <code>--ink</code> and <code>--accent-2</code> (section headings)
                    the same way.
                </p>
            </DocSection>
            <DocSection Id="doc-editorlitecontrol-parameters" Title="EditorLiteControl parameters" Count='@DocSection.Label(Vocab.Lite.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="EditorLiteControl parameters" Rows="Vocab.Lite" />
            </DocSection>
            <DocSection Id="doc-editorlitecontrol-methods" Title="EditorLiteControl methods" Count='@DocSection.Label(Vocab.LiteMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="EditorLiteControl methods" Rows="Vocab.LiteMethods" />
                <p>
                    Pasted HTML goes through the same sanitiser as <code>Value</code> before it is inserted; pasted plain text is escaped, with its line
                    breaks kept as <code>br</code>.
                </p>
            </DocSection>
            <DocSection Id="doc-editorlitevalue" Title="EditorLiteValue" Count='@DocSection.Label(Vocab.LiteValue.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditorLiteValue" Rows="Vocab.LiteValue" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
        <ul>
            <li><code>EditorControl</code>'s editable element is a <code>div</code> with <code>role="textbox"</code>, <code>aria-multiline="true"</code>, <code>aria-readonly</code> and <code>tabindex="0"</code>, named by <code>AriaLabel</code>. Keyboard focus draws a 2px blue outline.</li>
            <li>The control handles only the keys above. Ctrl+B and similar keys are left to the browser; the browser's own Undo and Redo commands go to the control's history when <code>EnableHistory</code> is on.</li>
            <li>The search panel is <code>role="search"</code>, named "Search document". Its text boxes are named "Find text" and "Replacement text", and the match count is a <code>role="status"</code> element.</li>
            <li><code>FormatControl</code>'s buttons sit in groups named "Text formatting", "Heading styles" and "Paragraph alignment". B, I, U, S, H1 and H2 are named by their letters and carry a title; the alignment buttons hold only an icon and take their name from the title. No button reports a pressed state. The dropdowns are native <code>select</code> elements inside labels reading Font, Size, Width and Line.</li>
            <li>The editor remembers the last selection made inside it, and each formatting call restores that selection before it runs, so a toolbar button reached with Tab still acts on the text selected before.</li>
            <li><code>EditorLiteControl</code>'s toolbar is <code>role="toolbar"</code>, named by <code>ToolbarLabel</code>. Its buttons carry <code>aria-label</code> and <code>title</code>, the text style list only a <code>title</code>, and every button is its own Tab stop. The editing area has no role or accessible name of its own, so give it a visible label.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/ai-prompt#app-bar">AI prompt</a>: <code>ToolbarControl</code>, which <code>ShowToolbar</code> draws, in an app bar of its own.</li>
            <li><a href="demo/forms">Forms</a>: single-line inputs and form layout.</li>
            <li><a href="demo/buttons">Buttons</a>: the <code>ButtonControl</code> used for the history row.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Document
    private EditorControl? _editor;
    private EditorHistoryState _history = new(false, false, 0, 0);
    private EditorPageWidth _width = EditorPageWidth.Normal;
    private string _font = "Georgia";
    private int _size = 16;
    private string _line = "1.6";
    private int _words = Words(Letter), _blocks = Letter.Length, _changes;

    private static EditorBlock P(string id, string html) => new(id, EditorBlockKind.Paragraph, html, Html: html);

    private static readonly EditorBlock[] Letter =
    {
        new("title", EditorBlockKind.ChapterHeading, "Your Lisbon Explorer itinerary"),
        P("greeting", "Dear Maya,"),
        P("intro", "Thank you for booking <b>Lisbon Explorer</b> with Razor Sharp Getaways. Your seven nights in Lisbon start on 12 May; this is the plan our Southern Europe desk has put together."),
        new("days", EditorBlockKind.SectionHeading, "Day by day"),
        P("day1", "<b>Days 1–2.</b> A transfer from the airport to your hotel in Baixa, then a guided walk up through Alfama to the castle."),
        P("day3", "<b>Days 3–4.</b> A day in Sintra by train, with timed entry to the palace gardens; the next day is yours to explore the city."),
        P("day5", "<b>Days 5–7.</b> Belém and the riverside, a cooking class on day six, and a late checkout before your flight home."),
        new("before", EditorBlockKind.SectionHeading, "Before you travel"),
        P("passport", "Please check that your passport is valid for the whole stay, and send us your flight numbers so that we can confirm the transfer."),
        P("signoff", "Kind regards,<br>The Razor Sharp Getaways team"),
    };

    private static readonly EditorDropDownControl.EditorDropDownOption[] Fonts = { new("Georgia", "Georgia"), new("Arial", "Arial"), new("Verdana", "Verdana") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Sizes = { new("14", "14"), new("16", "16"), new("18", "18"), new("20", "20"), new("24", "24") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Widths = { new("Narrow", "Narrow"), new("Normal", "Normal"), new("Wide", "Wide"), new("Full", "Full") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Lines = { new("1.4", "1.4"), new("1.6", "1.6"), new("2", "2") };

    private Task Format(string command) => _editor!.ExecFormatCommandAsync(command);
    private Task Heading(int px) => _editor!.ApplyHeadingStyleAsync("Georgia", px);
    private Task Align(EditorAlignment alignment) => _editor!.SetBlockAlignmentAsync(alignment);
    private Task Undo() => _editor!.UndoAsync();
    private Task Redo() => _editor!.RedoAsync();
    private Task FindReplace() => _editor!.OpenSearchAsync();

    private async Task PickFont(string font)
    {
        _font = font;
        await _editor!.ApplyInlineStyleAsync("font-family", font);
    }

    private async Task PickSize(string size)
    {
        _size = int.Parse(size);
        await _editor!.ApplyInlineStyleAsync("font-size", size + "px");
    }

    private void PickWidth(string width) => _width = Enum.Parse<EditorPageWidth>(width);

    private async Task PickLine(string line)
    {
        _line = line;
        await _editor!.ApplyBlockStyleAsync("line-height", line);
    }

    private async Task StartOver()
    {
        await _editor!.PushAsync();
        (_words, _blocks, _changes) = (Words(Letter), Letter.Length, 0);
    }

    private void LetterChanged(IReadOnlyList<EditorBlock> blocks)
    {
        _words = Words(blocks);
        _blocks = blocks.Count;
        _changes++;
    }

    private static int Words(IEnumerable<EditorBlock> blocks) =>
        blocks.Sum(b => Regex.Count(WebUtility.HtmlDecode(Regex.Replace(b.Text, "<[^>]+>", " ")), @"\S+"));

    // Booking note
    private string _note = "";

