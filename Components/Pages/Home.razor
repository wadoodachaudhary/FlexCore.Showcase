    private async Task CopyInstallCommand()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", "dotnet add package FlexCore");
            _copiedInstall = true;
            Notifications.Info("Install command copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2000);
            _copiedInstall = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task CopyActiveCode()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", GetActiveCodeSnippet());
            _copiedCode = true;
            Notifications.Info("Code snippet copied to clipboard!");
            StateHasChanged();
            await Task.Delay(2000);
            _copiedCode = false;
            StateHasChanged();
        }
        catch { }
    }

    private string GetActiveCodeSnippet()
    {
        return _activeTab switch
        {
            "grid" =>
@"<GridControl TValue=""TripRequest"" DataSource=""@FilteredRequests""
             @ref=""_grid""
             AllowSelection=""true""
             AllowSorting=""true""
             AllowFiltering=""true""
             AllowResizing=""true""
             EnableHover=""true""
             CssClass=""hero-grid-theme""
             EditSettingsRef=""@_editSettings""
             EventsRef=""@_gridEvents""
             WindowOverscanRows=""15""
             Height=""440px"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(TripRequest.Request)"" HeaderText=""Request"" Width=""100px""
                    IsPrimaryKey=""true"" AllowEditing=""false""
                    IsFrozen=""true"" FrozenPosition=""FrozenColumnPosition.Left"">
            <Template Context=""row"">
                @{ var r = (TripRequest)row; }
                <BadgeControl Text=""@r.Request"" CssClass=""grid-request-code"" />
            </Template>
        </GridColumn>

        <GridColumn Field=""@nameof(TripRequest.Agent)"" HeaderText=""Agent"" Width=""150px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{ var r = (TripRequest)row; }
                <div class=""agent-cell"">
                    <span class=""agent-avatar"" style=""background:@r.AvatarBg"">@r.AvatarInitials</span>
                    <span class=""agent-name"">@r.Agent</span>
                </div>
            </Template>
        </GridColumn>

        <GridColumn Field=""@nameof(TripRequest.Destination)"" HeaderText=""Destination"" Width=""130px"" AllowEditing=""false"" />

        @* In-cell DropDownGridControl: a four-column lookup with search; the header sorts by the code *@
        <GridColumn Field=""@nameof(TripRequest.TripType)"" HeaderText=""Trip type"" Width=""170px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{ var r = (TripRequest)row; }
                <div class=""grid-cell-dropdowngrid"">
                    <DropDownGridControl TItem=""TripTypeLookup"" TValue=""string""
                                         DataSource=""@_tripTypeLookup""
                                         Value=""@r.TripType""
                                         ValueChanged=""@(val => OnTripTypeChanged(r, val))""
                                         TextFieldName=""@nameof(TripTypeLookup.Name)""
                                         ValueFieldName=""@nameof(TripTypeLookup.Code)""
                                         ClosedTextFieldName=""@nameof(TripTypeLookup.Code)""
                                         PopupWidth=""490px""
                                         PopupHeight=""220px""
                                         RowHeight=""24""
                                         ShowSearch=""true""
                                         SearchPlaceholder=""Search trip types...""
                                         AllowClear=""false""
                                         Placeholder=""Select trip type..."">
                        <Columns>
                            <GridColumn Field=""@nameof(TripTypeLookup.Code)"" HeaderText=""Code"" Width=""95px"" />
                            <GridColumn Field=""@nameof(TripTypeLookup.Name)"" HeaderText=""Trip type"" Width=""165px"" />
                            <GridColumn Field=""@nameof(TripTypeLookup.Desk)"" HeaderText=""Desk"" Width=""90px"" />
                            <GridColumn Field=""@nameof(TripTypeLookup.LeadTime)"" HeaderText=""Book ahead"" Width=""110px"" />
                        </Columns>
                    </DropDownGridControl>
                </div>
            </Template>
        </GridColumn>

        @* Fast typing: click the cell and type, the value commits on Enter or blur *@
        <GridColumn Field=""@nameof(TripRequest.Quote)"" HeaderText=""Quote"" Width=""130px""
                    Type=""ColumnType.Number"" Format=""C2"" TextAlign=""TextAlign.Right""
                    AllowEditing=""true"" SelectAllOnEdit=""true"" />

        @* Inline SVG sparkline: five weekly fare samples for the route, the last one is the quote; the header sorts by the change *@
        <GridColumn Field=""@nameof(TripRequest.FareDeltaPercent)"" HeaderText=""Fare trend"" Width=""135px"" AllowFiltering=""false"" AllowEditing=""false"">
            <Template Context=""row"">
                @{
                    var r = (TripRequest)row;
                    var spark = GetSparklinePoints(r.FareHistory, 68, 22);
                    var isUp = r.FareDeltaPercent >= 0;
                    var color = isUp ? ""#10b981"" : ""#ef4444"";
                    var fill = isUp ? ""rgba(16, 185, 129, 0.16)"" : ""rgba(239, 68, 68, 0.16)"";
                    var deltaClass = isUp ? ""delta-up"" : ""delta-down"";
                    var titleText = $""5-week fare trend: {(isUp ? ""+"" : """")}{r.FareDeltaPercent}%"";
                    var deltaSign = isUp ? ""▲"" : ""▼"";
                }
                <div class=""sparkline-cell"" title=""@titleText"">
                    <svg width=""68"" height=""22"" viewBox=""0 0 68 22"" class=""sparkline-svg"">
                        <polygon points=""@spark.AreaPoints"" fill=""@fill"" />
                        <polyline points=""@spark.PolylinePoints"" fill=""none"" stroke=""@color"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"" />
                        <circle cx=""@spark.LastX"" cy=""@spark.LastY"" r=""2.5"" fill=""@color"" />
                    </svg>
                    <span class=""sparkline-delta @deltaClass"">
                        @deltaSign@Math.Abs(r.FareDeltaPercent)%
                    </span>
                </div>
            </Template>
        </GridColumn>

        <GridColumn Field=""@nameof(TripRequest.Status)"" HeaderText=""Status"" Width=""110px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{
                    var r = (TripRequest)row;
                    var statusBadge = GetStatusBadgeClass(r.Status);
                }
                <BadgeControl Text=""@r.Status"" CssClass=""@($""grid-badge {statusBadge}"")"" />
            </Template>
        </GridColumn>

        @* The Edit button opens the popup editor; a double-click on the row does the same *@
        <GridColumn Field=""@nameof(TripRequest.Itinerary)"" HeaderText=""Itinerary"" Width=""300px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{ var r = (TripRequest)row; }
