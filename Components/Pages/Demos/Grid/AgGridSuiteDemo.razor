@page "/demo/grid/ag-grid-showcase"
@page "/demo/grid/scenarios"
@rendermode InteractiveServer
@implements IDisposable
@using System.Diagnostics
@using System.Timers
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Services
@* Retitled 2026-10-06 to match the site nav; copy unchanged. *@

<PageTitle>Four scenarios — FlexCore Showcase</PageTitle>

<SyncfusionDemoLayout Title="Four scenarios"
                      Category="Enterprise Grids"
                      BadgeText="4-in-1 Suite"
                      RazorCode="@_razorSourceCode"
                      CSharpCode="@_csharpSourceCode"
                      CSharpTabName="AgGridModels.cs">
    <Summary>
        <p>
            This flagship showcase implements the <strong>4 signature enterprise use cases</strong> featured on
            <a href="https://www.ag-grid.com/example/" target="_blank" rel="noopener noreferrer">AG Grid's flagship live showcase</a>:
            <strong>Performance</strong> (100k virtualized rows), <strong>Finance</strong> (real-time high-frequency market tickers with price flashes and SVG sparklines),
            <strong>HR Directory</strong> (hierarchical organizational tree with manager-report relationships and avatars), and
            <strong>Inventory Logistics</strong> (master-detail product catalog with multi-warehouse stock breakdown).
        </p>
        <p>
            Built with <strong>FlexCore controls in C#</strong>. <strong>No third-party JavaScript grid library</strong>; GridControl loads its own interop script on demand.
            Runs on Blazor Server or WebAssembly.
        </p>
    </Summary>

    <DemoControls>
        <div style="display:flex;gap:10px;align-items:center;font-size:13px;flex-wrap:wrap;width:100%;">
            @if (_activeTab == AgTab.Performance)
            {
                <span class="fw-bold text-secondary">Dataset Scale:</span>
                <button type="button" class="btn btn-sm @(_perfRowCount == 10000 ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => LoadPerformanceData(10000)">10,000 Rows</button>
                <button type="button" class="btn btn-sm @(_perfRowCount == 50000 ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => LoadPerformanceData(50000)">50,000 Rows</button>
                <button type="button" class="btn btn-sm @(_perfRowCount == 100000 ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => LoadPerformanceData(100000)">100,000 Rows</button>
                <button type="button" class="btn btn-sm btn-outline-success ms-2" @onclick="() => LoadPerformanceData(_perfRowCount)">
                    🔄 Regenerate Data
                </button>
                <span class="text-muted ms-auto">
                    Loaded: <b>@_perfRows.Count.ToString("N0")</b> rows |
                    Gen Time: <b>@_perfGenMs.ToString("0.0") ms</b> |
                    Rendered: <b>visible window only</b>
                </span>
            }
            else if (_activeTab == AgTab.Finance)
            {
                <span class="fw-bold text-secondary">Market Simulation:</span>
                <button type="button" class="btn btn-sm @(_isStreaming ? "btn-danger" : "btn-success")"
                        @onclick="ToggleStreaming">
                    @(_isStreaming ? "⏸ Pause Stream" : "▶ Start Live Stream")
                </button>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn @(_timerIntervalMs == 100 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetInterval(100)">100ms (High Freq)</button>
                    <button type="button" class="btn @(_timerIntervalMs == 250 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetInterval(250)">250ms</button>
                    <button type="button" class="btn @(_timerIntervalMs == 500 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetInterval(500)">500ms</button>
                    <button type="button" class="btn @(_timerIntervalMs == 1000 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetInterval(1000)">1000ms</button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnManualTick">
                    ⚡ Tick Once
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="ResetMarket">
                    ↺ Reset Prices
                </button>
                <span class="text-muted ms-auto">
                    Status: <b class="@(_isStreaming ? "text-success" : "text-secondary")">@(_isStreaming ? "STREAMING" : "PAUSED")</b> |
                    Ticks: <b>@_totalTicksCount</b> |
                    Instruments: <b>@_financeRows.Count</b>
                </span>
            }
            else if (_activeTab == AgTab.Hr)
            {
                <span class="fw-bold text-secondary">Org Hierarchy:</span>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn @(_selectedDept == "All" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterDepartment("All")'>All Departments</button>
                    <button type="button" class="btn @(_selectedDept == "Engineering" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterDepartment("Engineering")'>Engineering</button>
                    <button type="button" class="btn @(_selectedDept == "Product" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterDepartment("Product")'>Product</button>
                    <button type="button" class="btn @(_selectedDept == "Sales" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterDepartment("Sales")'>Sales</button>
                    <button type="button" class="btn @(_selectedDept == "Human Resources" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterDepartment("Human Resources")'>HR</button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="ResetHrView">
                    ↺ Expand All
                </button>
                <span class="text-muted ms-auto">
                    Employees: <b>@_displayedHrEmployees.Count</b> |
                    Managers: <b>@_displayedHrEmployees.Count(e => e.IsManager)</b> |
                    Offices: <b>5 Global Hubs</b>
                </span>
            }
            else if (_activeTab == AgTab.Inventory)
            {
                <span class="fw-bold text-secondary">Inventory Filters:</span>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn @(_inventoryCategoryFilter == "All" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterInventoryCategory("All")'>All Categories</button>
                    <button type="button" class="btn @(_inventoryCategoryFilter == "Hardware" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterInventoryCategory("Hardware")'>Hardware</button>
                    <button type="button" class="btn @(_inventoryCategoryFilter == "Networking" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterInventoryCategory("Networking")'>Networking</button>
                    <button type="button" class="btn @(_inventoryCategoryFilter == "Displays" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterInventoryCategory("Displays")'>Displays</button>
                    <button type="button" class="btn @(_inventoryCategoryFilter == "Peripherals" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => FilterInventoryCategory("Peripherals")'>Peripherals</button>
                </div>
                <span class="text-muted ms-auto">
                    Total SKUs: <b>@_inventoryProducts.Count</b> |
                    Total Valuation: <b>@_inventoryProducts.Sum(p => p.InventoryValuation).ToString("$#,##0.00")</b>
                </span>
            }
        </div>
    </DemoControls>

    <DemoContent>
        <!-- 4-in-1 Scenario Switcher Tabs -->
        <div class="ag-suite-nav">
            <button type="button" class="ag-suite-tab-btn @(_activeTab == AgTab.Performance ? "active" : "")"
                    @onclick="() => SwitchTab(AgTab.Performance)">
                <span>⚡</span> Performance Benchmark
                <span class="ag-tab-badge">100k Rows</span>
            </button>
            <button type="button" class="ag-suite-tab-btn @(_activeTab == AgTab.Finance ? "active" : "")"
                    @onclick="() => SwitchTab(AgTab.Finance)">
                <span>📈</span> Finance &amp; Market Ticker
                <span class="ag-tab-badge">Real-Time</span>
            </button>
            <button type="button" class="ag-suite-tab-btn @(_activeTab == AgTab.Hr ? "active" : "")"
                    @onclick="() => SwitchTab(AgTab.Hr)">
                <span>👥</span> HR Organizational Directory
                <span class="ag-tab-badge">Tree Data</span>
            </button>
            <button type="button" class="ag-suite-tab-btn @(_activeTab == AgTab.Inventory ? "active" : "")"
                    @onclick="() => SwitchTab(AgTab.Inventory)">
                <span>📦</span> Inventory &amp; Warehouses
                <span class="ag-tab-badge">Master-Detail</span>
            </button>
        </div>

        @if (_activeTab == AgTab.Performance)
        {
            <!-- 1. PERFORMANCE BENCHMARK (100K ROWS) -->
            <div style="width: 100%;">
                <div class="alert alert-info py-2 px-3 mb-2" style="font-size: 13px;">
                    <strong>Performance Benchmark:</strong> Currently rendering <strong>@_perfRows.Count.ToString("N0") records</strong>
                    with virtualized row recycling. Only visible elements plus buffer window reside in the DOM.
                    Try sorting any column, filtering via the search box, or dragging the scrollbar rapidly.
                </div>

                <GridControl @key="_perfGenerationKey"
                             TValue="AgPerformanceRow"
                             DataSource="@_perfRows"
                             AllowSorting="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             AllowGrouping="true"
                             DefaultGroupsCollapsed="true"
                             AutoPageRowThreshold="0"
                             ShowGroupCount="true"
                             ShowSearchBar="true"
                             ShowRowCountInFooter="true"
                             Height="480px"
                             EnableTypeSearch="true"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(AgPerformanceRow.Id)" HeaderText="ID" Width="75px" TextAlign="TextAlign.Right" AllowGrouping="false" />
                        <GridColumn Field="@nameof(AgPerformanceRow.Project)" HeaderText="Project" Width="150px" />
                        <GridColumn Field="@nameof(AgPerformanceRow.Task)" HeaderText="Task Description" Width="210px" AllowGrouping="false" />
                        <GridColumn Field="@nameof(AgPerformanceRow.Assignee)" HeaderText="Assignee" Width="130px" />
                        <GridColumn Field="@nameof(AgPerformanceRow.Priority)" HeaderText="Priority" Width="100px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (AgPerformanceRow)context;
                                    var badge = row.Priority switch
                                    {
                                        "Critical" => "bg-danger text-white",
                                        "High" => "bg-warning text-dark",
                                        "Medium" => "bg-info text-dark",
                                        _ => "bg-secondary text-white"
                                    };
                                }
                                <span class="badge @badge" style="font-size:11px;">@row.Priority</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgPerformanceRow.Status)" HeaderText="Status" Width="115px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (AgPerformanceRow)context;
                                    var badge = row.Status switch
                                    {
                                        "Completed" => "bg-success text-white",
                                        "In Progress" => "bg-primary text-white",
                                        "Review" => "bg-warning text-dark",
                                        _ => "bg-danger text-white"
                                    };
                                }
                                <span class="badge @badge" style="font-size:11px;">@row.Status</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgPerformanceRow.Progress)" HeaderText="Progress" Width="120px" TextAlign="TextAlign.Center" AllowGrouping="false">
                            <Template>
                                @{
                                    var row = (AgPerformanceRow)context;
                                }
                                <div style="display:flex;align-items:center;gap:6px;font-size:11px;">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar @(row.Progress == 100 ? "bg-success" : "bg-primary")"
                                             role="progressbar"
                                             style="width: @(row.Progress)%;"></div>
                                    </div>
                                    <span style="min-width:28px;text-align:right;">@(row.Progress)%</span>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgPerformanceRow.Budget)" HeaderText="Budget" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0" AllowGrouping="false" />
                        <GridColumn Field="@nameof(AgPerformanceRow.ActualCost)" HeaderText="Actual" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0" AllowGrouping="false" />
                        <GridColumn Field="@nameof(AgPerformanceRow.Variance)" HeaderText="Variance" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowGrouping="false">
                            <Template>
                                @{
                                    var row = (AgPerformanceRow)context;
                                    var color = row.Variance >= 0 ? "#059669" : "#dc2626";
                                    var prefix = row.Variance > 0 ? "+" : "";
                                }
                                <span style="color: @color; font-weight: 600;">@prefix@row.Variance.ToString("$#,##0")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgPerformanceRow.RiskLevel)" HeaderText="Risk" Width="90px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (AgPerformanceRow)context;
                                    var color = row.RiskLevel switch { "High" => "#dc2626", "Medium" => "#d97706", _ => "#059669" };
                                }
                                <span style="color: @color; font-weight: 600;">@row.RiskLevel</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgPerformanceRow.DueDate)" HeaderText="Due Date" Width="105px" Type="ColumnType.Date" TextAlign="TextAlign.Center" Format="yyyy-MM-dd" AllowGrouping="false" />
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
        else if (_activeTab == AgTab.Finance)
        {
            <!-- 2. FINANCE & MARKET TICKER -->
            <div style="width: 100%;">
                <div class="alert alert-light border py-2 px-3 mb-2 d-flex align-items-center justify-content-between" style="font-size: 13px;">
                    <div>
                        <strong>Live Financial Ticker:</strong> Simulates high-frequency market updates.
                        Updated cells flash <span class="badge bg-success bg-opacity-25 text-success">green</span> on tick up and
                        <span class="badge bg-danger bg-opacity-25 text-danger">red</span> on tick down.
                        Sparklines are rendered via <strong>pure SVG polyline vectors</strong> without JS chart libraries.
                    </div>
                    <div>
                        <span class="badge @(_isStreaming ? "bg-success" : "bg-secondary") py-1 px-2">
                            @(_isStreaming ? "⚡ LIVE DATAFEED" : "⏸ FEED PAUSED")
                        </span>
                    </div>
                </div>

                <GridControl @key="_financeGenerationKey"
                             TValue="AgFinanceTickerRow"
                             DataSource="@_financeRows"
                             AllowSorting="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowRowCountInFooter="true"
                             Height="480px"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Ticker)" HeaderText="Ticker" Width="90px">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                }
                                <strong style="color: #0f172a; font-family: monospace; font-size: 13px;">@row.Ticker</strong>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Name)" HeaderText="Asset Name" Width="170px" />
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Instrument)" HeaderText="Type" Width="90px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                    var bg = row.Instrument switch
                                    {
                                        "Stock" => "bg-primary text-white",
                                        "ETF" => "bg-info text-dark",
                                        "Bond" => "bg-secondary text-white",
                                        "Crypto" => "bg-warning text-dark",
                                        _ => "bg-dark text-white"
                                    };
                                }
                                <span class="badge @bg" style="font-size: 10px;">@row.Instrument</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Price)" HeaderText="Current Price" Width="115px" Type="ColumnType.Number" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                    var flashClass = row.TickDirection > 0 ? "ag-ticker-up" : row.TickDirection < 0 ? "ag-ticker-down" : "";
                                }
                                <span class="ag-ticker-cell @flashClass">
                                    @row.Price.ToString("$#,##0.00")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Delta)" HeaderText="Change ($)" Width="105px" Type="ColumnType.Number" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                    var color = row.Delta >= 0 ? "#047857" : "#b91c1c";
                                    var arrow = row.Delta > 0 ? "▲" : row.Delta < 0 ? "▼" : "";
                                    var prefix = row.Delta > 0 ? "+" : "";
                                }
                                <span style="color: @color; font-weight: 600; font-family: monospace;">
                                    @arrow @prefix@row.Delta.ToString("$#,##0.00")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.DeltaPercent)" HeaderText="Change (%)" Width="95px" Type="ColumnType.Number" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                    var color = row.DeltaPercent >= 0 ? "#047857" : "#b91c1c";
                                    var prefix = row.DeltaPercent > 0 ? "+" : "";
                                }
                                <span style="color: @color; font-weight: 600; font-family: monospace;">
                                    @prefix@row.DeltaPercent.ToString("0.00")%
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Timeline)" HeaderText="24h Trend" Width="135px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                }
                                <svg class="ag-sparkline-svg" viewBox="0 0 110 24">
                                    <polyline points="@GetSparklinePoints(row.Timeline)"
                                              stroke="@GetSparklineStroke(row.Timeline)"
                                              stroke-width="2"
                                              fill="none"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                </svg>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.Quantity)" HeaderText="Holdings" Width="85px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="#,##0" />
                        <GridColumn Field="@nameof(AgFinanceTickerRow.TotalValue)" HeaderText="Market Value" Width="120px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(AgFinanceTickerRow.UnrealizedPL)" HeaderText="Unrealized P&amp;L" Width="125px" Type="ColumnType.Number" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var row = (AgFinanceTickerRow)context;
                                    var color = row.UnrealizedPL >= 0 ? "#047857" : "#b91c1c";
                                    var prefix = row.UnrealizedPL > 0 ? "+" : "";
                                }
                                <span style="color: @color; font-weight: 600;">
                                    @prefix@row.UnrealizedPL.ToString("$#,##0.00")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgFinanceTickerRow.LastUpdated)" HeaderText="Timestamp" Width="105px" Type="ColumnType.Date" TextAlign="TextAlign.Right" Format="HH:mm:ss.f" />
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
        else if (_activeTab == AgTab.Hr)
        {
            <!-- 3. HR ORGANIZATIONAL DIRECTORY (TREE DATA) -->
            <div style="width: 100%;">
                <div class="alert alert-light border py-2 px-3 mb-2" style="font-size: 13px;">
                    <strong>HR Hierarchy:</strong> Demonstrates self-referential organizational hierarchy using <code>TreeGridControl</code>.
                    Notice the executive reporting structure (CEO &rarr; VPs &rarr; Directors &rarr; Staff), employee avatars,
                    and star rating templates.
                </div>

                <div style="height: 480px; width: 100%;">
                    <TreeGridControl @key="_hrGenerationKey"
                                     TValue="AgHrEmployeeRow"
                                     DataSource="@_displayedHrEmployees"
                                     IdMapping="EmployeeID"
                                     ParentIdMapping="ReportsToID"
                                     TreeColumnIndex="0"
                                     EnableCollapseAll="true"
                                     AllowSelection="true"
                                     ToggleOnRowClick="false"
                                     Height="100%"
                                     CssClass="fx-treegrid-compact fx-treegrid-dotted-lines">
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.FullName)" HeaderText="Employee Name" Width="280px">
                            <Template>
                                @{
                                    var emp = (AgHrEmployeeRow)context;
                                }
                                <div class="ag-avatar-pill">
                                    <span class="ag-avatar-circle" style="background-color: @emp.AvatarBg;">
                                        @GetInitials(emp.FullName)
                                    </span>
                                    <div>
                                        <span style="font-weight: 600; color: #0f172a;">@emp.FullName</span>
                                        @if (emp.IsManager)
                                        {
                                            <span class="badge bg-primary ms-1" style="font-size: 9px; vertical-align: middle;">
                                                Manager (@emp.SubordinatesCount)
                                            </span>
                                        }
                                    </div>
                                </div>
                            </Template>
                        </TreeGridColumn>
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.JobTitle)" HeaderText="Job Title" Width="220px" />
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.Department)" HeaderText="Department" Width="130px">
                            <Template>
                                @{
                                    var emp = (AgHrEmployeeRow)context;
                                    var deptBadge = emp.Department switch
                                    {
                                        "Executive" => "bg-dark text-white",
                                        "Engineering" => "bg-primary text-white",
                                        "Product" => "bg-purple text-white",
                                        "Sales" => "bg-success text-white",
                                        "Human Resources" => "bg-warning text-dark",
                                        _ => "bg-secondary text-white"
                                    };
                                }
                                <span class="badge @deptBadge" style="font-size: 10px;">@emp.Department</span>
                            </Template>
                        </TreeGridColumn>
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.Office)" HeaderText="Office" Width="120px" />
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.EmploymentType)" HeaderText="Type" Width="100px" TextAlign="TextAlign.Center" />
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.Salary)" HeaderText="Base Salary" Width="120px" TextAlign="TextAlign.Right" Format="$#,##0" />
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.Rating)" HeaderText="Performance" Width="110px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var emp = (AgHrEmployeeRow)context;
                                }
                                <span class="ag-rating-star">
                                    @GetStars(emp.Rating)
                                </span>
                            </Template>
                        </TreeGridColumn>
                        <TreeGridColumn Field="@nameof(AgHrEmployeeRow.HireDate)" HeaderText="Hire Date" Width="110px" TextAlign="TextAlign.Center" Format="yyyy-MM-dd" />
                    </TreeGridControl>
                </div>
            </div>
        }
        else if (_activeTab == AgTab.Inventory)
        {
            <!-- 4. INVENTORY & WAREHOUSES (MASTER-DETAIL) -->
            <div style="width: 100%;">
                <div class="alert alert-light border py-2 px-3 mb-2" style="font-size: 13px;">
                    <strong>Inventory Logistics &amp; Warehouses:</strong> Master-Detail architecture linking global product SKUs
                    with granular warehouse distribution stock, bin locations, and delivery tracking.
                    Click <strong>[Inspect]</strong> or any row to expand its warehouse distribution breakdown.
                </div>

                <GridControl @ref="_inventoryGrid"
                             TValue="AgInventoryProductRow"
                             DataSource="@_displayedInventoryProducts"
                             AllowSorting="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowRowCountInFooter="true"
                             Height="340px"
                             EventsRef="@_inventoryEvents"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn HeaderText="Inspect" Width="80px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var prod = (AgInventoryProductRow)context;
                                    var isSel = _selectedInventoryProduct?.SKU == prod.SKU;
                                }
                                <button type="button"
                                        class="btn btn-sm @(isSel ? "btn-primary" : "btn-outline-secondary") py-0 px-2"
                                        style="font-size: 11px;"
                                        @onclick="() => SelectInventoryProduct(prod)">
                                    @(isSel ? "▼ Active" : "▶ Inspect")
                                </button>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(AgInventoryProductRow.SKU)" HeaderText="SKU" Width="110px">
                            <Template>
                                @{
                                    var prod = (AgInventoryProductRow)context;
                                }
