                <HeaderContent><span class=""acc-head""><span class=""bi bi-laptop""></span> Equipment <BadgeControl Text=""@Step(_equipment)"" Variant=""@Color(_equipment)"" Size=""BadgeSize.Small"" /></span></HeaderContent>
                <ChildContent><CheckBoxControl @bind-Checked=""_equipment"" Label=""Laptop and headset ordered from IT"" /></ChildContent>
            </AccordionItemControl>
            <AccordionItemControl>
                <HeaderContent><span class=""acc-head""><span class=""bi bi-building""></span> Office <BadgeControl Text=""@Step(_office)"" Variant=""@Color(_office)"" Size=""BadgeSize.Small"" /></span></HeaderContent>
                <ChildContent><CheckBoxControl @bind-Checked=""_office"" Label=""Desk assigned in the Lisbon office"" /></ChildContent>
