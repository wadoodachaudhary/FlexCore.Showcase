    private void Archive()
    {
        _archiveOpen = false;
        _archiveResult = $"Archived at {DateTime.Now:HH:mm:ss} — priority {_priority}"
            + (_due is { } due ? $", due {due:d}" : "")
            + (string.IsNullOrWhiteSpace(_note) ? "" : $", note: {_note}");
