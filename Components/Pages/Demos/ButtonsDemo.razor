@page "/demo/buttons"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: on FeatureDemoLayout; toggle, group and split buttons have their own pages; removed demos' parameters stay in the
   vocabulary. Uses only CSS shipped in FlexCore 0.2.48.
   2026-10-20: code tabs generated from this file.
   2026-11-15: three examples with a booking story: actions that follow a status, a form with submit, busy and cancel, and the
   dropdown. Checked against ButtonControl.razor, Editor/SaveButtonControl.razor, Editor/CancelButtonControl.razor,
   Editor/RoundedButtonControl.razor (FlexCore 0.2.50).
   2026-11-15: example story moved to the HR tracking theme.
   2026-11-16: pre-deploy review fixes. *@

<PageTitle>Blazor Button Component — FlexCore</PageTitle>

<FeatureDemoLayout Title="Buttons" Category="Components" ControlName="ButtonControl"
                   Tagline="Run actions, submit forms and open dropdowns with one native button."
                   SourcePath="ButtonControl.razor; Editor/SaveButtonControl.razor; Editor/CancelButtonControl.razor; Editor/RoundedButtonControl.razor">
    <Overview>
        <p>
            <code>ButtonControl</code> is a Blazor button: users click it to run an action, submit a form or open a dropdown panel. It renders a native <code>&lt;button&gt;</code>, so Tab, Enter and Space behave as the browser intends and <code>ButtonType="submit"</code> sends its form. Set the look with a <code>btn-*</code> class, an <code>IconCss</code> icon and the <code>--fx-btn-*</code> color variables; <code>SaveButtonControl</code>, <code>CancelButtonControl</code> and the pill-shaped <code>RoundedButtonControl</code> build on it.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="actions" Title="Actions on a leave request" RazorCode="@Code.Actions" CSharpCode="@Code.ActionsCs">
            <Description><p>Review the leave request: the actions pair a <code>btn-*</code> color with an <code>IconCss</code> icon (Team calendar puts its arrow after the caption), and <code>Disabled</code> follows the request's status, so only the actions that make sense stay live. Print is icon-only, named with <code>aria-label</code>; Small buttons adds <code>btn-sm</code>.</p></Description>
            <Controls>
                <SwitchControl @bind-Checked="_small" Label="Small buttons" />
            </Controls>
            <Demo>
                <div class="lr">
                    <div class="lr-head">
                        <span class="lr-icon bi bi-calendar-week" aria-hidden="true"></span>
                        <div class="lr-text">
                            <div class="lr-title">LR-0107 · Vacation, Dec 14 to 18</div>
                            <div class="lr-sub">Hermione Ranger, Reservations, 5 working days</div>
                        </div>
                        <BadgeControl Text="@_status" Variant="@StatusVariant" />
                    </div>
                    <div class="demo-row">
                        <ButtonControl CssClass="@Size("btn-success")" IconCss="bi bi-check2-circle" Disabled="@(_status is "Approved" or "Declined")"
                                       OnClick='() => Set("Approved", "Leave approved")'>Approve</ButtonControl>
                        <ButtonControl CssClass="@Size("btn-primary")" IconCss="bi bi-envelope" Disabled="@(_status == "Declined")"
                                       OnClick='() => Log("Coverage question emailed to the manager")'>Ask manager</ButtonControl>
                        <ButtonControl CssClass="@Size("btn-warning")" IconCss="bi bi-pause-circle" Disabled="@(_status != "Pending")"
                                       OnClick='() => Set("On hold", "On hold until coverage is confirmed")'>Hold</ButtonControl>
                        <ButtonControl CssClass="@Size("btn-outline-primary")" OnClick='() => Log("Team calendar opened")'>Team calendar <span class="bi bi-arrow-right"></span></ButtonControl>
                        <ButtonControl CssClass="@Size("")" IconCss="bi bi-printer" Title="Print" aria-label="Print" OnClick='() => Log("Sent to the printer")' />
                        <ButtonControl CssClass="@Size("btn-danger")" IconCss="bi bi-x-circle" Disabled="@(_status == "Declined")"
                                       OnClick='() => Set("Declined", "Leave declined")'>Decline</ButtonControl>
                        <ButtonControl CssClass="@Size("btn-secondary")" IconCss="bi bi-arrow-counterclockwise" Disabled="@(_status == "Pending")"
                                       OnClick='() => Set("Pending", "Reopened for review")'>Reopen</ButtonControl>
                    </div>
                    <p class="result" role="status"><span class="bi bi-clock-history" aria-hidden="true"></span>Last action: @_last</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="form" Title="Submit, busy and cancel" RazorCode="@Code.Form" CSharpCode="@Code.FormCs">
            <Description><p>Add a colleague to cover the leave: type a name and press Enter or Save. <code>ButtonType="submit"</code> sends the form, and <code>IsSaving</code> disables the button and reads "Saving…" until the save returns. The spinner it shows meanwhile is this page's CSS in place of the library's pulse: the page turns off the animation on <code>.fx-save-button--saving</code>, hides the disk icon and draws a turning ring in <code>::before</code>. Cancel clears the box. The colleagues covering are <code>RoundedButtonControl</code> pills: click one to remove it.</p></Description>
            <Demo>
                <form class="cv" @onsubmit="AddCoverAsync">
                    <div class="cv-label"><span class="bi bi-person-plus" aria-hidden="true"></span>Add a colleague to cover for Hermione Ranger</div>
                    <div class="demo-row">
                        <TextBoxControl @bind-Value="_name" UpdateOnInput="true" Placeholder="Colleague's full name" Width="240px" aria-label="Colleague name" />
                        <SaveButtonControl ButtonType="submit" IsSaving="_saving" Disabled="@string.IsNullOrWhiteSpace(_name)" />
                        <CancelButtonControl Disabled="@(_saving || string.IsNullOrEmpty(_name))" OnClick="() => _name = null" />
                    </div>
                    <div class="demo-row mt" id="pill">
                        @foreach (var colleague in _covering)
                        {
                            <RoundedButtonControl Variant="accent" IconCss="bi bi-x" Title="@($"Remove {colleague}")" OnClick="() => _covering.Remove(colleague)"><span class="sr">Remove </span>@colleague</RoundedButtonControl>
                        }
                        <RoundedButtonControl Variant="@(_covering.Count > 0 ? "success" : "danger")" Disabled="true">@_covering.Count covering</RoundedButtonControl>
                    </div>
                </form>
            </Demo>
        </DemoExample>

        <DemoExample Id="dropdown" Title="Dropdown button" RazorCode="@Code.Dropdown" CSharpCode="@Code.DropdownCs">
            <Description><p>Click Export leave report: <code>DropDownContent</code> opens beneath the button, a click away closes it, and a pick calls <code>CloseDropDown()</code>.</p></Description>
            <Demo>
                <div class="demo-row dd">
                    <ButtonControl @ref="_export" CssClass="btn-primary" IconCss="bi bi-download" DropDownCssClass="menu">
                        <ChildContent>Export leave report <span class="bi bi-caret-down-fill dd-caret"></span></ChildContent>
                        <DropDownContent>
                            @foreach (var (fmt, icon) in new[] { ("Excel (.xlsx)", "bi-file-earmark-excel"), ("CSV", "bi-filetype-csv"), ("PDF", "bi-file-earmark-pdf") })
                            {
                                <ButtonControl BareStyle="true" CssClass="menu-item" IconCss="@($"bi {icon}")" OnClick="@(() => Pick(fmt))">@fmt</ButtonControl>
                            }
                        </DropDownContent>
                    </ButtonControl>
                    <span class="result" role="status">@(_picked is null ? "Nothing exported yet" : $"Leave report exported as {_picked}")</span>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-presets" Title="SaveButtonControl, CancelButtonControl and RoundedButtonControl" Count='@DocSection.Label(Vocab.Presets.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="SaveButtonControl, CancelButtonControl and RoundedButtonControl" Rows="Vocab.Presets" />
                <p>
                    All three inherit <code>ButtonControl</code> but draw their own <code>&lt;button&gt;</code>: <code>ChildContent</code>, <code>CssClass</code>,
                    <code>Disabled</code>, <code>OnClick</code>, <code>ButtonType</code>, <code>Title</code>, <code>Style</code>, <code>BareStyle</code>,
                    <code>StopPropagation</code> and <code>PreventMouseDownDefault</code> apply, and <code>IconCss</code> on the pill only. <code>TabIndex</code>,
                    <code>AutoFocus</code>, <code>DropDownContent</code>, <code>FocusAsync()</code> and unmatched attributes such as <code>aria-label</code> do not work on them.
                </p>
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
            <DocSection Id="doc-css-variables" Title="CSS variables" Count='@DocSection.Label(Vocab.Vars.Length, "variables")'>
                <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>Every button is a native <code>&lt;button&gt;</code>: Tab reaches it, Enter and Space press it, and <code>ButtonType="submit"</code> sends its form. A disabled button leaves the Tab order.</li>
            <li>Name an icon-only button with <code>aria-label</code> as well as <code>Title</code>; <code>ButtonControl</code> writes unmatched attributes such as <code>aria-label</code> on the <code>&lt;button&gt;</code> itself.</li>
            <li>Name Save, Cancel and pill buttons with visible text or <code>Title</code>. Save and Cancel read "Save" and "Cancel" by default, and their built-in icons carry <code>aria-hidden="true"</code>.</li>
            <li>Dropdown mode adds <code>aria-haspopup="true"</code> and <code>aria-expanded</code> ("true" or "false"). Focus stays on the button when the panel opens and Tab moves into it; a click outside or <code>CloseDropDown()</code> closes it.</li>
            <li><code>IsSaving</code> disables the Save button and sets its default text and tooltip to "Saving…". To announce the save, show the outcome in a <code>role="status"</code> message.</li>
            <li>Inside a <code>DialogControl</code> with <code>OnEnter</code>, Enter on a focused button presses that button, not the dialog's default action. A custom control that keeps Enter calls <code>ConsumeEnter()</code> on the cascaded <code>DefaultButtonScope</code>.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A default action with alternatives: <a href="demo/split-button">Split button</a>. Pressed states and button groups: <a href="demo/toggle-buttons">Toggle buttons</a>. A round button fixed to a corner: <a href="demo/fab">Floating action button</a>.</li>
            <li><code>ToolbarControl</code> and <code>ToolbarButtonControl</code>: <a href="demo/toolbar">Toolbar</a>.</li>
            <li>Default button on Enter: <a href="demo/dialog">Dialogs</a>.</li>
            <li><code>RibbonControl</code>: <a href="demo/ribbon">Ribbon</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Leave request actions
    private bool _small;
    private string _status = "Pending";
    private string _last = "none yet";
    private BadgeVariant StatusVariant => _status switch
    {
        "Approved" => BadgeVariant.Success,
        "On hold" => BadgeVariant.Warning,
        "Declined" => BadgeVariant.Danger,
        _ => BadgeVariant.Secondary,
    };
    private string Size(string variant) => _small ? $"{variant} btn-sm" : variant;
    private void Log(string action) => _last = action;
    private void Set(string status, string action)
    {
        _status = status;
        _last = action;
    }

    // Form actions
    private string? _name;
    private bool _saving;
    private readonly List<string> _covering = new() { "Ron Measly", "Ginny Measly" };
    private async Task AddCoverAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_name)) return;
        var name = _name.Trim();   // read before the await: the box stays editable during the save
        _saving = true;
        await Task.Delay(900);   // stands in for the call that saves
        _covering.Add(name);
        _name = null;
        _saving = false;
    }

    // Dropdown
    private ButtonControl? _export;
    private string? _picked;
    private void Pick(string format)
    {
        _picked = format;
        _export?.CloseDropDown();
    }

