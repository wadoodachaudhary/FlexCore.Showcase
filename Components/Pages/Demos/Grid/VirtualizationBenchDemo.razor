            new("ShowRowCountInFooter", "A compact row count under the grid: the complete filtered result, not the rendered window or page.", "bool", "false"),
            new("ShowSearchBar", "A search box in the grid toolbar.", "bool", "false"),
            new("EnableTypeSearch", "With the grid focused, printable keys search the active column for the first row whose text starts with the typed buffer.", "bool", "false"),
            new("AllowGrouping", "Lets the user group by a column; the group drop area appears above the header.", "bool", "false"),
            new("SelectionSettingsRef", "Selection options object: Multiple rows here.", "SelectionSettings?", "null"),
