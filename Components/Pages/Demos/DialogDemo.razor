private MessageBoxControl? _box;
private MultiLineEditControl? _editor;
private string _subject = ""Charged twice in October"", _status = ""Open"", _notes = """";
private async Task Rename()
{
    var subject = await Dialogs.PromptAsync(""Subject:"", ""Rename ticket"", _subject);
    if (!string.IsNullOrWhiteSpace(subject)) _subject = subject;
}
private async Task Notes()
{
    var text = await _editor!.ShowAsync(_notes, ""Ticket notes"", 500, ""Internal notes for the ticket; 500 characters at most."");
    if (text is not null) _notes = text;
}
private async Task SendReply()
{
    if (!await Dialogs.ConfirmAsync($""{_subject}: send the reply to Hermione Ranger?"", ""Send reply"")) return;
    _status = ""Waiting on customer"";
    StateHasChanged();   // show the new status behind the alert
    await Dialogs.AlertAsync(""The reply is on its way. The customer has 7 days to answer."", ""Reply sent"");
}
private async Task RefundCharge()
{
    var answer = await _box!.ShowAsync($""{_subject}: refund the duplicate charge and solve the ticket?"", ""Refund charge"", MessageBoxButtons.OkCancel, ""warning"", null, ""I understand this cannot be undone"");
    if (answer == MessageBoxResult.Ok) _status = ""Solved"";
}
private void Restore() => (_subject, _status, _notes) = (""Charged twice in October"", ""Open"", """");";
    }
