    private static List<CustomQuote> GenerateQuotes(int count)
    {
        var salesPeople = new[]
        {
            ("Prissy Pearl", "PP", "#0284c7"),
            ("Snoop Dog", "SD", "#7c3aed"),
            ("Alex Vance", "AV", "#10b981"),
            ("Sarah Connor", "SC", "#d97706"),
            ("Big Betty", "BB", "#e11d48"),
            ("Gordon Freeman", "GF", "#0891b2"),
            ("Dana Scully", "DS", "#4f46e5"),
            ("Fox Mulder", "FM", "#059669")
        };

        var communities = new[]
        {
            "CARNATION ROW", "DAISY STREET", "LILY VALLEY", "FERN AVENUE",
            "ROSE LANE", "MARGARITA VILLE", "ELLIOT TRAINING", "OAK RIDGE",
            "PINE CREST", "CEDAR SPRINGS", "MAPLE GLEN", "WILLOW PARK"
        };

        var categories = new[]
        {
            ("APPLIANCES", "Kitchen & Laundry Appliances", 4500, 9500),
            ("SWITCHES", "Smart Switches & Dimmers", 800, 2400),
            ("PLUMBING", "Rough-in & Designer Fixtures", 1800, 4800),
            ("FINISHES", "Drywall, Trim & Moldings", 1200, 3900),
            ("STRUCTURAL", "Engineered Beams & Trusses", 6500, 18500),
            ("GARAGE", "Insulated Doors & Openers", 2200, 12000),
            ("HARDWOOD", "Hardwood & Engineered Plank", 4800, 19500),
            ("ELECTRICAL", "200A Panels & High-Voltage", 2400, 5600)
        };

        var statuses = new[] { "Approved", "In Review", "New Request", "Pending" };

        var descriptions = new[]
        {
            "Custom commercial double wall oven with warming drawer",
            "Add 3-way dimmer switch in kitchen island & pantry",
            "Dual shower rough-in with thermostatic mixer valve",
            "Crown molding upgrade in master suite & dining",
            "Engineered timber beam vault support for open concept",
            "18x13 clear short glass insulated overhead garage door",
            "Engineered French Oak 7-inch wide plank throughout main floor",
            "200A electrical sub-panel installation with EV rough-in",
            "Under-cabinet LED task strip lighting with smart dimmer",
            "Freestanding soaking tub with floor-mounted Roman faucet",
            "Custom coffered ceiling with integrated cove lighting",
            "Zero-threshold walk-in shower with linear drain tile",
            "Soundproofing insulation package between floors",
            "Tankless high-efficiency continuous hot water system",
            "Smart home automation hub with motorized blinds wiring"
        };

        var rnd = new Random(42);
        var list = new List<CustomQuote>(count);
        var startDate = new DateTime(2026, 1, 1);

        for (int i = 1; i <= count; i++)
        {
            var sp = salesPeople[rnd.Next(salesPeople.Length)];
            var comm = communities[rnd.Next(communities.Length)];
            var cat = categories[rnd.Next(categories.Length)];
            var status = statuses[rnd.Next(statuses.Length)];
            var desc = descriptions[rnd.Next(descriptions.Length)];
            var est = rnd.Next(cat.Item3 / 10, cat.Item4 / 10) * 10m;
            var date = startDate.AddMinutes(rnd.Next(0, 180 * 24 * 60));

            int baseTrend = (int)(est * 0.85m);
            var trend = new List<int>
            {
                baseTrend,
                baseTrend + rnd.Next(-300, 400),
                baseTrend + rnd.Next(-100, 600),
                baseTrend + rnd.Next(100, 800),
                (int)est
            };
            int delta = (int)Math.Round(((decimal)trend[4] - trend[0]) / Math.Max(1, trend[0]) * 100);

            string prefix = comm.Length >= 2 ? comm[..2] : "CR";
            list.Add(new CustomQuote
            {
                Id = i,
                Job = $"{prefix}{i:D4}",
                Salesperson = sp.Item1,
                AvatarInitials = sp.Item2,
                AvatarBg = sp.Item3,
                DateRequested = date,
                Community = comm,
                CustomerNo = $"90000{i:D4}",
                Customer = $"{prefix}{i:D4} - SPEC",
                Category = cat.Item1,
                CategoryDesc = cat.Item2,
                Address = $"{rnd.Next(10, 999)} {comm.Split(' ')[0]} Way",
                Description = desc,
                Location = "Main Floor",
                Comments = "Client approved options sheet",
                EstimateAmount = est,
                Status = status,
                TrendHistory = trend,
                TrendDeltaPercent = delta
            });
        }

        return list;
    }

