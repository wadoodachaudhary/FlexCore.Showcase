@page "/demo/grid/items"
@page "/demo/grid/grouping"
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, tracker section 6). Same grid, data and aggregates, with
   three corrections: ShowGroupCount dropped because the Count aggregate's caption template already prints "(n items)", so every
   caption showed the count twice; the internal catalog name left the intro; "default sorts" left the intro because the page sets
   none. Two library behaviours shape the copy (logged in SC-253): a group footer prints only the first aggregate defined for a
   column, so the Count footer template never shows; and the caption aggregates' pill styling is scoped CSS that never matches the
   spans built in GridControl.razor.cs, so they run together, which the page CSS works around through the .catalog wrapper. Parameter tables are a later pass (SC-278). *@

<PageTitle>Grouping &amp; totals — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Grouping &amp; totals" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Group rows by a column, with averages and counts in the group captions and footers."
                   SourcePath="Grid/GridControl.razor;Grid/GridModels.cs">
    <Overview>
        <p>
            <code>GroupColumns</code> opens the grid already grouped; with <code>AllowGrouping</code> the user regroups by dragging a header
            into the bar above the grid. <code>AggregateRows</code> lists what to compute per group: each <code>AggregateColumn</code> names a
            field, an <code>AggregateType</code> and a format, and its <code>GroupCaptionTemplate</code> and <code>GroupFooterTemplate</code>
            decide where the value is printed and how. <code>ShowSearchBar</code> adds a search box to the grid toolbar.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="catalog" Title="Item catalog grouped by category" RazorCode="@Code.Catalog" CSharpCode="@Code.CatalogCs">
            <Description><p>A cost-item catalog: material, labor, subcontract, equipment and overhead lines keyed by phase, each with a default cost and an Active flag. It opens grouped by <strong>Category</strong>; drag <strong>Phase</strong> into the bar to regroup. Each caption shows the average default cost and the item count; each footer repeats the average. Sort <strong>Default $</strong> descending for the priciest items, filter <strong>Active</strong> for the inactive ones, or type in the search box.</p></Description>
            <Demo>
                <div class="catalog">
                <GridControl TValue="CatalogItem"
                             DataSource="@_items"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowGrouping="true"
                             AllowResizing="true"
                             AllowColumnReorder="true"
                             EnableHover="true"
                             ShowSearchBar="true"
                             Height="520px"
                             GroupColumns="@_groupColumns"
                             AggregateRows="_aggregates">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(CatalogItem.ItemId)"      HeaderText="Item ID"     Width="110px" />
                        <GridColumn Field="@nameof(CatalogItem.Description)" HeaderText="Description" Width="260px" />
                        <GridColumn Field="@nameof(CatalogItem.Phase)"       HeaderText="Phase"       Width="160px" />
                        <GridColumn Field="@nameof(CatalogItem.Category)"    HeaderText="Category"    Width="160px" />
                        <GridColumn Field="@nameof(CatalogItem.UOM)"         HeaderText="UOM"         Width="70px" />
                        <GridColumn Field="@nameof(CatalogItem.DefaultCost)" HeaderText="Default $"   Width="120px"
                                    Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(CatalogItem.IsActive)"    HeaderText="Active"      Width="80px"
                                    Type="ColumnType.Boolean" TextAlign="TextAlign.Center" />
                    </GridColumnsBase>
                </GridControl>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>GridControl</code> grouping and aggregate parameters, and the <code>AggregateRow</code>, <code>AggregateColumn</code> and <code>AggregateType</code> tables, are still to be written from <code>Grid/GridControl.razor.cs</code> and <code>Grid/GridModels.cs</code>. Tracker SC-278.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/pivot-formulas">Pivot tables</a>: totals as a cross-tab instead of groups.</li>
            <li>Further grid pages not in the menu: <a href="demo/grid/assembly">Assembly</a> and <a href="demo/grid/vendor-prices">Vendor prices</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private List<CatalogItem> _items = DemoData.GenerateItemCatalog();

    private List<string> _groupColumns = new() { nameof(CatalogItem.Category) };

    private List<AggregateRow> _aggregates = new()
    {
        new AggregateRow
        {
            ShowInGroupCaption = true,
            ShowInGroupFooter = true,
            Columns = new()
            {
                new AggregateColumn { Field = nameof(CatalogItem.DefaultCost), Type = AggregateType.Average, Format = "C2",
                    GroupCaptionTemplate = "avg {value}", GroupFooterTemplate = "Avg {value}" },
                new AggregateColumn { Field = nameof(CatalogItem.DefaultCost), Type = AggregateType.Count,
                    GroupCaptionTemplate = "({value} items)", GroupFooterTemplate = "{value} items" },
            }
        }
    };

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed); the C# tab also carries the
    // CatalogItem record from Data/DemoData.cs.
    private static class Code
    {
        public const string Catalog = @"<div class=""catalog"">
<GridControl TValue=""CatalogItem""
             DataSource=""@_items""
             AllowSelection=""true""
             AllowSorting=""true""
             AllowFiltering=""true""
             AllowGrouping=""true""
             AllowResizing=""true""
             AllowColumnReorder=""true""
             EnableHover=""true""
             ShowSearchBar=""true""
             Height=""520px""
             GroupColumns=""@_groupColumns""
             AggregateRows=""_aggregates"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(CatalogItem.ItemId)""      HeaderText=""Item ID""     Width=""110px"" />
        <GridColumn Field=""@nameof(CatalogItem.Description)"" HeaderText=""Description"" Width=""260px"" />
        <GridColumn Field=""@nameof(CatalogItem.Phase)""       HeaderText=""Phase""       Width=""160px"" />
        <GridColumn Field=""@nameof(CatalogItem.Category)""    HeaderText=""Category""    Width=""160px"" />
        <GridColumn Field=""@nameof(CatalogItem.UOM)""         HeaderText=""UOM""         Width=""70px"" />
        <GridColumn Field=""@nameof(CatalogItem.DefaultCost)"" HeaderText=""Default $""   Width=""120px""
                    Type=""ColumnType.Number"" Format=""C2"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(CatalogItem.IsActive)""    HeaderText=""Active""      Width=""80px""
                    Type=""ColumnType.Boolean"" TextAlign=""TextAlign.Center"" />
    </GridColumnsBase>
</GridControl>
</div>";
        public const string CatalogCs = @"private List<CatalogItem> _items = DemoData.GenerateItemCatalog();

private List<string> _groupColumns = new() { nameof(CatalogItem.Category) };

private List<AggregateRow> _aggregates = new()
{
    new AggregateRow
    {
        ShowInGroupCaption = true,
        ShowInGroupFooter = true,
        Columns = new()
        {
            new AggregateColumn { Field = nameof(CatalogItem.DefaultCost), Type = AggregateType.Average, Format = ""C2"",
                GroupCaptionTemplate = ""avg {value}"", GroupFooterTemplate = ""Avg {value}"" },
            new AggregateColumn { Field = nameof(CatalogItem.DefaultCost), Type = AggregateType.Count,
                GroupCaptionTemplate = ""({value} items)"", GroupFooterTemplate = ""{value} items"" },
        }
    }
};

// Data/DemoData.cs
public record CatalogItem(string ItemId, string Description, string Phase, string Category,
    string UOM, decimal DefaultCost, bool IsActive);";
    }
}
