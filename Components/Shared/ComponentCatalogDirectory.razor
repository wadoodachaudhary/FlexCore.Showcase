            </div>
            <span class="popular-name">Data Grid</span>
        </a>

        <a href="demo/charts" class="popular-card">
            <div class="popular-icon-box purple">
                <span class="bi bi-pie-chart-fill"></span>
            </div>
            <span class="popular-name">Charts</span>
        </a>

        <a href="demo/charts/sunburst" class="popular-card">
            <div class="popular-icon-box teal">
                <span class="bi bi-sun-fill"></span>
            </div>
