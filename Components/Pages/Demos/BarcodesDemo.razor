    // Code 128 and Code 39 take the lettered SKU; EAN-13 and ITF take digits only.
    private string Sample => _type is BarcodeType.Ean13 or BarcodeType.Itf ? Tag.Digits : Tag.Sku;
    private void PickProduct(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _product = values[0];
        _barcodeValue = Sample;
    }
    private void PickType(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _type = Enum.Parse<BarcodeType>(values[0]);
        _barcodeValue = Sample;
    }

