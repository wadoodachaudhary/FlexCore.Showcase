@page "/demo/grid/reordering"
@* Retitled 2026-10-06 to match the site nav; copy unchanged. *@

<PageTitle>Column reorder — FlexCore Showcase</PageTitle>

<h1>Column reorder</h1>
<p>
    Focused demo for column drag-and-drop behavior. Use this page to validate
    first-drop reorder, left/right drop positioning, and repeated reorder cycles.
</p>

<div style="display:flex; align-items:center; gap:10px; margin:10px 0 14px;">
    <label for="reorderPipeColor" style="font-weight:600;">Reorder pipe color</label>
    <input id="reorderPipeColor" type="color" @bind="_reorderPipeColor" />
    <input type="text" @bind="_reorderPipeColor" style="width:110px;" />
</div>

<div class="demo-frame">
    <GridControl TValue="ReorderingRow"
                 DataSource="@_rows"
                 AllowSelection="true"
                 AllowSorting="true"
                 AllowFiltering="true"
                 AllowGrouping="false"
                 AllowResizing="true"
                 AllowColumnReorder="true"
                 ColumnReorderPipeColor="@_reorderPipeColor"
                 EnableHover="true"
                 ShowSearchBar="true"
                 Height="520px">
        <GridColumnsBase>
            <GridColumn Field="@nameof(ReorderingRow.Model)"       HeaderText="Model"        Width="130px" />
            <GridColumn Field="@nameof(ReorderingRow.Community)"   HeaderText="Community"    Width="150px" />
            <GridColumn Field="@nameof(ReorderingRow.Phase)"       HeaderText="Phase"        Width="120px" />
            <GridColumn Field="@nameof(ReorderingRow.Task)"        HeaderText="Task"         Width="220px" />
            <GridColumn Field="@nameof(ReorderingRow.Owner)"       HeaderText="Owner"        Width="150px" />
            <GridColumn Field="@nameof(ReorderingRow.Priority)"    HeaderText="Priority"     Width="100px" />
            <GridColumn Field="@nameof(ReorderingRow.Hours)"       HeaderText="Hours"        Width="90px"
                        Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(ReorderingRow.Cost)"        HeaderText="Cost"         Width="120px"
                        Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(ReorderingRow.LastUpdated)" HeaderText="Last Updated" Width="130px"
                        Type="ColumnType.Date" Format="d" />
        </GridColumnsBase>
    </GridControl>
</div>

<h2>Things to try</h2>
<ul>
    <li>Drag <strong>Priority</strong> before <strong>Model</strong> and confirm first drop reorders immediately.</li>
    <li>Drag <strong>Owner</strong> to the right half of <strong>Cost</strong> and verify it lands after Cost.</li>
    <li>Perform 4-5 sequential reorders and confirm only the dragged column moves each time.</li>
    <li>Reload the page and repeat to validate consistent behavior from a fresh state.</li>
</ul>

<h2>Other Grid Demos</h2>
<ul>
    <li><a href="/demo/grid">Basic Grid</a></li>
    <li><a href="/demo/grid/assembly">Assembly</a></li>
    <li><a href="/demo/grid/vendor-prices">Vendor Prices</a></li>
    <li><a href="/demo/grid/items">Items Catalog</a></li>
</ul>

