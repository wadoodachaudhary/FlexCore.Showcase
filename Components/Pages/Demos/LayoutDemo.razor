    private string _section = "Estimates";
    private Item _selected = null!;
    private void Go(string section) { _section = section; _selected = _data[section][0]; }

    // Dashboard: placements come from state so a click re-flows the grid.
    private sealed record Kpi(string Key, string Value, string Label, string Trend, string Detail);
    private readonly Kpi[] _kpis =
    {
        new("orders", "1,234", "Orders", "+5.2%", "1,234 this week, 1,173 last week"),
        new("revenue", "$89K", "Revenue", "+12%", "$89K this week, $79K last week"),
        new("uptime", "98.5%", "Uptime", "+0.1%", "98.5% over 30 days, 2 incidents"),
    };
    private string? _focus;
    private Dictionary<string, (int Row, int Col, int SizeX, int SizeY)> _place = new();
    private int ChartsRow => _focus is null ? 2 : 4;   // KPI rows 0–1, or 0–3 while one is expanded
    protected override void OnInitialized() { _selected = _data["Estimates"][1]; Layout(); }
    private void Toggle(string key) { _focus = _focus == key ? null : key; Layout(); }
    private void Layout()
    {
        _place.Clear();
        var col = 0;
        if (_focus is not null) _place[_focus] = (0, 0, 3, 2);            // expanded card takes the whole first row
        foreach (var k in _kpis.Where(k => k.Key != _focus))
            _place[k.Key] = (_focus is null ? 0 : 2, col++, 1, 2);        // the rest line up below it
    }

    private readonly List<ChartSeries> _traffic = new()
