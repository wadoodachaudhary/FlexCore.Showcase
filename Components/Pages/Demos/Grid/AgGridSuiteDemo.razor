    <DocumentationContent>
        <h3>FlexCore vs. AG Grid Architecture</h3>
        <p>
            This showcase brings the four flagship use cases of <strong>AG Grid</strong> into the .NET ecosystem using
            <strong>FlexCore controls written in C#</strong>, with no wrapper around a third-party JavaScript grid:
        </p>
        <ul>
            <li>
                <strong>1. Performance (100,000 Rows):</strong> FlexCore renders only the visible rows plus a small buffer and recycles those elements, so DOM size does not grow with the dataset. Frame rate is not measured here.
            </li>
            <li>
                <strong>2. High-Frequency Market Ticker (Finance):</strong> High-rate delta recalculations and price flashes are computed directly in C# on server or client circuits.
                Sparklines are rendered via pure SVG vector math without loading heavyweight third-party charting libraries into every cell.
            </li>
            <li>
                <strong>3. Organizational Directory (HR Tree Data):</strong> <code>TreeGridControl</code> supports self-referential parent/child hierarchy mappings (<code>IdMapping</code> / <code>ParentIdMapping</code>) without requiring cumbersome nested DTO models.
            </li>
            <li>
                <strong>4. Supply Chain Logistics (Inventory Master-Detail):</strong> Seamlessly links high-level product catalogs to multi-warehouse breakdown rows with synchronized real-time stock actions.
            </li>
        </ul>

        <h3>Performance Comparison Matrix</h3>
        <table class="sf-param-table">
            <thead>
                <tr>
                    <th>Feature</th>
                    <th>FlexCore (.NET 10)</th>
                    <th>AG Grid (JavaScript)</th>
                    <th>Advantage</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Execution Runtime</strong></td>
                    <td>Native C# / Blazor WebAssembly &amp; Server</td>
                    <td>JavaScript / TypeScript V8</td>
                    <td>Strong typing and shared backend models; no JSON contract between grid and app code</td>
                </tr>
                <tr>
                    <td><strong>Sparkline Footprint</strong></td>
                    <td>Lightweight Pure SVG polyline</td>
                    <td>AG Charts JavaScript module</td>
                    <td>No third-party charting script</td>
                </tr>
                <tr>
                    <td><strong>Tree Data Binding</strong></td>
                    <td>Flat lists with <code>IdMapping</code> / <code>ParentIdMapping</code></td>
                    <td>Path arrays or nested object graphs</td>
                    <td>Direct 1-to-1 match with SQL table schemas</td>
                </tr>
                <tr>
                    <td><strong>100k Rows Memory</strong></td>
                    <td>Recycled DOM viewport + buffer</td>
                    <td>Recycled DOM viewport + buffer</td>
                    <td>DOM size fixed at the visible window; scroll latency not measured</td>
                </tr>
            </tbody>
        </table>
    </DocumentationContent>
</SyncfusionDemoLayout>

@code {
    private enum AgTab
    {
        Performance,
        Finance,
        Hr,
        Inventory
    }

    private AgTab _activeTab = AgTab.Performance;

    // Performance Demo State
    private List<AgPerformanceRow> _perfRows = new();
    private int _perfRowCount = 100000;
    private double _perfGenMs = 0;
    private int _perfGenerationKey = 1;

    // Finance Demo State
    private List<AgFinanceTickerRow> _financeRows = new();
    private System.Timers.Timer? _financeTimer;
    private bool _isStreaming = false;
    private int _timerIntervalMs = 500;
    private int _totalTicksCount = 0;
    private int _financeGenerationKey = 1;

    // HR Demo State
    private List<AgHrEmployeeRow> _allHrEmployees = new();
    private List<AgHrEmployeeRow> _displayedHrEmployees = new();
    private string _selectedDept = "All";
    private int _hrGenerationKey = 1;

    // Inventory Demo State
    private GridControl<AgInventoryProductRow>? _inventoryGrid;
    private readonly GridControlEvents<AgInventoryProductRow> _inventoryEvents = new();
    private List<AgInventoryProductRow> _inventoryProducts = new();
    private List<AgInventoryProductRow> _displayedInventoryProducts = new();
    private AgInventoryProductRow? _selectedInventoryProduct;
    private string _inventoryCategoryFilter = "All";

    protected override void OnInitialized()
    {
        // 1. Initialize Performance data
        LoadPerformanceData(100000);

        // 2. Initialize Finance data
        _financeRows = BenchDataStore.GetFinanceTickers();

        // 3. Initialize HR data
        _allHrEmployees = BenchDataStore.GetHrHierarchy();
        _displayedHrEmployees = _allHrEmployees.ToList();

        // 4. Initialize Inventory data
        _inventoryProducts = BenchDataStore.GetInventoryProducts();
        _displayedInventoryProducts = _inventoryProducts.ToList();
        _selectedInventoryProduct = _displayedInventoryProducts.FirstOrDefault();

        // Bind inventory selection event
        _inventoryEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<AgInventoryProductRow>>(this, args =>
        {
            if (args.Data != null)
            {
                _selectedInventoryProduct = args.Data;
                StateHasChanged();
            }
        });
    }

    private void SwitchTab(AgTab tab)
    {
        _activeTab = tab;
        if (tab == AgTab.Finance && !_isStreaming)
        {
            // Auto-start streaming on entering Finance tab for live effect
            StartStreaming();
        }
        else if (tab != AgTab.Finance && _isStreaming)
        {
            // Pause timer when switching away to conserve CPU
            PauseStreaming();
        }
    }

    #region 1. Performance Methods
    private void LoadPerformanceData(int count)
    {
        _perfRowCount = count;
        var sw = Stopwatch.StartNew();
        _perfRows = BenchDataStore.GeneratePerformanceRows(count);
        sw.Stop();
        _perfGenMs = sw.Elapsed.TotalMilliseconds;
        _perfGenerationKey++;
    }
    #endregion

    #region 2. Finance Methods
    private void StartStreaming()
    {
        _isStreaming = true;
        _financeTimer?.Stop();
        _financeTimer?.Dispose();

        _financeTimer = new System.Timers.Timer(_timerIntervalMs);
        _financeTimer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(OnFinanceTick);
        };
        _financeTimer.AutoReset = true;
        _financeTimer.Start();
    }

    private void PauseStreaming()
    {
        _isStreaming = false;
        _financeTimer?.Stop();
    }

    private void ToggleStreaming()
    {
        if (_isStreaming)
            PauseStreaming();
        else
            StartStreaming();
    }

    private void SetInterval(int intervalMs)
    {
        _timerIntervalMs = intervalMs;
        if (_isStreaming)
        {
            StartStreaming();
        }
    }

    private void OnManualTick()
    {
        OnFinanceTick();
    }

    private void OnFinanceTick()
    {
        if (_financeRows.Count == 0) return;

        // Randomly pick 3 to 7 tickers to update
        int countToUpdate = Random.Shared.Next(3, 8);
        for (int i = 0; i < countToUpdate; i++)
        {
            int idx = Random.Shared.Next(_financeRows.Count);
            var ticker = _financeRows[idx];

            ticker.PreviousPrice = ticker.Price;
            // -1.5% to +1.5% price delta
            double pctChange = (Random.Shared.NextDouble() - 0.49) * 0.03;
            decimal delta = Math.Round(ticker.Price * (decimal)pctChange, 2);
            if (delta == 0) delta = pctChange >= 0 ? 0.05m : -0.05m;

            ticker.Price = Math.Max(0.50m, ticker.Price + delta);
            ticker.TickDirection = ticker.Price > ticker.PreviousPrice ? 1 : -1;
            ticker.LastUpdated = DateTime.UtcNow;

            // Update sparkline timeline
            ticker.Timeline.Add((double)ticker.Price);
            if (ticker.Timeline.Count > 24)
            {
                ticker.Timeline.RemoveAt(0);
            }
        }

        _totalTicksCount++;
        StateHasChanged();
    }

    private void ResetMarket()
    {
        _financeRows = BenchDataStore.GetFinanceTickers();
        _totalTicksCount = 0;
        _financeGenerationKey++;
        StateHasChanged();
    }

    private static string GetSparklinePoints(List<double> timeline)
    {
        if (timeline == null || timeline.Count < 2) return "0,12 110,12";
        double min = timeline.Min();
        double max = timeline.Max();
        double range = max - min;
        if (range < 0.001) range = 1.0;

        var pts = new List<string>(timeline.Count);
        for (int i = 0; i < timeline.Count; i++)
        {
            double x = (i * 100.0) / (timeline.Count - 1) + 5.0;
            double y = 20.0 - ((timeline[i] - min) / range * 16.0) + 2.0;
            pts.Add($"{x:F1},{y:F1}");
        }
        return string.Join(" ", pts);
    }

    private static string GetSparklineStroke(List<double> timeline)
    {
        if (timeline == null || timeline.Count < 2) return "#0284c7";
        return timeline[^1] >= timeline[0] ? "#10b981" : "#ef4444";
    }
    #endregion

    #region 3. HR Methods
    private void FilterDepartment(string dept)
    {
        _selectedDept = dept;
        if (dept == "All")
        {
            _displayedHrEmployees = _allHrEmployees.ToList();
        }
        else
        {
            // Keep matching dept or any parent managers so hierarchy renders correctly
            var matching = _allHrEmployees.Where(e => e.Department == dept).Select(e => e.EmployeeID).ToHashSet();
            var needed = new HashSet<string>(matching);

            foreach (var id in matching)
            {
                var cur = _allHrEmployees.FirstOrDefault(e => e.EmployeeID == id);
                while (cur?.ReportsToID != null)
                {
                    needed.Add(cur.ReportsToID);
                    cur = _allHrEmployees.FirstOrDefault(e => e.EmployeeID == cur.ReportsToID);
                }
            }

            _displayedHrEmployees = _allHrEmployees.Where(e => needed.Contains(e.EmployeeID)).ToList();
        }
        _hrGenerationKey++;
    }

    private void ResetHrView()
    {
        _selectedDept = "All";
        _displayedHrEmployees = _allHrEmployees.ToList();
        _hrGenerationKey++;
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "EM";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetStars(int rating)
    {
        int r = Math.Clamp(rating, 0, 5);
        return new string('★', r) + new string('☆', 5 - r);
    }
    #endregion

    #region 4. Inventory Methods
    private void FilterInventoryCategory(string category)
    {
        _inventoryCategoryFilter = category;
        if (category == "All")
        {
            _displayedInventoryProducts = _inventoryProducts.ToList();
        }
        else
        {
            _displayedInventoryProducts = _inventoryProducts.Where(p => p.Category == category).ToList();
        }

        if (!_displayedInventoryProducts.Contains(_selectedInventoryProduct!))
        {
            _selectedInventoryProduct = _displayedInventoryProducts.FirstOrDefault();
        }
    }

    private void SelectInventoryProduct(AgInventoryProductRow product)
    {
        _selectedInventoryProduct = product;
    }

    private void SimulateStockArrival()
    {
        if (_selectedInventoryProduct == null) return;
        var firstWh = _selectedInventoryProduct.WarehouseDetails.FirstOrDefault();
        if (firstWh != null)
        {
            firstWh.QuantityOnHand += 50;
            if (firstWh.IncomingShipmentQty >= 50)
                firstWh.IncomingShipmentQty -= 50;
        }
        _selectedInventoryProduct.TotalOnHand += 50;
        StateHasChanged();
    }

    private void SimulateStockReserve()
    {
        if (_selectedInventoryProduct == null) return;
        var firstWh = _selectedInventoryProduct.WarehouseDetails.FirstOrDefault(w => w.AvailableQuantity >= 10);
        if (firstWh != null)
        {
            firstWh.ReservedQuantity += 10;
            _selectedInventoryProduct.TotalReserved += 10;
            StateHasChanged();
        }
    }
    #endregion

    public void Dispose()
    {
        _financeTimer?.Stop();
        _financeTimer?.Dispose();
        _financeTimer = null;
    }

