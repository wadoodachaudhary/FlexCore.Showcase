@using FlexCore.Showcase.Components.Shared
@inject FlexCore.Showcase.Services.BenchDataStore BenchData

@* 2026-10-18: moved onto FeatureDemoLayout (Saturday plan) and given a real relation: UserListItem now carries GroupID and
   BenchDataStore generates one user per SecurityGroup.MemberCount, so the detail grid filters on u.GroupID == group.GroupID and
   the master's Users column equals the detail's row count (SC-189, SC-193). Gone: the Take((GroupID % 4) + 3) subset, the
   "Create Group & Rename" button that never opened an editor (SC-190), the manual dirty checkbox (SC-191; the real veto is on
   Unsaved-row lock), the benchmark wording (SC-192) and the UserPerms jargon in the copy (SC-188; the old route stays as an
   alias).
   2026-10-18: vocabulary written from GridControl.razor.cs (selection parameters, the private SelectRow/ToggleRowSelection paths that
   raise RowSelecting/RowSelected, SelectFirstVisibleRowAsync, the public Select*/Clear* methods and NotifySelectionChangedAsync),
   GridControl.KeyboardSelection.cs, GridControlEvents.cs, SelectionSettings.cs and GridModels.cs; rows checked with
   scratchpad/vocabcheck.py. Members the grid declares but never raises or reads (RowDeselecting, RowDeselected, EnableToggle,
   PersistSelection) are listed as such; the library note is in SC-253. *@

<PageTitle>Master-detail — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Master-detail" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Two grids, one selection: pick a row in the first and the second shows what belongs to it."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridControlEvents.cs;Grid/SelectionSettings.cs;Grid/GridModels.cs">
    <Overview>
        <p>
            A master-detail screen is two ordinary grids and one event. The master grid raises <code>RowSelected</code> (a
            <code>GridControlEvents</code> callback passed through <code>EventsRef</code>) with the selected row in <code>args.Data</code>;
            the page filters its detail list by that row's key and binds the result to the second grid's <code>DataSource</code>.
            <code>SelectionSettings</code> with <code>SelectionType.Single</code> keeps one master row selected, and
            <code>AutoSelectFirstRow</code> selects the first row as soon as the grid has rows and raises <code>RowSelected</code> for it, so
            the detail fills on arrival. <code>RowSelecting</code> can refuse a move while the detail has unsaved edits; the
            <a href="demo/grid/unsaved-row-lock">Unsaved-row lock</a> page shows that.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="groups" Title="Security groups and their members" RazorCode="@Code.Groups" CSharpCode="@Code.GroupsCs">
            <Description><p>Seven groups on the left, 126 users on the right. Click a group and the right grid shows its members; the Users column of the group row, the member grid's footer and the line under the grids count the same people. The member grid sorts on its own and marks inactive accounts.</p></Description>
            <Demo>
                <div class="pair">
                    <div>
                        <p class="pane-title">Groups</p>
                        <GridControl TValue="SecurityGroup"
                                     DataSource="@_groups"
                                     Height="300px"
                                     AllowSelection="true"
                                     AutoSelectFirstRow="true"
                                     SelectionSettingsRef="@_singleRow"
                                     EventsRef="@_groupEvents">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(SecurityGroup.Description)" HeaderText="Group" Width="200px" />
                                <GridColumn Field="@nameof(SecurityGroup.IsAdmin)" HeaderText="Admin" Width="80px" Type="ColumnType.Boolean" />
                                <GridColumn Field="@nameof(SecurityGroup.MemberCount)" HeaderText="Users" Width="80px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                            </GridColumnsBase>
                        </GridControl>
                    </div>
                    <div>
                        <p class="pane-title">Members of @(_selectedGroup?.Description ?? "…")</p>
                        <GridControl TValue="UserListItem"
                                     DataSource="@_members"
                                     Height="300px"
                                     AllowSorting="true"
                                     ShowRowCountInFooter="true">
                            <GridColumnsBase>
                                <GridColumn Field="@nameof(UserListItem.UserID)" HeaderText="Login" Width="100px" />
                                <GridColumn Field="@nameof(UserListItem.UserName)" HeaderText="Name" Width="150px" />
                                <GridColumn Field="@nameof(UserListItem.Email)" HeaderText="Email" Width="210px" />
                                <GridColumn Field="@nameof(UserListItem.Active)" HeaderText="Active" Width="70px" Type="ColumnType.Boolean" />
                            </GridColumnsBase>
                        </GridControl>
                    </div>
                </div>
                <p class="result">@_members.Count members of @(_selectedGroup?.Description ?? "no group"), @_members.Count(u => !u.Active) inactive.</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="GridControl selection parameters" Rows="Vocab.Grid" />
        <ApiTable Kind="ApiKind.Properties" Title="SelectionSettings" Rows="Vocab.Settings" />
        <ApiTable Kind="ApiKind.Events" Title="GridControlEvents, selection" Rows="Vocab.Events" />
        <ApiTable Kind="ApiKind.Properties" Title="RowSelectEventArgs&lt;TValue&gt;" Rows="Vocab.Args" />
        <ApiTable Kind="ApiKind.Methods" Title="Selection methods" Rows="Vocab.Methods" />
        <p>
            <code>GridControlEvents</code> also carries the sorting, filtering, paging, editing, grouping, resizing, reordering and cell
            events; those belong with the pages that use them. The methods above change the selection without raising
            <code>RowSelecting</code> or <code>RowSelected</code>; they raise <code>SelectionChanged</code> with the source
            <code>Programmatic</code>.
        </p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/unsaved-row-lock">Unsaved-row lock</a>: <code>RowSelecting</code> refusing a move while a row has unsaved edits.</li>
            <li><a href="demo/grid/grouping">Grouping &amp; totals</a>: one grid with nested groups instead of two grids.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private List<SecurityGroup> _groups = [];
    private List<UserListItem> _users = [];
    private List<UserListItem> _members = [];
    private SecurityGroup? _selectedGroup;

    private readonly SelectionSettings _singleRow = new() { Mode = SelectionMode.Row, Type = SelectionType.Single };
    private readonly GridControlEvents<SecurityGroup> _groupEvents = new();

    protected override void OnInitialized()
    {
        _groups = BenchData.SecurityGroups.ToList();
        _users = BenchData.Users.ToList();
        _groupEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<SecurityGroup>>(this, args => Show(args.Data));
        Show(_groups.FirstOrDefault());
    }

    private void Show(SecurityGroup? group)
    {
        _selectedGroup = group;
        _members = group is null ? [] : _users.Where(u => u.GroupID == group.GroupID).ToList();
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
    {
