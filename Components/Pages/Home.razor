            <Template Context=""row"">
                @{
                    var q = (CustomQuote)row;
                    var spark = GetSparklinePoints(q.TrendHistory, 68, 22);
                    var isUp = q.TrendDeltaPercent >= 0;
                    var color = isUp ? ""#10b981"" : ""#ef4444"";
                    var fill = isUp ? ""rgba(16, 185, 129, 0.16)"" : ""rgba(239, 68, 68, 0.16)"";
                }
                <div class=""sparkline-cell"" title=""5-Month Cost Trend: @(isUp ? ""+"" : """")@q.TrendDeltaPercent%"">
                    <svg width=""68"" height=""22"" viewBox=""0 0 68 22"" class=""sparkline-svg"">
                        <polygon points=""@spark.AreaPoints"" fill=""@fill"" />
                        <polyline points=""@spark.PolylinePoints"" fill=""none"" stroke=""@color"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"" />
                        <circle cx=""@spark.LastX"" cy=""@spark.LastY"" r=""2.5"" fill=""@color"" />
                    </svg>
                    <span class=""sparkline-delta @(isUp ? ""delta-up"" : ""delta-down"")"">
                        @(isUp ? ""▲"" : ""▼"")@Math.Abs(q.TrendDeltaPercent)%
                    </span>
                </div>
            </Template>
        </GridColumn>

        <GridColumn Field=""Status"" HeaderText=""Status"" Width=""110px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{ var q = (CustomQuote)row; }
                <BadgeControl Text=""@q.Status"" CssClass=""@($""grid-badge {GetStatusBadgeClass(q.Status)}"")"" />
            </Template>
        </GridColumn>

        <!-- ── POPUP EDITABLE DESCRIPTION COLUMN ── -->
        <GridColumn HeaderText=""Description (Popup Edit)"" Width=""280px"" AllowEditing=""false"">
            <Template Context=""row"">
                @{ var q = (CustomQuote)row; }
                <div class=""desc-cell-wrapper"">
                    <span class=""desc-text"" title=""@q.Description"">@q.Description</span>
                    <button type=""button"" class=""btn-cell-popup-edit"" title=""Edit in Modal Popup""
                            @onclick=""@(() => OpenPopupEdit(q))"" @onclick:stopPropagation=""true"">
                        <span class=""bi bi-pencil-square""></span> Edit
                    </button>
                </div>
            </Template>
        </GridColumn>
    </GridColumnsBase>
</GridControl>",

            "charts" =>
@"<ChartControl Type=""ChartType.Bar"" Title=""Performance Overview"" Height=""280px"" Series=""@_quarterlySeries"" />

<ChartControl Type=""ChartType.Pie"" Title=""Inventory Allocation"" Height=""280px"" Series=""@_pieSeries"" />",

            "ribbon" =>
@"<RibbonControl>
    <RibbonTab Title=""Home"">
        <RibbonGroup Title=""Clipboard"">
            <RibbonButton Text=""Paste"" Icon=""bi-clipboard"" OnClick=""@OnPaste"" />
            <RibbonButton Text=""Copy"" Icon=""bi-files"" OnClick=""@OnCopy"" />
        </RibbonGroup>
        <RibbonGroup Title=""Export"">
            <RibbonButton Text=""Excel (XLSX)"" Icon=""bi-file-earmark-excel"" OnClick=""@OnExportExcel"" />
        </RibbonGroup>
    </RibbonTab>
</RibbonControl>",

            "reports" =>
@"// Crystal Reports XML / SQL Adaptive Reporting Pipeline
builder.Services.AddScoped<CrystalXmlReportLoader>();
builder.Services.AddScoped<IReportSessionContext, ShowcaseReportSessionContext>();
builder.Services.AddScoped<IReportDataExecutor, ShowcaseReportDataExecutor>();

<ReportWriterControl Definition=""@reportDef"" Executor=""@executor"" />",

            _ => ""
        };
    }
}
