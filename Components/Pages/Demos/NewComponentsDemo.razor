@code {
    private readonly List<BreadCrumbItem> _crumbs = new() { new("Home", "/"), new("Requests", "demo/layout"), new("LIS-0001 Marmalade") };

    // Progress (2026-10-25): the import is simulated; a PeriodicTimer on this page advances it and the controls only display it.
    private enum ImportPhase { Idle, Connecting, Importing, Cancelled, Failed, Done }
    private static readonly (string City, int Lines)[] RateFiles = { ("Lisbon", 2000), ("Kyoto", 1800), ("Cape Town", 1200) };
    private static readonly int TotalLines = RateFiles.Sum(f => f.Lines);
    private ImportPhase _phase;
    private int _linesDone, _connectTicks;
    private bool _cancelling;
    private string? _error;
    private PeriodicTimer? _timer;

    private bool Running => _phase is ImportPhase.Connecting or ImportPhase.Importing;
    private bool Connecting => _phase == ImportPhase.Connecting;
    private double Percent => 100.0 * _linesDone / TotalLines;
    // The control shows its Cancel button whenever OnCancel has a delegate, so pass one only while the import runs.
    private EventCallback CancelCallback => Running ? EventCallback.Factory.Create(this, CancelImport) : default;

    private (int Index, int Done) CurrentFile()
    {
        int i = 0, left = _linesDone;
        while (i < RateFiles.Length - 1 && left >= RateFiles[i].Lines) left -= RateFiles[i++].Lines;
        return (i, left);
    }

    private string FileStatus() { var (i, done) = CurrentFile(); return $"{RateFiles[i].City}: {done:N0} of {RateFiles[i].Lines:N0} lines"; }

    private string ImportStatus => _phase switch
    {
        ImportPhase.Idle => "not started",
        ImportPhase.Connecting => "connecting",
        ImportPhase.Cancelled => $"stopped at {_linesDone:N0} lines",
        ImportPhase.Done => $"{TotalLines:N0} lines read",
        _ => FileStatus(),
    };

    private string ImportDetail => $"file {CurrentFile().Index + 1} of {RateFiles.Length} · {_linesDone:N0} of {TotalLines:N0} lines in all";

    private void StartImport()
    {
        StopTimer();
        (_phase, _linesDone, _connectTicks, _cancelling, _error) = (ImportPhase.Connecting, 0, 0, false, null);
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
        _ = RunImportAsync(_timer);
    }

    private async Task RunImportAsync(PeriodicTimer timer)
    {
        // StopTimer and Dispose end this loop: a disposed PeriodicTimer's WaitForNextTickAsync returns false.
        while (await timer.WaitForNextTickAsync())
            await InvokeAsync(() => { Tick(); StateHasChanged(); });
    }

    private void Tick()
    {
        if (!Running) return;
        if (_cancelling) { _phase = ImportPhase.Cancelled; StopTimer(); }
        else if (Connecting) { if (++_connectTicks == 6) _phase = ImportPhase.Importing; }
        else
        {
            _linesDone = Math.Min(TotalLines, _linesDone + Random.Shared.Next(80, 170));
            if (_linesDone == TotalLines) { _phase = ImportPhase.Done; StopTimer(); }
        }
    }

    // Bound to CancelDisabled: the button reads "cancelling…" until the next tick stops the loop.
    private void CancelImport() => _cancelling = true;

    private void FailImport()
    {
        var (i, done) = CurrentFile();
        _error = $"{RateFiles[i].City}, line {done + 1:N0}: the rate column is empty.";
        _phase = ImportPhase.Failed;
        StopTimer();
    }

    private void StopTimer() { _timer?.Dispose(); _timer = null; }

    // The page declares @implements IDisposable, so the timer stops when the page goes away.
    public void Dispose() => StopTimer();

