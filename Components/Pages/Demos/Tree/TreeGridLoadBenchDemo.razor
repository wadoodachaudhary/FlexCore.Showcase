private void GenerateTree()
{
    var list = new List<BenchTreeNode>();
    var rand = new Random(33);

    var groupTitles = new[]
    {
        ""0100 - General Requirements"",
        ""0200 - Existing Site Conditions"",
        ""0300 - Concrete Foundations"",
        ""0400 - Masonry & Stonework"",
        ""0500 - Metals & Structural Steel"",
        ""0600 - Wood, Plastics & Composites"",
        ""0700 - Thermal & Moisture Protection"",
        ""0800 - Openings (Doors & Windows)"",
        ""0900 - Finishes & Drywall"",
        ""1000 - Specialties & Accessories""
    };

    for (int g = 1; g <= _groupCount; g++)
    {
        var gId = $""G-{g:D3}"";
        var gTitle = groupTitles[(g - 1) % groupTitles.Length];
        decimal groupBudget = 0;

        var childNodes = new List<BenchTreeNode>();
        for (int p = 1; p <= _phasesPerGroup; p++)
        {
            var pBudget = Math.Round((decimal)(rand.NextDouble() * 35000 + 5000), 2);
            groupBudget += pBudget;
            childNodes.Add(new BenchTreeNode
            {
                NodeID = $""P-{g:D3}-{p:D2}"",
                ParentID = gId,
                Node = $""Phase {p}"",
                Level = 2,
                IsGroup = false,
                PhaseCount = 1,
                Budget = pBudget
            });
        }

        list.Add(new BenchTreeNode
        {
            NodeID = gId,
            ParentID = null,
            Node = $""{gTitle} (Division {g})"",
            Level = 1,
            IsGroup = true,
            PhaseCount = _phasesPerGroup,
            Budget = groupBudget
        });

        list.AddRange(childNodes);
    }

    _treeNodes = list;
    _treeGeneration++;
}

private bool TreatAsParent(BenchTreeNode node) => node.IsGroup;

