<PageTitle>Blazor Ribbon Control — FlexCore</PageTitle>

<FeatureDemoLayout Title="Ribbon" Category="Components" ControlName="RibbonControl"
                   Tagline="Organize many commands into tabs and titled groups, Office style."
                   SourcePath="RibbonControl.razor;RibbonTab.razor;RibbonGroup.razor;RibbonButton.razor;RibbonControl.razor.css">
    <Overview>
        <p>
            <code>RibbonControl</code> is a Blazor ribbon: an Office-style command bar with tabs across the top and titled groups of large and small buttons in each. Use it when a screen has more commands than a toolbar can hold, such as editing a booking; only the open tab's groups are shown, so the bar stays compact. The buttons hold no state, so your page decides what each does, when it is disabled and how it looks pressed.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="tabs" Title="A booking desk ribbon" RazorCode="@Code.Tabs" CSharpCode="@Code.TabsCs">
            <Description><p>Build the booking from the ribbon: each Trip button adds its line once and then turns <code>Disabled</code>, and the total grows; Hold is a toggle, and Cancel disables what no longer applies. Email opens a <code>DropDownContent</code> menu, and one group holds check boxes instead of buttons, which show or hide the line prices and the total. Hide the ribbon with the arrow on the right or a double-click on a tab; Reports is a <code>Disabled</code> tab.</p></Description>
            <Demo>
                <div class="desk-ribbon">
                    <RibbonControl Collapsible="true" @bind-Collapsed="_hidden">
                        <RibbonTab Title="Home">
                            <RibbonGroup Title="Booking">
                                <RibbonButton Text="Hold" Icon="⏸️" Large="true" Tooltip="Hold the seats for 24 hours" Pressed="@_held" Disabled="@_canceled" OnClick="@(() => _held = !_held)" />
                                <RibbonButton Text="Cancel" Icon="✖️" Disabled="@_canceled" OnClick="@(() => _canceled = true)" />
                                <RibbonButton Text="Reopen" Icon="↩️" Disabled="@(!_canceled)" OnClick="@(() => _canceled = false)" />
                            </RibbonGroup>
                            <RibbonGroup>
                                <div class="ribbon-options">
                                    <CheckBoxControl @bind-Checked="_showPrices" Label="Show prices" />
                                    <CheckBoxControl @bind-Checked="_showTotal" Label="Show total" />
                                </div>
                            </RibbonGroup>
                        </RibbonTab>
                        <RibbonTab Title="Trip">
                            <RibbonGroup Title="Travel" Disabled="@_canceled">
                                <RibbonButton Text="Add flight" Icon="✈️" Large="true" Disabled="@Has("Return flights")" OnClick="@(() => Add("Return flights", 420))" />
                                <RibbonButton Text="Transfer" Icon="🚐" Disabled="@Has("Airport transfer")" OnClick="@(() => Add("Airport transfer", 80))" />
                            </RibbonGroup>
                            <RibbonGroup Title="Stay" Disabled="@_canceled">
                                <RibbonButton Text="Add hotel" Icon="🏨" Large="true" Disabled="@Has("Old-town hotel, 4 nights")" OnClick="@(() => Add("Old-town hotel, 4 nights", 1120))" />
                                <RibbonButton Text="Excursion" Icon="🗺️" Disabled="@Has("Guided food tour")" OnClick="@(() => Add("Guided food tour", 180))" />
                                <RibbonButton Text="Insurance" Icon="🛡️" Disabled="@Has("Travel insurance")" OnClick="@(() => Add("Travel insurance", 120))" />
                            </RibbonGroup>
                        </RibbonTab>
                        <RibbonTab Title="Documents">
                            <RibbonGroup Title="Send">
                                <RibbonButton @ref="_send" Text="Email" Icon="✉️" Large="true">
                                    <DropDownContent>
                                        @foreach (var doc in new[] { "Itinerary", "Invoice", "Tickets" })
                                        {
                                            <ButtonControl BareStyle="true" CssClass="ribbon-menu-item" OnClick="@(() => Send(doc))">@doc</ButtonControl>
                                        }
                                    </DropDownContent>
                                </RibbonButton>
                                <RibbonButton Text="Print" Icon="🖨️" OnClick="@(() => _sent = "Itinerary printed")" />
                            </RibbonGroup>
                        </RibbonTab>
                        <RibbonTab Title="Reports" Disabled="true" />
                    </RibbonControl>
                    <div class="desk-booking" role="status">
                        <div class="desk-head">
                            <strong>LIS-0001 · Lisbon city break for Albus Door</strong>
                            <BadgeControl Text="@(_canceled ? "Canceled" : _held ? "On hold" : "Open")" Variant="@(_canceled ? BadgeVariant.Danger : _held ? BadgeVariant.Warning : BadgeVariant.Success)" />
                        </div>
                        <ul class="desk-lines">
                            @if (_lines.Count == 0) { <li><span>No lines yet; add them on the Trip tab.</span></li> }
                            @foreach (var line in _lines)
                            {
                                <li><span>@line.Item</span>@if (_showPrices) { <span>@line.Price.ToString("C0")</span> }</li>
                            }
                        </ul>
                        <div class="desk-foot">
                            <span>@(_sent ?? "Nothing sent yet")</span>
                            @if (_showTotal) { <strong>Total @_lines.Sum(l => l.Price).ToString("C0")</strong> }
                        </div>
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="pressed" Title="Toggles, disabled groups and hidden tabs" RazorCode="@Code.Pressed" CSharpCode="@Code.PressedCs">
            <Description><p>Pick a traveler and a tab named after them joins the strip through <code>Visible</code>. Its buttons are toggles through <code>Pressed</code>, and the badges on the traveler's row follow; confirm the traveler and two groups turn <code>Disabled</code>.</p></Description>
            <Demo>
                <div class="paper-ribbon">
                    <RibbonControl CssClass="paper">
                        <RibbonTab Title="Group">
                            <RibbonGroup Title="Kyoto Classic, four travelers">
                                <RibbonButton Text="Confirm all" Icon="✔️" Large="true" Disabled="@_travelers.All(t => t.Confirmed)" OnClick="@(() => _travelers.ForEach(t => t.Confirmed = true))" />
                                <RibbonButton Text="Start over" Icon="↩️" OnClick="Reset" />
                            </RibbonGroup>
                        </RibbonTab>
                        <RibbonTab Title="@(_who?.Name ?? "Traveler")" Visible="@(_who is not null)">
                            <RibbonGroup Title="Seat and meal" Disabled="@(_who?.Confirmed == true)">
                                <RibbonButton Text="Window seat" Icon="💺" Pressed="@(_who?.Window == true)" OnClick="@(() => _who!.Window = !_who.Window)" />
                                <RibbonButton Text="Vegetarian" Icon="🥗" Pressed="@(_who?.Vegetarian == true)" OnClick="@(() => _who!.Vegetarian = !_who.Vegetarian)" />
                            </RibbonGroup>
                            <RibbonGroup Title="Room" Disabled="@(_who?.Confirmed == true)">
                                <RibbonButton Text="Quiet room" Icon="🌙" Pressed="@(_who?.Quiet == true)" OnClick="@(() => _who!.Quiet = !_who.Quiet)" />
                            </RibbonGroup>
                            <RibbonGroup Title="Booking">
                                <RibbonButton Text="@(_who?.Confirmed == true ? "Reopen" : "Confirm")" Icon="✔️" Large="true" OnClick="@(() => _who!.Confirmed = !_who.Confirmed)" />
                            </RibbonGroup>
                        </RibbonTab>
                    </RibbonControl>
                </div>
                <ul class="who-list">
                    @foreach (var t in _travelers)
                    {
                        <li class="@(t == _who ? "picked" : null)">
                            <ButtonControl BareStyle="true" CssClass="who-name" OnClick="@(() => _who = t == _who ? null : t)">@t.Name</ButtonControl>
                            @if (t.Window) { <BadgeControl Text="Window seat" Variant="BadgeVariant.Info" Size="BadgeSize.Small" /> }
                            @if (t.Vegetarian) { <BadgeControl Text="Vegetarian" Variant="BadgeVariant.Info" Size="BadgeSize.Small" /> }
                            @if (t.Quiet) { <BadgeControl Text="Quiet room" Variant="BadgeVariant.Info" Size="BadgeSize.Small" /> }
                            <BadgeControl Text="@(t.Confirmed ? "Confirmed" : "Open")" Variant="@(t.Confirmed ? BadgeVariant.Success : BadgeVariant.Secondary)" Size="BadgeSize.Small" />
                        </li>
                    }
                </ul>
                <span class="result">@(_who is null ? "Pick a traveler to add their tab." : _who.Confirmed ? $"{_who.Name}'s tab is on the strip; Reopen there unlocks their seat, meal and room." : $"{_who.Name}'s tab is on the strip; open it to set their seat, meal and room.")</span>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-ribbon" Title="RibbonControl" Count='@DocSection.Label(Vocab.Ribbon.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="RibbonControl" Rows="Vocab.Ribbon" />
                <p class="note">Tabs join the strip in the order they first render: there is no parameter or method to open a tab from code, and a tab removed from the page later keeps its header, so hide a tab with <code>Visible</code> instead. The four components accept no attributes beyond the parameters listed here.</p>
            </DocSection>
            <DocSection Id="doc-tab" Title="RibbonTab" Count='@DocSection.Label(Vocab.Tab.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RibbonTab" Rows="Vocab.Tab" />
            </DocSection>
            <DocSection Id="doc-group" Title="RibbonGroup" Count='@DocSection.Label(Vocab.Group.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RibbonGroup" Rows="Vocab.Group" />
            </DocSection>
            <DocSection Id="doc-button" Title="RibbonButton" Count='@DocSection.Label(Vocab.Button.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RibbonButton" Rows="Vocab.Button" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
            <DocSection Id="doc-css-variables" Title="CSS variables" Count='@DocSection.Label(Vocab.Vars.Length, "variables")'>
                <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
                <p class="note">The other colors, the borders and the spacing are fixed in the control's stylesheet.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The tab strip is a <code>tablist</code> of native buttons with <code>role="tab"</code>, <code>aria-selected</code> and <code>aria-controls</code>; the open tab's groups sit in a <code>tabpanel</code> named by its tab. The open tab is the strip's one Tab stop: Left and Right move to the next tab that can be opened, wrapping at the ends, and Home and End to the first and last.</li>
            <li>With <code>Collapsible</code>, the hide and show button after the tabs is a second Tab stop; it carries <code>aria-expanded</code> and the label "Show the ribbon" or "Hide the ribbon".</li>
            <li>Each <code>RibbonButton</code> is a native <code>&lt;button type="button"&gt;</code>, so Tab reaches it and Enter or Space runs it. Its <code>title</code> is the tooltip, or the label when there is none. A toggle carries <code>aria-pressed</code> set to "true" or "false"; a dropdown button carries <code>aria-haspopup</code> and <code>aria-expanded</code>, and its panel closes on a click outside it.</li>
            <li>Tabs and buttons show a 2px outline under keyboard focus.</li>
            <li>A group is a <code>role="group"</code> named by its <code>Title</code>, so give every group a title.</li>
            <li>A button's <code>Icon</code> is text and is read as part of its name. Pick a glyph that reads well aloud, or leave <code>Icon</code> empty.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A single row of commands: <a href="demo/toolbar">Toolbar</a>.</li>
            <li>Tabs that switch page content: <a href="demo/tabs-accordion#tabs">Tabs &amp; accordion</a>.</li>
            <li>Plain buttons, with a dropdown mode: <a href="demo/buttons">Buttons</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Booking desk
    private bool _hidden, _held, _canceled, _showPrices = true, _showTotal = true;
    private RibbonButton? _send;
    private string? _sent;
    private sealed record Line(string Item, decimal Price);
    private readonly List<Line> _lines = new();
    private void Add(string item, decimal price)
    {
        if (!Has(item)) _lines.Add(new(item, price));
    }
    private bool Has(string item) => _lines.Any(l => l.Item == item);
    private void Send(string document)
    {
        _sent = $"{document} emailed to Albus Door";
        _send?.CloseDropDown();
    }

    // A tab for the selected traveler
    private sealed class Traveler
    {
        public string Name { get; init; } = "";
        public bool Window { get; set; }
        public bool Vegetarian { get; set; }
        public bool Quiet { get; set; }
        public bool Confirmed { get; set; }
    }
    private List<Traveler> _travelers = Seed();
    private Traveler? _who;
    private static List<Traveler> Seed() => new()
    {
        new() { Name = "Hermione Ranger", Window = true },
        new() { Name = "Albus Door" },
        new() { Name = "Ron Measly", Vegetarian = true },
        new() { Name = "Luna Goodlove", Confirmed = true },
    };
    private void Reset()
    {
        _travelers = Seed();
        _who = null;
    }

