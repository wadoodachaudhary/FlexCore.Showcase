@page "/demo/grid"
@page "/demo/grid/radzen-comparison"
@* Retitled 2026-10-06 to match the site nav; copy unchanged. *@

<PageTitle>Data Grid — FlexCore Showcase</PageTitle>

<h1>Data Grid</h1>
<p>Sortable, filterable, groupable data grid. Click a header to sort, drag to reorder, right-click for menu.</p>

<div class="demo-frame">
    <GridControl TValue="Person" DataSource="@_people"
                 AllowSelection="true"
                 AllowSorting="true"
                 AllowFiltering="true"
                 AllowGrouping="true"
                 AllowResizing="true"
                 EnableHover="true"
                 Height="420px">
        <GridColumnsBase>
            <GridColumn Field="@nameof(Person.Id)"        HeaderText="ID"          Width="60px"
                        Type="ColumnType.Number" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(Person.Name)"      HeaderText="Name"        Width="160px" />
            <GridColumn Field="@nameof(Person.Department)" HeaderText="Department" Width="160px" />
            <GridColumn Field="@nameof(Person.Role)"      HeaderText="Role"        Width="160px" />
            <GridColumn Field="@nameof(Person.Salary)"    HeaderText="Salary"      Width="120px"
                        Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" />
            <GridColumn Field="@nameof(Person.HireDate)"  HeaderText="Hire Date"   Width="120px"
                        Type="ColumnType.Date" Format="d" />
        </GridColumnsBase>
    </GridControl>
</div>

<h2>Grid pages</h2>
@* Built from SiteNav so this list and the Data Grid menu cannot disagree. *@
<ul>
    @foreach (var link in SiteNav.LinksOf("Data Grid"))
    {
        <li><a href="@link.Href">@link.Text</a></li>
    }
</ul>

<h2>Markup</h2>
<pre><code>&lt;GridControl TValue="Person" DataSource="@@_people"
             AllowSelection="true" AllowSorting="true"
             AllowFiltering="true" AllowGrouping="true"
             AllowResizing="true" EnableHover="true" Height="420px"&gt;
    &lt;GridColumnsBase&gt;
        &lt;GridColumn Field="Id"         HeaderText="ID"         Width="60px"
                    Type="ColumnType.Number" TextAlign="TextAlign.Right" /&gt;
        &lt;GridColumn Field="Name"       HeaderText="Name"       Width="160px" /&gt;
        &lt;GridColumn Field="Department" HeaderText="Department" Width="160px" /&gt;
        &lt;GridColumn Field="Role"       HeaderText="Role"       Width="160px" /&gt;
        &lt;GridColumn Field="Salary"     HeaderText="Salary"     Width="120px"
                    Type="ColumnType.Number" Format="C0" TextAlign="TextAlign.Right" /&gt;
        &lt;GridColumn Field="HireDate"   HeaderText="Hire Date"  Width="120px"
                    Type="ColumnType.Date" Format="d" /&gt;
    &lt;/GridColumnsBase&gt;
&lt;/GridControl&gt;</code></pre>

