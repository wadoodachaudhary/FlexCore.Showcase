        new Item(""Hotel Lisbon Central"", ""Net 15 · 1 open booking"", new[] { (""Contact"", ""P. Reyes""), (""Terms"", ""Net 15""), (""Open bookings"", ""1"") }),
        new Item(""Lisbon Walks"", ""Prepaid · no open bookings"", new[] { (""Contact"", ""M. Chen""), (""Terms"", ""Prepaid""), (""Open bookings"", ""0"") }),
