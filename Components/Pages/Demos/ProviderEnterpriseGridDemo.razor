private int _flatRequests;

private string _flatLast = ""Waiting for the first request…"";

private async ValueTask<GridItemsResult<RateCardItem>> LoadItemsAsync(GridItemsRequest request)
{
    await Task.Delay(25, request.CancellationToken);
    IEnumerable<RateCardItem> rows = BenchData.RateCard;
    var text = request.Query.SearchText;
    if (!string.IsNullOrWhiteSpace(text))
    {
        var comparison = request.Query.CaseSensitive ? StringComparison.CurrentCulture : StringComparison.CurrentCultureIgnoreCase;
        rows = rows.Where(r => r.Code.Contains(text, comparison)
                            || r.Description.Contains(text, comparison)
                            || r.Supplier.Contains(text, comparison));
    }
    var matched = SortItems(rows, request.Query.Sorts).ToList();
    var page = matched.Skip(request.StartIndex).Take(request.Count).ToList();
    _flatLast = $""Request {++_flatRequests}: {request.Purpose}, start {request.StartIndex:N0}, count {request.Count:N0}; ""
              + $""{page.Count} of {matched.Count:N0} matching rows returned""
              + (string.IsNullOrWhiteSpace(text) ? ""."" : $"" for \""{text}\""."");
    await InvokeAsync(StateHasChanged);
    return new GridItemsResult<RateCardItem>(page, matched.Count);
}

private static IEnumerable<RateCardItem> SortItems(IEnumerable<RateCardItem> rows, IReadOnlyList<GridSortDescriptor> sorts)
{
    IOrderedEnumerable<RateCardItem>? ordered = null;
    foreach (var sort in sorts)
    {
        var property = typeof(RateCardItem).GetProperty(sort.Field);
        if (property is null) continue;
        Func<RateCardItem, object?> key = r => property.GetValue(r);
        ordered = ordered is null
            ? sort.Direction == SortDirection.Descending ? rows.OrderByDescending(key) : rows.OrderBy(key)
            : sort.Direction == SortDirection.Descending ? ordered.ThenByDescending(key) : ordered.ThenBy(key);
    }
    return ordered ?? rows;
