    </GridColumnsBase>
</GridControl>
<p class=""result"">@_rows.Count.ToString(""N0"") rows · @_columns.Count columns: @string.Join("" · "", _columns.Select(c => c.Header))</p>";
        public const string Annotations = @"<GridControl DataSource=""@_annotatedRows""
             TValue=""AnnotatedGridItem""
             AutoGenerateColumns=""true""
             Height=""300px""
             AllowSorting=""true""
             AllowFiltering=""true""
             EditSettingsRef=""@_editSettings"" />";
        public const string AnnotationsCs = @"// Columns from data annotations (moved here from Frozen columns, 2026-10-20)
public sealed class AnnotatedGridItem
