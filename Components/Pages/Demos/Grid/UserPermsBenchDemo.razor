            </DocSection>
            <DocSection Id="doc-selection-methods" Title="Selection methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Selection methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-detail-row-parameters" Title="GridControl detail-row parameters" Count='@DocSection.Label(Vocab.Detail.Length, "parameters")'>
