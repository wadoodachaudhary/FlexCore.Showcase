<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GovAiAcademy</RootNamespace>
    <AssemblyName>GovAiAcademy</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!--
    Same side-by-side layout as FlexCore.Showcase:
      parent/
        FlexCore/
        FlexCore.Showcase/   (this repo)
          GovAiAcademy/      (this project — ../../FlexCore)
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\FlexCore\FlexCore.csproj" />
    <ProjectReference Include="..\..\FlexCore\FlexCore.Documents\FlexCore.Documents.csproj" />
  </ItemGroup>

</Project>
