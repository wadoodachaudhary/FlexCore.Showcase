<PageTitle>Column sets — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Column sets" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Swap the whole column set at runtime from a list of specs, without remounting the grid."
                   SourcePath="Grid/GridColumn.cs;Grid/GridColumnsBase.cs;Grid/GridControl.razor.cs;Grid/GridControlEvents.cs;Grid/GridModels.cs;Grid/GridEnums.cs">
    <Overview>
        <p>
            The columns inside <code>GridColumnsBase</code> are ordinary Razor markup, so a <code>@@foreach</code> over a list of column
            specs defines them. Replace the list and the grid re-reads its columns in place: a different set, order, width or
            <code>Visible</code> flag, while the component instance, its data and its selection stay. Wrap the swap in
            <code>SuspendRedraw(fields)</code>: the grid holds its rendering while the list changes, converges added and removed columns in
            place and applies the order you pass; without it, new fields append after the ones the grid already knows.
            <code>Visible="false"</code> keeps a column in the set but off the screen.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="sets" Title="Three column sets, one grid" RazorCode="@Code.Sets" CSharpCode="@Code.SetsCs">
            <Description><p>Select a row, then switch between the Default, Purchasing and Minimal sets: the selection stays while the columns change. Each set is a list of <code>ColumnSpec</code> objects; the Purchasing set also carries a hidden Category column. Qty and Price are editable in Default, Price in Purchasing (<code>EditMode.Batch</code>: double-click a cell).</p></Description>
            <Controls>
                <ButtonGroupControl Items="_layouts" Values="@(new[] { _activeLayout })"
                                    ValuesChanged="@(v => ApplyLayoutAsync(v.Count > 0 ? v[0] : "Default"))"
                                    Selection="ChoiceSelectionMode.Single" AriaLabel="Column set" />
            </Controls>
            <Demo>
                <GridControl @ref="_grid"
                             TValue="CRow"
                             DataSource="@_rows"
                             Height="340px"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowSorting="true"
                             ShowRowCountInFooter="true"
                             EditSettingsRef="@_editSettings"
                             EventsRef="@_events">
                    <GridColumnsBase>
                        @foreach (var col in _currentColumns)
                        {
                            <GridColumn @key="col.Field"
                                        Field="@col.Field"
                                        HeaderText="@col.Header"
                                        Width="@col.Width"
                                        Visible="@col.Visible"
                                        AllowEditing="@col.Editable" />
                        }
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_activeLayout set: @_currentColumns.Count(c => c.Visible) of @_currentColumns.Count columns visible@(_selected is null ? "" : $" · selected row {_selected}")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p>
            The core <code>GridColumn</code> parameters, the container they register with, the column-set methods this page calls and the
            selection events it wires. The editing parameters (<code>EditTemplate</code>, <code>EditOptions</code>, the edit button and
            their relatives) are on <a href="demo/grid/batch-editing">Batch editing</a>; <code>Field</code>, <code>Type</code> and
            <code>Format</code> in depth on <a href="demo/grid/dynamic-columns">Dynamic columns</a>; <code>SelectionSettings</code>, the
            selection methods and <code>GridSelectionChangedArgs</code> on <a href="demo/grid/master-detail">Master-detail</a>. A set
            switch here is host state: the <code>@@foreach</code> inside <code>GridColumnsBase</code> runs over <code>_currentColumns</code>,
            each column keyed by its <code>Field</code>, and the assignment sits inside <code>SuspendRedraw(fields)</code>, which pairs
            <code>BeginUpdate()</code> with <code>EndUpdateAsync(order)</code>.
        </p>
        <DocSections>
            <DocSection Id="doc-gridcolumn-core-parameters" Title="GridColumn core parameters" Count='@DocSection.Label(Vocab.Column.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumn core parameters" Rows="Vocab.Column" />
            </DocSection>
            <DocSection Id="doc-gridcolumnsbase-parameters" Title="GridColumnsBase parameters" Count='@DocSection.Label(Vocab.ColumnsBase.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumnsBase parameters" Rows="Vocab.ColumnsBase" />
            </DocSection>
            <DocSection Id="doc-gridcolumnsbase-properties" Title="GridColumnsBase properties" Count='@DocSection.Label(Vocab.ColumnsBaseProps.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="GridColumnsBase properties" Rows="Vocab.ColumnsBaseProps" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-column-set-methods" Title="GridControl column-set methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="GridControl column-set methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-gridcontrolevents-selection" Title="GridControlEvents, selection" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="GridControlEvents, selection" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-rowselecteventargs-tvalue" Title="RowSelectEventArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.Args.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="RowSelectEventArgs&lt;TValue&gt;" Rows="Vocab.Args" />
                <p>
                <code>SelectionChanged</code> carries the selected count as a plain <code>int</code>; <code>Count</code> and <code>Source</code>
                arrive on <code>SelectionChangedDetailed</code>. The selection survives a swap because the grid keeps selected rows by item and
                only the column list changes; the positional cell selection and active cell are cleared when a column is added or removed, and
                nothing is cleared when an instance is merely replaced under the same <code>Field</code>.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/dynamic-columns">Dynamic columns</a>: columns that follow the data.</li>
            <li><a href="demo/grid/reordering">Column reorder</a>: the user moves columns by dragging headers.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class CRow
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Supplier { get; set; } = string.Empty;
        public string BookingRef { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public decimal Total => Qty * Price;
    }

    private readonly SelectionItem[] _layouts = { new("Default", "Default"), new("Purchasing", "Purchasing"), new("Minimal", "Minimal") };
    private GridControl<CRow>? _grid;
    private List<CRow> _rows = [];
    private string _activeLayout = "Default";
    private List<ColumnSpec> _currentColumns = [];
    private string? _selected;

    private readonly EditSettings _editSettings = new() { AllowEditing = true, Mode = EditMode.Batch };
    private readonly GridControlEvents<CRow> _events = new();

    protected override void OnInitialized()
    {
        _rows =
        [
            new CRow { Code = "HT-110", Description = "Hotel, double room per night", Category = "Hotels", Supplier = "Casa Lumiar Riverside", BookingRef = "BK-2041", Qty = 14, Price = 145.00m },
            new CRow { Code = "FL-210", Description = "Return flight, economy", Category = "Flights", Supplier = "Tejo Skyline Charters", BookingRef = "BK-2042", Qty = 24, Price = 189.00m },
            new CRow { Code = "TF-310", Description = "Airport transfer, coach", Category = "Transfers", Supplier = "Alfama Coach Lines", BookingRef = "BK-2043", Qty = 2, Price = 320.00m },
            new CRow { Code = "TR-410", Description = "Sintra palaces day tour", Category = "Tours", Supplier = "Quinta Azul Day Tours", BookingRef = "BK-2044", Qty = 24, Price = 68.50m },
            new CRow { Code = "IN-510", Description = "Group travel insurance", Category = "Insurance", Supplier = "Harbourline Travel Cover", BookingRef = "BK-2045", Qty = 24, Price = 34.50m },
            new CRow { Code = "RL-610", Description = "Rail pass, Lisbon to Porto", Category = "Rail", Supplier = "Ribeira Rail Holidays", BookingRef = "BK-2046", Qty = 24, Price = 42.00m }
        ];

        _events.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<CRow>>(this, args => _selected = args.Data?.Code);
        _events.RowDeselected = EventCallback.Factory.Create<RowSelectEventArgs<CRow>>(this, _ => _selected = null);

        _currentColumns = ColumnsFor("Default");
    }

    private async Task ApplyLayoutAsync(string layoutName)
    {
        _activeLayout = layoutName;
        var columns = ColumnsFor(layoutName);
        if (_grid is null) { _currentColumns = columns; return; }
        await using (_grid.SuspendRedraw(columns.Select(c => c.Field)))
        {
            _currentColumns = columns;
        }
    }

    private static List<ColumnSpec> ColumnsFor(string layoutName)
        => layoutName switch
        {
            "Purchasing" =>
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Item Code", Width = "90px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "220px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Supplier), Header = "Supplier", Width = "200px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.BookingRef), Header = "Booking Ref", Width = "100px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Price), Header = "Unit Price", Width = "100px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Category), Header = "Category", Width = "120px", Visible = false }
            ],
            "Minimal" =>
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Code", Width = "100px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "300px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Total), Header = "Total Cost", Width = "140px", Visible = true, Editable = false }
            ],
            _ => // Default
            [
                new ColumnSpec { Field = nameof(CRow.Code), Header = "Item Code", Width = "90px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Description), Header = "Description", Width = "240px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Category), Header = "Category", Width = "130px", Visible = true },
                new ColumnSpec { Field = nameof(CRow.Qty), Header = "Qty", Width = "80px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Price), Header = "Price", Width = "100px", Visible = true, Editable = true },
                new ColumnSpec { Field = nameof(CRow.Total), Header = "Total", Width = "110px", Visible = true, Editable = false }
            ]
        };

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed); the C# tab also carries
    // ColumnSpec from Data/BenchModels.cs.
    private static class Code
    {
        public const string Sets = @"<GridControl @ref=""_grid""
             TValue=""CRow""
             DataSource=""@_rows""
             Height=""340px""
             AllowSelection=""true""
             AllowResizing=""true""
             AllowSorting=""true""
             ShowRowCountInFooter=""true""
             EditSettingsRef=""@_editSettings""
             EventsRef=""@_events"">
    <GridColumnsBase>
        @foreach (var col in _currentColumns)
        {
            <GridColumn @key=""col.Field""
                        Field=""@col.Field""
                        HeaderText=""@col.Header""
                        Width=""@col.Width""
                        Visible=""@col.Visible""
                        AllowEditing=""@col.Editable"" />
