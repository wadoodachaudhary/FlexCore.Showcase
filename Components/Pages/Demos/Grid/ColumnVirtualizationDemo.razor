   library fix (SC-292).
   Parameter tables are a later pass (SC-278). *@

<PageTitle>Wide grids — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Wide grids" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Twenty-one columns and a thousand rows: pinned edges, and only the columns in view kept in the page."
                   SourcePath="Grid/GridControl.ColumnVirtualization.cs;Grid/GridColumn.cs">
    <Overview>
        <p>
            <code>EnableColumnVirtualization</code> renders only the non-frozen columns that are horizontally in view, plus
            <code>ColumnVirtualizationOverscan</code> columns on either side; the rest become fixed-width spacers so the scrollbar and the
            column positions stay right. Frozen columns stay mounted. The grid exposes <code>ColumnVirtualizationStatus</code> (Disabled,
            Active or Fallback) and, when it has to fall back to a full render, <code>ColumnVirtualizationFallbackReason</code>.
            <code>WidthMode="GridWidthMode.FitColumns"</code> sizes the grid to the sum of its column widths, up to the space available.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="wide" Title="Twenty-one columns, three of them pinned" RazorCode="@Code.Wide" CSharpCode="@Code.WideCs">
            <Description><p>Scroll the grid sideways. ID and Code stay on the left, Status on the right, and the eighteen metric columns move between them. The first paint mounts every column; from the first scroll on, only the metrics in view plus two on each side stay mounted and the rest become spacers. The line under the grid reports the grid's own status.</p></Description>
            <Demo>
                <div class="wide">
                <GridControl @ref="_grid"
                             TValue="WideGridRow"
                             DataSource="@_rows"
                             Height="520px"
                             WidthMode="GridWidthMode.FitColumns"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             EnableColumnVirtualization="true"
                             ColumnVirtualizationOverscan="2"
                             ShowColumnVirtualizationFallback="true">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(WideGridRow.Id)" HeaderText="ID" Width="72px"
                                    Type="ColumnType.Number" IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" />
                        <GridColumn Field="@nameof(WideGridRow.Code)" HeaderText="Code" Width="116px"
                                    IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left" />
                        <GridColumn Field="@nameof(WideGridRow.M01)" HeaderText="Metric 01" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M02)" HeaderText="Metric 02" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M03)" HeaderText="Metric 03" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M04)" HeaderText="Metric 04" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M05)" HeaderText="Metric 05" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M06)" HeaderText="Metric 06" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M07)" HeaderText="Metric 07" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M08)" HeaderText="Metric 08" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M09)" HeaderText="Metric 09" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M10)" HeaderText="Metric 10" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M11)" HeaderText="Metric 11" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M12)" HeaderText="Metric 12" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M13)" HeaderText="Metric 13" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M14)" HeaderText="Metric 14" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M15)" HeaderText="Metric 15" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M16)" HeaderText="Metric 16" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M17)" HeaderText="Metric 17" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.M18)" HeaderText="Metric 18" Width="112px" Type="ColumnType.Number" Format="N2" />
                        <GridColumn Field="@nameof(WideGridRow.Status)" HeaderText="Status" Width="104px"
                                    IsFrozen="true" FrozenPosition="FrozenColumnPosition.Right" />
                    </GridColumnsBase>
                </GridControl>
                </div>
                <p class="result">Column virtualization: @(_grid?.ColumnVirtualizationStatus.ToString() ?? "…")@(_grid?.ColumnVirtualizationFallbackReason is { } why ? $" ({why})" : "")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>EnableColumnVirtualization</code>, <code>ColumnVirtualizationOverscan</code>, <code>ColumnVirtualizationDefaultWidth</code>, <code>ShowColumnVirtualizationFallback</code>, <code>ColumnVirtualizationStatus</code>, <code>ColumnVirtualizationFallbackReason</code> and <code>WidthMode</code> are still to be written up from <code>Grid/GridControl.ColumnVirtualization.cs</code> and <code>Grid/GridEnums.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/advanced">Frozen columns</a>: pinned columns and header bands on their own.</li>
            <li><a href="demo/grid/column-swap">Column sets</a>: swapping whole column layouts at runtime.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

