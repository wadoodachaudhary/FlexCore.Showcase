@page "/demo/grid/enterprise-suite"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Data
@using FlexCore.Showcase.Components.Shared
@inject FlexCore.Showcase.Services.BenchDataStore BenchData

@* 2026-10-17: moved onto FeatureDemoLayout (one-example-plus-code push, row 2 of the Data Grid list). Same 250 rows and columns.
   Changes, closing SC-019 and SC-141 to SC-145: the "Show Filter Row" button went (GridControl has no filter-row parameter); the
   "Selected" readout went (it never refreshed); AllowEditing left the columns (no EditSettings, nothing was editable); grouping,
   group count and type search left the grid (off-topic here); the Excel button now calls ExportToXlsxAsync (ExportToExcelAsync is the
   .xls HTML alias, so the old .xlsx file was HTML); the status badge is BadgeControl instead of Bootstrap classes; the buttons are
   ButtonControls. Copy dropped: "zero external JavaScript dependencies", "complete parity with high-end desktop data grids",
   ClosedXML (the grid's xlsx writer is the library's own, GridExportModels.cs BuildXlsx), multi-column sorting, checklist
   filtering and frozen columns (none configured here). Parameter tables are a later pass (SC-278). *@

<PageTitle>Export &amp; templates — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Export &amp; templates" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Export the rows you see to CSV or a real .xlsx workbook, and render a column through your own markup."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridExportModels.cs;Grid/GridColumn.cs">
    <Overview>
        <p>
            The grid exports itself: <code>ExportToCsvAsync</code>, <code>ExportToXlsxAsync</code> and the other <code>ExportTo…Async</code>
            methods take the rows as currently filtered and sorted and the columns as currently visible, build the file on the server with
            the library's own writers, and hand it to the browser. Where the File System Access API exists a save dialog opens; elsewhere
            the file downloads. A <code>GridColumn</code> with a <code>Template</code> renders whatever markup you put inside it for each row,
            with <code>context</code> as the row object; the Status column here renders a <code>BadgeControl</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="export" Title="Export the rows you see" RazorCode="@Code.Export" CSharpCode="@Code.ExportCs">
            <Description><p>Two hundred and fifty estimate lines. Search, filter or sort first, then export: the file holds exactly the rows and columns on screen, in the same order. When the export is done the grid shows the row count in a status pill.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="ExportCsv">Export CSV</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="ExportExcel">Export Excel (.xlsx)</ButtonControl>
            </Controls>
            <Demo>
                <GridControl @ref="_grid"
                             TValue="EnterpriseRow"
                             DataSource="@_displayRows"
                             ShowRowCountInFooter="true"
                             AllowSorting="true"
                             AllowSelection="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowSearchBar="true"
                             Height="420px"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(EnterpriseRow.Code)" HeaderText="Item Code" Width="100px" />
                        <GridColumn Field="@nameof(EnterpriseRow.Description)" HeaderText="Description" Width="260px" />
                        <GridColumn Field="@nameof(EnterpriseRow.Category)" HeaderText="Trade Category" Width="140px" />
                        <GridColumn Field="@nameof(EnterpriseRow.Status)" HeaderText="Status" Width="120px" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var row = (EnterpriseRow)context;
                                    var variant = row.Status switch
                                    {
                                        "Approved" => BadgeVariant.Success,
                                        "Pending" => BadgeVariant.Warning,
                                        "Review" => BadgeVariant.Info,
                                        _ => BadgeVariant.Secondary
                                    };
                                }
                                <BadgeControl Text="@row.Status" Variant="@variant" Size="BadgeSize.Small" />
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(EnterpriseRow.Qty)" HeaderText="Takeoff Qty" Width="100px" Type="ColumnType.Number" TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(EnterpriseRow.UnitPrice)" HeaderText="Unit Price" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0.00" />
                        <GridColumn Field="@nameof(EnterpriseRow.TotalCost)" HeaderText="Total Cost" Width="120px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="$#,##0.00" />
                    </GridColumnsBase>
                </GridControl>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending">The export methods and <code>GridExportFormat</code>, and the <code>Template</code> parameter of <code>GridColumn</code>, are still to be written from <code>Grid/GridControl.razor.cs</code>, <code>Grid/GridExportModels.cs</code> and <code>Grid/GridColumn.cs</code>.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/advanced">Frozen columns</a>: another template column, with a working button in it.</li>
            <li><a href="demo/new-components">UI elements</a>: <code>BadgeControl</code> on its own.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    public class EnterpriseRow
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Status { get; set; } = "Approved";
        public decimal Qty { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalCost => Qty * UnitPrice;
    }

    private GridControl<EnterpriseRow>? _grid;
    private List<EnterpriseRow> _displayRows = [];

    protected override void OnInitialized()
    {
        var statuses = new[] { "Approved", "Pending", "Review", "Completed" };
        var categories = new[] { "Foundation", "Framing", "Mechanical", "Electrical", "Plumbing", "Interior" };

        _displayRows = BenchData.EstimatingItems.Take(250).Select((item, idx) => new EnterpriseRow
        {
            Code = item.Item ?? $"ITM-{idx:D4}",
            Description = item.ItemDesc ?? "Construction Assembly Item",
            Category = categories[idx % categories.Length],
            Status = statuses[idx % statuses.Length],
            Qty = (idx % 25) + 1,
            UnitPrice = item.Price ?? 45.00m
        }).ToList();
    }

    private Task ExportCsv() => _grid?.ExportToCsvAsync("estimate-items.csv") ?? Task.CompletedTask;

    private Task ExportExcel() => _grid?.ExportToXlsxAsync("estimate-items.xlsx") ?? Task.CompletedTask;

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
    {
        public const string Export = @"<GridControl @ref=""_grid""
             TValue=""EnterpriseRow""
             DataSource=""@_displayRows""
             ShowRowCountInFooter=""true""
             AllowSorting=""true""
             AllowSelection=""true""
             AllowResizing=""true""
             AllowFiltering=""true""
             ShowSearchBar=""true""
             Height=""420px""
             CssClass=""fx-grid-compact"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(EnterpriseRow.Code)"" HeaderText=""Item Code"" Width=""100px"" />
        <GridColumn Field=""@nameof(EnterpriseRow.Description)"" HeaderText=""Description"" Width=""260px"" />
        <GridColumn Field=""@nameof(EnterpriseRow.Category)"" HeaderText=""Trade Category"" Width=""140px"" />
        <GridColumn Field=""@nameof(EnterpriseRow.Status)"" HeaderText=""Status"" Width=""120px"" TextAlign=""TextAlign.Center"">
            <Template>
                @{
                    var row = (EnterpriseRow)context;
                    var variant = row.Status switch
                    {
                        ""Approved"" => BadgeVariant.Success,
                        ""Pending"" => BadgeVariant.Warning,
                        ""Review"" => BadgeVariant.Info,
                        _ => BadgeVariant.Secondary
                    };
                }
                <BadgeControl Text=""@row.Status"" Variant=""@variant"" Size=""BadgeSize.Small"" />
            </Template>
        </GridColumn>
        <GridColumn Field=""@nameof(EnterpriseRow.Qty)"" HeaderText=""Takeoff Qty"" Width=""100px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" />
        <GridColumn Field=""@nameof(EnterpriseRow.UnitPrice)"" HeaderText=""Unit Price"" Width=""110px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" Format=""$#,##0.00"" />
        <GridColumn Field=""@nameof(EnterpriseRow.TotalCost)"" HeaderText=""Total Cost"" Width=""120px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" Format=""$#,##0.00"" />
    </GridColumnsBase>
</GridControl>";
        public const string ExportCs = @"public class EnterpriseRow
{
