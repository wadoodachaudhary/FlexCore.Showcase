@page "/demo/fab"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page on FeatureDemoLayout. Facts checked against FabMenuControl.razor, FabMenuItem.cs,
   FabMenuControl.razor.css and BadgeModels.cs (FlexCore 0.2.48). The control is position:fixed; each card
   pins its instance inside a stage with two scoped overrides (CSS tab of the first example) so two can show. *@

<PageTitle>Blazor Floating Action Button (FAB) — FlexCore</PageTitle>

<FeatureDemoLayout Title="Floating action button" Category="Components" ControlName="FabMenuControl"
                   Tagline="A round button fixed to the corner of the screen that fans out a menu of actions."
                   SourcePath="FabMenuControl.razor">
    <Overview>
        <p>
            <code>FabMenuControl</code> renders a 56px round trigger fixed 2rem from the bottom-right of the viewport. Clicking it dims
            the page behind a backdrop and slides up one labelled round button per <code>FabMenuItem</code>, first item nearest the
            trigger. That open state is what other libraries call a speed dial. Picking an action closes the menu and runs the item's
            <code>OnClick</code>. No JavaScript.
        </p>
        <p>On this page each example pins its instance inside a grey stage so two can be shown at once. In an app, leave the position alone.</p>
    </Overview>

    <Examples>
        <DemoExample Id="menu" Title="Action menu" RazorCode="@Code.Menu" CSharpCode="@Code.MenuCs" CssCode="@Code.MenuCss">
            <Description><p>Each item carries a label, an icon and a colour. The plus turns into a close cross while open. The switch on the right sets <code>Disabled</code>.</p></Description>
            <Controls>
                <ToggleButtonControl @bind-Selected="_disabled">Disabled</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="fab-stage">
                    <div class="stage-lines"><span style="width:38%"></span><span style="width:72%"></span><span style="width:55%"></span><span style="width:64%"></span></div>
                    <FabMenuControl Items="_actions" Disabled="@_disabled" Title="Create" />
                </div>
                <span class="result">@(_last is null ? "Open the menu and pick an action." : $"Picked: {_last}")</span>
            </Demo>
        </DemoExample>

        <DemoExample Id="custom" Title="Trigger icon and extra content" RazorCode="@Code.Custom" CSharpCode="@Code.CustomCs">
            <Description><p><code>IconCss</code> replaces the plus. <code>ChildContent</code> renders in the fan after the items, for markup that is not an action.</p></Description>
            <Demo>
                <div class="fab-stage short">
                    <FabMenuControl IconCss="bi bi-chat-dots" Items="_support" Title="Support">
                        <div class="fab-note">Replies within a day</div>
                    </FabMenuControl>
                </div>
                <span class="result">@(_contact is null ? "" : $"Picked: {_contact}")</span>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-fabmenuitem" Title="FabMenuItem" Count='@DocSection.Label(Vocab.Item.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="FabMenuItem" Rows="Vocab.Item" />
                <p class="note">Colours, sizes and the 2rem corner offset are fixed in the control's stylesheet; it reads no <code>--fx-*</code> variables. There are no public methods.</p>
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The trigger is a native <code>&lt;button&gt;</code> with <code>aria-expanded</code>. Its default icon is an unlabelled SVG, so set <code>Title</code> to give it a name.</li>
            <li>Each action is a native button named by its <code>title</code> attribute; the visible label chip is a separate span.</li>
            <li>Enter or Space on the trigger opens and closes the menu. The action buttons come before the trigger in the DOM, so after opening use Shift+Tab to reach them. There is no arrow-key or Escape handling, and the backdrop is not focusable.</li>
            <li>The fan slides in over 0.2s with no <code>prefers-reduced-motion</code> check.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A menu on a button in the page flow: <a href="demo/buttons#dropdown">ButtonControl dropdown mode</a> or <a href="demo/split-button">Split button</a>.</li>
            <li>Pressed-state buttons: <a href="demo/toggle-buttons">Toggle buttons</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private bool _disabled;
    private string? _last, _contact;
    private List<FabMenuItem> _actions = new(), _support = new();

    protected override void OnInitialized()
    {
        _actions = new()
        {
            Action("New document", "bi bi-file-earmark-plus", BadgeVariant.Primary, t => _last = t),
            Action("Upload", "bi bi-upload", BadgeVariant.Success, t => _last = t),
            Action("Share", "bi bi-share", BadgeVariant.Info, t => _last = t),
            Action("Delete", "bi bi-trash", BadgeVariant.Danger, t => _last = t),
        };
        _support = new()
        {
            Action("Chat with us", "bi bi-chat-text", BadgeVariant.Primary, t => _contact = t),
            Action("Email", "bi bi-envelope", BadgeVariant.Secondary, t => _contact = t),
        };
    }

    // FabMenuItem(title, iconCss, color); OnClick is a settable EventCallback.
    private FabMenuItem Action(string title, string icon, BadgeVariant color, Action<string> pick) =>
        new(title, icon, color) { OnClick = EventCallback.Factory.Create(this, () => pick(title)) };

