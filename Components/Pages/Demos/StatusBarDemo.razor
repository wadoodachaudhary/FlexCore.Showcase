        public const string Content = @"<div class=""sb-frame"">
    <div class=""sb-chrome"" aria-hidden=""true""><span></span><span></span><span></span></div>
    <div class=""sb-body sb-list"">
        @foreach (var line in _lines)
        {
            <CheckBoxControl @bind-Checked=""line.Received"" Label=""@($""{line.Name}, {line.Amount:C0}"")"" />
        }
    </div>
    <StatusBarControl Panels=""_who"">
        <div class=""sb-panel sb-spring"">
            <span><strong>@ReceivedLines.Count()</strong> of <strong>@_lines.Count</strong> lines received</span>
