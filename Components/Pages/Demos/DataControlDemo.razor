@page "/demo/data-control"
@rendermode InteractiveServer
@using System.Dynamic
@using Fx.ControlKit
@using Fx.ControlKit.Charts
@using Fx.ControlKit.Data
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Components.Shared
@* Retitled 2026-10-06 to match the site nav.
   2026-10-20: rebuilt on FeatureDemoLayout (developer meeting, point 2; the old API-reference page is docs/retired-pages/DataControlDemo.razor.txt).
   DataControl is a non-visual class, so the one example shows it doing something: one frame behind a grid, a chart and a CSV, with a
   filter and a sort applied to the frame and every view following. Facts checked against Data/DataControl.cs: DataFrame, ConvertDtypes
   and InferDtypes (bool, int, long, decimal, DateTime, in that order, only when every value parses), Filter/Sort (DataView
   expressions), Query, SortBy, GroupBy, Find, ToGridRows/ToExpandoRows, ToChartSeries/ToChartBars, ToReportColumns/ToReportDefinition,
   ToCsv/ToJson/SaveAs.
   2026-10-23 (developer meeting, point 5: chart labels too small): the SVG bar chart draws on a fixed 600x300 viewBox and scales to
   min(tile width / 600, Height / 300), so the chart tile was widened to half the row (.views 1fr/1fr, about 465 px at 1280) and Height
   set to the width-bound 232px. ShowValues and ValueFormat were dropped: only the legacy Bars mode and the gauges read them, the SVG
   renderer never did, so they drew nothing. YAxis gets Max 4000 with five ticks so the axis reads 0, 1000 ... 4000 instead of
   multiples of 858 (GetNiceRange takes 1.1 x the data maximum and GetTicks divides evenly); the fixed Max keeps the scale the same
   under every filter. *@

<PageTitle>Data control — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Data control" Category="Data Grid" CategoryHref="demo/grid" ControlName="DataControl"
                   Tagline="One in-memory table behind a grid, a chart and a CSV: filter and sort it once and every view follows."
                   SourcePath="Data/DataControl.cs">
    <Overview>
        <p>
            <code>DataControl</code> is not a visual control. It wraps a <code>DataTable</code> and gives it a small, typed surface: build it
            with <code>DataFrame</code> from column arrays and optional row labels, with <code>FromRows</code> from any objects, or from a
            <code>DataTable</code>; <code>ConvertDtypes</code> turns text columns into <code>bool</code>, <code>int</code>, <code>long</code>,
            <code>decimal</code> or <code>DateTime</code> when every value parses. <code>Filter</code> and <code>Sort</code> are
            <code>DataView</code> expressions applied to the current view, and <code>Query</code> returns a new frame of the matching rows.
        </p>
        <p>
            The converters read the current view, filtered and sorted: <code>ToGridRows</code> gives <code>ExpandoObject</code> rows a
            <code>GridControl</code> binds to, <code>ToChartBars</code> and <code>ToChartSeries</code> shape it for <code>ChartControl</code>,
            <code>ToReportDefinition</code> describes it for <code>ReportWriterControl</code>, and <code>ToCsv</code> / <code>ToJson</code>
            write it out. <code>At</code> and <code>Iat</code> read and write single cells; <code>IsDirty</code> and
            <code>GetChanges</code> track edits the way a <code>DataTable</code> does.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="frame" Title="Filter and sort once; a grid, a chart and a CSV follow" RazorCode="@Code.Frame" CSharpCode="@Code.FrameCs">
            <Description><p>Eight orders, entered as text and converted once: <code>Amount</code> became <code>decimal</code>, <code>Open</code> became <code>bool</code> and <code>Ordered</code> became <code>DateTime</code>. Type a <code>DataView</code> filter such as <code>Amount > 1000</code>, <code>Open = true</code> or <code>Customer LIKE 'A%'</code> and apply it; pick a sort. The grid, the chart and the CSV under them are all read from the same frame, so they change together. An expression the view cannot parse is reported and the previous filter stays.</p></Description>
            <Controls>
                <TextBoxControl @bind-Value="_filterText" Placeholder="Amount > 1000" Width="220px" />
                <ButtonControl CssClass="btn-sm btn-primary" OnClick="ApplyFilter">Apply filter</ButtonControl>
                <ButtonGroupControl Items="_sortItems" Values="@(new[] { _sortKey })" ValuesChanged="PickSort" Selection="ChoiceSelectionMode.Single" AriaLabel="Sort" />
            </Controls>
            <Demo>
                <div class="views">
                    <GridControl TValue="ExpandoObject" DataSource="@_rows" Height="260px" AllowSorting="false" ShowRowCountInFooter="true">
                        <GridColumnsBase>
                            @foreach (var column in _frame.Columns)
                            {
                                var type = _frame.Dtypes[column.Name];
                                <GridColumn @key="column.Name" Field="@column.Name" HeaderText="@column.Name"
                                            Type="@(type == typeof(bool) ? ColumnType.Boolean : type == typeof(DateTime) ? ColumnType.Date : type == typeof(decimal) || type == typeof(int) || type == typeof(long) ? ColumnType.Number : ColumnType.Text)"
                                            Format="@(type == typeof(decimal) ? "N2" : type == typeof(DateTime) ? "d" : null)"
                                            TextAlign="@(type == typeof(decimal) || type == typeof(int) || type == typeof(long) ? TextAlign.Right : TextAlign.Left)" />
                            }
                        </GridColumnsBase>
                    </GridControl>
                    <ChartControl Type="ChartType.Bar" Title="Amount by order" Series="@_series" YAxis="_amountAxis" Height="232px" />
                </div>
                <pre class="csv">@_csv</pre>
                <p class="result @(_error is null ? null : "bad")">@Status</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-datacontrol-properties" Title="DataControl properties" Count='@DocSection.Label(Vocab.Props.Length, "properties")' Open="true">
                <ApiTable Kind="ApiKind.Properties" Title="DataControl properties" Rows="Vocab.Props" />
            </DocSection>
            <DocSection Id="doc-building-shaping-and-converting" Title="Building, shaping and converting" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Building, shaping and converting" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Events" Rows="Vocab.Events" />
                <p>
                Type inference tries <code>bool</code>, <code>int</code>, <code>long</code>, <code>decimal</code> and <code>DateTime</code> in that
                order, in the current culture, and keeps a column as it is unless every value parses. <code>ConvertDtypes</code> converts
                <code>object</code> and <code>string</code> columns; <code>InferObjects</code> only <code>object</code> columns. Row numbers in
                <code>GetItem</code>, <code>SetItem</code>, <code>Find</code> and the row methods are 1-based, as in a DataWindow; <code>Iat</code>
                is 0-based, as in pandas. The editing and row-copy members (<code>InsertRow</code>, <code>DeleteRow</code>,
                <code>RowsCopy</code>, <code>RowsMove</code>, <code>SelectRow</code>, <code>Modify</code>) are in the source and not shown here.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/dynamic-columns">Dynamic columns</a>: a grid over dictionary-shaped rows, which is what <code>ToGridRows</code> produces.</li>
            <li><a href="demo/charts">Charts</a>: the chart types <code>ToChartBars</code> and <code>ToChartSeries</code> feed.</li>
            <li><a href="demo/reports/package-costs">Report writer</a>: where a <code>ToReportDefinition</code> result is rendered.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Eight orders typed as text, then converted once: Amount -> decimal, Open -> bool, Ordered -> DateTime.
    private readonly DataControl _frame = DataControl.DataFrame(
        data: new Dictionary<string, object?>
        {
            ["Order"] = new[] { "A100", "A101", "A102", "A103", "A104", "A105", "A106", "A107" },
            ["Customer"] = new[] { "Acme", "Northwind", "Contoso", "Fabrikam", "Acme", "Northwind", "Contoso", "Acme" },
            ["Amount"] = new[] { "1280.50", "845.25", "2210.00", "1640.75", "420.00", "1995.10", "760.40", "3120.00" },
            ["Open"] = new[] { "true", "false", "true", "true", "false", "true", "false", "true" },
            ["Ordered"] = new[] { "2026-09-02", "2026-09-05", "2026-09-09", "2026-09-12", "2026-09-15", "2026-09-19", "2026-09-23", "2026-09-30" },
        },
        index: new[] { "a", "b", "c", "d", "e", "f", "g", "h" },
        columns: new[] { "Order", "Customer", "Amount", "Open", "Ordered" }).ConvertDtypes();

    private readonly SelectionItem[] _sortItems = { new("none", "Unsorted"), new("amount", "Amount, high first"), new("customer", "Customer") };
    private string? _filterText;
    private string _sortKey = "none";
    private string? _error;
    private List<ExpandoObject> _rows = [];
    private List<ChartSeries> _series = [];
    private readonly ChartAxis _amountAxis = new() { Max = 4000, TickCount = 5 };   // 0, 1000 ... 4000 whatever the filter leaves in view
    private string _csv = "";

    private string Status => _error is not null
        ? $"Filter not applied: {_error}"
        : $"{_frame.RowCount} of {_frame.TotalRowCount} rows in view; Amount is {_frame.Dtypes["Amount"].Name}, Open is {_frame.Dtypes["Open"].Name}, " +
          $"Ordered is {_frame.Dtypes["Ordered"].Name}" + (string.IsNullOrWhiteSpace(_frame.Filter) ? "." : $"; filter {_frame.Filter}.");

    protected override void OnInitialized() => Refresh();

    private void ApplyFilter()
    {
        var previous = _frame.Filter;
        try
        {
            _frame.Filter = string.IsNullOrWhiteSpace(_filterText) ? null : _filterText;   // a DataView expression; the view throws on a bad one
            _error = null;
        }
        catch (Exception ex)
        {
            _frame.Filter = previous;
            _error = ex.Message;
        }
        Refresh();
    }

    private void PickSort(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _sortKey = values[0];
        _frame.Sort = _sortKey switch { "amount" => "Amount DESC", "customer" => "Customer ASC", _ => null };
        Refresh();
    }

    // Every view is re-read from the same frame, so filter and sort reach all three at once.
    private void Refresh()
    {
        _rows = _frame.ToGridRows().ToList();
        _series = _frame.ToChartSeries("Order", "Amount");
        _csv = _frame.ToCsv();
    }

    // Documentation rows (2026-10-20) from Data/DataControl.cs.
    private static class Vocab
    {
        public static readonly ApiRow[] Props =
        {
            new("Table", "The underlying DataTable. Assigning a new one clears the selection and reapplies Filter and Sort.", "DataTable"),
            new("Filter", "DataView row filter expression applied to the current view.", "string?", "null"),
            new("Sort", "DataView sort expression applied to the current view.", "string?", "null"),
            new("Shape", "Rows in the current view and columns.", "DataControlShape"),
            new("Size", "Rows × columns of the current view.", "int"),
            new("Empty", "True when the view has no rows or the table no columns.", "bool"),
            new("Columns", "Name and type of each column.", "IReadOnlyList&lt;DataControlColumn&gt;"),
            new("Dtypes", "Column name to CLR type.", "IReadOnlyDictionary&lt;string, Type&gt;"),
            new("RowCount / TotalRowCount", "Rows in the current view; rows in the table.", "int"),
            new("IsDirty", "True while the table has uncommitted changes.", "bool"),
            new("At / Iat", "Cell by row label and column name; cell by 0-based row and column position. Both read and write.", "DataControlAtIndexer / DataControlIatIndexer"),
        };
        public static readonly ApiRow[] Methods =
        {
            new("DataFrame(data, index, columns, dtype, copy)", "Static. Builds a frame from column arrays keyed by name, with optional row labels, column order and a forced type.", "DataControl"),
            new("FromRows(rows, tableName)", "Static. Builds a frame from any sequence of objects.", "DataControl"),
            new("FromDataTable(table)", "Static. Wraps an existing table.", "DataControl"),
            new("ConvertDtypes()", "New frame with object and string columns converted to the type every value parses as.", "DataControl"),
            new("InferObjects()", "The same for object columns only.", "DataControl"),
            new("Astype(columnName, dtype)", "New frame with one column forced to a type.", "DataControl"),
            new("Query(expression)", "New frame holding the rows a DataTable Select expression matches.", "DataControl"),
            new("SortBy(columnName, descending)", "Sets Sort on this frame and returns it.", "DataControl"),
            new("GroupBy(groupColumn, valueColumn, aggregate)", "One result per distinct group value over the current view: the aggregate of valueColumn and the row count.", "IReadOnlyList&lt;DataControlAggregateResult&gt;"),
            new("Find(expression, startRow, endRow)", "1-based number of the first row in the range matching the expression; 0 when none.", "int"),
            new("ToGridRows()", "Current view as ExpandoObject rows, one key per column.", "IEnumerable&lt;ExpandoObject&gt;"),
            new("ToChartBars(labelColumn, valueColumn, colorColumn)", "One bar per row of the current view; the optional colour column names each bar's colour.", "List&lt;ChartControl.ChartBar&gt;"),
            new("ToChartSeries(labelColumn, valueColumns)", "One series per value column, with a point per row of the current view.", "List&lt;ChartSeries&gt;"),
            new("ToReportDefinition(title)", "A report definition whose columns mirror the table: header from the column caption, numeric columns right-aligned.", "ReportDefinition"),
            new("ToCsv() / ToJson(options) / SaveAs(format)", "The current view as text; SaveAs picks Csv or Json.", "string"),
        };
        public static readonly ApiRow[] Events =
        {
            new("DataChanged", "After the table, filter, sort or a cell changed, or changes were reset or rejected.", "EventHandler"),
            new("RowChanged", "After one row changed, with its 1-based number and the DataRow.", "EventHandler&lt;DataControlRowChangedEventArgs&gt;"),
        };
    }

    // Code tabs are verbatim
    private static class Code
    {
        public const string Frame = @"<TextBoxControl @bind-Value=""_filterText"" Placeholder=""Amount > 1000"" Width=""220px"" />
<ButtonControl CssClass=""btn-sm btn-primary"" OnClick=""ApplyFilter"">Apply filter</ButtonControl>
<ButtonGroupControl Items=""_sortItems"" Values=""@(new[] { _sortKey })"" ValuesChanged=""PickSort"" Selection=""ChoiceSelectionMode.Single"" AriaLabel=""Sort"" />

<div class=""views"">
    <GridControl TValue=""ExpandoObject"" DataSource=""@_rows"" Height=""260px"" AllowSorting=""false"" ShowRowCountInFooter=""true"">
        <GridColumnsBase>
            @foreach (var column in _frame.Columns)
            {
                var type = _frame.Dtypes[column.Name];
                <GridColumn @key=""column.Name"" Field=""@column.Name"" HeaderText=""@column.Name""
                            Type=""@(type == typeof(bool) ? ColumnType.Boolean : type == typeof(DateTime) ? ColumnType.Date : type == typeof(decimal) || type == typeof(int) || type == typeof(long) ? ColumnType.Number : ColumnType.Text)""
                            Format=""@(type == typeof(decimal) ? ""N2"" : type == typeof(DateTime) ? ""d"" : null)""
                            TextAlign=""@(type == typeof(decimal) || type == typeof(int) || type == typeof(long) ? TextAlign.Right : TextAlign.Left)"" />
            }
        </GridColumnsBase>
    </GridControl>
    <ChartControl Type=""ChartType.Bar"" Title=""Amount by order"" Series=""@_series"" YAxis=""_amountAxis"" Height=""232px"" />
</div>
<pre class=""csv"">@_csv</pre>
<p class=""result @(_error is null ? null : ""bad"")"">@Status</p>";
        public const string FrameCs = @"// Eight orders typed as text, then converted once: Amount -> decimal, Open -> bool, Ordered -> DateTime.
private readonly DataControl _frame = DataControl.DataFrame(
    data: new Dictionary<string, object?>
    {
        [""Order""] = new[] { ""A100"", ""A101"", ""A102"", ""A103"", ""A104"", ""A105"", ""A106"", ""A107"" },
        [""Customer""] = new[] { ""Acme"", ""Northwind"", ""Contoso"", ""Fabrikam"", ""Acme"", ""Northwind"", ""Contoso"", ""Acme"" },
        [""Amount""] = new[] { ""1280.50"", ""845.25"", ""2210.00"", ""1640.75"", ""420.00"", ""1995.10"", ""760.40"", ""3120.00"" },
        [""Open""] = new[] { ""true"", ""false"", ""true"", ""true"", ""false"", ""true"", ""false"", ""true"" },
        [""Ordered""] = new[] { ""2026-09-02"", ""2026-09-05"", ""2026-09-09"", ""2026-09-12"", ""2026-09-15"", ""2026-09-19"", ""2026-09-23"", ""2026-09-30"" },
    },
    index: new[] { ""a"", ""b"", ""c"", ""d"", ""e"", ""f"", ""g"", ""h"" },
    columns: new[] { ""Order"", ""Customer"", ""Amount"", ""Open"", ""Ordered"" }).ConvertDtypes();

private readonly SelectionItem[] _sortItems = { new(""none"", ""Unsorted""), new(""amount"", ""Amount, high first""), new(""customer"", ""Customer"") };

private string? _filterText;

private string _sortKey = ""none"";

private string? _error;

private List<ExpandoObject> _rows = [];

private List<ChartSeries> _series = [];

private readonly ChartAxis _amountAxis = new() { Max = 4000, TickCount = 5 };   // 0, 1000 ... 4000 whatever the filter leaves in view

private string _csv = """";

private string Status => _error is not null
    ? $""Filter not applied: {_error}""
    : $""{_frame.RowCount} of {_frame.TotalRowCount} rows in view; Amount is {_frame.Dtypes[""Amount""].Name}, Open is {_frame.Dtypes[""Open""].Name}, "" +
      $""Ordered is {_frame.Dtypes[""Ordered""].Name}"" + (string.IsNullOrWhiteSpace(_frame.Filter) ? ""."" : $""; filter {_frame.Filter}."");

protected override void OnInitialized() => Refresh();

private void ApplyFilter()
{
    var previous = _frame.Filter;
    try
    {
        _frame.Filter = string.IsNullOrWhiteSpace(_filterText) ? null : _filterText;   // a DataView expression; the view throws on a bad one
        _error = null;
