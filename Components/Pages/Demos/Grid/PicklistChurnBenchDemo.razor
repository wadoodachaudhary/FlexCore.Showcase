private readonly EditSettings _editSettings = new() { AllowEditing = true, Mode = EditMode.Batch };

private List<AnnotatedGridItem> _annotatedRows = BuildAnnotated();

private static List<AnnotatedGridItem> BuildAnnotated() =>
    Enumerable.Range(1, 12).Select(i =>
    {
        var price = 15.50m + (i % 25) * 4.25m;
        return new AnnotatedGridItem
        {
            Id = i, Code = $""SKU-{i:D5}"", Description = $""Material Item #{i}"",
