@page "/demo/menu-bar"
@using FlexCore.Showcase.Components.Shared

@* 2026-11-14: new page. The menu bar family had no page; the site's own top menu was its only use. Facts from MenuBarControl.razor,
   MenuDropDownControl.razor, MenuActionControl.razor, MenuSeparatorControl.razor, their stylesheets and wwwroot/menu-control.js
   (FlexCore 0.2.50 plus the close-on-navigation fix of the same day). The examples keep the library's own look.
   2026-11-15: three examples (booking desk, split button, menu filled on opening); events in their own table.
   2026-11-15: example story moved to the Project management theme.
   2026-11-16: pre-deploy review fixes. *@

<PageTitle>Blazor Menu Bar and Dropdown Menu — FlexCore</PageTitle>

<FeatureDemoLayout Title="Menu bar" Category="Components" ControlName="MenuBarControl · MenuDropDownControl · MenuActionControl"
                   Tagline="A classic application menu: a bar of dropdown menus, or one menu button on its own."
                   SourcePath="MenuBarControl.razor; MenuDropDownControl.razor; MenuActionControl.razor; MenuSeparatorControl.razor; wwwroot/menu-control.js">
    <Overview>
        <p>
            <code>MenuBarControl</code> is a Blazor menu bar: it holds <code>MenuDropDownControl</code> menus and keeps one open at a time. Each menu lists <code>MenuActionControl</code> entries and <code>MenuSeparatorControl</code> dividers. A <code>MenuDropDownControl</code> also works alone, as a menu button or a split button, and can fill its entries as it opens. This site's top menu is a <code>MenuBarControl</code> of <code>MenuDropDownControl</code> menus.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="bar" Title="An application menu bar" RazorCode="@Code.Bar" CSharpCode="@Code.BarCs">
            <Description><p>Run the Website relaunch task list from its menus: Task adds, starts and finishes tasks, and View changes how the list is shown. Entries turn <code>Disabled</code> when they have nothing to act on, View's check marks are text set through <code>Icon</code>, and one whole menu is disabled. Use Down, Up, Home, End, Enter and Escape inside an open menu.</p></Description>
            <Demo>
                <div class="menu-window">
                    <div class="mw-chrome" aria-hidden="true"><span></span><span></span><span></span></div>
                    <MenuBarControl>
                        <MenuDropDownControl Label="Task">
                            <MenuActionControl Text="New task" Icon="📝" Disabled="@(_tasks.Count >= 6)" OnClick="AddTask" />
                            <MenuActionControl Text="Start first to-do task" Icon="🔨" Disabled="@(!_tasks.Any(t => t.Status == "To do"))" OnClick="StartTask" />
                            <MenuSeparatorControl />
                            <MenuActionControl Text="Finish last open task" Icon="🏁" Disabled="@(!_tasks.Any(t => t.Status != "Done"))" OnClick="FinishLast" />
                        </MenuDropDownControl>
                        <MenuDropDownControl Label="View">
                            <MenuActionControl Text="Show done" Icon="@Check(_showDone)" OnClick="@(() => _showDone = !_showDone)" />
                            <MenuActionControl Text="Compact rows" Icon="@Check(_compact)" OnClick="@(() => _compact = !_compact)" />
                        </MenuDropDownControl>
                        <MenuDropDownControl Label="Reports" Disabled="true" />
                    </MenuBarControl>
                    <ul class="menu-list @(_compact ? "compact" : null)">
                        @foreach (var t in _tasks.Where(t => _showDone || t.Status != "Done"))
                        {
                            <li><span>@t.Title</span><BadgeControl Text="@t.Status" Variant="@(t.Status == "Done" ? BadgeVariant.Success : t.Status == "In progress" ? BadgeVariant.Primary : t.Status == "In review" ? BadgeVariant.Warning : BadgeVariant.Secondary)" /></li>
                        }
                    </ul>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="standalone" Title="A split button" RazorCode="@Code.Standalone" CSharpCode="@Code.StandaloneCs">
            <Description><p>Without a bar, a menu opens on its own. Send status report is a <code>SplitButton</code>: the left half runs <code>PrimaryClick</code>, and the arrow opens the other things to send.</p></Description>
            <Demo>
                <div class="mb">
                    <div class="demo-row">
                        <MenuDropDownControl Label="Send status report" SplitButton="true" ArrowLabel="More things to send" PrimaryClick="@(() => Send("Status report"))">
                            <MenuActionControl Text="Send invoice" OnClick="@(() => Send("Invoice"))" />
                            <MenuActionControl Text="Send meeting notes" OnClick="@(() => Send("Meeting notes"))" />
                        </MenuDropDownControl>
                        <span class="result">Website relaunch for Green Fork Cafe, client contact Albus Door</span>
                    </div>
                    <ul class="sent" role="status">
                        @foreach (var line in _sent)
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="opening" Title="A menu filled when it opens" RazorCode="@Code.Opening" CSharpCode="@Code.OpeningCs">
            <Description><p>Open In review and approve a task: <code>OnOpening</code> reads the list each time the menu opens, so an approved task is gone the next time, and the count in the trigger, your own <code>TriggerContent</code>, drops.</p></Description>
            <Demo>
                <div class="mb">
                    <div class="demo-row">
                        <MenuDropDownControl OnOpening="LoadWaiting">
                            <TriggerContent>In review <span class="count">@_waiting.Count</span></TriggerContent>
                            <ChildContent>
                                @if (_menuTasks.Count == 0)
                                {
                                    <MenuActionControl Text="Nothing in review" Disabled="true" />
                                }
                                @foreach (var task in _menuTasks)
                                {
                                    <MenuActionControl Text="@($"Approve {task}")" OnClick="@(() => Approve(task))" />
                                }
                            </ChildContent>
                        </MenuDropDownControl>
                        <ButtonControl CssClass="btn-sm" Disabled="@(_waiting.Count == 3)" OnClick="ResetWaiting">Start over</ButtonControl>
                    </div>
                    <p class="result" role="status">@_approved The list was read @_loads time@(_loads == 1 ? "" : "s").</p>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-menubar" Title="MenuBarControl" Count='@DocSection.Label(Vocab.Bar.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="MenuBarControl" Rows="Vocab.Bar" />
            </DocSection>
            <DocSection Id="doc-menudropdown" Title="MenuDropDownControl" Count='@DocSection.Label(Vocab.DropDown.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="MenuDropDownControl" Rows="Vocab.DropDown" />
            </DocSection>
            <DocSection Id="doc-menuaction" Title="MenuActionControl" Count='@DocSection.Label(Vocab.Action.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="MenuActionControl" Rows="Vocab.Action" />
                <p class="note"><code>MenuSeparatorControl</code> has no parameters. The four controls accept no attributes beyond the parameters listed here, and none has a public method: a page cannot open or close a menu from code.</p>
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-keyboard" Title="Keyboard" Count='@DocSection.Label(Vocab.Keys.Length, "keys")'>
                <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
                <p class="note">Colors, the font and the borders are fixed in the controls' stylesheets; <code>--fx-zoom</code> scales the text. Restyle through the class parameters, as this site's top menu does.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The bar is a <code>menubar</code>, each trigger and entry a native button with <code>role="menuitem"</code>, an open panel a <code>menu</code> and a divider a <code>separator</code>.</li>
            <li>A trigger carries <code>aria-haspopup="true"</code> and <code>aria-expanded</code> set to "true" or "false". In split mode the arrow half is named by <code>ArrowLabel</code>, else "<em>Label</em> menu", else "Open menu"; set <code>ArrowLabel</code> to say what the menu holds.</li>
            <li>Opening a menu from the keyboard focuses its first enabled entry, or its last with Up. Escape in an open menu closes it and puts focus back on its trigger. The Keyboard section lists the keys.</li>
            <li>A trigger under keyboard focus shows a dotted outline, and an entry focused from the keyboard is highlighted.</li>
            <li>An entry's <code>Icon</code> is text and is read as part of its name. Pick a character that reads well aloud, and for an on or off entry say the state in <code>Text</code> as well.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A default action with alternatives, outside a menu: <a href="demo/split-button">Split button</a>.</li>
            <li>Commands in tabs and groups: <a href="demo/ribbon">Ribbon</a>. A single row of commands: <a href="demo/toolbar">Toolbar</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Menu bar
    private sealed class ProjectTask
    {
        public string Title { get; init; } = "";
        public string Status { get; set; } = "To do";
    }
    private readonly List<ProjectTask> _tasks = new()
    {
        new() { Title = "WEB-113 Site footer", Status = "Done" },
        new() { Title = "WEB-123 Photo gallery", Status = "In progress" },
        new() { Title = "WEB-124 Allergen icons" },
    };
    private static readonly string[] More = { "WEB-125 Contact form", "WEB-126 Opening hours banner", "WEB-127 Launch checklist" };
    private bool _showDone, _compact;
    private void AddTask() => _tasks.Add(new() { Title = More[(_tasks.Count - 3) % More.Length] });
    private void StartTask() => _tasks.First(t => t.Status == "To do").Status = "In progress";
    private void FinishLast() => _tasks.Last(t => t.Status != "Done").Status = "Done";
    // A menu entry has no checked state, so the page shows a check mark through Icon
    private static string Check(bool on) => on ? "✓" : "";

    // Split button
    private readonly List<string> _sent = new() { "Nothing sent yet" };
    private void Send(string what)
    {
        if (_sent[0] == "Nothing sent yet") _sent.Clear();
        _sent.Insert(0, $"{what} sent to Albus Door");
    }

    // A menu filled when it opens
    private List<string> _waiting = new() { "WEB-117 Order form", "WEB-121 Menu copy", "WEB-122 About page" };
    private List<string> _menuTasks = new();
    private string _approved = "Nothing approved yet.";
    private int _loads;
    // OnOpening runs each time the menu opens: fill the entries then, so they are current
    private void LoadWaiting()
    {
        _loads++;
        _menuTasks = _waiting.ToList();
    }
    private void Approve(string task)
    {
        _waiting.Remove(task);
        _approved = $"Approved {task}.";
    }
    private void ResetWaiting()
    {
        _waiting = new() { "WEB-117 Order form", "WEB-121 Menu copy", "WEB-122 About page" };
        (_approved, _loads) = ("Nothing approved yet.", 0);
    }

