<PageTitle>Blazor TreeView — FlexCore</PageTitle>

<FeatureDemoLayout Title="Tree view" Category="Components" ControlName="TreeViewControl"
                   Tagline="Show folders, categories or a staff directory as a tree users expand, check and rearrange."
                   SourcePath="TreeViewControl.razor;TreeViewControl.Appearance.cs;TreeViewControl.Operations.cs;TreeViewModels.cs;TreeViewData.cs;wwwroot/browser-capabilities.js">
    <Overview>
        <p>
            <code>TreeViewControl</code> is a Blazor tree view that shows nested items, such as folders or a staff directory, which users expand, select, check, rename and drag. Use it, rather than a <a href="demo/grid/tree-grid">tree grid</a>, when each node is a name, not a row of columns; <code>LoadChildren</code> fetches a branch when it opens, and <code>EnableVirtualization</code> renders only the nodes in view. <code>UseVb6TreeStyle</code> draws the dotted lines of the classic Windows tree control.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="explorer" Title="Staff directory with a node inspector" RazorCode="@Code.Explorer" CSharpCode="@Code.ExplorerCs">
            <Description><p>Browse the staff directory: type in the search box to find a person, click a node to read it on the right, and expand or collapse everything from code. VB6 lines switches to the classic connector lines, and the folder styles apply while it is on.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_styleItems" @bind-Values="_styleValues" Selection="ChoiceSelectionMode.Single" Enabled="@_useVb6Style" AriaLabel="Folder style" />
                <ToggleButtonControl @bind-Selected="_useVb6Style">VB6 lines</ToggleButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _tree!.ExpandAllAsync()">Expand all</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _tree!.CollapseAllAsync()">Collapse all</ButtonControl>
            </Controls>
            <Demo>
                <div class="explorer">
                    <div class="tree">
                        <TreeViewControl @ref="_tree" Nodes="@_treeNodes" ShowSearchBox="true" SearchPlaceholder="Find a person" AriaLabel="Staff directory"
                                         SelectedNode="@_selectedNode"
                                         SelectedNodeChanged="HandleNodeSelected"
                                         ToggleOnNodeClick="true"
                                         ShowIcons="true"
                                         UseVb6TreeStyle="@_useVb6Style"
                                         FolderStyle="@FolderStyle"
                                         TreeIndentPixels="16"
                                         NodesChanged="TreeChanged" />
                    </div>
                    <div class="inspector">
                        <h4>Selected in the directory</h4>
                        @if (_selectedNode is not null)
                        {
                            <dl class="props">
                                <dt>Name</dt><dd><strong>@_selectedNode.Text</strong></dd>
                                <dt>Kind</dt><dd>@(_selectedNode.Children.Count > 0 ? "Group" : "Person")</dd>
                                <dt>Entries inside</dt><dd>@_selectedNode.Children.Count</dd>
                                <dt>Open</dt><dd>@(_selectedNode.IsExpanded ? "yes" : "no")</dd>
                                <dt>Details</dt><dd>@(_selectedNode.Tag?.ToString() ?? "none")</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="muted">Click a person or a group to read it.</p>
                        }
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="extras" Title="Check boxes: pick extras for a new hire" RazorCode="@Code.Extras" CSharpCode="@Code.ExtrasCs">
            <Description><p>Check the extras for the new hire's onboarding order and the total follows. Checking a group checks everything in it, and a group with only some of its extras checked shows as partly checked, through <code>AutoCheck</code>; the buttons call <code>CheckAllAsync</code>.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="() => _extrasTree!.CheckAllAsync(true)">Add everything</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _extrasTree!.CheckAllAsync(false)">Clear</ButtonControl>
            </Controls>
            <Demo>
                <div class="explorer">
                    <div class="tree">
                        <TreeViewControl @ref="_extrasTree" Nodes="@_extras" ShowCheckboxes="true" AutoCheck="true" @bind-CheckedNodeIds="_checked"
                                         ShowIcons="false" Height="100%" AriaLabel="New-hire extras" />
                    </div>
                    <div class="inspector" role="status">
                        <h4>Onboarding order for Sybil Treeline</h4>
                        <dl class="props">
                            <dt>Standard kit</dt><dd>$1,450</dd>
                            @foreach (var extra in Chosen)
                            {
                                <dt>@extra.Key</dt><dd>$@extra.Value</dd>
                            }
                            <dt><strong>Total</strong></dt><dd><strong>@((1450 + Chosen.Sum(e => e.Value)).ToString("C0"))</strong></dd>
                        </dl>
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-parameters" Title="Parameters" Count='@DocSection.Label(Vocab.Parameters.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
            </DocSection>
            <DocSection Id="doc-treenode" Title="TreeNode" Count='@DocSection.Label(Vocab.Node.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="TreeNode" Rows="Vocab.Node" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
                <p>Get the control with <code>&#64;ref</code>. Each method re-renders the tree and raises the matching <code>…Changed</code> callbacks, so bound lists stay in step.</p>
            </DocSection>
            <DocSection Id="doc-keyboard" Title="Keyboard" Count='@DocSection.Label(Vocab.Keys.Length, "keys")'>
                <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
            </DocSection>
            <DocSection Id="doc-aria-output" Title="ARIA output" Count='@DocSection.Label(Vocab.Aria.Length, "attributes")'>
                <ApiTable Kind="ApiKind.Values" Title="ARIA output" Rows="Vocab.Aria" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The tree is one Tab stop: the root <code>div</code> has <code>role="tree"</code>, <code>tabindex</code> from <code>TabIndex</code>, <code>aria-label</code> from <code>AriaLabel</code> (default "Tree"), <code>aria-multiselectable</code>, and <code>aria-activedescendant</code> naming the current row, which is outlined while the tree has keyboard focus.</li>
            <li>Rows are <code>role="treeitem"</code> elements whose <code>aria-level</code>, <code>aria-posinset</code> and <code>aria-setsize</code> carry the hierarchy, with <code>aria-expanded</code>, <code>aria-selected</code>, <code>aria-disabled</code>, and <code>aria-checked</code> when <code>ShowCheckboxes</code> is on.</li>
            <li>Expanding, collapsing, checking and renaming are keys on the current row, listed in the Keyboard table above; the expander arrows and checkboxes are pointer shortcuts for the same actions.</li>
            <li>Each row is named by its node <code>Text</code> through <code>aria-label</code>, so put the words that identify a row in <code>Text</code> rather than only in a caption, secondary line or badge.</li>
            <li>Set <code>AriaLabel</code> to say what the tree holds, as "Staff directory" and "New-hire extras" do on this page; distinct names matter most when a page has more than one tree.</li>
            <li>The built-in search box sits in a <code>role="search"</code> region and is named by <code>SearchPlaceholder</code>; when nothing matches, <code>EmptyFilterText</code> appears as a <code>role="status"</code> message.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Rows with columns and totals under a tree: <a href="demo/grid/tree-grid">Tree grid</a>.</li>
            <li>Side navigation that collapses: <a href="demo/layout">Page layouts</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private TreeViewControl? _tree;
    private List<TreeNode> _treeNodes = [];
    private TreeNode? _selectedNode;
    private bool _useVb6Style = true;

    // Folder style switch: a ButtonGroupControl bound to the enum's name.
    private readonly SelectionItem[] _styleItems = { new("Yellow", "Yellow folders"), new("Grey", "Gray folders"), new("None", "No icons") };
    private IReadOnlyList<string> _styleValues = new[] { "Yellow" };
    private TreeFolderStyle FolderStyle => Enum.Parse<TreeFolderStyle>(_styleValues[0]);

    protected override void OnInitialized()
    {
        _treeNodes = BuildSampleTree();
        _selectedNode = _treeNodes.FirstOrDefault();
    }

    private void HandleNodeSelected(TreeNode node) => _selectedNode = node;
    private void TreeChanged(List<TreeNode> _) { }   // an expand or collapse re-renders the card, so Open stays true

    private static List<TreeNode> BuildSampleTree()
    {
        return
        [
            new TreeNode
            {
                Id = "root-1",
                Text = "Staff Directory",
                IsExpanded = true,
                Tag = "Current staff",
                Children =
                [
                    new TreeNode
                    {
                        Id = "reservations",
                        Text = "Reservations",
                        IsExpanded = true,
                        Children =
                        [
                            new TreeNode { Id = "hermione-ranger", Text = "Hermione Ranger", Tag = "Team lead, Lisbon office" },
                            new TreeNode { Id = "ron-measly", Text = "Ron Measly", Tag = "Reservations agent, Lisbon office" },
                            new TreeNode { Id = "ginny-measly", Text = "Ginny Measly", Tag = "Reservations agent, Denver office" }
                        ]
                    },
                    new TreeNode
                    {
                        Id = "tour-operations",
                        Text = "Tour Operations",
                        IsExpanded = false,
                        Children =
                        [
                            new TreeNode { Id = "albus-door", Text = "Albus Door", Tag = "Operations planner, Kyoto office" },
                            new TreeNode { Id = "rubeus-haggle", Text = "Rubeus Haggle", Tag = "Supplier coordinator, Cape Town office" },
                            new TreeNode { Id = "luna-goodlove", Text = "Luna Goodlove", Tag = "Guide scheduler, Kyoto office" }
                        ]
                    },
                    new TreeNode
                    {
                        Id = "finance",
                        Text = "Finance",
                        Children =
                        [
                            new TreeNode { Id = "minerva-mcgadget", Text = "Minerva McGadget", Tag = "Finance manager, Denver office" },
                            new TreeNode { Id = "filius-flipwick", Text = "Filius Flipwick", Tag = "Payroll specialist, Denver office" }
                        ]
                    }
                ]
            },
            new TreeNode
            {
                Id = "root-2",
                Text = "Joining in December",
                Children =
                [
                    new TreeNode { Id = "cedric-diggle", Text = "Cedric Diggle", Tag = "Starts December 1, Lisbon office" },
                    new TreeNode { Id = "sybil-treeline", Text = "Sybil Treeline", Tag = "Starts December 7, Denver office" }
                ]
            }
        ];
    }

    // Extras: the leaf ids are the extras' names, and Prices holds what each one costs
    private TreeViewControl? _extrasTree;
    private static readonly Dictionary<string, int> Prices = new()
    {
        ["Headset"] = 80, ["Second monitor"] = 210, ["Spreadsheet basics"] = 65, ["Customer care workshop"] = 120, ["First aid course"] = 95, ["Transit pass"] = 120,
    };
    private readonly List<TreeNode> _extras =
    [
        new() { Id = "desk-setup", Text = "Desk setup", IsExpanded = true, Children = [Extra("Headset"), Extra("Second monitor")] },
        new() { Id = "training", Text = "Training", IsExpanded = true, Children = [Extra("Spreadsheet basics"), Extra("Customer care workshop"), Extra("First aid course")] },
        Extra("Transit pass"),
    ];
    private IReadOnlyList<string> _checked = new[] { "Headset" };
    private static TreeNode Extra(string name) => new() { Id = name, Text = $"{name}, ${Prices[name]}" };
    private IEnumerable<KeyValuePair<string, int>> Chosen => Prices.Where(p => _checked.Contains(p.Key));

    // Vocabulary rows from the partial classes and models. 2026-10-24: each grouped row keeps one declared type so Type and
    // Default are exact; Keys and Aria from HandleKeyDown and the markup.
    private static class Vocab
    {
        public static readonly ApiRow[] Parameters =
        {
            new("Nodes", "Root nodes; each carries its <code>Children</code>. A null list is replaced by an empty one on first use. Ids must be non-empty and unique across the tree, or the control throws.", "List&lt;TreeNode&gt;?", "null"),
            new("SelectedNode / SelectedNodeChanged", "The primary selected node, two-way. Setting it selects the node with that <code>Id</code> and clears the others unless <code>AllowMultiSelect</code> is on. Ignored while <code>SelectedNodeIds</code> is set, which then supplies it.", "TreeNode?", "null"),
            new("SelectedNodeIds / CheckedNodeIds / ExpandedNodeIds", "Id lists that drive selection, checks and expansion, each with a <code>…Changed</code> callback. Applied when the sequence changes; null leaves the node flags alone.", "IReadOnlyList&lt;string&gt;?", "null"),
            new("OnNodeClick / OnNodeDoubleClick / OnNodeActivated / OnNodeExpand", "<code>OnNodeClick</code> follows a click, after the selection. <code>OnNodeDoubleClick</code> follows a double-click, and Enter when <code>OnNodeActivated</code> has no handler; <code>OnNodeActivated</code> is raised by Enter only. <code>OnNodeExpand</code> is raised when a single node becomes expanded, after any lazy load; <code>ExpandAllAsync</code> does not raise it.", "EventCallback&lt;TreeNode&gt;"),
            new("ToggleOnNodeClick", "A plain click on a parent expands or collapses it before selecting it; a Ctrl, Cmd or Shift click only selects. The expander arrow toggles regardless.", "bool", "true"),
            new("ShowIcons", "Draws each node's <code>IconCss</code> (<code>ExpandedIconCss</code> while expanded). With the VB6 style a parent without its own icon gets a folder in <code>FolderStyle</code> and a leaf a spacer; the Standard style draws nothing for a node without <code>IconCss</code>.", "bool", "true"),
            new("FolderStyle", "<code>Yellow</code>, <code>Grey</code> or <code>None</code>. Read only when the VB6 style is on; it picks the root modifier class and the folder icon.", "TreeFolderStyle", "TreeFolderStyle.Yellow"),
            new("UseVb6TreeStyle", "Dotted connector lines and plus/minus boxes, as in the Windows common control. A <code>CssClass</code> containing <code>fx-treeview-vb6</code> turns it on too.", "bool", "false"),
            new("TreeIndentPixels", "Indent per level in the VB6 and Outline styles. The Standard style without VB6 lines ignores it and indents 20px per level.", "int", "16"),
            new("ShowCheckboxes / AutoCheck", "A checkbox per node in the Standard display mode (Outline rows draw none, though <code>aria-checked</code> and Space still apply); Space toggles the focused one. <code>AutoCheck</code> cascades a check down to the children and sets each parent checked or indeterminate from its children.", "bool", "false"),
            new("AllowMultiSelect", "Ctrl-click toggles a node, Shift-click selects the visible range from the last node selected without Shift, Ctrl+A selects every visible node. Off, a click or Space selects one node.", "bool", "false"),
            new("Height / CssClass", "<code>Height</code> sizes the root with <code>overflow:auto</code>; <code>CssClass</code> is appended to the root element.", "string?", "null"),
            new("TabIndex", "The <code>tabindex</code> of the root element, the tree's only tab stop.", "int", "0"),
            new("AriaLabel", "The <code>aria-label</code> of the root element.", "string", "\"Tree\""),
            new("FocusOnSelection", "After a selection or a reveal the root element takes focus again, without scrolling. Turn off when the page must keep focus in another input.", "bool", "true"),
            new("DisplayMode", "<code>Standard</code> is the classic tree. <code>Outline</code> draws status circles and dots, a connector rail, the node's <code>Caption</code>, <code>SecondaryText</code>, <code>SecondaryIcon</code> and <code>BadgeText</code>, and a chevron on the right.", "TreeViewDisplayMode", "TreeViewDisplayMode.Standard"),
            new("ShowSearchBox", "Shows a search box above the tree whose text filters the nodes as you type. <code>FilterText</code> wins when both are set.", "bool", "false"),
            new("SearchPlaceholder", "Placeholder and <code>aria-label</code> of the search box.", "string", "\"Search\""),
            new("SearchText / SearchTextChanged", "The search box text, two-way; it filters even while the box is hidden. A node stays visible when its <code>Text</code> contains the filter, ignoring case (current culture), or when a descendant does; the branches above a match are shown expanded whatever their <code>IsExpanded</code>. The children of a matching group are hidden unless they match too, and nodes cannot be expanded or collapsed while a filter is active. Whitespace only means no filter.", "string?", "null"),
            new("FilterText", "A filter set by the page. It takes precedence over the search box text and matches the same way.", "string?", "null"),
            new("EmptyFilterText", "Shown in a status region under the tree when the search box filter matches nothing. Only with <code>ShowSearchBox</code>: a host <code>FilterText</code> that matches nothing leaves the tree empty, as before.", "string", "\"No matches\""),
            new("AllowEditing", "F2 or a double-click opens an inline rename with Save and Cancel buttons; Enter commits, Escape cancels, an empty name is refused. Not shown on this page.", "bool", "false"),
            new("NodeEditing / NodeEditCommitting / NodeEdited", "Before the editor opens, before the new text is applied, and after it. <code>Cancel</code> vetoes the first two; <code>Error</code> on the second shows the message instead of committing.", "EventCallback&lt;TreeNodeEditEventArgs&gt;"),
            new("AllowDragAndDrop", "Nodes become draggable; dropping one on another moves it inside that node as its last child. Not shown on this page.", "bool", "false"),
            new("CanDrop", "Asked before <code>NodeMoving</code>; false refuses the move without raising it.", "Func&lt;TreeNodeMoveEventArgs, bool&gt;?", "null"),
            new("NodeMoving / NodeMoved", "Before and after a move, by drop or by <code>MoveNodeAsync</code>; <code>Cancel</code> on the first vetoes it.", "EventCallback&lt;TreeNodeMoveEventArgs&gt;"),
            new("EnableVirtualization", "Row windowing through <code>Virtualize</code> with four rows of overscan; every row is forced to <code>ItemSize</code> high.", "bool", "false"),
            new("ItemSize", "Row height in px, used for virtualization and for scrolling a revealed row into view. Below 20 the control throws.", "float", "32"),
            new("LoadChildren", "Called the first time a node with <code>HasUnloadedChildren</code> expands, and for such nodes that start expanded; the result replaces its <code>Children</code>. A failure collapses the node and reports through <code>Error</code>.", "Func&lt;TreeNode, CancellationToken, Task&lt;IReadOnlyList&lt;TreeNode&gt;&gt;&gt;?", "null"),
            new("NodeTemplate", "Replaces the node text; key presses inside it do not reach the tree.", "RenderFragment&lt;TreeNode&gt;?", "null"),
            new("NodeComparer", "Sorts the siblings at every level.", "IComparer&lt;TreeNode&gt;?", "null"),
            new("NodesChanged", "Raised with the root list after a single node expands or collapses (not <code>ExpandAllAsync</code> or <code>CollapseAllAsync</code>), a committed rename, and <code>AddNodeAsync</code>, <code>RemoveNodeAsync</code> or <code>MoveNodeAsync</code>.", "EventCallback&lt;List&lt;TreeNode&gt;&gt;"),
            new("Error", "Raised with the message of a failed lazy load, rename or move; the same message appears in an alert under the tree.", "EventCallback&lt;string&gt;"),
        };
        public static readonly ApiRow[] Node =
        {
            new("Id", "Key; defaults to a random 8-character string. Must be non-empty and unique in the tree.", "string"),
            new("Text", "Label. It is also the row's accessible name and what the filter and type-ahead match.", "string", "\"\""),
            new("IconCss / ExpandedIconCss", "Leaf or folder icon classes; the second is used while expanded.", "string?", "null"),
            new("IsExpanded / IsSelected / IsChecked / IsDisabled / IsBold", "State flags. A disabled node is skipped by the keyboard and cannot be selected, checked, renamed or moved. <code>IsIndeterminate</code> is set by the control.", "bool", "false"),
            new("Children", "Child nodes. <code>HasChildren</code> is true when there are any, or when children are still to load.", "List&lt;TreeNode&gt;", "new()"),
            new("HasUnloadedChildren", "Marks a node whose children come from <code>LoadChildren</code> on first expand; cleared once loaded.", "bool", "false"),
            new("Tag", "Your own payload.", "object?", "null"),
            new("Status", "Outline mode only; starts as <code>None</code>, which draws no mark. <code>NotStarted</code>, <code>InProgress</code> and <code>Complete</code> draw a circle on a group and a dot on the rail of an item. <code>TreeViewData.RollUpStatus</code> sets parents from their children.", "TreeNodeStatus"),
            new("Caption", "Outline mode only: a small line above the text.", "string?", "null"),
            new("SecondaryText / SecondaryIcon", "Outline mode only: a second line under the text, with an icon before it given as a <code>FlexIcons</code> name or raw SVG path data.", "string?", "null"),
            new("BadgeText", "Outline mode only: a right-aligned label after the text. <code>RollUpStatus</code> with <code>setBadges</code> writes a done/total count here.", "string?", "null"),
        };
        public static readonly ApiRow[] Methods =
        {
            new("SelectNodesAsync(IEnumerable&lt;string&gt; ids)", "Selects those nodes: only the first without <code>AllowMultiSelect</code>, and never a disabled one. Raises <code>SelectedNodeChanged</code> for the first and the selection callbacks.", "Task"),
            new("SetCheckedAsync(string id, bool value)", "Checks or unchecks one node, cascading with <code>AutoCheck</code>. Ignored for a disabled or unknown node.", "Task"),
            new("CheckAllAsync(bool value = true)", "Checks every enabled node, or unchecks them with false, as Add everything and Clear do in the second example.", "Task"),
            new("SetExpandedAsync(string id, bool expanded)", "Expands or collapses one node, first loading its children through <code>LoadChildren</code> when they are not loaded yet.", "Task"),
