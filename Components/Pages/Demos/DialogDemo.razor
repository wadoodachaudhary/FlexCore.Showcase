        public const string ServiceCs = @"// Program.cs, once:
builder.Services.AddScoped<DialogService>();
builder.Services.AddScoped<IDialogService>(sp => sp.GetRequiredService<DialogService>());
// MainLayout.razor, once:   <DialogHostControl />

private async Task Confirm() =>
    _answer = await Dialogs.ConfirmAsync(""Delete 3 rows?"", ""Confirm"") ? ""Yes"" : ""No"";

private async Task Prompt()
{
    var name = await Dialogs.PromptAsync(""Project name:"", ""New project"", ""Untitled"");
    _answer = name is null ? ""Cancelled"" : $""Named {name}"";
}

private Task Alert() => Dialogs.AlertAsync(""Export finished. 240 rows written."", ""Export"");

private MessageBoxControl? _box;
private async Task AskDotNet() =>
    _answer = (await _box!.ShowAsync(""Save changes to Report.docx?"", ""Editor"",
        MessageBoxButtons.YesNoCancel, ""question"", MessageBoxLook.DotNet)).ToString();

private async Task GatedDelete() =>
    _answer = (await _box!.ShowAsync(""Delete the project and its 14 files?"", ""Delete project"",
        MessageBoxButtons.OkCancel, ""warning"", null,
        ""I understand this cannot be undone"")).ToString();";
    }
