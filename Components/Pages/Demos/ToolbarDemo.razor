            @if (_exportOpen)
            {
                <div class=""qd-backdrop"" @onclick=""() => _exportOpen = false""></div>
                <div class=""qd-menu"">
                    <ButtonControl CssClass=""qd-menu-item"" OnClick='() => Desk(""Export › PDF quote"")'>PDF quote</ButtonControl>
                    <ButtonControl CssClass=""qd-menu-item"" OnClick='() => Desk(""Export › CSV itinerary"")'>CSV itinerary</ButtonControl>
                </div>
            }
        </span>
        <ToolbarButtonControl Label=""Print"" IconCss=""bi bi-printer"" OnClick='() => Desk(""Print"")' />
    </ToolbarControl>
    <p class=""tb-status"" role=""status"">Last action: @_deskLast</p>
    <div class=""qd-label"">Agent notes, request QD-@(_request)</div>
    <TextBoxControl @bind-Value=""_notes"" @bind-Value:after=""MarkDirty"" Multiline=""true"" Rows=""10"" Width=""100%"" aria-label=""Agent notes"" />
</div>";
        public const string AppBarCs = @"// App bar
private bool _sticky = true, _exportOpen, _deskDirty;
private int _request = 1042;
private string _deskLast = ""none yet"";
private string _notes = ""Phoned on Monday: two adults, May 12–15, hotel within walking distance of the old town."";
private void Desk(string action)
{
    _exportOpen = false;
    _deskLast = action;
}
private void NewQuote()
{
    Desk(""New request"");
    _request++;
    _notes = """";
    _deskDirty = true;
}
private void SaveQuote()
{
    Desk(""Save"");
    _deskDirty = false;
}
private void MarkDirty() => _deskDirty = true;";
