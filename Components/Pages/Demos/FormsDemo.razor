        public const string PropertyGridCs = @"private TourPackage _package = new();
private int _changes;
private bool _seasonButtons;
private static readonly SelectionItem[] Seasons = Enum.GetNames<Season>().Select(s => new SelectionItem(s, s)).ToArray();
private void PackageChanged() => _changes++;
private void SeasonChanged(IReadOnlyList<string> values) { _package.Season = Enum.Parse<Season>(values[0]); _changes++; }

public enum Season { Spring, Summer, Autumn, Winter }

public sealed class TourPackage
{
    [Editable(false)] public string PackageCode { get; set; } = ""KYO-AUT-08"";
    public string Name { get; set; } = ""Kyoto Classic"";
    public string Destination { get; set; } = ""Kyoto"";
    public int Nights { get; set; } = 8;
    public decimal PricePerPerson { get; set; } = 2340.00m;
    public Season Season { get; set; } = Season.Autumn;
    public bool IncludesFlights { get; set; } = true;
    public DateTime DepartureDate { get; set; } = new(2026, 11, 14);
    // No setter, so the grid gives it no row.
    public string Summary => $""{PackageCode}: {Name}, {Destination}, {Season}, {Nights} nights from {DepartureDate:d MMM yyyy}, {PricePerPerson:0.00} per person, flights {(IncludesFlights ? ""included"" : ""not included"")}."";
}";
        public const string PropertyGridCss = @"/* 2026-10-25: property grid example. The checkbox editor repeats the row's caption beside the box; this hides that copy
   visually and keeps it as the checkbox's accessible name. */
.tour-grid { max-width: 560px; }
.tour-grid ::deep .fx-propertygrid-editor .fx-checkbox-label {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
}";
    }

