    private static class Vocab
    {
        public static readonly ApiRow[] Column =
        {
            new("IsFrozen", "Pins the column while the others scroll. The cell is <code>position: sticky</code>, offset by the summed widths of the frozen columns before it on the same edge (a column without a declared width counts as 120px). A lock set from the header menu overrides the declared value at runtime.", "bool", "false"),
            new("FrozenPosition", "The edge a frozen column sticks to, Left or Right. Ignored while <code>IsFrozen</code> is off.", "FrozenColumnPosition", "FrozenColumnPosition.Left"),
            new("HeaderBand", "Name of the band above this column; adjacent visible columns with the same name share one spanning cell. A <code>ColumnHeaderBands</code> entry that lists the field wins over this.", "string?", "null"),
            new("AllowEditing", "Whether this column's cells open an editor when the grid's <code>EditSettings</code> allow editing. Auto-generated columns set it from the property.", "bool", "true"),
        };
        public static readonly ApiRow[] Grid =
        {
            new("ColumnHeaderBands", "Band descriptors for the extra header row. Fields match case-insensitively; a band whose columns are separated by reordering or by a frozen edge renders one cell per contiguous run; columns in no band get an empty cell.", "IReadOnlyList&lt;GridColumnHeaderBand&gt;?", "null"),
            new("AutoGenerateColumns", "Builds one column per public readable property of <code>TValue</code>, as listed below. An explicit <code>GridColumn</code> with the same <code>Field</code> replaces the generated one; extra explicit columns follow the generated set.", "bool", "false"),
