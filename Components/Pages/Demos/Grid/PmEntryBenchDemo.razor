<PageTitle>Typing modes — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Typing modes" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Decide whether each keystroke in a cell editor goes to the server or stays in the browser until commit."
                   SourcePath="TextBoxTypingBehavior.cs;Grid/GridControl.razor.cs;Grid/GridTextEditingDiagnosticsSnapshot.cs;TextBoxControl.razor;wwwroot/textbox-control.js">
    <Overview>
        <p>
            Text cell editors are <code>TextBoxControl</code>s, and <code>TextEditorTypingBehavior</code> picks their transport.
            <code>ServerBacked</code>, the default, keeps the ordinary Blazor event path: the server sees the text as it is typed.
            <code>ClientBuffered</code> keeps typing in the browser and sends the completed value when the cell commits, so a slow or
            busy connection does not get a round trip per character. Both modes write the same value to the row on commit.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="transport" Title="Switch the transport, then type" RazorCode="@Code.Transport" CSharpCode="@Code.TransportCs">
            <Description><p>Pick a transport, double-click a Full Name, Email or Phone cell, type and press Enter. The line under the grid counts the saves and names the last one. On a local connection the two modes feel the same; the difference is how many messages travel while you type.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_transports" Values="@(new[] { _clientBuffered ? "client" : "server" })"
                                    ValuesChanged="@(v => SetTransport(v.Count > 0 && v[0] == "client"))"
                                    Selection="ChoiceSelectionMode.Single" AriaLabel="Typing transport" />
            </Controls>
            <Demo>
                <GridControl TValue="PMRow"
                             DataSource="@_rows"
                             Height="360px"
                             AllowSelection="true"
                             AllowSorting="true"
                             TextEditorTypingBehavior="@(_clientBuffered ? TextBoxTypingBehavior.ClientBuffered : TextBoxTypingBehavior.ServerBacked)"
                             EditSettingsRef="@_editSettings"
                             EventsRef="@_events"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(PMRow.ID)" HeaderText="PM ID" Width="85px" AllowEditing="false" />
                        <GridColumn Field="@nameof(PMRow.FullName)" HeaderText="Full Name" Width="200px" AllowEditing="true" />
                        <GridColumn Field="@nameof(PMRow.Email)" HeaderText="Email Address" Width="220px" AllowEditing="true" />
                        <GridColumn Field="@nameof(PMRow.Phone)" HeaderText="Direct Phone" Width="130px" AllowEditing="true" />
                        <GridColumn Field="@nameof(PMRow.IsAdmin)" HeaderText="Admin" Width="80px" Type="ColumnType.Boolean" TextAlign="TextAlign.Center" AllowEditing="true" />
                        <GridColumn Field="@nameof(PMRow.POLimit)" HeaderText="PO Limit" Width="130px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" Format="$#,##0" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@(_clientBuffered ? "ClientBuffered" : "ServerBacked") · @_saveCount @(_saveCount == 1 ? "cell" : "cells") saved@(_last is null ? "" : $"; last: {_last}")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-textboxtypingbehavior" Title="TextBoxTypingBehavior" Count='@DocSection.Label(Vocab.Modes.Length, "values")' Open="true">
                <ApiTable Kind="ApiKind.Values" Title="TextBoxTypingBehavior" Rows="Vocab.Modes" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-typing-parameters" Title="GridControl typing parameters" Count='@DocSection.Label(Vocab.Grid.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridControl typing parameters" Rows="Vocab.Grid" />
            </DocSection>
            <DocSection Id="doc-gridcontrol-transport-counters" Title="GridControl transport counters" Count='@DocSection.Label(Vocab.GridMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="GridControl transport counters" Rows="Vocab.GridMethods" />
            </DocSection>
            <DocSection Id="doc-gridtexteditingdiagnosticssnapshot" Title="GridTextEditingDiagnosticsSnapshot" Count='@DocSection.Label(Vocab.Snapshot.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="GridTextEditingDiagnosticsSnapshot" Rows="Vocab.Snapshot" />
            </DocSection>
            <DocSection Id="doc-textboxcontrol-typing-parameters" Title="TextBoxControl typing parameters" Count='@DocSection.Label(Vocab.TextBox.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="TextBoxControl typing parameters" Rows="Vocab.TextBox" />
            </DocSection>
            <DocSection Id="doc-textboxcontrol-callbacks-on-the-typing-p" Title="TextBoxControl callbacks on the typing path" Count='@DocSection.Label(Vocab.TextBoxEvents.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="TextBoxControl callbacks on the typing path" Rows="Vocab.TextBoxEvents" />
            </DocSection>
            <DocSection Id="doc-textboxcontrol-commit-methods" Title="TextBoxControl commit methods" Count='@DocSection.Label(Vocab.TextBoxMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="TextBoxControl commit methods" Rows="Vocab.TextBoxMethods" />
                <p>
                Both modes end in the same place, the grid's edit buffer and its cell commit; what differs is how many messages travel
                before that, and neither changes how the editor opens. The grid's filter and search boxes pick their own mode from
                <code>FilterSettings.SearchAsYouType</code> (<code>ServerBacked</code> as you type, <code>ClientBuffered</code> when it is
                off) and do not read <code>TextEditorTypingBehavior</code>.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/batch-editing">Batch editing</a>: the editing model these editors live in.</li>
            <li><a href="demo/grid/unsaved-row-lock">Unsaved-row lock</a>: keeping the user on a row until it is complete.</li>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

