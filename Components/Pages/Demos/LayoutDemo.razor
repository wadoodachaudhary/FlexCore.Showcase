        public static readonly ApiRow[] GridLayout =
        {
            new("Columns", "Written into <code>grid-template-columns</code> as given, so any CSS track list works: <code>repeat(3,minmax(0,1fr))</code>, <code>160px 1fr</code>, <code>repeat(auto-fill,minmax(160px,1fr))</code>.", "string", "\"repeat(2,minmax(0,1fr))\""),
