@page "/demo/checks"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-13: new page on FeatureDemoLayout; switch and rating moved from UI elements; Razor tabs generated from the Demo blocks.
   Facts from CheckBox*, Radio*, Switch*, Rating*, FlexControlBase.cs (FlexCore 0.2.48).
   2026-11-15: travel examples; events in their own table; text re-checked against FlexCore 0.2.50.
   2026-11-15: example story moved to the HR tracking theme. *@

<PageTitle>Blazor Checkbox, Radio Group, Switch and Rating — FlexCore</PageTitle>

<FeatureDemoLayout Title="Checks & switches" Category="Components" ControlName="CheckBoxControl · RadioGroupControl · SwitchControl · RatingControl"
                   Tagline="Let users check items, switch options on, pick one of several or give a star rating."
                   SourcePath="CheckBoxControl.razor; RadioGroupControl.razor; RadioControl.razor; SwitchControl.razor; RatingControl.razor">
    <Overview>
        <p>
            The small Blazor inputs that most forms need: <code>CheckBoxControl</code>, <code>SwitchControl</code>, <code>RadioGroupControl</code> for one choice out of a few, and <code>RatingControl</code> for stars. Use checkboxes for a list users check off, where a select-all box can show that only some are checked, and a switch for a single option users turn on or off, such as Parking pass. All four bind their value two ways.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="checks" Title="Checkboxes with select all" RazorCode="@Code.Checks" CSharpCode="@Code.ChecksCs">
            <Description><p>Choose a new hire's optional benefits: with only some checked, the parent shows a dash (<code>Indeterminate</code>), and the monthly deduction follows every change; check the parent to set all three. The health plan is checked and <code>Disabled</code>.</p></Description>
            <Demo>
                <div class="ck">
                    <div class="stack">
                        <CheckBoxControl Checked="@AllChecked" Indeterminate="@SomeChecked" CheckedChanged="SetAll" Label="Include in Neville Longbutton's benefits" />
                        <div class="stack indent">
                            <CheckBoxControl @bind-Checked="_dental" Label="Dental plan, $32" />
                            <CheckBoxControl @bind-Checked="_vision" Label="Vision plan, $12" />
                            <CheckBoxControl @bind-Checked="_gym" Label="Gym membership, $40" />
                            <CheckBoxControl Checked="true" Disabled="true" Label="Health plan, $85 (always included)" />
                        </div>
                    </div>
                    <p class="result" role="status">Monthly deduction: <strong>@Total.ToString("C0")</strong></p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="radio" Title="Radio group and switches" RazorCode="@Code.Radio" CSharpCode="@Code.RadioCs">
            <Description><p>Pick the new hire's work pattern, then switch Parking pass or Standing desk on and off; the line below reads your choices. Remote is a disabled item, and one switch is on and disabled.</p></Description>
            <Demo>
                <div class="ck">
                    <div class="demo-row top">
                        <div class="stack">
                            <span class="field-label">Work pattern</span>
                            <RadioGroupControl TValue="string" Items="_patternItems" @bind-Value="_pattern" Vertical="true" AriaLabel="Work pattern" />
                        </div>
                        <div class="stack">
                            <span class="field-label">Options</span>
                            <SwitchControl @bind-Checked="_parking" Label="Parking pass" />
                            <SwitchControl @bind-Checked="_standingDesk" Label="Standing desk" />
                            <SwitchControl Checked="true" Disabled="true" Label="Laptop (included)" />
                        </div>
                    </div>
                    <p class="result" role="status">@Setup</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="rating" Title="Rating" RazorCode="@Code.Rating" CSharpCode="@Code.RatingCs">
            <Description><p>Click a star to rate onboarding week: each click adds a rating to the 8 already given. The line below shows the new average, and its <code>ReadOnly</code> stars show it rounded, so they move only when the rounded value changes.</p></Description>
            <Demo>
                <div class="ck">
                    <div class="demo-row">
                        <span class="field-label">Your rating of onboarding week</span>
                        <RatingControl Value="@_stars" ValueChanged="Rate" />
                        <span class="result inline" role="status">@Stars</span>
                    </div>
                    <div class="demo-row mt">
                        <RatingControl Value="@Rounded" ReadOnly="true" />
                        <span class="field-label">Average @Average.ToString("0.0") of @_ratings new hire ratings</span>
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-checkboxcontrol-parameters" Title="CheckBoxControl parameters" Count='@DocSection.Label(Vocab.CheckBox.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="CheckBoxControl parameters" Rows="Vocab.CheckBox" />
            </DocSection>
            <DocSection Id="doc-radiogroupcontrol-tvalue-parameters" Title="RadioGroupControl&lt;TValue&gt; parameters" Count='@DocSection.Label(Vocab.RadioGroup.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RadioGroupControl&lt;TValue&gt; parameters" Rows="Vocab.RadioGroup" />
            </DocSection>
            <DocSection Id="doc-radiogroupitem-tvalue-and-radiocontrol" Title="RadioGroupItem&lt;TValue&gt; and RadioControl" Count='@DocSection.Label(Vocab.RadioItem.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="RadioGroupItem&lt;TValue&gt; and RadioControl" Rows="Vocab.RadioItem" />
            </DocSection>
            <DocSection Id="doc-switchcontrol-parameters" Title="SwitchControl parameters" Count='@DocSection.Label(Vocab.Switch.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="SwitchControl parameters" Rows="Vocab.Switch" />
            </DocSection>
            <DocSection Id="doc-ratingcontrol-parameters" Title="RatingControl parameters" Count='@DocSection.Label(Vocab.Rating.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RatingControl parameters" Rows="Vocab.Rating" />
            </DocSection>
            <DocSection Id="doc-events" Title="Events" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="Events" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
                <p>None of the four stylesheets reads a <code>--fx-*</code> variable. The checkbox has a second look, <code>fx-checkbox-theme-blue</code>, that switches to the browser's native 16px box with a blue accent.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
        <ul>
            <li>Checkbox and switch are native <code>&lt;input type="checkbox"&gt;</code> elements inside a <code>&lt;label&gt;</code>, so the label text is their accessible name. The checkbox shows a dotted outline on keyboard focus; the switch hides its input and shows a focus ring on the track.</li>
            <li>Unmatched attributes on <code>SwitchControl</code> reach its input: pass <code>role="switch"</code> to have screen readers announce on and off.</li>
            <li><code>Indeterminate</code> sets <code>aria-checked="mixed"</code> and draws a dash; the input's own checked value is unchanged.</li>
            <li>The radio group is <code>role="radiogroup"</code> named by <code>AriaLabel</code>; each radio is named by its item text. One radio holds the Tab stop: the selected one, else the first enabled.</li>
            <li>Each rating star is a native button; <code>ReadOnly</code> or <code>Disabled</code> disables them all, so Tab skips the control. Unmatched attributes land on the host <code>&lt;div&gt;</code>: pass <code>role="group"</code> and an <code>aria-label</code> to name the set, and show the value as text beside the stars, as the example does.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Pressed-state buttons and button groups: <a href="demo/toggle-buttons">Toggle buttons</a>. Numbers by dragging: <a href="demo/sliders">Sliders</a>.</li>
            <li>These controls inside a validated form: <a href="demo/forms#generated">Forms</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Checkboxes
    private bool _dental = true, _vision = true, _gym;
    private bool AllChecked => _dental && _vision && _gym;
    private bool SomeChecked => !AllChecked && (_dental || _vision || _gym);
    private void SetAll(bool value) => _dental = _vision = _gym = value;
    private decimal Total => 85 + (_dental ? 32 : 0) + (_vision ? 12 : 0) + (_gym ? 40 : 0);

    // Radio group and switches
    private readonly RadioGroupItem<string>[] _patternItems =
    {
        new("office", "In the office"), new("hybrid", "Hybrid"), new("remote", "Remote, not offered", true),
    };
    private string? _pattern = "hybrid";
    private bool _parking = true, _standingDesk;
    private string Setup => $"{_patternItems.First(i => i.Value == _pattern).Text}; parking pass {(_parking ? "requested" : "not requested")}; standing desk {(_standingDesk ? "requested" : "not requested")}; laptop included.";

    // Rating: each click adds one rating
    private int _stars;                                    // 0 until the visitor rates
    private int _ratings = 8, _sum = 28;                   // 8 ratings averaging 3.5 to start
    private double Average => (double)_sum / _ratings;
    private int Rounded => (int)Math.Round(Math.Round(Average, 1), MidpointRounding.AwayFromZero);   // rounds the average as shown
    private void Rate(int value)
    {
        _stars = value;
        _ratings++;
        _sum += value;
    }
    private string Stars => _stars switch
    {
        0 => "Not rated",
        1 => "1 star, poor",
        2 => "2 stars, fair",
        3 => "3 stars, good",
        4 => "4 stars, very good",
        _ => "5 stars, excellent",
    };

