@page "/demo/tree/treeview-explorer"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Navigation
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: moved onto FeatureDemoLayout. One example (the explorer with its inspector); folder style and
   VB6 lines are switches in the card header on FlexCore controls instead of Bootstrap buttons. Parameter
   table written from TreeViewControl.Appearance.cs and TreeViewControl.Operations.cs (0.2.48).
   2026-10-20: code tabs generated from this file (gencode), replacing hand-written constants that had drifted from the markup. *@

<PageTitle>Tree view — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Tree view" Category="Components" ControlName="TreeViewControl"
                   Tagline="A hierarchical tree with folder icons, checkboxes, editing, drag and drop, and a classic VB6 look."
                   SourcePath="TreeViewControl.razor; TreeViewModels.cs">
    <Overview>
        <p>
            <code>TreeViewControl</code> renders a list of <code>TreeNode</code>s with nested <code>Children</code>. Nodes expand on click,
            report selection through <code>SelectedNodeChanged</code>, and can carry a <code>Tag</code> for your own data. Two folder icon sets
            and <code>UseVb6TreeStyle</code>, which draws the dotted connector lines of the Windows common control, cover modern and
            migrated screens. Checkboxes, multi-select, inline editing, drag and drop, lazy loading and virtualization are parameters
            on the same control; this page shows the basics.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="explorer" Title="Project explorer with a node inspector" RazorCode="@Code.Explorer" CSharpCode="@Code.ExplorerCs">
            <Description><p>Click a node to select it and read its properties on the right; click a folder to expand it. The switches change the folder icons and the connector lines.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_styleItems" @bind-Values="_styleValues" Selection="ChoiceSelectionMode.Single" AriaLabel="Folder style" />
                <ToggleButtonControl @bind-Selected="_useVb6Style">VB6 lines</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="explorer">
                    <div class="tree">
                        <TreeViewControl Nodes="@_treeNodes"
                                         SelectedNode="@_selectedNode"
                                         SelectedNodeChanged="HandleNodeSelected"
                                         ToggleOnNodeClick="true"
                                         ShowIcons="true"
                                         UseVb6TreeStyle="@_useVb6Style"
                                         FolderStyle="@FolderStyle"
                                         TreeIndentPixels="16"
                                         Height="100%" />
                    </div>
                    <div class="inspector">
                        <h4>Selected node</h4>
                        @if (_selectedNode is not null)
                        {
                            <dl class="props">
                                <dt>Id</dt><dd><code>@_selectedNode.Id</code></dd>
                                <dt>Text</dt><dd>@_selectedNode.Text</dd>
                                <dt>Children</dt><dd>@_selectedNode.Children.Count</dd>
                                <dt>Expanded</dt><dd>@(_selectedNode.IsExpanded ? "yes" : "no")</dd>
                                <dt>Tag</dt><dd>@(_selectedNode.Tag?.ToString() ?? "none")</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="muted">Click a node to inspect it.</p>
                        }
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
        <ApiTable Kind="ApiKind.Properties" Title="TreeNode" Rows="Vocab.Node" />
    </Vocabulary>

    <Accessibility>
        <p class="fd-pending">Keyboard model and ARIA output are still to be checked against the source; the control exposes <code>AriaLabel</code> (default "Tree") and <code>TabIndex</code>.</p>
    </Accessibility>

    <Related>
        <ul>
            <li>Rows with columns and totals under a tree: <a href="demo/grid/tree-grid">Tree grid</a>.</li>
            <li>Side navigation that collapses: <a href="demo/layout">Page layouts</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
