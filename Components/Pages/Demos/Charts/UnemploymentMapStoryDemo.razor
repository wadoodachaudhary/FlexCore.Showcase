@page "/demo/charts/map-story"
@rendermode InteractiveServer
@using Fx.ControlKit.Maps
@using FlexCore.Showcase.Components.Shared
@using FlexCore.Showcase.Data
@* 2026-10-21: page added with the FlexKit 0.1.131 choropleth mirror (Cursor branch, merged by Wadood).
   2026-10-23 (meeting point 3): code tabs generated from this file (gencode) instead of hand-written constants; the inline style block
   moved to the page stylesheet; a parameter table for MapStoryControl written from Maps/MapStoryControl.razor.
   2026-10-26 (Baaria): second example, airports per country (the OurAirports snapshot the Data Grid page uses) as a choropleth built in
   code with MapStoryComposer; a click opens the country on MapControl's plain map with one marker per airport. MapControl draws markers
   only without a Choropleth, hence the two views. MapControl parameters written from Maps/MapControl.razor. *@

<PageTitle>Blazor Map Chart: Drill-Down Choropleth — FlexCore</PageTitle>

<FeatureDemoLayout Title="Map story" Category="Charts" CategoryHref="demo/charts" ControlName="MapStoryControl"
                   Tagline="A drill-down choropleth: world, then continent, then province, state, or region."
                   SourcePath="Maps/MapStoryControl.razor;Maps/ChoroplethLayout.cs;Maps/MapStory.cs">
    <Overview>
        <p>
            <code>MapStory</code> is a declarative report: levels, region values, a color scale, callouts and the source line.
            Define it in C# or load the same shape from JSON with <code>MapStory.Load</code>.
            <code>MapStoryControl</code> draws each level on the existing <code>MapControl</code> choropleth.
            Click a region to open the next map. Back and the breadcrumb return upward.
            <code>MapStory.RenderSvg</code> writes the same graphic as static SVG for a report or an export.
            The story below is unemployment. Continent figures are labour-force-weighted averages of ILO modelled national rates (World Bank, 2025).
            Europe uses the August 2026 rates from the reference graphic. Provincial maps use Eurostat NUTS-2 for 2024, and the United States uses BLS statewide rates for September 2026.
            No figure on this page is sample data. A country without a provincial series opens “Regional data not available”.
            The second example builds a choropleth in code from the airports on the <a href="demo/grid">Data Grid</a> page and, for one country,
            switches <code>MapControl</code> to its plain map with markers.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="story" Title="Unemployment, world to province" RazorCode="@Code.Story" CSharpCode="@Code.StoryCs">
            <Description>
                <p>Start at the world. Open Europe, then Spain, France, Germany, Italy or Finland. From North America, open the United States. Other countries stop at the national rate.</p>
            </Description>
            <Demo>
                <MapStoryControl Story="_story" Width="960" Height="640" />
            </Demo>
        </DemoExample>
        <DemoExample Id="airports" Title="Airports per country, then one country's airports" RazorCode="@Code.Airports" CSharpCode="@Code.AirportsCs" CssCode="@Code.AirportsCss">
            <Description>
                <p>The 4,009 airports from the <a href="demo/grid">Data Grid</a> page, counted per country: one airport is the palest blue, the United States' 634 the deepest. The colours step at 1, 3, 10, 30 and 100 airports because half of the countries have four or fewer. Click a country to open it on the plain map with one marker per airport (rose for large, amber for medium, grey for small). In the three countries with more than 200 airports (the United States, China and Canada), markers close together merge into a numbered circle that zooms in when clicked. Clicking a marker lists the airport's runways. Small territories such as French Polynesia have no outline at this scale. Data: <a href="https://ourairports.com/data/" target="_blank" rel="noopener">OurAirports</a>, public domain.</p>
            </Description>
            <Demo>
                @if (_country is null)
                {
                    <MapControl Choropleth="_airportLayout" ShapeClick="OpenCountry" Width="960" Height="560"
                                AriaLabel="Airports per country. Each country is a button that opens its airports." />
                }
                else
                {
                    <div class="country-bar">
                        <ButtonControl OnClick="BackToWorld">Back to the world map</ButtonControl>
                        <span><strong>@_byCountry[_country][0].Country</strong>: @_byCountry[_country].Count airports with scheduled service</span>
                        <span class="marker-key"><i class="large"></i>Large <i class="medium"></i>Medium <i class="small"></i>Small</span>
                    </div>
                    <MapControl Shapes="_shapes" Markers="_markers" @bind-Center="_center" @bind-Zoom="_zoom" MinZoom="1" MaxZoom="10"
                                ClusterMarkers="@(_markers.Count > 200)" MarkerClick="PickAirport" Width="960" Height="520"
                                Attribution="Airports: OurAirports, public domain. Outlines: Natural Earth."
                                AriaLabel="@($"Airports in {_byCountry[_country][0].Country}. Arrow keys pan, plus and minus zoom.")" />
                    @if (_picked is { } picked)
                    {
                        <div class="airport-card">
                            <p><strong>@picked.Code</strong> @picked.Name, @picked.City. @picked.Type airport, elevation @(picked.ElevationFt?.ToString("N0") ?? "unknown") ft.</p>
                            <ul>
                                @foreach (var runway in AirportData.RunwaysOf(picked.Code))
                                {
                                    <li>Runway @runway.Name: @(runway.LengthFt?.ToString("N0") ?? "length unknown") ft, @runway.Surface.ToLowerInvariant()@(runway.Lighted ? ", lit" : "")@(runway.Closed ? ", closed" : "")</li>
                                }
                            </ul>
                            @if (!string.IsNullOrEmpty(picked.Wikipedia))
                            {
                                <a href="@picked.Wikipedia" target="_blank" rel="noopener">Wikipedia article</a>
                            }
                        </div>
                    }
                }
            </Demo>
        </DemoExample>
        <DemoExample Id="svg" Title="The same Europe graphic as static SVG" RazorCode="@Code.Svg" CSharpCode="@Code.SvgCs">
            <Description>
                <p><code>RenderSvg</code> does not need a circuit. A report host can place this markup the way it places other SVG.</p>
            </Description>
            <Demo>
                <div class="map-story-static">@((MarkupString)_europeSvg)</div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-mapstorycontrol-parameters" Title="MapStoryControl parameters" Count='@DocSection.Label(Vocab.Params.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="MapStoryControl parameters" Rows="Vocab.Params" />
                <ul>
                <li><code>MapStory</code>, <code>MapStoryLevel</code>, <code>MapStoryRegion</code>: the report. A region’s <code>ChildLevelId</code> is the map that opens next.</li>
                <li><code>ChoroplethScale</code>: sequential stops. The default runs from <code>#F6E27A</code> to <code>#5A1228</code>. Missing values use <code>#C5C6C4</code>.</li>
                <li><code>MapStoryLevel.SampleData</code> and <code>MapStoryRegion.Sample</code>: the graphic prints “Sample data” instead of presenting a stand-in number as published.</li>
                <li><code>MapGeographyCatalog.Bundled</code>: Natural Earth 1:110m countries (public domain) and simplified NUTS-2 / US state boundaries, embedded with the control. No tile server.</li>
                <li>Sources for this story live in <code>wwwroot/maps/stories/unemployment.json</code>.</li>
                </ul>
            </DocSection>
            <DocSection Id="doc-mapcontrol-parameters" Title="MapControl parameters" Count='@DocSection.Label(Vocab.Map.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="MapControl parameters" Rows="Vocab.Map" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <p>
            Each region is a button. Enter or Space opens the next map. The breadcrumb is a list of buttons, and the current level is marked <code>aria-current="page"</code>.
            The title, legend range, source line and the “no regional data” message are in the page for assistive technology. Hover shows the same rate as the button name.
        </p>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/charts/sunburst">Sunburst</a>: the other drill-down graphic, for a hierarchy rather than a map.</li>
            <li><a href="demo/charts">Charts</a>: the rest of the SVG chart gallery.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    MapStory _story = null!;
    string _europeSvg = "";

    protected override void OnInitialized()
    {
        _story = MapStory.LoadBundledUnemployment();
        _story.Stops = ChartPalette.Scale.Select((color, i) => new ChoroplethStop { At = i / (ChartPalette.Scale.Length - 1d), Color = color }).ToList();
        _europeSvg = _story.RenderSvg(MapGeographyCatalog.Bundled(), "europe");
        BuildAirportMap();
    }

    // Airports (2026-10-26): the OurAirports snapshot (Data/AirportData.cs) counted per country on a choropleth; a click on a country
    // opens it on the plain map with one marker per airport, coloured by size.
    static readonly MapGeographyCatalog _geography = MapGeographyCatalog.Bundled();
    static readonly string[] _stepColors = ChartPalette.Scale;

    readonly Dictionary<string, List<Airport>> _byCountry = AirportData.Airports
        .GroupBy(a => a.CountryCode).ToDictionary(g => g.Key, g => g.ToList());
    ChoroplethLayout _airportLayout = null!;
    ChoroplethScale _airportScale = null!;
    int _maxAirports;

    string? _country;
    IReadOnlyList<MapShape> _shapes = [];
    IReadOnlyList<MapMarker> _markers = [];
    GeoPoint _center = new(20, 0);
    int _zoom = 2;
    Airport? _picked;

    void BuildAirportMap()
    {
        _maxAirports = _byCountry.Values.Max(list => list.Count);
        int[] steps = { 1, 3, 10, 30, 100, _maxAirports };
        var offMap = _byCountry.Where(p => _geography.Country(p.Key) is null).Sum(p => p.Value.Count);
        var story = new MapStory
        {
            Id = "airports",
            RootLevelId = "world",
            ValueFormat = "0",
            NoDataColor = "#E5E7EB",
            Stops = steps.Select((n, i) => new ChoroplethStop { At = (n - 1d) / (_maxAirports - 1d), Color = _stepColors[i] }).ToList(),
        };
        story.Levels.Add(new MapStoryLevel
        {
            Id = "world",
            Title = "Airports with scheduled passenger service",
            Geography = "countries",
            Projection = "Robinson",
            Footnote = $"OurAirports, public domain, {AirportData.SnapshotDate}. Grey: no airport. {offMap} airports in small territories are not drawn at this scale.",
            Regions = _byCountry.Select(p => new MapStoryRegion { Id = p.Key, Name = p.Value[0].Country, Value = p.Value.Count, ChildLevelId = "country" }).ToList(),
        });
        _airportScale = ChoroplethScale.From(story.Stops, story.NoDataColor);
        var layout = MapStoryComposer.Compose(story, story.Levels[0], _geography, null, null, 960, 560);
        // The colours step at 1, 3, 10, 30, 100 and the largest count, so the legend spaces them evenly; at their linear
        // positions five of the six would share the first sixth of the bar.
        _airportLayout = new ChoroplethLayout
        {
            Width = layout.Width, Height = layout.Height, Background = layout.Background, Title = layout.Title,
            SampleBanner = layout.SampleBanner, Footnote = layout.Footnote, Message = layout.Message,
            LegendCaption = $"Airports per country, colour steps at {string.Join(", ", steps)}", GradientId = "airports-legend",
            LegendStops = _stepColors.Select((color, i) => (i / (_stepColors.Length - 1d), color)).ToList(),
            LegendMin = "1", LegendMax = _maxAirports.ToString("N0"),
            LegendX = layout.LegendX, LegendY = layout.LegendY, LegendWidth = layout.LegendWidth,
            Regions = layout.Regions, Labels = layout.Labels, Callouts = layout.Callouts, Insets = layout.Insets,
        };
    }

    Task OpenCountry(MapShape shape)
    {
        if (!_byCountry.TryGetValue(shape.Id, out var airports)) return Task.CompletedTask;
        _country = shape.Id;
        _picked = null;
        _markers = airports.Select(a => new MapMarker(a.Code, new GeoPoint(a.Latitude, a.Longitude), $"{a.Code} {a.Name}", 1, TypeColor(a.Type))).ToList();
        (_center, _zoom) = Fit(_markers.Select(m => m.Location).ToList(), 960, 520);
        // The country in its choropleth colour, with the neighbours inside the airports' bounds in grey for context.
        _shapes = _geography.Countries
            .Where(f => f.Id == shape.Id || Overlaps(f, _markers))
            .OrderBy(f => f.Id == shape.Id)
            .Select(f => new MapShape(f.Id, f.Name, f.Polygons.SelectMany(polygon => polygon).ToList(),
                Fill: f.Id == shape.Id ? _airportScale.Color(airports.Count, 1, _maxAirports) : "#F1F5F9",
                Stroke: f.Id == shape.Id ? "#0c4a6e" : "#CBD5E1"))
            .ToList();
        return Task.CompletedTask;
    }

    void PickAirport(MapMarker marker) => _picked = _byCountry[_country!].First(a => a.Code == marker.Id);

    void BackToWorld() { _country = null; _picked = null; }

    static string TypeColor(string type) => type switch { "Large" => ChartPalette.Rose, "Medium" => ChartPalette.Amber, _ => "#64748B" };

    static bool Overlaps(MapFeature feature, IReadOnlyList<MapMarker> markers)
    {
        var south = markers.Min(m => m.Location.Latitude) - 5; var north = markers.Max(m => m.Location.Latitude) + 5;
        var west = markers.Min(m => m.Location.Longitude) - 5; var east = markers.Max(m => m.Location.Longitude) + 5;
        return feature.Points.Any(p => p.Latitude >= south && p.Latitude <= north && p.Longitude >= west && p.Longitude <= east);
    }

    // The highest zoom at which every marker fits inside the map with a margin; one airport opens at zoom 7.
    static (GeoPoint Center, int Zoom) Fit(IReadOnlyList<GeoPoint> points, int width, int height)
    {
        double south = points.Min(p => p.Latitude), north = points.Max(p => p.Latitude);
        double west = points.Min(p => p.Longitude), east = points.Max(p => p.Longitude);
        var center = new GeoPoint((south + north) / 2, (west + east) / 2);
        for (var zoom = 7; zoom > 1; zoom--)
        {
            var topLeft = MapProjection.Project(new GeoPoint(north, west), zoom);
            var bottomRight = MapProjection.Project(new GeoPoint(south, east), zoom);
            if (bottomRight.X - topLeft.X <= width - 80 && bottomRight.Y - topLeft.Y <= height - 80) return (center, zoom);
        }
        return (center, 1);
    }

