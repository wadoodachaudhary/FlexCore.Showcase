@page "/demo/grid/virtualization-bench"
@rendermode InteractiveServer
@using System.Diagnostics
@using Fx.ControlKit
@using Fx.ControlKit.Grid

<PageTitle>Row Virtualization Bench — FlexCore DataGrid</PageTitle>

<SyncfusionDemoLayout Title="Row Virtualization & Multi-Edit Batching"
                      Category="DataGrid"
                      BadgeText="High Performance"
                      RazorCode="@_razorSourceCode"
                      CSharpCode="@_csharpSourceCode"
                      CSharpTabName="VRowModel.cs">
    <Summary>
        <p>
            The <strong>Row Virtualization</strong> engine allows the FlexCore DataGrid to smoothly render and navigate thousands of records with near-zero memory footprint.
            Unlike conventional DOM renderers that instantiate all elements, FlexCore renders only the rows actively within the viewport plus a calibrated buffer window.
        </p>
        <p>
            This benchmark demonstrates <strong>1,000 fully editable records</strong> featuring diverse editor types (numeric, text, dropdown, checkbox), 
            <strong>multi-edit batching</strong> (select multiple rows and modify one cell to fan out changes across all selected rows), 
            live search bar filtering, type-to-search keyboard navigation, and interactive column grouping.
        </p>
    </Summary>

    <DemoControls>
        <div style="display:flex;gap:8px;align-items:center;font-size:13px;flex-wrap:wrap;">
            <strong>Grid Mode:</strong>
            <button class="btn btn-sm @(_mode == GridMode.Virtualized ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetMode(GridMode.Virtualized)">Virtualized (1,000 rows)</button>
            <button class="btn btn-sm @(_mode == GridMode.Paging ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetMode(GridMode.Paging)">Paging (25 / page)</button>
            <button class="btn btn-sm @(_mode == GridMode.Pivot ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetMode(GridMode.Pivot)">Pivot Engine</button>
            <span class="text-muted ms-2">Renders: <b>@_renderCount</b> | Last build: <b>@_lastBuildMs.ToString("0.0") ms</b></span>
        </div>
    </DemoControls>

    <DemoContent>
        <div style="width:100%;">
            <GridControl @ref="_grid"
                         ShowRowCountInFooter="true"
                         TValue="VRow"
                         DataSource="@_rows"
                         AllowSelection="true"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowColumnReorder="true"
                         AllowFiltering="true"
                         AllowGrouping="true"
                         ShowGroupCount="true"
                         ShowSearchBar="true"
                         Height="460px"
                         AllowPaging="@(_mode == GridMode.Paging)"
                         PageSize="@(_mode == GridMode.Paging ? 25 : 1000)"
                         AllowPivoting="@(_mode == GridMode.Pivot)"
                         ShowPivotPanelButton="@(_mode == GridMode.Pivot)"
                         ShowGridOptionsRail="@(_mode == GridMode.Pivot)"
                         EnableTypeSearch="true"
                         ShowRowSelectionEditColumnCue="true"
                         EditSettingsRef="@_editSettings"
                         SelectionSettingsRef="@_selectionSettings"
                         EventsRef="@_events">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(VRow.Code)" HeaderText="Code" Width="95px" AllowEditing="false" />
                    <GridColumn Field="@nameof(VRow.Description)" HeaderText="Description" Width="260px" AllowEditing="true" />
                    <GridColumn Field="@nameof(VRow.Category)" HeaderText="Category" Width="140px" AllowEditing="true" />
                    <GridColumn Field="@nameof(VRow.Qty)" HeaderText="Quantity" Width="95px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" />
                    <GridColumn Field="@nameof(VRow.Price)" HeaderText="Unit Price" Width="110px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" Format="$#,##0.00" />
                    <GridColumn Field="@nameof(VRow.Total)" HeaderText="Total Cost" Width="120px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="false" Format="$#,##0.00" />
                    <GridColumn Field="@nameof(VRow.InStock)" HeaderText="In Stock" Width="85px" Type="ColumnType.Boolean" TextAlign="TextAlign.Center" AllowEditing="true" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </DemoContent>

    <DocumentationContent>
        <h3>Key Virtualization Features Demonstrated</h3>
        <ul>
            <li><strong>DOM Windowing:</strong> Maintains consistent 60 FPS scrolling regardless of whether the dataset contains 100 rows or 50,000 rows.</li>
            <li><strong>Multi-Edit Fan-Out:</strong> Select multiple rows via Shift+Click or Ctrl+Click, then edit any value in the Quantity, Category, or In Stock columns. The change immediately batches across all selected records.</li>
            <li><strong>Zero External JS Footprint:</strong> Virtualization calculations run purely on .NET 10 WebAssembly or Blazor Server circuit with zero third-party JavaScript dependencies.</li>
        </ul>

        <h3>Core Configuration Properties</h3>
        <table class="sf-param-table">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Default</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>Height</code></td>
                    <td>string</td>
                    <td>"auto"</td>
                    <td>Explicit pixel or percentage height that activates row virtualization windowing.</td>
                </tr>
                <tr>
                    <td><code>WindowOverscanRows</code></td>
                    <td>int</td>
                    <td>260</td>
                    <td>Buffer rows maintained above and below the visible viewport to guarantee blank-free scrolling.</td>
                </tr>
                <tr>
                    <td><code>EnableTypeSearch</code></td>
                    <td>bool</td>
                    <td>true</td>
                    <td>Allows the operator to focus any non-editable column and immediately type characters to jump to matching records.</td>
                </tr>
                <tr>
                    <td><code>ShowSearchBar</code></td>
                    <td>bool</td>
                    <td>false</td>
                    <td>Enables the built-in search filter input to quickly query all columns simultaneously.</td>
                </tr>
            </tbody>
        </table>
    </DocumentationContent>
</SyncfusionDemoLayout>

@code {
    private enum GridMode { Virtualized, Paging, Pivot }

    public class VRow
    {
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Qty { get; set; }
        public decimal Price { get; set; }
        public decimal Total => Qty * Price;
        public bool InStock { get; set; }
    }

    private GridControl<VRow>? _grid;
    private List<VRow> _rows = [];
    private GridMode _mode = GridMode.Virtualized;
    private int _renderCount = 1;
    private double _lastBuildMs = 1.2;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly SelectionSettings _selectionSettings = new()
    {
        Mode = SelectionMode.Row,
        Type = SelectionType.Multiple
    };

    private readonly GridControlEvents<VRow> _events = new();

    protected override void OnInitialized()
    {
        _events.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<VRow>>(this, args =>
        {
            _renderCount++;
            StateHasChanged();
        });

        var categories = new[] { "Structural", "Mechanical", "Electrical", "Finishing", "Plumbing", "Masonry" };
        var list = new List<VRow>(1000);
        var rand = new Random(101);

        for (int i = 1; i <= 1000; i++)
        {
            var cat = categories[i % categories.Length];
            var qty = rand.Next(1, 150);
            var price = Math.Round((decimal)(rand.NextDouble() * 320 + 8.5), 2);
            list.Add(new VRow
            {
                Code = $"V-{i:D4}",
                Description = $"{cat} Material Component #{i}",
                Category = cat,
                Qty = qty,
                Price = price,
                InStock = (i % 3 != 0)
            });
        }
        _rows = list;
    }

    private void SetMode(GridMode mode)
    {
        var sw = Stopwatch.StartNew();
        _mode = mode;
        _renderCount++;
        sw.Stop();
        _lastBuildMs = sw.Elapsed.TotalMilliseconds;
    }

    private const string _razorSourceCode = @"@using Fx.ControlKit
@using Fx.ControlKit.Grid

<GridControl TValue=""VRow""
             DataSource=""@Rows""
             AllowSelection=""true""
             AllowSorting=""true""
             AllowResizing=""true""
             AllowColumnReorder=""true""
             AllowFiltering=""true""
             AllowGrouping=""true""
             ShowSearchBar=""true""
             Height=""460px""
             EnableTypeSearch=""true""
             ShowRowSelectionEditColumnCue=""true""
             EditSettingsRef=""@_editSettings""
             SelectionSettingsRef=""@_selectionSettings"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(VRow.Code)"" HeaderText=""Code"" Width=""95px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(VRow.Description)"" HeaderText=""Description"" Width=""260px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(VRow.Category)"" HeaderText=""Category"" Width=""140px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(VRow.Qty)"" HeaderText=""Quantity"" Width=""95px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(VRow.Price)"" HeaderText=""Unit Price"" Width=""110px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" AllowEditing=""true"" Format=""$#,##0.00"" />
        <GridColumn Field=""@nameof(VRow.Total)"" HeaderText=""Total Cost"" Width=""120px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" AllowEditing=""false"" Format=""$#,##0.00"" />
        <GridColumn Field=""@nameof(VRow.InStock)"" HeaderText=""In Stock"" Width=""85px"" Type=""ColumnType.Boolean"" TextAlign=""TextAlign.Center"" AllowEditing=""true"" />
    </GridColumnsBase>
</GridControl>

@code {
    private List<VRow> Rows { get; set; } = new();

    private readonly GridEditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = GridEditMode.Batch,
        BatchEditBehavior = GridBatchEditBehavior.SingleCell,
        AllowSingleCellColumnMassEdit = true
    };

    private readonly GridSelectionSettings _selectionSettings = new()
    {
        Mode = GridSelectionMode.Row,
        Type = GridSelectionType.Multiple
    };

    protected override void OnInitialized()
    {
        Rows = VRowModel.GenerateData(1000);
    }
}";

    private const string _csharpSourceCode = @"namespace FlexCore.Showcase.Models;

public class VRow
{
    public string Code { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public string Category { get; set; } = string.Empty;
    public decimal Qty { get; set; }
    public decimal Price { get; set; }
    public decimal Total => Qty * Price;
    public bool InStock { get; set; }

    public static List<VRow> GenerateData(int count)
    {
        var categories = new[] { ""Structural"", ""Mechanical"", ""Electrical"", ""Finishing"", ""Plumbing"", ""Masonry"" };
        var list = new List<VRow>(count);
        var rand = new Random(42);

        for (int i = 1; i <= count; i++)
        {
            var cat = categories[i % categories.Length];
            var qty = rand.Next(1, 150);
            var price = Math.Round((decimal)(rand.NextDouble() * 320 + 8.5), 2);
            list.Add(new VRow
            {
                Code = $""V-{i:D4}"",
                Description = $""{cat} Material Component #{i}"",
                Category = cat,
                Qty = qty,
                Price = price,
                InStock = (i % 3 != 0)
            });
        }
        return list;
    }
}";
}
