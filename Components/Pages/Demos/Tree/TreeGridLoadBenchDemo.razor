    protected override void OnInitialized()
    {
        GenerateTree();
    }

    private void SetScale(int suppliers)
    {
        _supplierCount = suppliers;
        _servicesPerSupplier = suppliers switch { 30 => 6, 60 => 8, _ => 4 };
        _last = null;
        GenerateTree();
    }

    // Supplier s takes pattern s % 8 and the city s / 8, so the first eight suppliers are Lisbon's, the next eight Amalfi's, and
    // sixty are distinct. The seed fixes the rates and bookings, so a size gives the same list on every rebuild.
    private void GenerateTree()
    {
        var list = new List<SupplierNode>();
        var rand = new Random(33);

        for (int s = 0; s < _supplierCount; s++)
        {
            var city = TravelData.Destinations[(s / _catalog.Length) % TravelData.Destinations.Length].City;
            var (pattern, category, services) = _catalog[s % _catalog.Length];
            var supplierId = $"S-{s + 1:D3}";
            var bookings = 0;

            var serviceNodes = new List<SupplierNode>();
            for (int v = 0; v < _servicesPerSupplier; v++)
            {
                var (description, unit, low, high) = services[v % services.Length];
                var booked = rand.Next(0, 80);
                bookings += booked;
                serviceNodes.Add(new SupplierNode
                {
                    Id = $"{supplierId}-{v + 1:D2}",
                    ParentId = supplierId,
                    Name = description,
                    Category = category,
                    Level = 2,
                    IsSupplier = false,
                    Unit = unit,
                    Rate = Math.Round(low + (decimal)rand.NextDouble() * (high - low), 2),
                    Bookings = booked
                });
            }

            list.Add(new SupplierNode
            {
                Id = supplierId,
                ParentId = null,
                Name = string.Format(pattern, city),
                Category = category,
                Level = 1,
                IsSupplier = true,
                ServiceCount = _servicesPerSupplier,
                Bookings = bookings
            });

            list.AddRange(serviceNodes);
        }

        _treeNodes = list;
        _treeGeneration++;
    }

    private bool TreatAsParent(SupplierNode node) => node.IsSupplier;

    // Org chart (moved here from Four scenarios, 2026-10-23): a department filter keeps the manager chain so the tree stays rooted.
    private readonly List<EmployeeRow> _people = BenchDataStore.GetHrHierarchy();
    private List<EmployeeRow> _shown = BenchDataStore.GetHrHierarchy();
    private readonly SelectionItem[] _deptItems = { new("All", "Everyone"), new("Engineering", "Engineering"), new("Executive", "Executive"), new("Human Resources", "HR"), new("Product", "Product"), new("Sales", "Sales") };
    private string _dept = "All";
    private int _orgGeneration = 1;   // @key: a new value remounts the tree grid when the list is swapped

    private string OrgStatus => $"{_shown.Count} of {_people.Count} people shown; {_shown.Count(p => p.IsManager)} managers.";

    private void ShowDepartment(IReadOnlyList<string> values)
    {
        if (values.Count == 0) return;
        _dept = values[0];
        if (_dept == "All")
        {
            _shown = _people.ToList();
        }
        else
        {
            var keep = _people.Where(p => p.Department == _dept).Select(p => p.EmployeeID).ToHashSet();
            foreach (var id in keep.ToList())
            {
                var current = _people.FirstOrDefault(p => p.EmployeeID == id);
                while (current?.ReportsToID is { } managerId && keep.Add(managerId))
                    current = _people.FirstOrDefault(p => p.EmployeeID == managerId);
            }
            _shown = _people.Where(p => keep.Contains(p.EmployeeID)).ToList();
        }
        _orgGeneration++;
    }

