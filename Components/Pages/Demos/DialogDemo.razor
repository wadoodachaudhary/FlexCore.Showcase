@page "/demo/dialog"
@using FlexCore.Showcase.Components.Shared
@using Fx.ControlKit.Dialogs
@inject IDialogService Dialogs

@* 2026-10-12: rebuilt on FeatureDemoLayout (was an ad hoc page with two dialogs and a static snippet); three
   examples per the up-to-3 rule, the classic look is a switch on the first.
   Facts checked against DialogControl.razor, DialogControl.razor.css, DefaultButtonScope.cs and
   Dialogs/* in FlexCore 0.2.48. The dialog service needs DialogService registered (Program.cs) and one
   DialogHostControl in MainLayout; both were added with this page. *@

<PageTitle>Dialogs — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Dialogs" Category="Components" ControlName="DialogControl"
                   Tagline="A movable, resizable window with a default button, plus message boxes and prompts you can await."
                   SourcePath="DialogControl.razor; Dialogs/MessageBoxControl.razor; Dialogs/IDialogService.cs">
    <Overview>
        <p>
            <code>DialogControl</code> is a window: a title bar with a close icon, a body, an optional footer. It drags by its title bar,
            resizes from eight handles, and is modal (page dimmed and blocked) or non-modal (page stays live). Enter can fire a default
            button, Escape closes, and a right-click on the title bar opens a Win32-style system menu. <code>CssClass="fx-dialog-classic"</code>
            gives it the classic frame for migrated VB6 forms.
        </p>
        <p>
            <code>MessageBoxControl</code> and <code>InputDialogControl</code> are built on it, and <code>IDialogService</code> wraps both so any
            component can <code>await</code> a confirm, alert or prompt in place of the browser's own.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="modal" Title="Modal dialog with a default button" RazorCode="@Code.Modal" CSharpCode="@Code.ModalCs">
            <Description><p><code>@@bind-Visible</code> opens and closes it. <code>FooterContent</code> holds the buttons. <code>OnEnter</code> makes Archive the default button: Enter anywhere in the dialog fires it. Escape and the close icon cancel. The switch applies <code>fx-dialog-classic</code>, the Win32 frame for migrated VB6 forms.</p></Description>
            <Controls>
                <ToggleButtonControl @bind-Selected="_classic">Classic look</ToggleButtonControl>
            </Controls>
            <Demo>
                <div class="demo-row">
                    <ButtonControl CssClass="btn-primary" OnClick="@(() => _archiveOpen = true)">Open dialog</ButtonControl>
                    <span class="result">@_archiveResult</span>
                </div>
                @* Classic: the frame class, the window icon, classic buttons; .dlg-host lets page CSS grey the footer. *@
                <div class="dlg-host">
                    <DialogControl @bind-Visible="_archiveOpen" Header="Archive project" Width="440px" OnEnter="Archive"
                                   CssClass="@(_classic ? "fx-dialog-classic" : null)" ShowWindowIcon="@_classic">
                        <ChildContent>
                            <p class="dlg-text">Archive <strong>Northwind rewrite</strong>? Members keep read access; nothing is deleted.</p>
                        </ChildContent>
                        <FooterContent>
                            <ButtonControl CssClass="@(_classic ? "fx-button-classic" : "btn-primary")" OnClick="Archive">Archive</ButtonControl>
                            <ButtonControl CssClass="@(_classic ? "fx-button-classic" : "btn-secondary")" OnClick="@(() => _archiveOpen = false)">Cancel</ButtonControl>
                        </FooterContent>
                    </DialogControl>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="window" Title="Non-modal window" RazorCode="@Code.Window" CSharpCode="@Code.WindowCs">
            <Description><p><code>IsModal="false"</code> leaves the page live. Width, height and position bind two ways, so a drag or resize reports back. <code>ShowWindowIcon</code> adds the icon that opens the system menu.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl CssClass="btn-primary" OnClick="@(() => _winOpen = true)">Open window</ButtonControl>
                    <ButtonControl OnClick="@(() => _pageClicks++)">Page click (@_pageClicks)</ButtonControl>
                    <span class="result">@_winWidth × @_winHeight, @(_winPos is null ? "centred" : $"moved {_winPos.X:0}, {_winPos.Y:0}")</span>
                </div>
                <DialogControl @bind-Visible="_winOpen" Header="Inspector" IsModal="false" ShowWindowIcon="true"
                               @bind-Width="_winWidth" @bind-Height="_winHeight" @bind-Position="_winPos"
                               MinResizeWidth="360" MinResizeHeight="200">
                    <p class="dlg-text">Drag the title bar, resize from any edge or corner, right-click the title for the window menu. The page behind stays clickable.</p>
                </DialogControl>
            </Demo>
        </DemoExample>

        <DemoExample Id="service" Title="Message box, prompt and the dialog service" RazorCode="@Code.Service" CSharpCode="@Code.ServiceCs">
            <Description><p><code>IDialogService</code> replaces <code>window.confirm</code>, <code>alert</code> and <code>prompt</code>: inject it anywhere and await the answer. A page can also own a <code>MessageBoxControl</code> and call <code>ShowAsync</code> for an icon, the .NET look, or a confirmation checkbox.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl OnClick="Confirm">Confirm</ButtonControl>
                    <ButtonControl OnClick="Prompt">Prompt</ButtonControl>
                    <ButtonControl OnClick="Alert">Alert</ButtonControl>
                    <ButtonControl OnClick="AskDotNet">Yes / No / Cancel, .NET look</ButtonControl>
                    <ButtonControl CssClass="btn-danger" OnClick="GatedDelete">Gated delete</ButtonControl>
                    <span class="result">@_answer</span>
                </div>
                <MessageBoxControl @ref="_box" />
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="DialogControl parameters" Rows="Vocab.Dialog" />
        <ApiTable Kind="ApiKind.Methods" Title="IDialogService" Rows="Vocab.Service" />
        <ApiTable Kind="ApiKind.Parameters" Title="MessageBoxControl parameters" Rows="Vocab.MessageBox" />
        <ApiTable Kind="ApiKind.Parameters" Title="InputDialogControl parameters" Rows="Vocab.Input" />
        <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
        <p class="note">Enums: <code>MessageBoxButtons</code> Ok, OkCancel, YesNo, YesNoCancel · <code>MessageBoxResult</code> Ok, Cancel, Yes, No · <code>MessageBoxLook</code> VB6, DotNet · <code>DialogPosition(X, Y)</code> is the offset from centre in CSS pixels.</p>
        <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
        <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>The dialog has <code>role="dialog"</code>, <code>aria-modal</code> when modal, and is labelled by <code>Header</code> or <code>AriaLabel</code>; <code>AriaDescribedBy</code> points at a description.</li>
            <li><code>AutoFocus</code> moves focus to the first focusable control on open; focus returns to the opener on close.</li>
            <li>Escape closes, or runs <code>OnEscape</code> when set. Alt+F4 closes. Ctrl+Enter closes when <code>CloseOnCtrlEnter</code> is on. Enter fires <code>OnEnter</code> unless the focused control keeps the key.</li>
            <li>The system menu (right-click on the title bar, or the window icon) offers Move and Close; Restore, Size, Minimize and Maximize are listed but disabled.</li>
            <li>Message box: Escape closes, Enter picks the default button, Arrow keys and Tab move between the buttons.</li>
            <li>The dialog imports the library's own <code>dialog-control.js</code> for focus capture and restore, Escape and Ctrl+Enter capture, and size measurement. No third-party script.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Buttons used in footers, and <code>DefaultButtonScope</code>: <a href="demo/buttons">Buttons</a>.</li>
            <li>Non-blocking messages: <a href="demo/notifications">Toasts</a>.</li>
            <li><code>MultiLineEditControl</code>, the long-text prompt grids open from a cell: see the Methods table; no live demo yet.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Modal
    private bool _archiveOpen, _classic;
    private string? _archiveResult;
    private void Archive() { _archiveOpen = false; _archiveResult = $"Archived at {DateTime.Now:HH:mm:ss}"; }

    // Window
    private bool _winOpen;
    private int _pageClicks;
    private string? _winWidth = "480px", _winHeight = "240px";
    private DialogPosition? _winPos;

    // Service and message box
    private MessageBoxControl? _box;
    private string? _answer;
    private async Task Confirm() => _answer = await Dialogs.ConfirmAsync("Delete 3 rows?", "Confirm") ? "Yes" : "No";
    private async Task Prompt()
    {
        var name = await Dialogs.PromptAsync("Project name:", "New project", "Untitled");
        _answer = name is null ? "Cancelled" : $"Named \"{name}\"";
    }
    private Task Alert() => Dialogs.AlertAsync("Export finished. 240 rows written.", "Export");
    private async Task AskDotNet() =>
        _answer = (await _box!.ShowAsync("Save changes to Report.docx?", "Editor", MessageBoxButtons.YesNoCancel, "question", MessageBoxLook.DotNet)).ToString();
    private async Task GatedDelete() =>
        _answer = (await _box!.ShowAsync("Delete the project and its 14 files?", "Delete project", MessageBoxButtons.OkCancel, "warning", null, "I understand this cannot be undone")).ToString();

