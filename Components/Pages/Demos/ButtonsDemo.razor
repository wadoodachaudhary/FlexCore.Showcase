@page "/demo/buttons"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: moved onto FeatureDemoLayout and cut from ten sections to five examples
   (reader feedback: too busy). Busy/focus, form types, BareStyle, Save/Cancel and Toolbar
   demos removed; the parameters stay in the vocabulary. Uses only CSS shipped in FlexCore 0.2.48. *@

<PageTitle>Buttons — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Buttons" Category="Components" ControlName="ButtonControl"
                   Tagline="One native button, styled through CSS variables, with an optional dropdown."
                   SourcePath="ButtonControl.razor">
    <Overview>
        <p>
            <code>ButtonControl</code> renders one <code>&lt;button&gt;</code>. Variants are CSS classes, colors come
            from <code>--fx-btn-*</code> variables, and any attribute it does not recognise is forwarded to the element.
            Give it <code>DropDownContent</code> and it becomes a popup trigger that closes on click-away without JavaScript.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="variants" Title="Variants" RazorCode="@Code.Variants">
            <Description><p>The default look comes from the theme variables. Add one <code>btn-*</code> class for a semantic color.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl>Default</ButtonControl>
                    <ButtonControl CssClass="btn-primary">Primary</ButtonControl>
                    <ButtonControl CssClass="btn-secondary">Secondary</ButtonControl>
                    <ButtonControl CssClass="btn-success">Success</ButtonControl>
                    <ButtonControl CssClass="btn-danger">Danger</ButtonControl>
                    <ButtonControl CssClass="btn-outline-primary">Outline</ButtonControl>
                    <ButtonControl CssClass="btn-primary" Disabled="true">Disabled</ButtonControl>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="icons" Title="Icons and sizes" RazorCode="@Code.Icons">
            <Description><p><code>IconCss</code> renders a leading icon; a trailing icon is ordinary content. <code>btn-sm</code> and <code>btn-lg</code> change padding and font size. Icon-only buttons need <code>Title</code> and <code>aria-label</code>.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl CssClass="btn-primary btn-sm" IconCss="bi bi-plus">Small</ButtonControl>
                    <ButtonControl CssClass="btn-primary" IconCss="bi bi-plus-lg">New</ButtonControl>
                    <ButtonControl CssClass="btn-primary btn-lg" IconCss="bi bi-plus">Large</ButtonControl>
                    <ButtonControl CssClass="btn-outline-primary">Next <span class="bi bi-arrow-right"></span></ButtonControl>
                    <ButtonControl CssClass="btn-secondary" IconCss="bi bi-gear" Title="Settings" aria-label="Settings" />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="dropdown" Title="Dropdown button" RazorCode="@Code.Dropdown" CSharpCode="@Code.DropdownCs">
            <Description><p>Set <code>DropDownContent</code> and the button toggles a panel beneath itself. A backdrop element closes it on click-away. Call <code>CloseDropDown()</code> after a pick.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl @ref="_export" CssClass="btn-primary" IconCss="bi bi-download" DropDownCssClass="menu">
                        <ChildContent>Export <span class="bi bi-caret-down-fill dd-caret"></span></ChildContent>
                        <DropDownContent>
                            @foreach (var fmt in new[] { "Excel (.xlsx)", "CSV", "PDF" })
                            {
                                <ButtonControl BareStyle="true" CssClass="menu-item" OnClick="@(() => Pick(fmt))">@fmt</ButtonControl>
                            }
                        </DropDownContent>
                    </ButtonControl>
                    @if (_picked is not null) { <span class="result">Exporting as @_picked</span> }
                </div>
            </Demo>
        </DemoExample>

        @* Palettes copied from flexkit-themes.css onto wrappers; the file itself is not loaded. *@
        <DemoExample Id="theme" Title="Theme with CSS variables" RazorCode="@Code.Theme" CssCode="@Code.ThemeCss">
            <Description><p>Default buttons read <code>--fx-btn-*</code>. Set the variables on any ancestor to retheme that region; no markup changes.</p></Description>
            <Demo>
                <div class="demo-row">
                    <div class="theme theme-classic">
                        <span class="theme-name">Classic (Win32)</span>
                        <div class="demo-row"><ButtonControl>OK</ButtonControl><ButtonControl>Cancel</ButtonControl><ButtonControl Disabled="true">Apply</ButtonControl></div>
                    </div>
                    <div class="theme theme-dark">
                        <span class="theme-name">Dark</span>
                        <div class="demo-row"><ButtonControl>OK</ButtonControl><ButtonControl>Cancel</ButtonControl><ButtonControl Disabled="true">Apply</ButtonControl></div>
                    </div>
                </div>
            </Demo>
        </DemoExample>

        @* Anchors #toggle #group #split #pill are catalog targets. *@
        <DemoExample Id="family" Title="Related controls" RazorCode="@Code.Family" CSharpCode="@Code.FamilyCs">
            <Description><p>Each builds on <code>ButtonControl</code> or shares its styling contract.</p></Description>
            <Demo>
                <div class="demo-row fam-row">
                    <div class="fam" id="toggle">
                        <span class="theme-name">ToggleButtonControl</span>
                        <div class="demo-row">
                            <ToggleButtonControl @bind-Selected="_bold" IconCss="bi bi-type-bold" Title="Bold" aria-label="Bold" />
                            <ToggleButtonControl @bind-Selected="_italic" IconCss="bi bi-type-italic" Title="Italic" aria-label="Italic" />
                        </div>
                    </div>
                    <div class="fam" id="group">
                        <span class="theme-name">ButtonGroupControl</span>
                        <ButtonGroupControl Items="_alignItems" @bind-Values="_align" Selection="ChoiceSelectionMode.Single" AriaLabel="Text alignment" />
                    </div>
                    <div class="fam" id="split">
                        <span class="theme-name">SplitButtonControl</span>
                        <div class="demo-row">
                            <SplitButtonControl Text="Save" IconCss="bi bi-save" Items="_splitItems"
                                                OnClick="@(() => _msg = "Saved")" OnItemClick="@(i => _msg = i.Text)" />
                            @if (_msg is not null) { <span class="result">@_msg</span> }
                        </div>
                    </div>
                    <div class="fam" id="pill">
                        <span class="theme-name">RoundedButtonControl</span>
                        <div class="demo-row">
                            <RoundedButtonControl Variant="accent">accent</RoundedButtonControl>
                            <RoundedButtonControl Variant="danger" IconCss="bi bi-exclamation-triangle">danger</RoundedButtonControl>
                        </div>
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <ApiTable Kind="ApiKind.Parameters" Title="Parameters" Rows="Vocab.Parameters" />
        <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
        <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
        <ApiTable Kind="ApiKind.CssVariables" Title="CSS variables" Rows="Vocab.Vars" />
    </Vocabulary>

    <Accessibility>
        <ul>
            <li>Renders a real <code>&lt;button&gt;</code>: Space and Enter activate it, it takes part in forms, and screen readers announce its role.</li>
            <li>Icon-only buttons need <code>Title</code> plus <code>aria-label</code>; the icon span carries no text.</li>
            <li>Dropdown mode sets <code>aria-haspopup</code> and <code>aria-expanded</code>.</li>
            <li><code>ToggleButtonControl</code> and <code>ButtonGroupControl</code> emit <code>aria-pressed</code>; the group moves focus with Arrow, Home and End.</li>
            <li>Inside <code>DialogControl</code>, Enter fires the default button through <code>DefaultButtonScope</code>; a control that needs Enter for itself calls <code>ConsumeEnter()</code>.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li><code>SaveButtonControl</code> and <code>CancelButtonControl</code> are presets of this control.</li>
            <li>Own pages: <a href="demo/split-button">Split button</a>, <a href="demo/toggle-buttons">Toggle buttons</a> (ToggleButtonControl and ButtonGroupControl), <a href="demo/fab">Floating action button</a>.</li>
            <li><code>ToolbarControl</code> and <code>ToolbarButtonControl</code>: <a href="demo/counterparts">Control tour</a>.</li>
            <li>Default button on Enter: <a href="demo/dialog">Dialogs</a>.</li>
            <li><code>RibbonControl</code>: <a href="">home page</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

