            new("Error(message, detail?, durationMs = 10000)", "Red toast. <code>durationMs: 0</code> keeps it until dismissed.", "void"),
            new("Dismiss(Guid id)", "Removes one toast, such as a progress message. The add methods return nothing, so read the new toast's <code>Id</code> from <code>Notifications</code>.", "void"),
            new("Clear()", "Removes every toast.", "void"),
            new("Notifications", "Current toasts, newest first, at most 20.", "IReadOnlyList&lt;Notification&gt;"),
            new("OnChange", "Raised after every add, dismiss or clear. Auto-dismiss raises it from a timer thread; marshal with <code>InvokeAsync</code>.", "event Action"),
        };
        public static readonly ApiRow[] Item =
        {
            new("Id", "Key for <code>Dismiss</code>.", "Guid"),
            new("Level", "Info, Success, Warning or Error.", "NotificationLevel"),
            new("Message", "Bold first line.", "string"),
            new("Detail", "Smaller second line.", "string?", "null"),
            new("Timestamp", "When it was added.", "DateTime"),
            new("DurationMs", "Auto-dismiss delay; 0 means sticky.", "int"),
        };
        public static readonly ApiRow[] Css =
        {
            new("fx-notification-container", "Fixed 12px from the top-right, 320–420px wide, z-index 10000, column with 8px gaps."),
            new("fx-notification · .fx-notification-info / -success / -warning / -error", "One toast; the level class sets the tinted background, text color and 4px left border. It slides in from the right over 0.25s."),
            new("fx-notification-icon · fx-notification-body · fx-notification-message · fx-notification-detail", "Icon glyph, text column, bold message, 11px detail at 80% opacity."),
            new("fx-notification-close", "The × button, 50% opacity until hovered."),
        };
    }

    // Code tabs are verbatim
    private static class Code
    {
        public const string Levels = @"<div class=""nt"">
    <div class=""demo-row"">
        <ButtonControl CssClass=""btn-primary"" OnClick=""@(() => Notifications.Info(""Pick list PICK-0318 assigned"", ""To Hermione Ranger, 12 lines""))"">Info</ButtonControl>
        <ButtonControl CssClass=""btn-success"" OnClick=""@(() => Notifications.Success(""Receipt for PO-2291 saved"", ""2 pallets, 48 cartons""))"">Success</ButtonControl>
        <ButtonControl CssClass=""btn-warning"" OnClick=""@(() => Notifications.Warning(""Bin A-12-03 is nearly full"", ""Room for 6 cartons, check before putaway""))"">Warning</ButtonControl>
        <ButtonControl CssClass=""btn-danger"" OnClick=""@(() => Notifications.Error(""Shipping label did not print"", ""Shipment SHP-0456 at Dock 4""))"">Error</ButtonControl>
        <ButtonControl CssClass=""btn-outline-primary"" OnClick=""@(() => Notifications.Error(""Pickup for shipment SHP-0457 was canceled"", ""Stays until you close it"", durationMs: 0))"">Sticky error</ButtonControl>
        <ButtonControl OnClick=""@(() => Notifications.Clear())"">Clear all</ButtonControl>
    </div>
    <p class=""result"" role=""status"">@(_count == 0 ? ""No toasts showing."" : $""{_count} showing, newest on top."")</p>
</div>";
        public const string LevelsCs = @"// Levels: the page listens to the service to count the toasts on show
// The page declares @inject NotificationService Notifications (namespace Fx.ControlKit.Notifications)
// and @implements IDisposable, so Dispose() below runs and unhooks OnChange.
private int _count;
protected override void OnInitialized()
{
    Notifications.OnChange += HandleChange;   // auto-dismiss fires off the render thread
    _count = Notifications.Notifications.Count;
}
private void HandleChange() => _ = InvokeAsync(() => { _count = Notifications.Notifications.Count; StateHasChanged(); });
public void Dispose() => Notifications.OnChange -= HandleChange;";
        public const string Task = @"<div class=""nt"">
    <div class=""demo-row"">
        <ButtonControl CssClass=""btn-primary"" IconCss=""bi bi-save"" Disabled=""_saving"" OnClick=""SaveAsync"">Save receipt</ButtonControl>
        <SwitchControl @bind-Checked=""_failSaves"" Label=""Make saves fail"" />
    </div>
