@page "/"
@inject IJSRuntime JS
@inject NotificationService Notifications
@inject IReportDataExecutor ReportData

@* 2026-10-23 (developer meeting point 5, chart label clutter): the Inventory Allocation pie has four slices instead of five so its
   legend, an HTML flex row of 12 px entries about 100 px wide with 12 px gaps, stays on one line in the 575 px column at 1280 px
   ("Finishes (8%)" wrapped to a second row); the shares are rebalanced to 40/25/20/15. The pie draws no slice labels, so the
   share stays in the legend text. The "charts" string in the code tab below is kept by hand and still matches the markup. *@

@* 2026-10-25 (Baaria, SC-344): the hero grid is a travel agency's quote desk, Inbox — Trip Requests. It replaced an example whose
   banner text, columns and names came from an earlier custom-quote inbox. Same grid features as before (1,000 windowed rows, frozen
   key column, in-cell DropDownGridControl lookup, fast-typing money cell, SVG sparkline, badges, popup editor); two buttons that only
   raised a notification now do their job: Export to Excel calls the grid's ExportToXlsxAsync, New Request opens the editor on a blank
   request and adds it on Save. The "grid" string in the code tab is the GridControl block below, copied verbatim (scratchpad
   home_inbox.py regenerates it). *@

@* 2026-10-25 (Baaria: "not very interactive"): the dropdown, Edit button and header sort all worked, but on the live site each
   answered in 0.4 to 1.6 s with no sign of life, and a second click undid the first (closed the list, flipped the sort). The grid
   rendered about 144 rows (8 columns, so the default 60-row overscan per side), each with its own DropDownGridControl; WindowOverscanRows
   is now 15, about 42 rows. Trip type, Fare trend and Itinerary had no Field, so their headers could not sort; they now sort by
   TripType, FareDeltaPercent and Itinerary. Headers lost their "(DropDownGrid)" style suffixes so the sort arrow fits; the feature
   cards above the grid name the controls. Rows get an opaque background in app.css: frozen cells use background-color: inherit,
   and a row with no background let the scrolled cells show through the Request column. *@

<PageTitle>FlexCore — Enterprise Blazor Component Suite for .NET</PageTitle>

<div class="landing-container">
    <!-- ── 1. Catchy One-Liner Before Grid ────────────────────────── -->
    <div class="top-hero-compact">
        <div class="hero-tagline-badge">
            <span class="badge-pulse"></span>
            <span>FlexCore v@_flexCoreVersion &bull; .NET 10 &bull; Rendered in C# and SVG &bull; No npm</span>
        </div>
        <h1 class="hero-oneliner">
            Enterprise Blazor data grid with row windowing for large datasets, in-grid editing and built-in Excel export.
        </h1>
    </div>

    <!-- ── 2. Grid Brought Right to the Top ───────────────────────── -->
    <section id="live-showcase" class="showcase-section">
        <div class="showcase-shell">
            <!-- Window titlebar (desktop app style) -->
            <div class="window-titlebar">
                <div class="window-controls">
                    <span class="window-dot dot-red"></span>
                    <span class="window-dot dot-yellow"></span>
                    <span class="window-dot dot-green"></span>
                </div>
                <div class="window-title">
                    <span class="bi bi-window-sidebar"></span>
                    <span>Inbox — Trip Requests</span>
                </div>
                <div class="window-tags">
                    <span>FlexCore Grid v@_flexCoreVersion • .NET 10 • 1,000 Rows Virtualized</span>
                </div>
            </div>

            <!-- Hint Subtitle Banner -->
            <div class="grid-banner-hint">
                <span class="bi bi-info-circle-fill" style="color: #0284c7;"></span>
                <span><strong>Quote desk:</strong> trip requests arrive from the booking site. Double-click a request to open the quote editor, or type a quote straight into the grid.</span>
            </div>

            <!-- Showcase Top Bar / Tabs -->
            <div class="showcase-header">
                <div class="showcase-tabs">
                    <button type="button" class="@($"tab-btn {(_activeTab == "grid" ? "active" : "")}")" @onclick="@(() => _activeTab = "grid")">
                        <span class="bi bi-table"></span> FlexGrid (Trip Requests)
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "charts" ? "active" : "")}")" @onclick="@(() => _activeTab = "charts")">
                        <span class="bi bi-bar-chart-line"></span> 30+ SVG Charts
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "ribbon" ? "active" : "")}")" @onclick="@(() => _activeTab = "ribbon")">
                        <span class="bi bi-menu-button-wide"></span> Office Ribbon
                    </button>
                    <button type="button" class="@($"tab-btn {(_activeTab == "reports" ? "active" : "")}")" @onclick="@(() => _activeTab = "reports")">
                        <span class="bi bi-file-earmark-spreadsheet"></span> Enterprise Reporting
                    </button>
                </div>

                <div class="showcase-controls">
                    <TabStripControl Items="_viewTabs" SelectedIndex="@(_showCode ? 1 : 0)" SelectedIndexChanged="@(i => _showCode = i == 1)" CssClass="hero-view-tabs" />
                </div>
            </div>

            <!-- Showcase Active Tab Content -->
            <div class="showcase-body">
                @* 2026-10-24 (Baaria): the Razor code is a tab over the example, not a drawer under it. The live example stays
                   mounted while hidden, so the grid keeps its state when the reader switches back. *@
                @if (_showCode)
                {
                    <div class="code-drawer">
                        <div class="code-header">
                            <span>Razor markup for the @(_activeTab.ToUpper()) tab</span>
                            <button type="button" class="btn-copy-code" @onclick="CopyActiveCode">
                                @(_copiedCode ? "✓ Copied!" : "📋 Copy Code")
                            </button>
                        </div>
                        <pre><code>@GetActiveCodeSnippet()</code></pre>
                    </div>
                }
                <div class="@(_showCode ? "showcase-live is-hidden" : "showcase-live")">
                @if (_activeTab == "grid")
                {
                    <div class="grid-card-toolbar">
                        <div class="toolbar-left">
                            <div class="view-select-group">
                                <label class="view-label">View:</label>
                                <DropDownListControl TValue="string" TItem="ViewOption"
                                                     DataSource="@ViewOptions"
                                                     Value="@_selectedView"
                                                     ValueChanged="@(v => { _selectedView = v ?? "All"; StateHasChanged(); })"
                                                     TextFieldName="Label"
                                                     ValueFieldName="Key"
                                                     Width="210px"
                                                     CssClass="view-flex-dropdown" />
                            </div>

                            <div class="search-input-wrapper">
                                <span class="bi bi-search search-icon"></span>
                                <TextBoxControl Value="@_gridSearchTerm"
                                                ValueChanged="@(v => { _gridSearchTerm = v ?? ""; StateHasChanged(); })"
                                                placeholder="Search requests, destinations, agents..."
                                                CssClass="grid-search-input" UpdateOnInput="true" />
                            </div>
                        </div>

                        <div class="toolbar-right">
                            <button type="button" class="btn-grid-action btn-excel" @onclick="ExportToExcel">
                                <span class="bi bi-file-earmark-excel"></span> Export to Excel
                            </button>
                            <button type="button" class="btn-grid-action btn-new" @onclick="CreateNewRequest">
                                <span class="bi bi-plus-lg"></span> New Request
                            </button>
                        </div>
                    </div>

                    <div class="category-filter-bar">
                        <span class="filter-bar-label">Trip type:</span>
                        @foreach (var type in _tripTypes)
                        {
                            <button type="button"
                                    class="@($"btn-filter-pill {(_selectedTripType == type ? "active" : "")}")"
                                    @onclick="@(() => _selectedTripType = type)">
                                @type
                            </button>
                        }
                    </div>

                    <div class="grid-perf-highlights">
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">⚡</span>
                            <div class="perf-badge-text">
                                <strong>1,000 Rows Live Virtualized</strong>
                                <span>Only the rows in view plus an overscan band are rendered as you scroll</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">⌨️</span>
                            <div class="perf-badge-text">
                                <strong>Instant In-Grid Typing</strong>
                                <span>Click any Quote cell to type directly — keystrokes stay in the browser until commit</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">🎛️</span>
                            <div class="perf-badge-text">
                                <strong>DropDownGridControl</strong>
                                <span>Multi-column trip-type picker with search &amp; sort</span>
                            </div>
                        </div>
                        <div class="perf-badge-item">
                            <span class="perf-badge-icon">✏️</span>
                            <div class="perf-badge-text">
                                <strong>Modal Popup Editor</strong>
                                <span>Click [✏ Edit] on Itinerary for the full request editor</span>
                            </div>
                        </div>
                    </div>

                    <GridControl TValue="TripRequest" DataSource="@FilteredRequests"
                                 @ref="_grid"
                                 AllowSelection="true"
                                 AllowSorting="true"
                                 AllowFiltering="true"
                                 AllowResizing="true"
                                 EnableHover="true"
                                 CssClass="hero-grid-theme"
                                 EditSettingsRef="@_editSettings"
                                 EventsRef="@_gridEvents"
                                 WindowOverscanRows="15"
                                 Height="440px">
                        <GridColumnsBase>
                            <GridColumn Field="@nameof(TripRequest.Request)" HeaderText="Request" Width="100px"
                                        IsPrimaryKey="true" AllowEditing="false"
                                        IsFrozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                <Template Context="row">
                                    @{ var r = (TripRequest)row; }
                                    <BadgeControl Text="@r.Request" CssClass="grid-request-code" />
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(TripRequest.Agent)" HeaderText="Agent" Width="150px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var r = (TripRequest)row; }
                                    <div class="agent-cell">
                                        <span class="agent-avatar" style="background:@r.AvatarBg">@r.AvatarInitials</span>
                                        <span class="agent-name">@r.Agent</span>
                                    </div>
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(TripRequest.Destination)" HeaderText="Destination" Width="130px" AllowEditing="false" />

                            @* In-cell DropDownGridControl: a four-column lookup with search; the header sorts by the code *@
                            <GridColumn Field="@nameof(TripRequest.TripType)" HeaderText="Trip type" Width="170px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var r = (TripRequest)row; }
                                    <div class="grid-cell-dropdowngrid">
                                        <DropDownGridControl TItem="TripTypeLookup" TValue="string"
                                                             DataSource="@_tripTypeLookup"
                                                             Value="@r.TripType"
                                                             ValueChanged="@(val => OnTripTypeChanged(r, val))"
                                                             TextFieldName="@nameof(TripTypeLookup.Name)"
                                                             ValueFieldName="@nameof(TripTypeLookup.Code)"
                                                             ClosedTextFieldName="@nameof(TripTypeLookup.Code)"
                                                             PopupWidth="490px"
                                                             PopupHeight="220px"
                                                             RowHeight="24"
                                                             ShowSearch="true"
                                                             SearchPlaceholder="Search trip types..."
                                                             AllowClear="false"
                                                             Placeholder="Select trip type...">
                                            <Columns>
                                                <GridColumn Field="@nameof(TripTypeLookup.Code)" HeaderText="Code" Width="95px" />
                                                <GridColumn Field="@nameof(TripTypeLookup.Name)" HeaderText="Trip type" Width="165px" />
                                                <GridColumn Field="@nameof(TripTypeLookup.Desk)" HeaderText="Desk" Width="90px" />
                                                <GridColumn Field="@nameof(TripTypeLookup.LeadTime)" HeaderText="Book ahead" Width="110px" />
                                            </Columns>
                                        </DropDownGridControl>
                                    </div>
                                </Template>
                            </GridColumn>

                            @* Fast typing: click the cell and type, the value commits on Enter or blur *@
                            <GridColumn Field="@nameof(TripRequest.Quote)" HeaderText="Quote" Width="130px"
                                        Type="ColumnType.Number" Format="C2" TextAlign="TextAlign.Right"
                                        AllowEditing="true" SelectAllOnEdit="true" />

                            @* Inline SVG sparkline: five weekly fare samples for the route, the last one is the quote; the header sorts by the change *@
                            <GridColumn Field="@nameof(TripRequest.FareDeltaPercent)" HeaderText="Fare trend" Width="135px" AllowFiltering="false" AllowEditing="false">
                                <Template Context="row">
                                    @{
                                        var r = (TripRequest)row;
                                        var spark = GetSparklinePoints(r.FareHistory, 68, 22);
                                        var isUp = r.FareDeltaPercent >= 0;
                                        var color = isUp ? "#10b981" : "#ef4444";
                                        var fill = isUp ? "rgba(16, 185, 129, 0.16)" : "rgba(239, 68, 68, 0.16)";
                                        var deltaClass = isUp ? "delta-up" : "delta-down";
                                        var titleText = $"5-week fare trend: {(isUp ? "+" : "")}{r.FareDeltaPercent}%";
                                        var deltaSign = isUp ? "▲" : "▼";
                                    }
                                    <div class="sparkline-cell" title="@titleText">
                                        <svg width="68" height="22" viewBox="0 0 68 22" class="sparkline-svg">
                                            <polygon points="@spark.AreaPoints" fill="@fill" />
                                            <polyline points="@spark.PolylinePoints" fill="none" stroke="@color" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                            <circle cx="@spark.LastX" cy="@spark.LastY" r="2.5" fill="@color" />
                                        </svg>
                                        <span class="sparkline-delta @deltaClass">
                                            @deltaSign@Math.Abs(r.FareDeltaPercent)%
                                        </span>
                                    </div>
                                </Template>
                            </GridColumn>

                            <GridColumn Field="@nameof(TripRequest.Status)" HeaderText="Status" Width="110px" AllowEditing="false">
                                <Template Context="row">
                                    @{
                                        var r = (TripRequest)row;
                                        var statusBadge = GetStatusBadgeClass(r.Status);
                                    }
                                    <BadgeControl Text="@r.Status" CssClass="@($"grid-badge {statusBadge}")" />
                                </Template>
                            </GridColumn>

                            @* The Edit button opens the popup editor; a double-click on the row does the same *@
                            <GridColumn Field="@nameof(TripRequest.Itinerary)" HeaderText="Itinerary" Width="300px" AllowEditing="false">
                                <Template Context="row">
                                    @{ var r = (TripRequest)row; }
                                    <div class="desc-cell-wrapper">
                                        <span class="desc-text" title="@r.Itinerary">@r.Itinerary</span>
                                        <button type="button" class="btn-cell-popup-edit" title="Edit in Modal Popup"
                                                @onclick="@(() => OpenPopupEdit(r))" @onclick:stopPropagation="true">
                                            <span class="bi bi-pencil-square"></span> Edit
                                        </button>
                                    </div>
                                </Template>
                            </GridColumn>
                        </GridColumnsBase>
                    </GridControl>

                    <div class="grid-status-footer">
                        <div class="status-left">
                            <span>Showing <strong>@FilteredRequests.Count()</strong> of <strong>@_requests.Count</strong> requests</span>
                            @if (_selectedRequest != null)
                            {
                                <span class="status-selected-highlight">
                                    • Selected: <strong>@_selectedRequest.Request</strong> (@_selectedRequest.Destination) — <strong>@_selectedRequest.Quote.ToString("C2")</strong>
                                </span>
                            }
                        </div>
                        <div class="status-right">
                            <span>Total quoted: <strong>@FilteredRequests.Sum(r => r.Quote).ToString("C2")</strong></span>
                        </div>
                    </div>

                    @if (_isPopupEditorOpen && _editingRequest != null)
                    {
                        <div class="modal-backdrop-blur" @onclick="ClosePopupEdit">
                            <div class="edit-modal-card" @onclick:stopPropagation="true">
                                <div class="modal-card-header">
                                    <div class="modal-header-titles">
                                        <BadgeControl Text="@(_isNewRequest ? "New" : _editingRequest.Request)" CssClass="modal-badge-request" />
                                        <div>
                                            <h3 class="modal-h3">@(_isNewRequest ? "New Trip Request" : "Edit Trip Request")</h3>
                                            <p class="modal-sub">@(_isNewRequest ? "Fill in the request, then Add" : $"{_editingRequest.Traveller} • {_editingRequest.Destination}")</p>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close-modal" @onclick="ClosePopupEdit" title="Close">&times;</button>
                                </div>

                                <div class="modal-card-body">
                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Agent</label>
                                            <TextBoxControl CssClass="modal-input" Value="@_editingRequest.Agent" ValueChanged="@(v => _editingRequest.Agent = v ?? "")" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Destination</label>
                                            <TextBoxControl CssClass="modal-input" Value="@_editingRequest.Destination" ValueChanged="@(v => _editingRequest.Destination = v ?? "")" />
                                        </div>
                                    </div>

                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Lead traveller</label>
                                            <TextBoxControl CssClass="modal-input" Value="@_editingRequest.Traveller" ValueChanged="@(v => _editingRequest.Traveller = v ?? "")" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Travellers</label>
                                            <NumericTextBoxControl TValue="int" Min="1" Max="12" Width="100%" CssClass="modal-input" Value="@_editingRequest.Travellers" ValueChanged="@(v => _editingRequest.Travellers = v)" />
                                        </div>
                                    </div>

                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Trip type</label>
                                            <DropDownListControl TValue="string" TItem="TripTypeLookup"
                                                                 Width="100%"
                                                                 DataSource="@_tripTypeLookup"
                                                                 Value="@_editingRequest.TripType"
                                                                 ValueChanged="@(v => _editingRequest.TripType = v ?? "")"
                                                                 TextFieldName="Display"
                                                                 ValueFieldName="Code"
                                                                 CssClass="modal-flex-dropdown" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Quote ($)</label>
                                            <NumericTextBoxControl TValue="decimal" Step="10" Width="100%" CssClass="modal-input" Value="@_editingRequest.Quote" ValueChanged="@(v => _editingRequest.Quote = v)" />
                                        </div>
                                    </div>

                                    <div class="modal-grid-2">
                                        <div class="modal-field">
                                            <label>Status</label>
                                            <DropDownListControl TValue="string" TItem="string"
                                                                 Width="100%"
                                                                 DataSource="@_statusOptions"
                                                                 Value="@_editingRequest.Status"
                                                                 ValueChanged="@(v => _editingRequest.Status = v ?? "")"
                                                                 CssClass="modal-flex-dropdown" />
                                        </div>
                                        <div class="modal-field">
                                            <label>Date requested</label>
                                            <DatePickerControl Value="@_modalDateRequested"
                                                               ValueChanged="@(dt => { if (_editingRequest != null && dt.HasValue) _editingRequest.DateRequested = dt.Value; })"
                                                               Format="MM/dd/yyyy"
                                                               CssClass="modal-flex-datepicker" />
                                        </div>
                                    </div>

                                    <div class="modal-field">
                                        <label>Itinerary &amp; requirements</label>
                                        <TextBoxControl Multiline="true" Rows="3" CssClass="modal-textarea" Value="@_editingRequest.Itinerary" ValueChanged="@(v => _editingRequest.Itinerary = v ?? "")" />
                                    </div>

                                    <div class="modal-field">
                                        <label>Notes for the agent</label>
                                        <TextBoxControl CssClass="modal-input" Value="@_editingRequest.Notes" ValueChanged="@(v => _editingRequest.Notes = v ?? "")" />
                                    </div>
                                </div>

                                <div class="modal-card-footer">
                                    <button type="button" class="btn-modal-cancel" @onclick="ClosePopupEdit">Cancel</button>
                                    <button type="button" class="btn-modal-save" @onclick="SavePopupEdit">
                                        <span class="bi bi-check-lg"></span> @(_isNewRequest ? "Add Request" : "Save Request")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (_activeTab == "charts")
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
                        <div>
                            <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; color: #0f172a;">Quarterly Revenue vs. Target (Pure SVG)</h4>
                            <ChartControl Type="ChartType.Bar" Title="Performance Overview" Height="280px" Series="@_quarterlySeries" />
                        </div>
                        <div>
                            <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; color: #0f172a;">Material Distribution Breakdown</h4>
                            <ChartControl Type="ChartType.Pie" Title="Inventory Allocation" Height="280px" Series="@_pieSeries" />
                        </div>
                    </div>
                }
                else if (_activeTab == "ribbon")
                {
                    <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                        <RibbonControl>
                            <RibbonTab Title="Home">
                                <RibbonGroup Title="Clipboard">
                                    <RibbonButton Text="Paste" Icon="bi-clipboard" OnClick="@OnPaste" />
                                    <RibbonButton Text="Copy" Icon="bi-files" OnClick="@OnCopy" />
                                </RibbonGroup>
                                <RibbonGroup Title="Actions">
                                    <RibbonButton Text="New Order" Icon="bi-plus-circle" OnClick="@OnNewOrder" />
                                    <RibbonButton Text="Save Batch" Icon="bi-save" OnClick="@OnSaveBatch" />
                                </RibbonGroup>
                                <RibbonGroup Title="Export">
                                    <RibbonButton Text="Excel (XLSX)" Icon="bi-file-earmark-excel" OnClick="@OnExportRibbonExcel" />
                                    <RibbonButton Text="Print PDF" Icon="bi-printer" OnClick="@OnPrintPdf" />
                                </RibbonGroup>
                            </RibbonTab>
                            <RibbonTab Title="View &amp; Filter">
                                <RibbonGroup Title="Display Options">
                                    <RibbonButton Text="Toggle Grid" Icon="bi-table" OnClick="@OnToggleGrid" />
                                    <RibbonButton Text="Freeze Headers" Icon="bi-pin-angle" OnClick="@OnFreezeHeaders" />
                                </RibbonGroup>
                            </RibbonTab>
                        </RibbonControl>
                        <div style="padding: 24px; background: #fafbfc; text-align: center; color: #64748b;">
                            <p style="margin: 0; font-size: 14px;">
                                💡 <strong>Interactive Ribbon:</strong> Click any of the ribbon buttons above to see live event handling and toast notifications!
                            </p>
                        </div>
                    </div>
                }
                else if (_activeTab == "reports")
                {
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                            <div>
                                <h3 style="margin: 0 0 4px; font-size: 18px; color: #0f172a;">Crystal Reports &amp; Paginated Print Engine</h3>
                                <p style="margin: 0; font-size: 13px; color: #64748b;">
                                    Load Crystal Reports (.rpt XML), bind session parameters, and stream to screen or print without Crystal runtime dependencies.
                                </p>
                            </div>
                            <a href="demo/reports/package-costs" class="btn-filter-pill" style="background:#0284c7; color:#fff; text-decoration:none;">
                                Open Full Report Demo &rarr;
                            </a>
                        </div>
                        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 18px; font-family: monospace; font-size: 13px; color: #334155;">
                            <div style="color: #0d3b66; font-weight: 700; border-bottom: 2px solid #0d3b66; padding-bottom: 6px; margin-bottom: 12px; display: flex; justify-content: space-between;">
                                <span>PACKAGE COST SHEET</span>
                                <span>@_costPreviewTitle | As of: @DateTime.Today.ToString("d")</span>
                            </div>
                            @foreach (var line in _costPreview)
                            {
                                <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #f1f5f9;">
                                    <span>@line.Label</span>
                                    <span style="font-weight: 600;">@line.Amount.ToString("C2")</span>
                                </div>
                            }
                            <div style="display: flex; justify-content: space-between; padding: 6px 0; margin-top: 8px; border-top: 2px solid #cbd5e1; font-weight: 700; color: #0f172a;">
                                <span>PACKAGE TOTAL:</span>
                                <span>@_costPreview.Sum(l => l.Amount).ToString("C2")</span>
                            </div>
                        </div>
                    </div>
                }
                </div>
            </div>
        </div>
    </section>

    <!-- ── 3. Most Popular UI Components & Component Directory ── -->
    <ComponentCatalogDirectory />


    <!-- ── 5. Why Choose FlexCore: Key Architectural Pillars ───────── -->
    <section class="pillars-section">
        <div class="section-header">
            <span class="section-tag">Enterprise Architecture</span>
            <h2 class="section-title">Engineered for Enterprise Demand</h2>
            <p class="section-desc">
