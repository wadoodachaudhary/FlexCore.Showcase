@page "/demo/charts/sunburst"
@rendermode InteractiveServer
@using Fx.ControlKit.Charts
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Services
@using System.Globalization

<PageTitle>COVID-19 Sunburst Chart — FlexCore Showcase</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-3 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="font-size: 24px;">☀️</span>
                <h2 class="mb-0 fw-bold" style="color: #0f172a; font-size: 1.65rem;">COVID-19 Global Sunburst Visualization</h2>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 ms-2">Pure SVG • Zero JS</span>
            </div>
            <p class="text-muted mb-0" style="font-size: 13.5px;">
                Visualizing <strong>56,956,080 confirmed cases</strong> and <strong>1,397,672 deaths</strong> across 6 continents and 210 countries.
                Click any continent to drill down, or click the center circle to zoom back out.
                <a href="https://towardsdatascience.com/how-i-created-a-sunburst-chart-using-javascript-to-visualize-covid-19-data-4ef27b45af8a/"
                   target="_blank" rel="noopener noreferrer" class="text-decoration-none ms-1">
                    Based on Towards Data Science research ↗
                </a>
            </p>
        </div>

        <!-- Metric Toggle & Reset Actions -->
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group shadow-sm" role="group">
                <button type="button" class="btn btn-sm @(!_useDeathsAsMetric ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SwitchMetric(false)">
                    <b>Total Cases</b> (56.96M)
                </button>
                <button type="button" class="btn btn-sm @(_useDeathsAsMetric ? "btn-danger" : "btn-outline-secondary")"
                        @onclick="() => SwitchMetric(true)">
                    <b>Total Deaths</b> (1.40M)
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ResetToWorld">
                🔄 Reset View
            </button>
        </div>
    </div>

    <!-- Continent Quick-Filters & Search Bar -->
    <div class="row g-2 align-items-center mb-3">
        <div class="col-lg-8 col-md-12">
            <div class="d-flex flex-wrap gap-1 align-items-center">
                <span class="text-muted small fw-semibold me-1">Continents:</span>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == null ? "btn-dark" : "btn-light border")"
                        @onclick="() => FilterByContinent(null)">
                    All Continents
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "Asia" ? "text-white" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "Asia" ? "#4db6ac" : "");"
                        @onclick='() => FilterByContinent("Asia")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#63c6c1;"></span>
                    Asia (15.9M)
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "North America" ? "text-white" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "North America" ? "#e53935" : "");"
                        @onclick='() => FilterByContinent("North America")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#e25b45;"></span>
                    North America (14.6M)
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "Europe" ? "text-white" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "Europe" ? "#8bc34a" : "");"
                        @onclick='() => FilterByContinent("Europe")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#adc965;"></span>
                    Europe (13.5M)
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "South America" ? "text-white" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "South America" ? "#5c6bc0" : "");"
                        @onclick='() => FilterByContinent("South America")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#7C79A2;"></span>
                    South America (10.7M)
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "Africa" ? "text-white" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "Africa" ? "#f59e0b" : "");"
                        @onclick='() => FilterByContinent("Africa")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#FBAF0A;"></span>
                    Africa (2.1M)
                </button>
                <button type="button" class="btn btn-sm @(_activeContinentFilter == "Oceania" ? "text-dark" : "btn-light border")"
                        style="background: @(_activeContinentFilter == "Oceania" ? "#FFC1A6" : "");"
                        @onclick='() => FilterByContinent("Oceania")'>
                    <span class="d-inline-block rounded-circle me-1" style="width:8px;height:8px;background:#FFC1A6;"></span>
                    Oceania (49.9K)
                </button>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" class="form-control border-start-0" placeholder="Search country (e.g. Italy, India, USA)..."
                       value="@_searchQuery"
                       @oninput="HandleSearchInput" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">✕</button>
                }
            </div>
        </div>
    </div>

    <!-- Main Content Stage -->
    <div class="row g-4">
        <!-- Sunburst Chart Stage -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow-sm border h-100" style="background: #ffffff; border-radius: 12px;">
                <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                    <span class="fw-bold text-secondary" style="font-size: 13px;">
                        Interactive Radial Sunburst Partition
                    </span>
                    <span class="badge bg-light text-dark border">
                        @(_useDeathsAsMetric ? "Showing Total Deaths" : "Showing Total Cases")
                    </span>
                </div>
                <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center" style="min-height: 640px;">
                    <SunburstChartControl RootNode="@_sunburstRoot"
                                          MetricName="@(_useDeathsAsMetric ? "Deaths" : "Cases")"
                                          SecondaryMetricName="@(_useDeathsAsMetric ? "Cases" : "Deaths")"
                                          CenterTitle="@(_useDeathsAsMetric ? "TOTAL DEATHS" : "TOTAL CASES")"
                                          CenterColor="@(_useDeathsAsMetric ? "#e53935" : "#56abf6")"
                                          ValueFormat="N0"
                                          EnableDrilldown="true"
                                          ShowBreadcrumb="true"
                                          ShowLabels="true"
                                          HighlightedNodeId="@_highlightedNodeId"
                                          OnNodeClick="HandleNodeClick"
                                          OnNodeHover="HandleNodeHover"
                                          Height="620px" />
                </div>
            </div>
        </div>

        <!-- Right Side Panel: Stats, Active Inspector, and Leaderboard -->
        <div class="col-xl-4 col-lg-5 d-flex flex-column gap-3">
            <!-- Global Metrics Overview -->
            <div class="card shadow-sm border" style="border-radius: 12px;">
                <div class="card-header bg-white py-2 px-3 fw-bold small text-secondary">
                    Global Pandemic Key Metrics
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="p-2 rounded" style="background: #eff6ff; border: 1px solid #bfdbfe;">
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Total Cases</div>
                                <div class="fw-bold text-primary" style="font-size: 17px;">56,956,080</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background: #fef2f2; border: 1px solid #fecaca;">
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Total Deaths</div>
                                <div class="fw-bold text-danger" style="font-size: 17px;">1,397,672</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Case Fatality Rate</div>
                                <div class="fw-bold text-dark" style="font-size: 17px;">2.45%</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted" style="font-size: 11px; text-transform: uppercase;">Territories</div>
                                <div class="fw-bold text-dark" style="font-size: 17px;">210 Countries</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Region Inspector Card -->
            <div class="card shadow-sm border" style="border-radius: 12px;">
                <div class="card-header bg-white py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
                    <span>Region Inspector</span>
                    @if (_selectedOrHoveredNode != null && _selectedOrHoveredNode.Depth == 2)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Country</span>
                    }
                    else if (_selectedOrHoveredNode != null && _selectedOrHoveredNode.Depth == 1)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle">Continent</span>
                    }
                </div>
                <div class="card-body p-3">
                    @if (_selectedOrHoveredNode != null)
                    {
                        var node = _selectedOrHoveredNode;
                        var cases = _useDeathsAsMetric ? (node.SecondaryValue ?? 0) : node.Value;
                        var deaths = _useDeathsAsMetric ? node.Value : (node.SecondaryValue ?? 0);
                        var cfr = cases > 0 ? (deaths / cases * 100.0) : 0.0;
                        var pctWorld = (cases / CovidDataService.WorldTotalCases) * 100.0;

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="d-inline-block rounded-circle" style="width:14px; height:14px; background: @(node.Color ?? "#56abf6");"></span>
                            <h5 class="mb-0 fw-bold">@node.Name</h5>
                            @if (node.CustomAttributes.TryGetValue("IsoCode", out var iso) && iso is string isoStr && !string.IsNullOrEmpty(isoStr))
                            {
                                <span class="badge bg-secondary">@isoStr</span>
                            }
                        </div>

                        <div class="d-flex flex-column gap-2 mb-3" style="font-size: 13px;">
                            <div class="d-flex justify-content-between border-bottom pb-1">
                                <span class="text-muted">Total Confirmed Cases:</span>
                                <strong class="text-primary">@cases.ToString("N0")</strong>
                            </div>
                            <div class="d-flex justify-content-between border-bottom pb-1">
                                <span class="text-muted">Total Reported Deaths:</span>
                                <strong class="text-danger">@deaths.ToString("N0")</strong>
                            </div>
                            <div class="d-flex justify-content-between border-bottom pb-1">
                                <span class="text-muted">Case Fatality Rate:</span>
                                <strong>@cfr.ToString("0.00")%</strong>
                            </div>
                            <div class="d-flex justify-content-between border-bottom pb-1">
                                <span class="text-muted">Share of Global Cases:</span>
                                <strong>@pctWorld.ToString("0.0")%</strong>
                            </div>
                            @if (node.CustomAttributes.TryGetValue("Continent", out var cont) && cont != null)
                            {
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Continent:</span>
                                    <span>@cont</span>
                                </div>
                            }
                        </div>

                        @if (node.Children.Count > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary w-100" @onclick="() => FilterByContinent(node.Name)">
                                Drill down into @node.Name (expand @node.Children.Count countries)
                            </button>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-4" style="font-size: 13px;">
                            <div style="font-size: 28px; margin-bottom: 6px;">👆</div>
                            Hover or click any segment on the sunburst chart to inspect country details and statistics.
                        </div>
                    }
                </div>
            </div>

            <!-- Top 10 Impacted Countries -->
            <div class="card shadow-sm border flex-grow-1" style="border-radius: 12px;">
                <div class="card-header bg-white py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
                    <span>Top 10 Highest Cases</span>
                    <span class="text-muted" style="font-size: 11px;">Click to highlight</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="font-size: 12.5px;">
                        @{ var topMax = _topCountries.Count > 0 ? _topCountries.Max(c => c.TotalCases) : 0.0; }
                        @foreach (var (country, idx) in _topCountries.Select((c, i) => (c, i + 1)))
                        {
                            var isSelected = _highlightedNodeName == country.Name;
                            var pct = topMax > 0 ? (country.TotalCases / topMax) * 100.0 : 0.0; // scaled to the #1 entry

                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex flex-column py-2 px-3 @(isSelected ? "bg-light border-primary" : "")"
                                    @onclick="() => HighlightCountry(country.Name)">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span>
                                        <b class="text-muted me-1">#@idx</b>
                                        <strong>@country.Name</strong>
                                        <small class="text-muted ms-1">(@country.Continent)</small>
                                    </span>
                                    <strong class="text-primary font-monospace">@country.TotalCases.ToString("N0")</strong>
                                </div>
                                <div class="progress" style="height: 4px;">
                                    <div class="progress-bar" style="width: @pct%; background-color: @country.Color;"></div>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Underlying Data Explorer Section -->
    <div class="card shadow-sm border mt-4 mb-4" style="border-radius: 12px;">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold">Underlying COVID-19 Dataset Explorer</h5>
                <small class="text-muted">Tabulated country records powered by FlexCore GridControl with sorting, filtering, and paging</small>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showGrid = !_showGrid">
                @(_showGrid ? "Hide Data Table ▲" : "Show Data Table ▼")
            </button>
        </div>

        @if (_showGrid)
        {
            <div class="card-body p-3">
                <GridControl TValue="CovidCountryData"
                             DataSource="@_filteredTableData"
                             AllowSorting="true"
                             AllowFiltering="true"
                             AllowPaging="true"
                             PageSize="15"
                             ShowRowCountInFooter="true"
                             Height="420px"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(CovidCountryData.IsoCode)" HeaderText="ISO" Width="75px" TextAlign="TextAlign.Center" />
                        <GridColumn Field="@nameof(CovidCountryData.Name)" HeaderText="Country / Territory" Width="220px" />
                        <GridColumn Field="@nameof(CovidCountryData.Continent)" HeaderText="Continent" Width="140px" />
                        <GridColumn Field="@nameof(CovidCountryData.TotalCases)" HeaderText="Total Cases" Width="130px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="#,##0" />
                        <GridColumn Field="@nameof(CovidCountryData.TotalDeaths)" HeaderText="Total Deaths" Width="120px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="#,##0" />
                        <GridColumn Field="@nameof(CovidCountryData.TotalCasesPerMillion)" HeaderText="Cases / Million" Width="130px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="#,##0.0" />
                        <GridColumn Field="@nameof(CovidCountryData.TotalDeathsPerMillion)" HeaderText="Deaths / Million" Width="130px" Type="ColumnType.Number" TextAlign="TextAlign.Right" Format="#,##0.0" />
                    </GridColumnsBase>
                </GridControl>
            </div>
        }
    </div>
</div>

@code {
    private SunburstNode _sunburstRoot = default!;
    private SunburstNode? _selectedOrHoveredNode;
    private bool _useDeathsAsMetric = false;
    private string? _activeContinentFilter;
    private string? _highlightedNodeId;
    private string? _highlightedNodeName;
    private string _searchQuery = "";
    private bool _showGrid = false;

    private List<CovidCountryData> _allCountryData = new();
    private List<CovidCountryData> _topCountries = new();
    private List<CovidCountryData> _filteredTableData = new();

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        _allCountryData = CovidDataService.GetFlatCountryData();
        _topCountries = _allCountryData.OrderByDescending(c => c.TotalCases).Take(10).ToList();
        _filteredTableData = _allCountryData;
        _sunburstRoot = CovidDataService.GetCovidSunburstTree(_useDeathsAsMetric);
        _selectedOrHoveredNode = _sunburstRoot;
    }

    private void SwitchMetric(bool useDeaths)
    {
        _useDeathsAsMetric = useDeaths;
        _sunburstRoot = CovidDataService.GetCovidSunburstTree(_useDeathsAsMetric);
        if (!string.IsNullOrEmpty(_activeContinentFilter))
        {
            var match = _sunburstRoot.Children.FirstOrDefault(c => c.Name.Equals(_activeContinentFilter, StringComparison.OrdinalIgnoreCase));
            if (match != null)
                _selectedOrHoveredNode = match;
        }
        else
        {
            _selectedOrHoveredNode = _sunburstRoot;
        }
    }

    private void ResetToWorld()
    {
        _activeContinentFilter = null;
        _highlightedNodeId = null;
        _highlightedNodeName = null;
        _searchQuery = "";
        _sunburstRoot = CovidDataService.GetCovidSunburstTree(_useDeathsAsMetric);
        _selectedOrHoveredNode = _sunburstRoot;
        _filteredTableData = _allCountryData;
    }

    private void FilterByContinent(string? continent)
    {
        _activeContinentFilter = continent;
        _highlightedNodeId = null;
        _highlightedNodeName = null;

        if (string.IsNullOrEmpty(continent))
        {
            ResetToWorld();
            return;
        }

        var fullTree = CovidDataService.GetCovidSunburstTree(_useDeathsAsMetric);
        var targetContinent = fullTree.Children.FirstOrDefault(c => c.Name.Equals(continent, StringComparison.OrdinalIgnoreCase));
        if (targetContinent != null)
        {
            _sunburstRoot = targetContinent;
            _selectedOrHoveredNode = targetContinent;
            _filteredTableData = _allCountryData.Where(c => c.Continent.Equals(continent, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void HighlightCountry(string name)
    {
        _highlightedNodeName = name;
        var node = _sunburstRoot.Flatten().FirstOrDefault(n => n.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
        if (node != null)
        {
            _highlightedNodeId = node.Id;
            _selectedOrHoveredNode = node;
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _highlightedNodeId = null;
            _highlightedNodeName = null;
            _filteredTableData = _allCountryData;
            return;
        }

        var match = _allCountryData.FirstOrDefault(c => c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        if (match != null)
        {
            HighlightCountry(match.Name);
        }

        _filteredTableData = _allCountryData
            .Where(c => c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || c.Continent.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _highlightedNodeId = null;
        _highlightedNodeName = null;
        _filteredTableData = _allCountryData;
    }

    private void HandleNodeClick(SunburstNode node)
    {
        _selectedOrHoveredNode = node;
        _highlightedNodeId = node.Id;
        _highlightedNodeName = node.Name;
    }

    private void HandleNodeHover(SunburstNode? node)
    {
        if (node != null)
        {
            _selectedOrHoveredNode = node;
        }
    }
}
