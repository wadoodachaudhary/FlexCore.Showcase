    private IReadOnlyList<GanttTask> _tasks = Plan();
    private string Summary => _tasks.Count == 0
        ? "No tasks."
        : $"{_tasks.Count} tasks, {_tasks.Min(t => t.Start):d} to {_tasks.Max(t => t.End):d}; {_tasks.Count(t => t.Progress == 100)} complete.";

    private static GanttTask[] Plan() =>
    [
        new() { Id = "design", Title = "Design", Start = new(2026, 11, 2), End = new(2026, 11, 13), Progress = 90, Color = "#0f766e" },
        new() { Id = "wire", Title = "Wireframes", Start = new(2026, 11, 2), End = new(2026, 11, 6), Progress = 100, ParentId = "design" },
        new() { Id = "visual", Title = "Visual design", Start = new(2026, 11, 6), End = new(2026, 11, 13), Progress = 80, ParentId = "design", Predecessors = "wire" },
        new() { Id = "build", Title = "Build", Start = new(2026, 11, 13), End = new(2026, 12, 4), Progress = 35, Color = "#0f766e" },
        new() { Id = "front", Title = "Front end", Start = new(2026, 11, 13), End = new(2026, 11, 27), Progress = 40, ParentId = "build", Predecessors = "visual" },
        new() { Id = "api", Title = "API", Start = new(2026, 11, 13), End = new(2026, 12, 4), Progress = 30, ParentId = "build", Predecessors = "wire" },
        new() { Id = "content", Title = "Content", Start = new(2026, 11, 9), End = new(2026, 11, 27), Progress = 60 },
        new() { Id = "qa", Title = "Test", Start = new(2026, 12, 4), End = new(2026, 12, 11), Predecessors = "front,api" },
        new() { Id = "launch", Title = "Launch", Start = new(2026, 12, 11), End = new(2026, 12, 12), Predecessors = "qa,content", Color = "#dc2626" },
    ];

    private readonly IReadOnlyList<GanttTask> _plan = Plan();
    private GanttView _view = GanttView.Month;

    private IReadOnlyList<GanttTask> _guarded = Plan();
    private string _decision = "No changes yet.";

    private void Guard(GanttTaskChangingArgs args)
    {
        var reason = args.Action == GanttChangeAction.Delete ? "deleting is off on this page"
                   : args.Previous?.Progress == 100 ? "the task is complete"
                   : null;
        args.Cancel = reason is not null;
        _decision = reason is null
            ? $"{args.Action} of '{args.Task.Title}' accepted."
            : $"{args.Action} of '{args.Task.Title}' refused: {reason}.";
    }

