        {
            new("ShowPasswordToggle", "Shows the eye button that reveals and hides the password.", "bool", "true"),
            new("RevealLastTypedCharacter", "Briefly draws the character just typed over the masked box. Pasted, autofilled and programmatic text stays masked.", "bool", "true"),
            new("PasswordRevealDurationMs", "How long that character shows. 0 turns it off; values above 2000 are capped at 2000.", "int", "1000"),
            new("ExistingPasswordViewable", "False starts the box blank and never renders the supplied <code>Value</code>; a blank commit before any typing is ignored. Keep the saved value on the server.", "bool", "true"),
            new("PasswordRevealUnavailableReason", "Keeps the eye visible but disabled, with this text as its label and tooltip, for example when only a hash is stored.", "string?", "null"),
        };
        public static readonly ApiRow[] TextBoxEvents =
        {
            new("ValueChanged", "When the field changes (Tab out, click away, Enter), or on every keystroke with <code>UpdateOnInput</code>. With <code>ClientBuffered</code>, when the box loses focus. Also after a classic-menu command that changed the text.", "string?"),
            new("InputValueChanged", "A plain <code>Action&lt;string?&gt;</code> called with the text on every input event, with or without <code>UpdateOnInput</code> (with <code>ClientBuffered</code>, on each commit). It does not re-render the parent.", "string?"),
            new("OnKeyDown", "Key presses in the box; while it is unset, the box sends no keydown events to the server. With <code>ClientBuffered</code> it receives the commit keys (Enter, Tab, Up, Down, the page keys) after the value has been sent, and Escape without sending it; it never sees the typing keys.", "KeyboardEventArgs"),
            new("OnBlur", "When the box loses focus, after a client-buffered draft has been sent.", null),
            new("OnPasteTruncated", "A paste was cut short by <code>MaxLength</code>. The browser trims before any input event, so this is the only notice.", "(int PastedLength, int MaxLength)"),
        };
        public static readonly ApiRow[] TextBoxMethods =
        {
            new("FocusAsync(bool preventScroll = true)", "Focuses the input.", "ValueTask"),
            new("FlushClientBufferedValueAsync() / FlushClientBufferedValueAsync(bool requireCurrentValue)", "With <code>ClientBuffered</code>, reads the browser's text and raises <code>ValueChanged</code> now, for a Save button that should not wait for blur. With <code>requireCurrentValue</code> a failed read throws instead of leaving the older value.", "Task"),
        };
        public static readonly ApiRow[] Numeric =
        {
            new("Value", "The number. Bind with <code>@bind-Value</code> and set <code>TValue</code> to <code>int</code>, <code>decimal</code>, <code>double</code>, <code>float</code> or a nullable form of one.", "TValue?", "default"),
            new("Format", "A .NET format for the number shown, applied with the invariant culture. Every <code>C</code> and <code>N</code> in it becomes <code>F</code>, so <code>C2</code> shows <code>3200.00</code> without a symbol. A custom format with group separators gives text a number input cannot display.", "string?", "null"),
            new("Placeholder", "Hint shown while the box is empty.", "string?", "null"),
            new("Width", "CSS width written as an inline style.", "string?", "null"),
            new("CssClass", "Added after <code>fx-numeric</code>.", "string?", "null"),
            new("Enabled", "False renders <code>disabled</code> (greyed by the stylesheet).", "bool", "true"),
            new("Min / Max", "Bounds. A committed value outside them is replaced by the bound. Also written as the input's <code>min</code> and <code>max</code>.", "decimal?", "null"),
            new("Step", "The input's <code>step</code>, which the browser uses for ArrowUp and ArrowDown. The default 1 writes <code>step=\"any\"</code>; any other value is written as given and makes <code>inputmode</code> <code>decimal</code>.", "decimal", "1"),
            new("MaxLength", "Writes <code>maxlength</code> and switches the input to <code>type=\"text\"</code>, because number inputs ignore <code>maxlength</code>.", "int?", "null"),
            new("TabIndex", "The input's <code>tabindex</code>.", "int?", "null"),
            new("ClearOnCommit", "After each accepted commit the box clears and <code>ValueChanged</code> receives the default value (null for a nullable type). After an Enter commit focus stays in the box.", "bool", "false"),
        };
        public static readonly ApiRow[] NumericEvents =
        {
            new("ValueChanged", "On commit (Enter, Tab, a click away), after parsing and clamping; never per keystroke. Blank or unreadable text commits as 0, or null for a nullable type when blank, before <code>Min</code> and <code>Max</code> apply.", "TValue?"),
