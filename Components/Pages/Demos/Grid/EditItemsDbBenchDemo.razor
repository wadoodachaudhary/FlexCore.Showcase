@page "/demo/grid/edit-items-db"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Data
@inject FlexCore.Showcase.Services.BenchDataStore BenchData
@inject ZoomService Zoom

<PageTitle>Edit Items Database &amp; Typing Bench — FlexCore DataGrid</PageTitle>

<SyncfusionDemoLayout Title="Enterprise Estimating Items Database &amp; Typing Bench"
                      Category="DataGrid"
                      BadgeText="Enterprise DB"
                      RazorCode="@_razorSourceCode"
                      CSharpCode="@_csharpSourceCode"
                      CSharpTabName="EstimatingItemModel.cs">
    <Summary>
        <p>
            Modeled after HomeFront's production Estimating Items catalog, this benchmark manages thousands of construction catalog specifications with live editing,
            typing responsiveness metrics, zoom level scaling (via <code>ZoomService</code>), and multi-cell batch navigation.
        </p>
        <p>
            Features include <strong>SelectAllOnEdit</strong> for numeric rates, live waste percentage updates, and keyboard Arrow/Tab navigation that feels identical to native desktop ERPs.
        </p>
    </Summary>

    <DemoControls>
        <div style="display:flex;gap:10px;align-items:center;font-size:13px;flex-wrap:wrap;">
            <span><strong>Dataset:</strong> <b>@_items.Count.ToString("N0")</b> items</span>
            <span class="ms-2"><strong>Zoom:</strong></span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetZoom(85)">85%</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetZoom(100)">100%</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetZoom(115)">115%</button>

            <span class="text-muted ms-2">Current Zoom: <b>@(_currentZoom)%</b> | Edits: <b>@_editCount</b></span>
        </div>
    </DemoControls>

    <DemoContent>
        <div style="width:100%; transform: scale(@(_currentZoom / 100.0)); transform-origin: top left; transition: transform 0.2s ease;">
            <GridControl @ref="_grid"
                         ShowRowCountInFooter="true"
                         TValue="EstimatingItemRecord"
                         DataSource="@_items"
                         AllowSelection="true"
                         AllowSorting="true"
                         AllowResizing="true"
                         AllowFiltering="true"
                         ShowSearchBar="true"
                         Height="420px"
                         EnableTypeSearch="true"
                         EditSettingsRef="@_editSettings"
                         EventsRef="@_events"
                         CssClass="fx-grid-compact">
                <GridColumnsBase>
                    <GridColumn Field="@nameof(EstimatingItemRecord.Item)" HeaderText="Item Code" Width="105px" AllowEditing="false" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.ItemDesc)" HeaderText="Description" Width="260px" AllowEditing="true" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.Phase)" HeaderText="Phase" Width="80px" AllowEditing="false" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.PhaseDesc)" HeaderText="Phase Title" Width="180px" AllowEditing="false" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.CostCategory)" HeaderText="Cost Category" Width="130px" AllowEditing="true" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.OrderUOM)" HeaderText="UOM" Width="75px" TextAlign="TextAlign.Center" AllowEditing="true" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.Price)" HeaderText="Unit Price" Width="105px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" Format="$#,##0.00" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.WastePercent)" HeaderText="Waste %" Width="85px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" />
                    <GridColumn Field="@nameof(EstimatingItemRecord.POIndex)" HeaderText="PO Index" Width="100px" AllowEditing="true" />
                </GridColumnsBase>
            </GridControl>
        </div>
    </DemoContent>

    <DocumentationContent>
        <h3>Enterprise Estimating Architecture</h3>
        <ul>
            <li><strong>SelectAllOnEdit:</strong> When pressing Tab or clicking into numeric cells, the entire value is pre-selected so typing immediately replaces the contents without backspacing.</li>
            <li><strong>Zoom Scaling Integration:</strong> <code>ZoomService</code> injects CSS custom properties (<code>--fx-zoom</code>) allowing accessibility magnification across the whole grid.</li>
            <li><strong>Low Memory Overhead:</strong> Memory usage remains constant even with thousands of estimating records loaded in the browser session.</li>
        </ul>
    </DocumentationContent>
</SyncfusionDemoLayout>

@code {
    private GridControl<EstimatingItemRecord>? _grid;
    private List<EstimatingItemRecord> _items = [];
    private int _currentZoom = 100;
    private int _editCount;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly GridControlEvents<EstimatingItemRecord> _events = new();

    protected override void OnInitialized()
    {
        _items = BenchData.EstimatingItems.ToList();

        _events.OnCellEdit = EventCallback.Factory.Create<CellEditArgs<EstimatingItemRecord>>(this, args =>
        {
            _editCount++;
            StateHasChanged();
        });
    }

    private void SetZoom(int zoom)
    {
        _currentZoom = zoom;
        Zoom.SetZoom(zoom);
        StateHasChanged();
    }

    private const string _razorSourceCode = @"@using Fx.ControlKit
@using Fx.ControlKit.Grid

<GridControl TValue=""EstimatingItemRecord""
             DataSource=""@Items""
             AllowSelection=""true""
             AllowSorting=""true""
             AllowResizing=""true""
             AllowFiltering=""true""
             ShowSearchBar=""true""
             Height=""420px""
             EditSettingsRef=""@_editSettings"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(EstimatingItemRecord.Item)"" HeaderText=""Item Code"" Width=""105px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.ItemDesc)"" HeaderText=""Description"" Width=""260px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.Phase)"" HeaderText=""Phase"" Width=""80px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.CostCategory)"" HeaderText=""Cost Category"" Width=""130px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.OrderUOM)"" HeaderText=""UOM"" Width=""75px"" TextAlign=""TextAlign.Center"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.Price)"" HeaderText=""Unit Price"" Width=""105px"" Type=""ColumnType.Number"" AllowEditing=""true"" SelectAllOnEdit=""true"" Format=""$#,##0.00"" />
        <GridColumn Field=""@nameof(EstimatingItemRecord.WastePercent)"" HeaderText=""Waste %"" Width=""85px"" Type=""ColumnType.Number"" AllowEditing=""true"" SelectAllOnEdit=""true"" />
    </GridColumnsBase>
</GridControl>";

    private const string _csharpSourceCode = @"namespace FlexCore.Showcase.Data;

public sealed class EstimatingItemRecord
{
    public int DivisionID { get; set; }
    public string? Phase { get; set; }
    public string? Item { get; set; }
    public string? ItemDesc { get; set; }
    public string? CostCategory { get; set; }
    public string? OrderUOM { get; set; }
    public decimal? Price { get; set; }
    public int? WastePercent { get; set; }
    public string? POIndex { get; set; }
}";
}
