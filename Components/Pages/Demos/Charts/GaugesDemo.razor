@page "/demo/gauges"
@rendermode InteractiveServer
@using Fx.ControlKit
@using Fx.ControlKit.Charts
@using FlexCore.Showcase.Components.Shared

@* 2026-10-19: new page (Baaria approved the Control tour split; fourth page; replaces the SC-033 idea of folding these into
   Financial & gauges, which already has three examples). The tour's Charts tab moved here and was removed there. Documentation
   written from Charts/GaugeControl.razor, GaugeControls.cs, GaugeVisualControl.razor, GaugeModels.cs, StockChartControl.razor,
   StockChartRange.cs and ChartModels.cs; rows checked with scratchpad/vocabcheck.py; the drawing and toolbar sentences read
   from GaugeVisualControl's markup and StockChartControl's SetRangeAsync/ZoomAsync/PanAsync/OnParametersSet. *@
@* 2026-10-23 (developer meeting point 5, chart label clutter). Gauges: two to a row at Height 300px, so the 300-unit view box
   renders at scale 1 and its 11-unit tick labels at 11 px (four 225 px tiles at 200px gave scale 0.667, 7.3 px); the linear gauge
   gets 150px, where its 320 by 105 view box fills a 465 px tile. Stock chart: ChartControl's financial renderer writes a label
   under every visible point (no thinning), and about sixteen "MMM d" labels are all that fit its 530-unit plot, so Start opens
   the chart on the last fourteen trading days and the page's buttons offer five and fourteen; the old Last 30 days (22 points)
   and Everything (90 points) buttons overlapped. Height 400px renders the 600 by 320 view box at scale 1.25 (12.5 px axis text)
   instead of 1.0625. ShowNavigator is off: the navigator draws a 600 by 300 line chart 90 px high, scale 0.3, text at 3 px; it
   returns when the library can draw its labels at a readable size. The range line counts the trading days in view so the
   buttons, the chart and the text agree. *@

<PageTitle>Blazor Gauges and Stock Chart — FlexCore</PageTitle>

<FeatureDemoLayout Title="Gauges &amp; stock chart" Category="Charts" CategoryHref="demo/charts"
                   ControlName="ArcGaugeControl · CircularGaugeControl · RadialGaugeControl · LinearGaugeControl · StockChartControl"
                   Tagline="Four gauges that share one set of parameters, and a candlestick chart with a date toolbar."
                   SourcePath="Charts/GaugeControl.razor;Charts/GaugeControls.cs;Charts/GaugeVisualControl.razor;Charts/GaugeModels.cs;Charts/StockChartControl.razor;Charts/StockChartRange.cs;Charts/ChartModels.cs">
    <Overview>
        <p>
            The four gauge controls are one <code>GaugeControl</code> with a different shape each: <code>ArcGaugeControl</code> fills a
            three-quarter arc, <code>CircularGaugeControl</code> a full ring, <code>RadialGaugeControl</code> adds a needle to the arc, and
            <code>LinearGaugeControl</code> is a horizontal bar. They take the same parameters: a value between <code>Min</code> and
            <code>Max</code>, coloured <code>Ranges</code>, extra <code>Pointers</code>, tick count and formats. Each is drawn as inline SVG and
            exposes itself as a <code>meter</code>. <code>StockChartControl</code> wraps a candlestick, OHLC or high-low chart in a toolbar of
            date pickers, zoom and pan buttons, with a navigator strip of closing prices and two sliders underneath; the visible range is
            yours through <code>Start</code>, <code>End</code> and <code>RangeChanged</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="gauges" Title="Four gauges, one value" RazorCode="@Code.Gauges" CSharpCode="@Code.GaugesCs">
            <Description><p>The buttons move one value through all four. The arc has three coloured ranges, so its value arc is drawn thinner over them. The ring uses ten ticks and a <code>ValueTemplate</code> in place of the printed value. The radial gauge carries a second needle, a <code>GaugePointer</code> for the target, in its own colour. The linear gauge combines ranges, a pointer and formats with a percent sign. Hover a range or a pointer for its label.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="() => _value = Math.Max(0, _value - 10)" Disabled="@(_value <= 0)">−10</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _value = Math.Min(100, _value + 10)" Disabled="@(_value >= 100)">+10</ButtonControl>
            </Controls>
            <Demo>
                <div class="four">
                    <div><p class="pane-title">Arc</p><ArcGaugeControl Value="@_value" Ranges="@_ranges" Color="@ChartPalette.Blue" AriaLabel="Utilisation" Height="300px" /></div>
                    <div>
                        <p class="pane-title">Circular</p>
                        <CircularGaugeControl Value="@_value" TickCount="10" Color="@ChartPalette.Green" AriaLabel="Progress" Height="300px">
                            <ValueTemplate Context="g"><strong class="ring-value">@g.Value of @g.Max</strong></ValueTemplate>
                        </CircularGaugeControl>
                    </div>
                    <div><p class="pane-title">Radial</p><RadialGaugeControl Value="@_value" Pointers="@_target" Color="@ChartPalette.Indigo" AriaLabel="Throughput" Height="300px" /></div>
                    <div><p class="pane-title">Linear</p><LinearGaugeControl Value="@_value" Ranges="@_ranges" Pointers="@_target" Color="@ChartPalette.Blue" LabelFormat="0'%'" ValueFormat="0'%'" AriaLabel="Capacity" Height="150px" /></div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="stock" Title="Stock chart" RazorCode="@Code.Stock" CSharpCode="@Code.StockCs">
            <Description><p>Ninety trading days of generated prices; <code>Start</code> opens the chart on the last fourteen. The toolbar's pickers set the start and end and cannot cross each other or leave the data; Zoom in halves the visible span around its centre, Zoom out doubles it, Earlier and Later slide it by half, All shows everything. The chart writes a date under every visible day, so once more than about sixteen are in view the labels run into each other: the page's buttons stay at five and fourteen trading days, and the navigator is off because its 90 px strip draws a 600 by 300 chart at three tenths of its size. The buttons above call <code>SetRangeAsync</code> from the page and switch the chart type; the line below is fed by <code>RangeChanged</code> and counts the trading days in view.</p></Description>
            <Controls>
                <ButtonControl CssClass="btn-sm" OnClick="() => _stock!.SetRangeAsync(_prices[^5].DateValue, null)">Last 5 trading days</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _stock!.SetRangeAsync(_firstShown, null)">Last 14 trading days</ButtonControl>
                <ButtonControl CssClass="btn-sm" OnClick="() => _type = _type == ChartType.Candlestick ? ChartType.Ohlc : ChartType.Candlestick">Show as @(_type == ChartType.Candlestick ? "OHLC" : "candlesticks")</ButtonControl>
            </Controls>
            <Demo>
                <StockChartControl @ref="_stock" DataSource="@_prices" Type="@_type" UpColor="@ChartPalette.Green" DownColor="@ChartPalette.Rose" Start="@_firstShown" Height="400px" ShowNavigator="false" RangeChanged="r => _range = Describe(r.Start, r.End)" />
                <p class="result">Range: @_range</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-gauge-parameters-shared-by-the-four-cont" Title="Gauge parameters, shared by the four controls" Count='@DocSection.Label(Vocab.Gauge.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="Gauge parameters, shared by the four controls" Rows="Vocab.Gauge" />
                <p>
                <code>GaugeRange(double From, double To, string Color, string? Label = null)</code> and
                <code>GaugePointer(double Value, string Color = "#dc2626", string? Label = null)</code> are records;
                <code>GaugeValueContext(double Value, double Min, double Max)</code> is what a <code>ValueTemplate</code> receives.
                <code>CssClass</code>, <code>Style</code>, <code>Id</code>, <code>Visible</code> and <code>AdditionalAttributes</code> come from
                <code>FlexControlBase</code> and apply to the root <code>div</code>.
                </p>
                <p>How the gauges draw, from the shared SVG:</p>
                <ul>
                <li>The arc, radial and circular gauges use a 300 by 300 view box. The track and the ranges are 16 px arcs; the value arc is 16 px on its own and 7 px over ranges. The arc and radial gauges sweep 270 degrees from the lower left; the circular gauge sweeps the full 360.</li>
                <li>The radial gauge draws a needle for the value; every gauge draws a needle, or a vertical mark on the linear gauge, for each pointer. Ranges and pointers carry a <code>title</code> with their label, so hovering shows it.</li>
                <li><code>TickCount</code> intervals give <code>TickCount + 1</code> labels formatted with <code>LabelFormat</code>; the circular gauge drops the last one, which would overlap the first.</li>
                <li>The value is printed in the middle with <code>ValueFormat</code> unless a <code>ValueTemplate</code> is set, in which case the template is centred over the drawing.</li>
                <li>For drawing and for <code>aria-valuenow</code> the value is clamped into <code>Min</code> to <code>Max</code>; a range or pointer outside that span is clamped the same way.</li>
                <li>The gauge throws when a value is not finite, when <code>Max</code> is not above <code>Min</code>, when <code>TickCount</code> is outside 1 to 100, or when a range ends before it starts.</li>
                </ul>
            </DocSection>
            <DocSection Id="doc-stockchartcontrol-parameters" Title="StockChartControl parameters" Count='@DocSection.Label(Vocab.Stock.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="StockChartControl parameters" Rows="Vocab.Stock" />
            </DocSection>
            <DocSection Id="doc-stockchartcontrol-events" Title="StockChartControl events" Count='@DocSection.Label(Vocab.StockEvents.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="StockChartControl events" Rows="Vocab.StockEvents" />
            </DocSection>
            <DocSection Id="doc-stockchartcontrol-methods" Title="StockChartControl methods" Count='@DocSection.Label(Vocab.StockMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="StockChartControl methods" Rows="Vocab.StockMethods" />
                <p>
                Each data point is a <code>ChartDataPoint</code> made with <code>ChartDataPoint.Financial(label, open, high, low, close, date)</code>:
                open, high, low and close land in <code>Value</code> to <code>Value4</code> and are read back through <code>Open</code>, <code>High</code>,
                <code>Low</code> and <code>Close</code>; <code>DateValue</code> is required and the points are sorted by it. <code>StockChartRange(DateTime Start, DateTime End)</code>
                is the record <code>RangeChanged</code> delivers. The control throws for a <code>Type</code> other than <code>Candlestick</code>, <code>Ohlc</code>
                or <code>HighLow</code>, for a point without a date, and for a <code>Start</code> after <code>End</code>. With no points it shows
                "No financial data." instead of the chart.
                </p>
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <p>
            Each gauge is a <code>meter</code> named by <code>AriaLabel</code> with <code>aria-valuenow</code>, <code>aria-valuemin</code> and
            <code>aria-valuemax</code>; its SVG is hidden from assistive technology so the figures are not read twice. The stock chart's
            pickers are labelled "Stock chart start date" and "Stock chart end date", the navigator sliders "Navigator start" and
            "Navigator end" (the navigator is off in the example above), and the empty state is a status message.
        </p>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/advanced-charts">Financial &amp; gauges</a>: the same shapes as <code>ChartControl</code> types fed by a series, without the toolbar or the meter semantics.</li>
            <li><a href="demo/charts">Charts overview</a>: the chart gallery.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private double _value = 65;
    private readonly IReadOnlyList<GaugeRange> _ranges = [new(0, 40, ChartPalette.Green, "Healthy"), new(40, 75, ChartPalette.Amber, "Busy"), new(75, 100, ChartPalette.Rose, "Saturated")];
    private readonly IReadOnlyList<GaugePointer> _target = [new(80, ChartPalette.Rose, "Target")];

    private StockChartControl? _stock;
    private ChartType _type = ChartType.Candlestick;
    private string _range;
    private readonly DateTime _firstShown;
    private readonly ChartDataPoint[] _prices;

    public GaugesDemo()
    {
        // 90 trading days of a seeded random walk, so the chart is the same on every visit.
        var random = new Random(7);
        var day = new DateTime(2026, 6, 1);
        var close = 104.0;
        var points = new List<ChartDataPoint>();
        while (points.Count < 90)
        {
            if (day.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday))
            {
                var open = close;
                close = Math.Round(open * (1 + (random.NextDouble() - 0.48) * 0.04), 2);
                var high = Math.Round(Math.Max(open, close) * (1 + random.NextDouble() * 0.015), 2);
                var low = Math.Round(Math.Min(open, close) * (1 - random.NextDouble() * 0.015), 2);
                points.Add(ChartDataPoint.Financial(day.ToString("MMM d"), open, high, low, close, day));
            }
            day = day.AddDays(1);
        }
        _prices = points.ToArray();
        _firstShown = _prices[^14].DateValue!.Value;
        _range = Describe(_firstShown, _prices[^1].DateValue!.Value);
    }

    private string Describe(DateTime start, DateTime end) =>
        $"{start:MMM d} to {end:MMM d}, {_prices.Count(p => p.DateValue >= start && p.DateValue <= end)} trading days.";

    // Code tabs are verbatim copies of each Demo block and of the members behind it (scratchpad/gencode.py).
    private static class Code
    {
        // The palette the gauges use, printed from Components/Shared/ChartPalette.cs
        private static string PaletteCs => "\n\n" + AppSource.Region("ChartPalette.cs", "chart-palette");

        public const string Gauges = @"<ButtonControl CssClass=""btn-sm"" OnClick=""() => _value = Math.Max(0, _value - 10)"" Disabled=""@(_value <= 0)"">−10</ButtonControl>
<ButtonControl CssClass=""btn-sm"" OnClick=""() => _value = Math.Min(100, _value + 10)"" Disabled=""@(_value >= 100)"">+10</ButtonControl>

<div class=""four"">
    <div><p class=""pane-title"">Arc</p><ArcGaugeControl Value=""@_value"" Ranges=""@_ranges"" Color=""@ChartPalette.Blue"" AriaLabel=""Utilisation"" Height=""300px"" /></div>
    <div>
        <p class=""pane-title"">Circular</p>
        <CircularGaugeControl Value=""@_value"" TickCount=""10"" Color=""@ChartPalette.Green"" AriaLabel=""Progress"" Height=""300px"">
            <ValueTemplate Context=""g""><strong class=""ring-value"">@g.Value of @g.Max</strong></ValueTemplate>
        </CircularGaugeControl>
    </div>
    <div><p class=""pane-title"">Radial</p><RadialGaugeControl Value=""@_value"" Pointers=""@_target"" Color=""@ChartPalette.Indigo"" AriaLabel=""Throughput"" Height=""300px"" /></div>
    <div><p class=""pane-title"">Linear</p><LinearGaugeControl Value=""@_value"" Ranges=""@_ranges"" Pointers=""@_target"" Color=""@ChartPalette.Blue"" LabelFormat=""0'%'"" ValueFormat=""0'%'"" AriaLabel=""Capacity"" Height=""150px"" /></div>
</div>";
        public static string GaugesCs => @"private double _value = 65;

private readonly IReadOnlyList<GaugeRange> _ranges = [new(0, 40, ChartPalette.Green, ""Healthy""), new(40, 75, ChartPalette.Amber, ""Busy""), new(75, 100, ChartPalette.Rose, ""Saturated"")];

private readonly IReadOnlyList<GaugePointer> _target = [new(80, ChartPalette.Rose, ""Target"")];" + PaletteCs;
        public const string Stock = @"<ButtonControl CssClass=""btn-sm"" OnClick=""() => _stock!.SetRangeAsync(_prices[^5].DateValue, null)"">Last 5 trading days</ButtonControl>
<ButtonControl CssClass=""btn-sm"" OnClick=""() => _stock!.SetRangeAsync(_firstShown, null)"">Last 14 trading days</ButtonControl>
<ButtonControl CssClass=""btn-sm"" OnClick=""() => _type = _type == ChartType.Candlestick ? ChartType.Ohlc : ChartType.Candlestick"">Show as @(_type == ChartType.Candlestick ? ""OHLC"" : ""candlesticks"")</ButtonControl>

<StockChartControl @ref=""_stock"" DataSource=""@_prices"" Type=""@_type"" UpColor=""@ChartPalette.Green"" DownColor=""@ChartPalette.Rose"" Start=""@_firstShown"" Height=""400px"" ShowNavigator=""false"" RangeChanged=""r => _range = Describe(r.Start, r.End)"" />
<p class=""result"">Range: @_range</p>";
        public static string StockCs => @"private StockChartControl? _stock;

private ChartType _type = ChartType.Candlestick;

private string _range;

private readonly DateTime _firstShown;

private readonly ChartDataPoint[] _prices;

public GaugesDemo()
{
    // 90 trading days of a seeded random walk, so the chart is the same on every visit.
    var random = new Random(7);
    var day = new DateTime(2026, 6, 1);
    var close = 104.0;
    var points = new List<ChartDataPoint>();
    while (points.Count < 90)
    {
        if (day.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday))
        {
            var open = close;
            close = Math.Round(open * (1 + (random.NextDouble() - 0.48) * 0.04), 2);
            var high = Math.Round(Math.Max(open, close) * (1 + random.NextDouble() * 0.015), 2);
            var low = Math.Round(Math.Min(open, close) * (1 - random.NextDouble() * 0.015), 2);
            points.Add(ChartDataPoint.Financial(day.ToString(""MMM d""), open, high, low, close, day));
        }
        day = day.AddDays(1);
    }
    _prices = points.ToArray();
    _firstShown = _prices[^14].DateValue!.Value;
    _range = Describe(_firstShown, _prices[^1].DateValue!.Value);
}

private string Describe(DateTime start, DateTime end) =>
    $""{start:MMM d} to {end:MMM d}, {_prices.Count(p => p.DateValue >= start && p.DateValue <= end)} trading days."";" + PaletteCs;
    }

