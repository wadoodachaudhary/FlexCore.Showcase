    // and MainLayout.razor hosts <DialogHostControl />. This page has @inject IDialogService Dialogs at the top.
    private MessageBoxControl? _box;
    private MultiLineEditControl? _editor;
    private string _notes = "";
    private string? _answer;
    private async Task Confirm() => _answer = await Dialogs.ConfirmAsync("Delete 3 rows?", "Confirm") ? "Yes" : "No";
    private async Task Prompt()
    {
        var name = await Dialogs.PromptAsync("Project name:", "New project", "Untitled");
        _answer = name is null ? "Cancelled" : $"Named \"{name}\"";
    }
    private Task Alert() => Dialogs.AlertAsync("Export finished. 240 rows written.", "Export");
    private async Task Notes()
    {
        var text = await _editor!.ShowAsync(_notes, "Booking notes", 500, "Internal notes for the booking; 500 characters at most.");
        if (text is not null) _notes = text;
        _answer = text is null ? "Cancelled" : $"Notes: {text.Length} characters";
    }
    private async Task AskDotNet() =>
        _answer = (await _box!.ShowAsync("Save changes to Report.docx?", "Editor", MessageBoxButtons.YesNoCancel, "question", MessageBoxLook.DotNet)).ToString();
    private async Task GatedDelete() =>
        _answer = (await _box!.ShowAsync("Delete the project and its 14 files?", "Delete project", MessageBoxButtons.OkCancel, "warning", null, "I understand this cannot be undone")).ToString();

