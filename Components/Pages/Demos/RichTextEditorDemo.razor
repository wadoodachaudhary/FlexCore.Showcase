            new("IsDirtyAsync()", "True after any change since the last push; undoing back to the pushed text makes it false again. Also true when the check itself fails.", "Task&lt;bool&gt;"),
            new("GetSelectionAsync()", "The selected text, trimmed, with its block id and position; <code>null</code> when the selection is empty or outside the editor.", "Task&lt;EditorSelectionInfo?&gt;"),
            new("SelectAllAsync()", "Selects all of the editor's content.", "Task"),
            new("ClearSelectionAsync()", "Clears the page's selection and focuses the editor.", "Task"),
            new("ExecFormatCommandAsync(string command)", "Runs a browser editing command (<code>bold</code>, <code>italic</code>, <code>underline</code>, <code>strikeThrough</code>) on the selection. Like the other formatting methods it first restores the editor's last selection when focus is elsewhere, and records one undo step when the blocks read back afterward differ. The browser writes <code>strikeThrough</code> as a <code>strike</code> element, which the read-back does not keep: it is not reported, not undoable and is lost on the next undo, redo or read.", "Task"),
            new("ApplyInlineStyleAsync(string property, string value)", "Wraps the selected text in spans carrying one CSS property, or sets it on a span that already wraps just that text. Does nothing when the selection is collapsed. Only the four properties <code>ReadBlocksAsync</code> keeps survive a read.", "Task"),
