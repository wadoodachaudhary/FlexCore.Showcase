@page "/demo/toggle-buttons"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page on FeatureDemoLayout. 
   2026-10-29: example 3, SegmentedControl (SegmentedControl.razor, 0.2.49): a RadioGroupControl drawn as one bar.
   2026-11-15: the three examples tell a trip-quote story: extras that change a price, a board and day filter over departures,
   a price view switch. Code tabs generated from the Demo blocks.
   2026-11-15: example story moved to the Project management theme. *@

<PageTitle>Blazor Toggle Button and Button Group — FlexCore</PageTitle>

<FeatureDemoLayout Title="Toggle buttons" Category="Components" ControlName="ToggleButtonControl · ButtonGroupControl · SegmentedControl"
                   Tagline="Switch options on and off, or pick one or several, from a row of buttons."
                   SourcePath="ToggleButtonControl.razor; ButtonGroupControl.razor; SegmentedControl.razor">
    <Overview>
        <p>
            <code>ToggleButtonControl</code> is a Blazor toggle button: it stays pressed until clicked again, so users turn an option on or off in one click, such as a blog on a website estimate. <code>ButtonGroupControl</code> joins related buttons in one bar, with every option in view, for one choice or several, such as a task status or its labels. <code>SegmentedControl</code> shows a few text choices as one bar that works as a radio group, such as a budget per sprint or per week.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="toggle" Title="Toggle button" RazorCode="@Code.Toggle" CSharpCode="@Code.ToggleCs">
            <Description><p>Add extras to the estimate: each button stays down until pressed again, <code>&#64;bind-Selected</code> holds its state, and the total follows. Core pages is <code>Selected</code> with <code>Enabled</code> false; the flag is icon-only, named with <code>aria-label</code>.</p></Description>
            <Demo>
                <div class="estimate">
                    <div class="est-head"><span class="est-icon bi bi-kanban" aria-hidden="true"></span><span class="lbl">Website relaunch for Green Fork Cafe: extras</span></div>
                    <div class="demo-row">
                        <ToggleButtonControl Selected="true" Enabled="false" IconCss="bi bi-window">Core pages included</ToggleButtonControl>
                        <ToggleButtonControl @bind-Selected="_ordering" IconCss="bi bi-bag">Online ordering</ToggleButtonControl>
                        <ToggleButtonControl @bind-Selected="_blog" IconCss="bi bi-journal-text">Blog</ToggleButtonControl>
                        <ToggleButtonControl @bind-Selected="_photos" IconCss="bi bi-camera">Photo shoot</ToggleButtonControl>
                        <ToggleButtonControl @bind-Selected="_flagged" IconCss="@(_flagged ? "bi bi-flag-fill" : "bi bi-flag")"
                                             Title="Flag for review" aria-label="Flag for review" />
                    </div>
                    <p class="price" role="status">@Total.ToString("C0") <span class="result">estimate@(_flagged ? ", flagged for review" : "")</span><span class="extras">Includes @Extras</span></p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="group" Title="Button group" RazorCode="@Code.Group" CSharpCode="@Code.GroupCs">
            <Description><p>Pick one status and any labels to filter the open Sprint 8 tasks: <code>Selection</code> makes a group single or multiple choice, <code>AllowEmpty</code> lets the labels be cleared (then every label matches), QA is a disabled item, and Stack the labels sets <code>Orientation</code>.</p></Description>
            <Controls>
                <SwitchControl @bind-Checked="_stackLabels" Label="Stack the labels" />
            </Controls>
            <Demo>
                <div class="demo-row top panel">
                    <div class="stack">
                        <span class="lbl">Status</span>
                        <ButtonGroupControl Items="_statusItems" @bind-Values="_status" Selection="ChoiceSelectionMode.Single" AriaLabel="Status" />
                    </div>
                    <div class="stack">
                        <span class="lbl">Labels</span>
                        <ButtonGroupControl Items="_labelItems" @bind-Values="_labels" Selection="ChoiceSelectionMode.Multiple" AllowEmpty="true"
                                            Orientation="@(_stackLabels ? FlexOrientation.Vertical : FlexOrientation.Horizontal)" AriaLabel="Labels" />
                    </div>
                    <div class="stack res">
                        <span class="lbl" role="status">@Matches.Length of @_tasks.Length open tasks match</span>
                        <ul class="tasks">
                            @foreach (var t in Matches)
                            {
                                <li><span class="bi bi-card-checklist" aria-hidden="true"></span>@t.Title<span class="task-label">@t.Label</span></li>
                            }
                        </ul>
                    </div>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="segmented" Title="Segmented control" RazorCode="@Code.Segmented" CSharpCode="@Code.SegmentedCs">
            <Description><p>Switch the Build budget between per sprint, in total and per week on one bar; the arrow keys move the choice as in a radio group.</p></Description>
            <Demo>
                <div class="estimate">
                    <div class="demo-row">
                        <span class="est-icon bi bi-cash-coin" aria-hidden="true"></span>
                        <span class="lbl">Build milestone, 4 sprints, 8 weeks</span>
                        <SegmentedControl Items="_budgetItems" @bind-Value="_budgetView" AriaLabel="Budget view" />
                    </div>
                    <p class="price" role="status">@Budget.ToString("C0") <span class="result">@_budgetItems.First(i => i.Value == _budgetView).Text.ToLowerInvariant()</span></p>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

