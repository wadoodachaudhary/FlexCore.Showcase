@* The Dashboard: four figures, the month-by-month chart and the upcoming departures, each a card placed by GridLayoutControl from
   the Settings page's layout, with a rearrange mode that drags cards by their bar. It reads the same trip requests as the Trip
   Requests page, so an edit or a new request there shows up here. *@
@namespace RazorSharpGetaways.Components.Getaways
@using Fx.ControlKit
@using Fx.ControlKit.Charts
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Layout
@using Fx.ControlKit.Notifications
@using RazorSharpGetaways.Data
@inject TripRequestStore Store
@inject GetawaysAppSettings Settings
@inject NotificationService Notifications

<div class="gw-dash">
    <div class="gw-dash-head">
        <div>
            <h3 class="gw-greeting">Welcome back, Pippa</h3>
            <p class="gw-greeting-sub">Here's the agency at a glance for @Today.ToString("dddd, MMMM d").</p>
        </div>
        <div class="gw-dash-tools">
            <ButtonControl BareStyle="true" CssClass="gw-round-btn" IconCss="bi bi-arrows-move" Title="Rearrange the cards" aria-pressed="@(Settings.Customising ? "true" : "false")" OnClick="@(() => Settings.Customising = !Settings.Customising)" />
            <ButtonControl BareStyle="true" CssClass="gw-round-btn" IconCss="bi bi-arrow-clockwise" Title="Refresh" OnClick="Refresh" />
        </div>
    </div>

    @if (Settings.Customising)
    {
        <div class="gw-customise-bar">
            <span class="gw-customise-text"><span class="bi bi-arrows-move"></span> Drag a card by its bar, or use its arrows.</span>
            <div class="gw-customise-tools">
                @foreach (var key in Settings.HiddenCards.ToList())
                {
                    <ButtonControl CssClass="btn-sm" IconCss="bi bi-eye" OnClick="@(() => Settings.SetCardShown(key, true))">Show @GetawaysAppSettings.CardTitle(key)</ButtonControl>
                }
                <ButtonControl CssClass="btn-sm" OnClick="Settings.ResetLayout">Reset layout</ButtonControl>
                <ButtonControl CssClass="btn-sm btn-primary" OnClick="@(() => Settings.Customising = false)">Done</ButtonControl>
            </div>
        </div>
    }

    @* Settings.Slots places the visible cards; each card keeps its state when it moves *@
    <GridLayoutControl CssClass="gw-layout" Columns="@Settings.DashboardColumns" Gap="14px">
        @foreach (var slot in Settings.Slots)
        {
            <GridLayoutItemControl @key="slot.Key" Row="slot.Row" Column="slot.Column" ColumnSpan="slot.Span">
                <div class="@SlotClass(slot)" @ondragover:preventDefault="Settings.Customising"
                     @ondragenter="@(() => { if (_dragging is not null) _dragOver = slot.Key; })" @ondrop="@(() => Drop(slot.Key))">
                    @if (Settings.Customising)
                    {
                        <div class="gw-slot-bar" draggable="true" @ondragstart="@(() => _dragging = slot.Key)" @ondragend="EndDrag">
                            <span class="gw-slot-grip bi bi-grip-vertical"></span>
                            <span class="gw-slot-name">@slot.Title</span>
                            <ButtonControl BareStyle="true" CssClass="gw-slot-btn" IconCss="bi bi-arrow-up" Title="Move up" Disabled="@(!Settings.CanMove(slot.Key, -1))" OnClick="@(() => Settings.MoveCard(slot.Key, -1))" />
                            <ButtonControl BareStyle="true" CssClass="gw-slot-btn" IconCss="bi bi-arrow-down" Title="Move down" Disabled="@(!Settings.CanMove(slot.Key, 1))" OnClick="@(() => Settings.MoveCard(slot.Key, 1))" />
                            <ButtonControl BareStyle="true" CssClass="gw-slot-btn" IconCss="bi bi-eye-slash" Title="Hide this card" OnClick="@(() => Settings.SetCardShown(slot.Key, false))" />
                        </div>
                    }
                    @switch (slot.Key)
                    {
                        case GetawaysAppSettings.Figures:
                            @* Each card opens the Trip Requests page on its view *@
                            <div class="@($"gw-kpis {(slot.Beside ? "gw-kpis-column" : "")}")">
                                @foreach (var k in Kpis)
                                {
                                    <CardControl CssClass="gw-kpi" Elevation="0">
                                        <ButtonControl BareStyle="true" CssClass="gw-kpi-btn" Title="@k.Tip" OnClick="@(() => OnShowRequests.InvokeAsync(k.View))">
                                            <span class="gw-kpi-label">@k.Label</span>
                                            <span class="gw-kpi-line"><span class="gw-kpi-value">@k.Value</span> <span class="gw-kpi-note">@k.Note</span></span>
                                        </ButtonControl>
                                    </CardControl>
                                }
                            </div>
                            break;

                        case GetawaysAppSettings.Chart:
                            <CardControl CssClass="gw-card">
                                <HeaderContent>
                                    <div class="gw-card-head">
                                        <h4 class="gw-card-title">Trip requests by month</h4>
                                        <div class="gw-card-tools">
                                            <CheckBoxControl Label="Include declined" Checked="@_withDeclined" CheckedChanged="@(v => _withDeclined = v)" />
                                            <SegmentedControl Items="_ranges" @bind-Value="_range" AriaLabel="Months shown" CssClass="gw-range" />
                                        </div>
                                    </div>
                                </HeaderContent>
                                <ChildContent>
                                    <ChartControl Type="@Settings.DashboardChart" Height="@(slot.Beside ? "260px" : "360px")" Series="@Settings.MonthlySeries(Requests, int.Parse(_range), _withDeclined)" />
                                </ChildContent>
                            </CardControl>
                            break;

                        default:
                            @* Drag a header onto the bar above the grid to group by it; double-click a trip to open the request *@
                            <CardControl CssClass="gw-card">
                                <HeaderContent>
                                    <div class="gw-card-head">
                                        <h4 class="gw-card-title">Upcoming departures</h4>
                                        <span class="gw-card-note">@Departures.Count booked trips</span>
                                    </div>
                                </HeaderContent>
                                <ChildContent>
                                    <GridControl TValue="TripRequest" DataSource="@Departures"
                                                 AllowSorting="true"
                                                 AllowGrouping="true"
                                                 AllowPaging="true"
                                                 PageSettingsRef="@_paging"
                                                 EnableHover="true"
                                                 EventsRef="@_events"
                                                 Theme="@Settings.GridThemeValue"
                                                 Density="@Settings.GridDensity"
                                                 GridLines="@Settings.GridLines"
                                                 EnableAltRow="@Settings.AlternateRows"
                                                 CssClass="@Settings.GridCss"
                                                 Height="320px">
                                        <GridColumnsBase>
                                            <GridColumn Field="@nameof(TripRequest.Request)" HeaderText="Request" Width="100px">
                                                <Template Context="row">
                                                    <BadgeControl Text="@(((TripRequest)row).Request)" CssClass="gw-code" />
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(TripRequest.Traveller)" HeaderText="Lead traveller" Width="180px" />
                                            <GridColumn Field="@nameof(TripRequest.Destination)" HeaderText="Destination" Width="125px" />
                                            <GridColumn Field="@nameof(TripRequest.TripTypeName)" HeaderText="Trip" Width="190px" />
                                            <GridColumn Field="@nameof(TripRequest.Agent)" HeaderText="Agent" Width="150px" />
                                            <GridColumn Field="@nameof(TripRequest.Departure)" HeaderText="Departs" Width="120px" Type="ColumnType.Date" Format="MMM d, yyyy" />
                                        </GridColumnsBase>
                                    </GridControl>
                                </ChildContent>
                            </CardControl>
                            break;
                    }
                </div>
            </GridLayoutItemControl>
        }
    </GridLayoutControl>

    @if (Settings.Slots.Count == 0)
    {
        <p class="gw-dash-empty">All the cards are hidden. Turn them back on in Settings, or use the rearrange button above and Reset layout.</p>
    }
</div>

@code {
    /// <summary>Opens the Trip Requests page on a view: "All", "New requests", "Quoted" or "Booked".</summary>
    [Parameter] public EventCallback<string> OnShowRequests { get; set; }

    /// <summary>Opens a request in the Trip Requests page's editor.</summary>
    [Parameter] public EventCallback<TripRequest> OnOpenRequest { get; set; }

    private IReadOnlyList<TripRequest> Requests => Store.Requests;

    // The requests are generated over the 300 days up to today (TripRequestStore)
    private static DateTime Today => DateTime.Today;

    private bool _withDeclined;
    private string _range = "6";
    private static readonly SelectionItem[] _ranges = [new("3", "3M"), new("6", "6M"), new("12", "12M")];
    private readonly PageSettings _paging = new() { PageSize = 6, PageSizes = [6, 12, 24] };
    private readonly GridControlEvents<TripRequest> _events = new();
    private string? _dragging;
    private string? _dragOver;

    private string SlotClass(GetawaysCardSlot slot) =>
        $"gw-slot {(slot.Beside ? "gw-slot-beside" : "")} {(Settings.Customising ? "is-customising" : "")} {(_dragOver == slot.Key && _dragging != slot.Key ? "is-drop-target" : "")}";

    private void Drop(string target)
    {
        if (_dragging is not null) Settings.PlaceCard(_dragging, target);
        EndDrag();
    }

    private void EndDrag() => (_dragging, _dragOver) = (null, null);

    private sealed record Kpi(string Label, int Value, string Note, string View, string Tip);

    private IEnumerable<Kpi> Kpis
    {
        get
        {
            var thisMonth = Requests.Count(r => r.Status == "Booked" && SameMonth(r.DateRequested, Today));
            var lastMonth = Requests.Count(r => r.Status == "Booked" && SameMonth(r.DateRequested, Today.AddMonths(-1)));
            var change = thisMonth - lastMonth;
            yield return new("New requests", Requests.Count(r => r.Status == "New"), "need a quote", "New requests", "Show the new requests");
            yield return new("Quoted", Requests.Count(r => r.Status == "Quoted"), "with the client", "Quoted", "Show the quoted requests");
            yield return new("Booked this month", thisMonth, $"{(change >= 0 ? "+" : "")}{change} vs last month", "Booked", "Show the booked trips");
            yield return new("Departing soon", Departures.Count(r => r.Departure < Today.AddDays(14)), "next 14 days", "Booked", "Show the booked trips");
        }
    }

    private static bool SameMonth(DateTime a, DateTime b) => a.Year == b.Year && a.Month == b.Month;

    private List<TripRequest> Departures => Store.BookedDepartures.ToList();

    protected override void OnInitialized()
    {
        _events.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<TripRequest>>(this, e =>
            e.Data is null ? Task.CompletedTask : OnOpenRequest.InvokeAsync(e.Data));
    }

    private void Refresh() => Notifications.Info("Dashboard refreshed", $"{Requests.Count} trip requests, {Departures.Count} upcoming departures.");
}
