            new("ChildContent", "The <code>RibbonTab</code>s.", "RenderFragment?", "null"),
            new("CssClass", "Added to the outer <code>fx-ribbon</code> element.", "string", "\"\""),
        };
        public static readonly ApiRow[] Tab =
        {
            new("Title", "Text of the tab's header.", "string", "\"\""),
            new("ChildContent", "The tab's <code>RibbonGroup</code>s, rendered only while the tab is open.", "RenderFragment?", "null"),
            new("Parent (cascading)", "Supplied by the enclosing <code>RibbonControl</code>. A tab outside one renders nothing.", "RibbonControl?", "null"),
        };
        public static readonly ApiRow[] Group =
        {
            new("Title", "Caption under the group. No caption row when empty.", "string", "\"\""),
            new("ChildContent", "The group's buttons, or any other markup.", "RenderFragment?", "null"),
        };
        public static readonly ApiRow[] Button =
        {
            new("Text", "Label.", "string", "\"\""),
