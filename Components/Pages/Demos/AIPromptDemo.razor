private async Task<string> RefundNoteAsync(AIPromptRequest request, CancellationToken token)
{
    await Task.Delay(2500, token);
    if (_billingDown) throw new InvalidOperationException(""The billing system did not answer. Try again in a minute."");
    return request.Command?.Key == ""shorten""
        ? ""Charged $59 twice on October 3; the duplicate is refunded within five business days.""
