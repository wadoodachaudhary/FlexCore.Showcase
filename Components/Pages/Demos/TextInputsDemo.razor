        public const string Details = @"<div class=""ti"">
    <div class=""details"">
        <label class=""field"">
            <span class=""field-label"">Lead traveler</span>
            <TextBoxControl @bind-Value=""_name"" UpdateOnInput=""true"" ShowClearButton=""true""
                            Placeholder=""Full name as on the passport"" MaxLength=""40"" CssClass=""text-field"" />
        </label>
        <label class=""field"">
            <span class=""field-label"">Email</span>
            <TextBoxControl @bind-Value=""_email"" InputType=""email""
                            Placeholder=""name@example.com"" MaxLength=""80"" CssClass=""text-field"" />
        </label>
        <label class=""field"">
            <span class=""field-label"">Travelers (1 to 12)</span>
            <NumericTextBoxControl TValue=""int"" @bind-Value=""_travelers"" Min=""1"" Max=""12"" Width=""90px"" />
        </label>
        <label class=""field"">
            <span class=""field-label"">Budget in dollars, steps of 50</span>
            <NumericTextBoxControl TValue=""decimal"" Value=""_budget"" ValueChange=""CheckBudget""
                                   Format=""C2"" Step=""50"" Min=""0"" Width=""140px"" />
        </label>
    </div>
    <div class=""tag-preview"" role=""status"">
        <span class=""tag-name"">@(string.IsNullOrWhiteSpace(_name) ? ""NO NAME YET"" : _name.ToUpperInvariant())</span>
        <span><strong>@Trip.Name</strong>, @Trip.Nights nights, @TravelerCount</span>
        <span>Confirmation goes to @(string.IsNullOrWhiteSpace(_email) ? ""nobody yet"" : _email)</span>
        <span>Budget @_budget.ToString(""$#,##0"") (@((_budget / _travelers).ToString(""$#,##0"")) a head)</span>
    </div>
    <p class=""warn"" role=""status"">@(_budgetNote ?? LowBudget)</p>
</div>";
        public const string DetailsCs = @"// Traveler details
private static readonly TravelData.Package Trip = TravelData.Packages[2];
private string? _name = ""Albus Door"";
private string? _email;
private int _travelers = 2;
private decimal _budget = 3200m;
private string? _budgetNote;
private string TravelerCount => _travelers == 1 ? ""1 traveler"" : $""{_travelers} travelers"";
private decimal Floor => 250m * _travelers;
private void CheckBudget(NumericTextBoxControl<decimal>.NumericChangeEventArgs<decimal> e)
{
    if (e.Value < Floor)
    {
        e.Cancel = true;
        _budgetNote = $""Budget not accepted: at least {Floor:$#,##0} for {TravelerCount}. The box keeps your figure until you change it."";
        return;
    }
    _budget = e.Value;
    _budgetNote = null;
}
// Raising Travelers can leave an accepted budget under the floor.
private string? LowBudget => _budget < Floor ? $""Raise the budget to at least {Floor:$#,##0} for {TravelerCount}."" : null;";
        public const string Notes = @"<div class=""ti"">
    <div class=""notes"">
        <label class=""field"">
            <span class=""field-label"">Booking note for @Trip.Name</span>
            <Fx.ControlKit.TextAreaControl @ref=""_noteBox"" @bind-Value=""_note"" UpdateOnInput=""true"" MaxLength=""NoteLimit"" Rows=""5""
                                           SpellCheck=""true"" Placeholder=""Dietary needs, room requests, arrival times""
                                           UseClassicContextMenu=""_classicMenu"" ContextMenuItems=""TextContextMenuItems.Editing"" />
        </label>
        <div class=""note-bar"">
            <span class=""count @(NoteLimit - NoteLength <= 20 ? ""near"" : null)"">@NoteLength / @NoteLimit characters</span>
            @foreach (var phrase in Phrases)
            {
                <ButtonControl CssClass=""btn-sm"" OnClick=""() => Insert(phrase)"">@phrase</ButtonControl>
            }
            <SwitchControl @bind-Checked=""_classicMenu"" Label=""Classic context menu"" />
        </div>
        <p class=""warn"" role=""status"">@_noteStatus</p>
    </div>
</div>";
        public const string NotesCs = @"// Notes with a limit
private static readonly TravelData.Package Trip = TravelData.Packages[2];
private const int NoteLimit = 200;
private static readonly string[] Phrases = { ""Airport transfer requested."", ""Vegetarian meals."", ""Late arrival, hold the room."" };
private Fx.ControlKit.TextAreaControl? _noteBox;
private string? _note = ""Arriving on the late flight on day one. "";
private bool _classicMenu;
private string? _noteStatus;
private int NoteLength => _note?.Length ?? 0;
private async Task Insert(string phrase)
{
    if (_noteBox is null) return;
    var inserted = await _noteBox.InsertTextAsync(phrase + "" "");
    _noteStatus = inserted ? ""Inserted at the caret."" : $""Not inserted: the phrase would pass the {NoteLimit}-character limit."";
}";
        public const string Portal = @"<div class=""ti"">
    <div class=""details"">
        <label class=""field"">
            <span class=""field-label"">Mobile number</span>
            <MaskedTextBoxControl @ref=""_mask"" @bind-Value=""_phone"" Mask=""000-000-0000"" Required=""true"" Placeholder=""206-555-0142"" AriaLabel=""Mobile number"" OnChange=""PhoneSet"" />
        </label>
        <label class=""field"">
            <span class=""field-label"">Password</span>
            <PasswordControl @bind-Value=""_password"" RevealLastTypedCharacter=""true"" PasswordRevealDurationMs=""800"" MaxLength=""40"" Width=""100%""
                             Placeholder=""At least 8 characters"" CssClass=""text-field"" aria-label=""Password"" />
        </label>
    </div>
    <ul class=""rules"">
        <li class=""@(LongEnough ? ""ok"" : null)"">8 characters or more</li>
        <li class=""@(HasDigit ? ""ok"" : null)"">a digit</li>
        <li class=""@(HasUpper ? ""ok"" : null)"">a capital letter</li>
    </ul>
    <div class=""note-bar"">
        <ButtonControl CssClass=""btn-primary btn-sm"" Disabled=""@(!CanCreate)"" OnClick=""CreateAccount"">Create account</ButtonControl>
        <span class=""warn"" role=""status"">@_portal</span>
    </div>
</div>";
        public const string PortalCs = @"// Traveler portal sign-up
private MaskedTextBoxControl? _mask;
private string? _phone, _password, _portal;
private bool _phoneOk;
// OnChange runs only for a number the mask accepts.
private void PhoneSet(MaskResult result)
{
    _phoneOk = result.Complete;
    _portal = null;
}
private bool LongEnough => (_password?.Length ?? 0) >= 8;
private bool HasDigit => _password?.Any(char.IsDigit) == true;
private bool HasUpper => _password?.Any(char.IsUpper) == true;
private bool CanCreate => _phoneOk && LongEnough && HasDigit && HasUpper;
// The number may have been changed to one the mask rejects since it was accepted: check it again.
private async Task CreateAccount()
{
    if (_mask is null) return;
    await _mask.CommitAsync();
    if (_mask.Error is not null)
    {
        _phoneOk = false;
        _portal = ""Not created: enter all ten digits of the mobile number."";
        return;
    }
    _portal = $""Account created for Albus Door; codes go to {_phone}."";
}";
    }
}
