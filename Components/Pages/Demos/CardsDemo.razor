<div class=""trip-pager"">
    <ButtonControl CssClass=""btn-sm"" OnClick=""@(() => _carousel!.Prev())"">Previous</ButtonControl>
    <ButtonControl CssClass=""btn-sm"" OnClick=""@(() => _carousel!.Next())"">Next</ButtonControl>
    <ButtonControl CssClass=""btn-sm"" OnClick=""@(() => _carousel!.SelectSlide(0))"" Disabled=""@(_slide == 0)"">First</ButtonControl>
    <span class=""trip-count"" aria-live=""polite"">Card @(_slide + 1) of @_trips.Length: @_trips[_slide].Package, @_trips[_slide].Nights nights</span>
</div>
<div class=""trip-pager"">
    <span class=""field-label"">Go to</span>
    @foreach (var (t, i) in _trips.Select((t, i) => (t, i)))
    {
        <ButtonControl CssClass=""@(i == _slide ? ""btn-sm btn-primary"" : ""btn-sm"")"" OnClick=""@(() => _slide = i)"">@t.City</ButtonControl>
    }
</div>";
        public const string CarouselCs = @"// Carousel
private CarouselControl? _carousel;
private int _slide;
private bool _showNav = true;
private bool _showDots = true;
private sealed record Trip(string City, string Country, string Package, int Nights, string Blurb);
private readonly Trip[] _trips =
{
    new(""Lisbon"", ""Portugal"", ""Lisbon Explorer"", 7, ""Tram 28 up to the Alfama, custard tarts in Belém and an evening of fado.""),
    new(""Amalfi"", ""Italy"", ""Amalfi Coast Drive"", 6, ""The cliff road from Positano to Ravello, with a boat day out to Capri.""),
    new(""Kyoto"", ""Japan"", ""Kyoto Classic"", 8, ""Temple gardens at opening time, a tea ceremony and a day trip to Nara.""),
    new(""Hoi An"", ""Vietnam"", ""Hoi An Lantern Trail"", 9, ""Lantern evenings in the old town, a tailor's fitting and a riverside cooking class.""),
    new(""Cape Town"", ""South Africa"", ""Cape Winelands"", 10, ""Table Mountain by cable car, then three days among the Stellenbosch vineyards.""),
    new(""Marrakech"", ""Morocco"", ""Marrakech to the Dunes"", 6, ""The souks and Jemaa el-Fnaa, then over the Atlas to a camp in the dunes.""),
};";
    }
}
