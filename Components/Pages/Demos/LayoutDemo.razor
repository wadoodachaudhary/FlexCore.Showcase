            </DocSection>
            <DocSection Id="doc-dashboardlayoutcontrol-and-dashboardlayo" Title="DashboardLayoutControl and DashboardLayoutPanel" Count='@DocSection.Label(Vocab.Dashboard.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="DashboardLayoutControl and DashboardLayoutPanel" Rows="Vocab.Dashboard" />
            </DocSection>
            <DocSection Id="doc-gridlayoutcontrol-parameters" Title="GridLayoutControl parameters" Count='@DocSection.Label(Vocab.GridLayout.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridLayoutControl parameters" Rows="Vocab.GridLayout" />
            </DocSection>
            <DocSection Id="doc-gridlayoutitemcontrol-parameters" Title="GridLayoutItemControl parameters" Count='@DocSection.Label(Vocab.GridItem.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridLayoutItemControl parameters" Rows="Vocab.GridItem" />
            </DocSection>
            <DocSection Id="doc-stacklayoutcontrol-parameters" Title="StackLayoutControl parameters" Count='@DocSection.Label(Vocab.Stack.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="StackLayoutControl parameters" Rows="Vocab.Stack" />
            </DocSection>
            <DocSection Id="doc-flexalignment-and-flexorientation" Title="FlexAlignment and FlexOrientation" Count='@DocSection.Label(Vocab.Flex.Length, "values")'>
                <ApiTable Kind="ApiKind.Values" Title="FlexAlignment and FlexOrientation" Rows="Vocab.Flex" />
            </DocSection>
