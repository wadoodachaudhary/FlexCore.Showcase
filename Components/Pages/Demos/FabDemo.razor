        public const string MenuCss = @"/* Stage: pins the fixed-position control inside the card. The host goes static so the backdrop's
   containing block is the stage; isolation keeps the control's z-indexes under the site nav. */
.fab-stage { position: relative; isolation: isolate; height: 320px; border-radius: 8px; background: #f1f5f9; overflow: hidden;
             display: flex; justify-content: flex-end; align-items: flex-end; padding: 1rem; box-sizing: border-box; }
.fab-stage.short { height: 240px; }
.fab-stage ::deep .fx-fab-host { position: static; }
.fab-stage ::deep .fx-fab-backdrop { position: absolute; }

.stage-lines { position: absolute; inset: 0; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
.stage-lines span { display: block; height: 10px; border-radius: 5px; background: #e2e8f0; }";

