@page "/demo/grid/picklist-churn"
@page "/demo/grid/dynamic-columns"
@rendermode InteractiveServer
@using System.Dynamic
@using Fx.ControlKit
@using Fx.ControlKit.Grid
@using FlexCore.Showcase.Components.Shared

@* 2026-10-17: moved onto FeatureDemoLayout (row 8 of the Data Grid list) and made to match its menu label. The old page bound
   ExpandoObject rows to five fixed columns and dressed that as a "modal opening benchmark" with typed-in numbers (SC-022, SC-159,
   SC-160, SC-162); all of that went, with the "PickList"/"FPickList"/"HomeFront" names (SC-161) and the unused @ref (SC-163). Now
   the columns are read from the keys of the first row, a switch adds a field to every row so a column appears, and the row count
   is a ButtonGroupControl. Column-set changes go through the grid's SuspendRedraw scope with the columns keyed by field (see
   SC-298 for why). Parameter tables are a later pass (SC-278). *@

<PageTitle>Dynamic columns — FlexCore Showcase</PageTitle>

<FeatureDemoLayout Title="Dynamic columns" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Rows as property bags and columns read from their keys: a grid whose shape follows the data."
                   SourcePath="Grid/GridControl.razor.cs;Grid/GridColumn.cs">
    <Overview>
        <p>
            The grid reads a cell through the column's <code>Field</code>. When a row is an <code>IDictionary&lt;string, object&gt;</code>,
            which is what <code>ExpandoObject</code> is, <code>Field</code> is the key, so ad-hoc query results bind without a model class.
            On this page the columns come from the data too: a <code>@@foreach</code> over the keys of the first row declares one
            <code>GridColumn</code> per key, numeric values get <code>ColumnType.Number</code> and a format, and when the key set changes the
            swap runs inside <code>SuspendRedraw</code> so the grid converges the columns in place.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="dynamic" Title="Columns read from the first row" RazorCode="@Code.Dynamic" CSharpCode="@Code.DynamicCs">
            <Description><p>Five keys per row to start. Turn on the lead-time field and every row gains a key, so a sixth column appears; turn it off and the column goes. Change the row count to rebuild the list at a different size. Sorting, the filter icons and the search box work on the dynamic values; the line under the grid lists the columns the grid has right now.</p></Description>
            <Controls>
                <ButtonGroupControl Items="_sizes" Values="@(new[] { _rowCount.ToString() })"
                                    ValuesChanged="@(v => SetRowCountAsync(v.Count > 0 ? int.Parse(v[0]) : 500))"
                                    Selection="ChoiceSelectionMode.Single" AriaLabel="Row count" />
                <SwitchControl Checked="@_leadTime" CheckedChanged="SetLeadTimeAsync" Label="Lead-time field" />
            </Controls>
            <Demo>
                <GridControl @ref="_grid"
                             TValue="ExpandoObject"
                             DataSource="@_rows"
                             Height="340px"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             ShowSearchBar="true"
                             ShowRowCountInFooter="true">
                    <GridColumnsBase>
                        @foreach (var col in _columns)
                        {
                            <GridColumn @key="col.Field"
                                        Field="@col.Field"
                                        HeaderText="@col.Header"
                                        Width="@(col.Field == "Description" ? "260px" : col.IsNumber ? "110px" : "130px")"
                                        Type="@(col.IsNumber ? ColumnType.Number : ColumnType.Text)"
                                        Format="@col.Format"
                                        TextAlign="@(col.IsNumber ? TextAlign.Right : TextAlign.Left)" />
                        }
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_rows.Count.ToString("N0") rows · @_columns.Count columns: @string.Join(" · ", _columns.Select(c => c.Header))</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <p class="fd-pending"><code>GridColumn</code> (<code>Field</code>, <code>Type</code>, <code>Format</code>), dictionary-backed rows and <code>SuspendRedraw</code> / <code>EndUpdateAsync</code> are still to be written up from <code>Grid/GridColumn.cs</code>, <code>Grid/GridEnums.cs</code> and <code>Grid/GridControl.razor.cs</code>. Tracker SC-278.</p>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid/column-swap">Column sets</a>: the host picks between fixed column sets.</li>
            <li><a href="demo/grid/provider-enterprise">On-demand loading</a>: rows fetched page by page from a provider.</li>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private sealed record DynamicColumn(string Field, string Header, bool IsNumber, string? Format);

    private readonly SelectionItem[] _sizes = { new("50", "50 rows"), new("500", "500 rows"), new("2000", "2,000 rows") };
    private GridControl<ExpandoObject>? _grid;
    private List<ExpandoObject> _rows = [];
    private List<DynamicColumn> _columns = [];
    private int _rowCount = 500;
    private bool _leadTime;

    protected override void OnInitialized()
    {
        _rows = BuildRows(_rowCount, _leadTime);
        _columns = ColumnsFrom(_rows);
    }

    private Task SetRowCountAsync(int count)
    {
        _rowCount = count;
        return ReloadAsync();
    }

    private Task SetLeadTimeAsync(bool on)
    {
        _leadTime = on;
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var rows = BuildRows(_rowCount, _leadTime);
        var columns = ColumnsFrom(rows);
        if (_grid is null) { _rows = rows; _columns = columns; return; }
        await using (_grid.SuspendRedraw(columns.Select(c => c.Field)))
        {
            _rows = rows;
            _columns = columns;
        }
    }

    private static List<ExpandoObject> BuildRows(int count, bool leadTime)
    {
        var groups = new[] { "General", "Architectural", "Structural", "MEP", "Site" };
        var rand = new Random(55);
        var list = new List<ExpandoObject>(count);
        for (int i = 1; i <= count; i++)
        {
            dynamic row = new ExpandoObject();
            row.Code = $"IT-{(1000 + i):D4}";
            row.Description = $"Catalog item {i}, {groups[i % groups.Length].ToLowerInvariant()}";
            row.Group = groups[i % groups.Length];
            row.Status = (i % 4 == 0) ? "Pending" : "Active";
            row.Rate = Math.Round((decimal)(rand.NextDouble() * 250 + 20), 2);
            if (leadTime) row.LeadTimeDays = 1 + (i * 7) % 30;
            list.Add(row);
        }
        return list;
    }

    private static List<DynamicColumn> ColumnsFrom(List<ExpandoObject> rows)
    {
        if (rows.Count == 0) return [];
        var first = (IDictionary<string, object?>)rows[0];
        return first.Select(kv => new DynamicColumn(
            kv.Key,
            Humanize(kv.Key),
            kv.Value is decimal or int or double,
            kv.Value switch { decimal => "N2", int => "N0", _ => null })).ToList();
    }

    private static string Humanize(string key)
        => System.Text.RegularExpressions.Regex.Replace(key, "(?<=[a-z])(?=[A-Z])", " ");

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed).
    private static class Code
