            new("Music", 42) { Value2 = 89, Value3 = 57, Value4 = 79, Value5 = 69 }
        }}
    };

    // Scatter and Bubble read x from Label (parsed as a number) and y from Value; x tick labels are not drawn.
    List<ChartSeries> _scatterSeries = new()
    {
        // x = study hours, y = exam score
        new() { Name = "Class A", DataPoints = new() {
            new("2", 22), new("3", 26), new("5", 33), new("6", 40),
            new("8", 51), new("9", 57), new("11", 64), new("12", 70)
        }},
        new() { Name = "Class B", DataPoints = new() {
            new("1", 10), new("4", 21), new("5", 28),
            new("7", 37), new("10", 47), new("13", 62)
        }}
    };

    List<ChartSeries> _bubbleSeries = new()
    {
        // x = ad spend in $k, y = sales in $k, Value2 = store count (bubble size)
        new() { Name = "Regions", DataPoints = new() {
            new("10", 100) { Value2 = 6 },
            new("18", 160) { Value2 = 12 },
            new("25", 230) { Value2 = 20 },
            new("32", 250) { Value2 = 9 },
            new("40", 340) { Value2 = 16 },
            new("50", 400) { Value2 = 8 }
        }}
    };

    List<ChartSeries> _radarSeries = new()
    {
        new() { Name = "Developer A", DataPoints = new() {
            new("C#", 90), new("JS", 75), new("SQL", 85), new("Design", 60), new("DevOps", 70), new("Testing", 80) } },
        new() { Name = "Developer B", DataPoints = new() {
            new("C#", 70), new("JS", 90), new("SQL", 65), new("Design", 85), new("DevOps", 55), new("Testing", 75) } }
    };

    List<ChartSeries> _waterfallSeries = new()
    {
        // every point is a step from the running total (there are no subtotal bars), so the last step lands on net income: 120
        new() { Name = "P&L", DataPoints = new() {
            new("Revenue", 500), new("COGS", -200), new("OpEx", -120), new("Interest", -20), new("Tax", -40) } }
    };

    List<ChartSeries> _paretoSeries = new()
    {
        new() { Name = "Defects", DataPoints = new() {
            new("UI Bugs", 45), new("API Errors", 30), new("Perf", 15), new("Security", 8), new("Other", 2) } }
    };

    List<ChartSeries> _ganttSeries = new()
    {
        // weeks 0-12; eight rows fill the plot because the renderer caps a row at 30 of the 250 plot units
        new() { Name = "Tasks", DataPoints = new() {
            new("Discovery", 0) { Value2 = 2, Category = "Phase 1" },
            new("Design", 1) { Value2 = 3, Category = "Phase 1" },
