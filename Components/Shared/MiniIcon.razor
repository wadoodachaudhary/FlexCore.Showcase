@namespace FlexCore.Showcase.Components.Shared

<svg class="mini-icon @CssClass" width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    @switch (Name.ToLowerInvariant())
    {
        case "grid":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="1" y1="6" x2="15" y2="6" stroke="currentColor" stroke-width="1.2" />
            <line x1="1" y1="10" x2="15" y2="10" stroke="currentColor" stroke-width="1.2" />
            <line x1="6" y1="2" x2="6" y2="14" stroke="currentColor" stroke-width="1.2" />
            <line x1="11" y1="2" x2="11" y2="14" stroke="currentColor" stroke-width="1.2" />
            break;

        case "ag-grid":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M1 6h14M1 10h14M6 2v12M11 2v12" stroke="currentColor" stroke-width="1.2" />
            <rect x="2" y="3" width="3" height="2" fill="currentColor" />
            <rect x="7" y="7" width="3" height="2" fill="currentColor" />
            <rect x="12" y="11" width="2" height="2" fill="currentColor" />
            break;

        case "tree-grid":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <circle cx="4" cy="5" r="1.5" fill="currentColor" />
            <circle cx="7" cy="8.5" r="1.2" fill="currentColor" />
            <circle cx="10" cy="12" r="1" fill="currentColor" />
            <path d="M4 6.5v2h2m-2 0v3.5h5" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            <line x1="9" y1="5" x2="13" y2="5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="10" y1="8.5" x2="13" y2="8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "pivot":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="1" y="2" width="5" height="4" fill="currentColor" fill-opacity="0.25" />
            <line x1="6" y1="2" x2="6" y2="14" stroke="currentColor" stroke-width="1.2" />
            <line x1="1" y1="6" x2="15" y2="6" stroke="currentColor" stroke-width="1.2" />
            <path d="M13 9h-4l2.5 2-2.5 2h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            break;

        case "data-control":
            <ellipse cx="8" cy="4" rx="6" ry="2" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M2 4v4c0 1.1 2.7 2 6 2s6-.9 6-2V4M2 8v4c0 1.1 2.7 2 6 2s6-.9 6-2V8" stroke="currentColor" stroke-width="1.2" fill="none" />
            break;

        case "virtualization":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M1 6h5M1 10h5" stroke="currentColor" stroke-width="1" />
            <path d="M11 3l-3 5h3l-2 5 5-6h-3l2-4z" fill="currentColor" />
            break;

        case "selection":
            <rect x="1.5" y="2.5" width="3.5" height="3.5" rx="0.8" fill="currentColor" />
            <path d="M2.5 4.2l1 1 1.5-1.5" stroke="#fff" stroke-width="0.8" fill="none" />
            <line x1="7" y1="4.2" x2="14.5" y2="4.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <rect x="1.5" y="7.5" width="3.5" height="3.5" rx="0.8" fill="currentColor" />
            <path d="M2.5 9.2l1 1 1.5-1.5" stroke="#fff" stroke-width="0.8" fill="none" />
            <line x1="7" y1="9.2" x2="14.5" y2="9.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <rect x="1.5" y="12" width="3.5" height="3" rx="0.8" stroke="currentColor" stroke-width="0.8" fill="none" />
            <line x1="7" y1="13.5" x2="12" y2="13.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "frozen":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="6" y1="2" x2="6" y2="14" stroke="currentColor" stroke-width="1.6" stroke-dasharray="1 1" />
            <circle cx="3.5" cy="4" r="1.5" fill="currentColor" />
            <line x1="3.5" y1="5.5" x2="3.5" y2="8" stroke="currentColor" stroke-width="1" />
            <line x1="8" y1="6" x2="13.5" y2="6" stroke="currentColor" stroke-width="1" />
            <line x1="8" y1="10" x2="13.5" y2="10" stroke="currentColor" stroke-width="1" />
            break;

        case "col-virt":
            <rect x="1" y="2" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="6" y="2" width="4" height="12" rx="1" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.2" />
            <rect x="11" y="2" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
            break;

        case "col-swap":
            <rect x="1" y="3" width="5" height="10" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="10" y="3" width="5" height="10" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M7 6l1.5-1.5M7 6l1.5 1.5M7 6h2M9 10l-1.5-1.5M9 10l-1.5 1.5M9 10H7" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            break;

        case "batch-edit":
            <rect x="1" y="2" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="1" y1="7" x2="15" y2="7" stroke="currentColor" stroke-width="1" />
            <line x1="7" y1="2" x2="7" y2="14" stroke="currentColor" stroke-width="1" />
            <path d="M9 12l4-4 1.5 1.5-4 4-2 .5.5-2z" fill="currentColor" />
            break;

        case "sqlite":
            <rect x="2" y="2" width="12" height="5" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="2" y="9" width="12" height="5" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
            <circle cx="4.5" cy="4.5" r="1" fill="currentColor" />
            <circle cx="4.5" cy="11.5" r="1" fill="currentColor" />
            <line x1="7.5" y1="4.5" x2="12" y2="4.5" stroke="currentColor" stroke-width="1" />
            <line x1="7.5" y1="11.5" x2="12" y2="11.5" stroke="currentColor" stroke-width="1" />
            break;

        case "master-detail":
            <rect x="1" y="2" width="14" height="4" rx="1" fill="currentColor" />
            <path d="M3 8v5h10" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" />
            <rect x="5" y="7" width="9" height="3" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="5" y="11" width="9" height="3" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            break;

        case "picklist":
            <rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M10.5 7l2 2 2-2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="3" y1="6.5" x2="8" y2="6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="3" y1="9.5" x2="6.5" y2="9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "veto":
            <path d="M8 1.5l5.5 2v4.5c0 3.5-2.5 6-5.5 7-3-1-5.5-3.5-5.5-7V3.5L8 1.5z" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M6 6.5l4 4m0-4l-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "optimizer":
            <path d="M9 1l-6 8h5l-2 6 7-8H8l3-6z" fill="currentColor" />
            break;

        case "dual-list":
            <rect x="1" y="2" width="5.5" height="12" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="9.5" y="2" width="5.5" height="12" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            <path d="M7 6l1.5 1.5L7 9m2 1l-1.5-1.5L9 7" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            break;

        case "reorder":
            <line x1="6" y1="4" x2="15" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="6" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="6" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <path d="M3 4.5l-1.5 1.5L3 7.5m-1.5-1.5v5m2 0l-1.5-1.5L3 11" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            break;

        case "pager":
            <rect x="1" y="4" width="4" height="8" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="6" y="4" width="4" height="8" rx="1" fill="currentColor" />
            <rect x="11" y="4" width="4" height="8" rx="1" stroke="currentColor" stroke-width="1" fill="none" />
            break;

        case "editor":
            <path d="M2.5 1.5h7l4 4V14a1 1 0 0 1-1 1h-10a1 1 0 0 1-1-1V2.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M9.5 1.5v4h4" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="4.5" y1="7" x2="8" y2="7" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            <line x1="4.5" y1="9.5" x2="11" y2="9.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            <line x1="4.5" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            break;

        case "pdf":
            <path d="M3 1.5h6.5l4 4V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M9.5 1.5v4h4" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="3.5" y="8" width="9" height="4.5" rx="0.8" fill="currentColor" />
            <g><text x="8" y="11.5" font-size="3.2" fill="#fff" font-weight="900" text-anchor="middle" font-family="sans-serif">PDF</text></g>
            break;

        case "report":
            <rect x="2" y="1.5" width="12" height="13" rx="1" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="3.5" y="3" width="9" height="2.5" fill="currentColor" />
            <line x1="3.5" y1="7.5" x2="12.5" y2="7.5" stroke="currentColor" stroke-width="0.8" />
            <line x1="3.5" y1="9.5" x2="12.5" y2="9.5" stroke="currentColor" stroke-width="0.8" />
            <line x1="3.5" y1="11.5" x2="12.5" y2="11.5" stroke="currentColor" stroke-width="0.8" />
            <line x1="7.5" y1="5.5" x2="7.5" y2="13" stroke="currentColor" stroke-width="0.8" />
            break;

        case "report-param":
            <line x1="2" y1="4" x2="14" y2="4" stroke="currentColor" stroke-width="1.2" />
            <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.2" />
            <line x1="2" y1="12" x2="14" y2="12" stroke="currentColor" stroke-width="1.2" />
            <circle cx="5" cy="4" r="1.8" fill="currentColor" />
            <circle cx="11" cy="8" r="1.8" fill="currentColor" />
            <circle cx="7" cy="12" r="1.8" fill="currentColor" />
            break;

        case "format":
            <path d="M3 13.5l4-11h2l4 11h-2l-1-3H6l-1 3H3zm3.5-5h3L8 4.8 6.5 8.5z" fill="currentColor" />
            break;

        case "chart-bar":
            <line x1="1" y1="14" x2="15" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <rect x="2.5" y="8" width="3" height="6" rx="0.5" fill="currentColor" />
            <rect x="6.5" y="4" width="3" height="10" rx="0.5" fill="currentColor" />
            <rect x="10.5" y="2" width="3" height="12" rx="0.5" fill="currentColor" />
            break;

        case "sunburst":
            <circle cx="8" cy="8" r="2.2" fill="currentColor" />
            <path d="M8 2a6 6 0 0 1 6 6M2 8a6 6 0 0 1 6-6M14 8a6 6 0 0 1-6 6M8 14a6 6 0 0 1-6-6" stroke="currentColor" stroke-width="1.8" stroke-dasharray="3 3" />
            break;

        case "stock":
            <path d="M1 12l4-5 3 2 4-6 3 2" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="5" y1="5" x2="5" y2="10" stroke="currentColor" stroke-width="0.8" />
            <line x1="12" y1="2" x2="12" y2="6" stroke="currentColor" stroke-width="0.8" />
            break;

        case "gauge-circular":
            <path d="M3 12a6 6 0 1 1 10 0" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" />
            <circle cx="8" cy="11" r="1.5" fill="currentColor" />
            <line x1="8" y1="11" x2="11.5" y2="6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "gauge-linear":
            <rect x="1" y="6" width="14" height="4" rx="2" stroke="currentColor" stroke-width="1.2" fill="none" />
            <rect x="2" y="7" width="7" height="2" rx="1" fill="currentColor" />
            <line x1="9" y1="4" x2="9" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "gauge-radial":
        case "gauge-arc":
            <path d="M2.5 11.5A6.5 6.5 0 0 1 13.5 11.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" />
            <line x1="8" y1="8" x2="11" y2="5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <circle cx="8" cy="8" r="1.2" fill="currentColor" />
            break;

        case "sparkline":
            <path d="M1 11l3.5-5 3.5 3 4-6 3 3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="15" cy="6" r="1.2" fill="currentColor" />
            break;

        case "barcode":
            <line x1="2" y1="2" x2="2" y2="14" stroke="currentColor" stroke-width="1.5" />
            <line x1="5" y1="2" x2="5" y2="14" stroke="currentColor" stroke-width="1" />
            <line x1="7.5" y1="2" x2="7.5" y2="14" stroke="currentColor" stroke-width="2" />
            <line x1="11" y1="2" x2="11" y2="14" stroke="currentColor" stroke-width="1" />
            <line x1="13.5" y1="2" x2="13.5" y2="14" stroke="currentColor" stroke-width="1.8" />
            break;

        case "qrcode":
            <rect x="1" y="1" width="5" height="5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="2.5" y="2.5" width="2" height="2" fill="currentColor" />
            <rect x="10" y="1" width="5" height="5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="11.5" y="2.5" width="2" height="2" fill="currentColor" />
            <rect x="1" y="10" width="5" height="5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="2.5" y="11.5" width="2" height="2" fill="currentColor" />
            <rect x="9" y="9" width="2" height="2" fill="currentColor" />
            <rect x="13" y="13" width="2" height="2" fill="currentColor" />
            <rect x="9" y="13" width="2" height="2" fill="currentColor" />
            break;

        case "diagram":
            <rect x="1" y="2" width="5" height="4" rx="0.8" fill="currentColor" />
            <rect x="10" y="2" width="5" height="4" rx="0.8" fill="currentColor" />
            <rect x="5.5" y="10" width="5" height="4" rx="0.8" fill="currentColor" />
            <path d="M3.5 6v2.5h9V6M8 8.5V10" stroke="currentColor" stroke-width="1" fill="none" />
            break;

        case "treeview":
            <path d="M1.5 3h4l1.5 1.5h7.5v8.5a1 1 0 0 1-1 1h-12a1 1 0 0 1-1-1V3z" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="4.5" y1="7.5" x2="11.5" y2="7.5" stroke="currentColor" stroke-width="1" />
            <line x1="4.5" y1="10.5" x2="9.5" y2="10.5" stroke="currentColor" stroke-width="1" />
            break;

        case "property-grid":
            <rect x="1.5" y="2" width="13" height="12" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="7" y1="2" x2="7" y2="14" stroke="currentColor" stroke-width="1.2" />
            <line x1="1.5" y1="6" x2="14.5" y2="6" stroke="currentColor" stroke-width="0.8" />
            <line x1="1.5" y1="10" x2="14.5" y2="10" stroke="currentColor" stroke-width="0.8" />
            break;

        case "button":
            <rect x="1.5" y="4.5" width="13" height="7" rx="3.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="5.5" y1="8" x2="10.5" y2="8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            break;

        case "split-button":
            <rect x="1.5" y="4.5" width="13" height="7" rx="2" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="10.5" y1="4.5" x2="10.5" y2="11.5" stroke="currentColor" stroke-width="1" />
            <path d="M12 7l1 1-1 1" stroke="currentColor" stroke-width="0.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            break;

        case "toggle-button":
        case "fab":
        case "speed-dial":
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M8 5v6M5 8h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            break;

        case "gantt":
            <rect x="1" y="2.5" width="6" height="2.5" rx="0.8" fill="currentColor" />
            <rect x="5.5" y="6.5" width="6.5" height="2.5" rx="0.8" fill="currentColor" />
            <rect x="8.5" y="10.5" width="6" height="2.5" rx="0.8" fill="currentColor" />
            break;

        case "scheduler":
        case "calendar":
        case "datepicker":
            <rect x="1.5" y="3" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="1.5" y1="6.5" x2="14.5" y2="6.5" stroke="currentColor" stroke-width="1.2" />
            <line x1="4.5" y1="1.5" x2="4.5" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="11.5" y1="1.5" x2="11.5" y2="4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <rect x="4" y="8.5" width="2" height="2" rx="0.3" fill="currentColor" />
            <rect x="7" y="8.5" width="2" height="2" rx="0.3" fill="currentColor" />
            <rect x="10" y="8.5" width="2" height="2" rx="0.3" fill="currentColor" />
            break;

        case "timepicker":
        case "timespan":
            <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <path d="M8 4.5v3.5h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            break;

        case "input-number":
            <rect x="1.5" y="3" width="13" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <g><text x="8" y="10.5" font-size="7" fill="currentColor" font-weight="700" text-anchor="middle" font-family="sans-serif">#</text></g>
            break;

        case "input-text":
        case "textarea":
            <rect x="1.5" y="3" width="13" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none" />
            <line x1="4" y1="8" x2="12" y2="8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <line x1="5.5" y1="6" x2="5.5" y2="10" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            break;

        case "otp":
            <rect x="1.5" y="4.5" width="2.8" height="7" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="5.1" y="4.5" width="2.8" height="7" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="8.7" y="4.5" width="2.8" height="7" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            <rect x="12.3" y="4.5" width="2.8" height="7" rx="0.5" stroke="currentColor" stroke-width="1" fill="none" />
            break;

