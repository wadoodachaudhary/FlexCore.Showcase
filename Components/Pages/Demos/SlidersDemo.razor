        {
            new("Value", "Start and end. Two-way with <code>@bind-Value</code>. Must lie inside <code>Min</code>..<code>Max</code> with <code>Start &lt;= End</code>, or the control throws <code>ArgumentException</code> on render.", "NumericRange", "(25, 75)"),
            new("ValueChanged", "Fires after either thumb moves, with the whole range.", "EventCallback&lt;NumericRange&gt;"),
