@page "/not-found"
@layout MainLayout

<h3>Not Found</h3>
<p>That page does not exist. Pages that moved keep their old address, so this is usually a typo.</p>
<ul>
    @foreach (var g in SiteNav.FooterGroups)
    {
        <li><a href="@g.Href">@g.Label</a></li>
    }
    <li><a href="components">All components</a></li>
    <li><a href="get-started">Get Started</a></li>
</ul>
