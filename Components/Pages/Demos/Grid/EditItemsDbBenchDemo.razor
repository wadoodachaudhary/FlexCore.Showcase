<PageTitle>Batch Editing in a Blazor Grid — FlexCore</PageTitle>

<FeatureDemoLayout Title="Batch editing" Category="Data Grid" CategoryHref="demo/grid" ControlName="GridControl"
                   Tagline="Double-click a cell, type, press Enter: cell-by-cell editing on a 5,000-line rate card, written straight to the bound objects."
                   SourcePath="Grid/EditSettings.cs;Grid/GridEnums.cs;Grid/GridColumn.cs;Grid/GridControlEvents.cs;Grid/GridModels.cs;Grid/GridControl.razor.cs;Grid/GridControl.razor;Grid/GridControl.DeleteConfirmation.cs;Grid/GridControl.RowEditing.cs;Grid/GridControl.Validation.cs">
    <Overview>
        <p>
            <code>EditSettings</code> turns editing on and picks the mode. In <code>EditMode.Batch</code> a double-click on an editable cell,
            or Enter on the selected cell, opens an editor in that cell; Tab or Enter commits the value to the bound object and Escape
            abandons it. There is no row editor and no save button. Columns opt in with <code>AllowEditing</code>. <code>GridControlEvents</code> reports what happens: <code>OnCellEdit</code> before a cell opens (set
            <code>Cancel</code> to refuse) and <code>OnCellSave</code> when a value is written.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="edit" Title="Edit rate card cells in place" RazorCode="@Code.Edit" CSharpCode="@Code.EditCs">
            <Description><p>Five thousand generated rate card lines held in memory; each line is a service from one supplier at one destination, with the net rate the operator pays and the margin it adds. Code, Region and Destination are read-only; double-click any other cell, or select it and press Enter, to edit it. Enter commits and stays on the cell, Tab commits and moves the selection to the next editable cell, Escape abandons the edit. The line under the grid counts saves and names the last one.</p></Description>
            <Demo>
                <GridControl TValue="RateCardItem"
                             DataSource="@_lines"
                             ShowRowCountInFooter="true"
                             AllowSelection="true"
                             AllowSorting="true"
                             AllowResizing="true"
                             AllowFiltering="true"
                             ShowSearchBar="true"
                             Height="420px"
                             EditSettingsRef="@_editSettings"
                             EventsRef="@_events"
                             CssClass="fx-grid-compact">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(RateCardItem.Code)" HeaderText="Code" Width="95px" AllowEditing="false" />
                        <GridColumn Field="@nameof(RateCardItem.Description)" HeaderText="Description" Width="230px" AllowEditing="true" />
                        <GridColumn Field="@nameof(RateCardItem.Region)" HeaderText="Region" Width="130px" AllowEditing="false" />
                        <GridColumn Field="@nameof(RateCardItem.Destination)" HeaderText="Destination" Width="115px" AllowEditing="false" />
                        <GridColumn Field="@nameof(RateCardItem.Category)" HeaderText="Category" Width="125px" AllowEditing="true" />
                        <GridColumn Field="@nameof(RateCardItem.Unit)" HeaderText="Unit" Width="75px" TextAlign="TextAlign.Center" AllowEditing="true" />
                        <GridColumn Field="@nameof(RateCardItem.Rate)" HeaderText="Rate" Width="100px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" Format="C2" />
                        <GridColumn Field="@nameof(RateCardItem.MarginPercent)" HeaderText="Margin %" Width="90px" Type="ColumnType.Number" TextAlign="TextAlign.Right" AllowEditing="true" SelectAllOnEdit="true" />
                        <GridColumn Field="@nameof(RateCardItem.Supplier)" HeaderText="Supplier" Width="200px" AllowEditing="true" />
                    </GridColumnsBase>
                </GridControl>
                <p class="result">@_saveCount @(_saveCount == 1 ? "cell" : "cells") saved@(_last is null ? "" : $"; last: {_last}")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-gridcontrol-editing-parameters" Title="GridControl editing parameters" Count='@DocSection.Label(Vocab.Grid.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="GridControl editing parameters" Rows="Vocab.Grid" />
            </DocSection>
            <DocSection Id="doc-editsettings" Title="EditSettings" Count='@DocSection.Label(Vocab.Settings.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditSettings" Rows="Vocab.Settings" />
            </DocSection>
            <DocSection Id="doc-editmode" Title="EditMode" Count='@DocSection.Label(Vocab.Modes.Length, "values")'>
                <ApiTable Kind="ApiKind.Values" Title="EditMode" Rows="Vocab.Modes" />
            </DocSection>
            <DocSection Id="doc-gridbatcheditbehavior" Title="GridBatchEditBehavior" Count='@DocSection.Label(Vocab.Behaviors.Length, "values")'>
                <ApiTable Kind="ApiKind.Values" Title="GridBatchEditBehavior" Rows="Vocab.Behaviors" />
                <p>
                The <code>GridColumn</code> parameters that bear on editing follow; the column's other parameters are on the
                <a href="demo/grid/column-swap">Column sets</a> and <a href="demo/grid/dynamic-columns">Dynamic columns</a> pages.
                </p>
            </DocSection>
            <DocSection Id="doc-gridcolumn-editing-parameters" Title="GridColumn editing parameters" Count='@DocSection.Label(Vocab.Column.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumn editing parameters" Rows="Vocab.Column" />
            </DocSection>
            <DocSection Id="doc-gridcolumn-dropdown-picker-and-date-para" Title="GridColumn dropdown, picker and date parameters" Count='@DocSection.Label(Vocab.ColumnEditors.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="GridColumn dropdown, picker and date parameters" Rows="Vocab.ColumnEditors" />
            </DocSection>
            <DocSection Id="doc-gridcontrolevents-editing" Title="GridControlEvents, editing" Count='@DocSection.Label(Vocab.Events.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="GridControlEvents, editing" Rows="Vocab.Events" />
            </DocSection>
            <DocSection Id="doc-celleditargs-tvalue" Title="CellEditArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.EditArgs.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="CellEditArgs&lt;TValue&gt;" Rows="Vocab.EditArgs" />
            </DocSection>
            <DocSection Id="doc-cellsaveargs-tvalue" Title="CellSaveArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.SaveArgs.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="CellSaveArgs&lt;TValue&gt;" Rows="Vocab.SaveArgs" />
            </DocSection>
            <DocSection Id="doc-rowediteventargs-tvalue" Title="RowEditEventArgs&lt;TValue&gt;" Count='@DocSection.Label(Vocab.RowArgs.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="RowEditEventArgs&lt;TValue&gt;" Rows="Vocab.RowArgs" />
            </DocSection>
            <DocSection Id="doc-editing-methods" Title="Editing methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Editing methods" Rows="Vocab.Methods" />
                <p>
                The other payloads: <code>CellEditButtonArgs&lt;TValue&gt;</code> carries <code>Data</code>, <code>ColumnName</code> and the
                <code>GridColumn</code> itself as <code>Column</code>; <code>CellValueTruncatedArgs&lt;TValue&gt;</code> carries <code>Data</code>,
                <code>ColumnName</code>, <code>HeaderText</code>, <code>PastedLength</code> and <code>MaxLength</code>;
                <code>TypeAheadCommitArgs&lt;TValue&gt;</code> carries <code>SelectedItems</code>, <code>ColumnName</code> and the typed
                <code>Value</code>. Beyond <code>EndEditAsync</code> there is no public commit or cancel for a batch cell: Escape abandons the
                open editor, and Enter, Tab or a click elsewhere commits it. A commit converts the text to the property's type, runs
                <code>ValidationSettings</code> (data annotations and a custom validator) and on failure keeps the editor open with the
                message; only then is the value written and <code>OnCellSave</code> raised. The toolbar items named above come from the
                grid's <code>Toolbar</code> parameter, a list of names with Add, Edit and Delete among them; a column's <code>Commands</code>
                give per-row edit, delete, save and cancel buttons for the row editor.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Related>
        <ul>
            <li><a href="demo/grid">Grid overview</a>: the core flags on a small list.</li>
            <li><a href="demo/grid/advanced">Frozen columns</a>: the same batch editing on a grid with pinned columns.</li>
            <li><a href="demo/grid/typing-modes">Typing modes</a> and <a href="demo/grid/unsaved-row-lock">Unsaved-row lock</a>: more on editing.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    private List<RateCardItem> _lines = [];
    private int _saveCount;
    private string? _last;

    private readonly EditSettings _editSettings = new()
    {
        AllowEditing = true,
        Mode = EditMode.Batch
    };

    private readonly GridControlEvents<RateCardItem> _events = new();

    protected override void OnInitialized()
    {
        _lines = BenchData.RateCard.ToList();

        _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<RateCardItem>>(this, args =>
        {
            _saveCount++;
            _last = $"{args.ColumnName} = {args.Value} on {args.Data.Code}";
        });
    }

    // Code tabs are verbatim copies of the Demo block and the members above (generated, not typed); the C# tab also carries
    // RateCardItem from Data/BenchModels.cs.
    private static class Code
    {
        public const string Edit = @"<GridControl TValue=""RateCardItem""
             DataSource=""@_lines""
             ShowRowCountInFooter=""true""
             AllowSelection=""true""
             AllowSorting=""true""
             AllowResizing=""true""
             AllowFiltering=""true""
             ShowSearchBar=""true""
             Height=""420px""
             EditSettingsRef=""@_editSettings""
             EventsRef=""@_events""
             CssClass=""fx-grid-compact"">
    <GridColumnsBase>
        <GridColumn Field=""@nameof(RateCardItem.Code)"" HeaderText=""Code"" Width=""95px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(RateCardItem.Description)"" HeaderText=""Description"" Width=""230px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(RateCardItem.Region)"" HeaderText=""Region"" Width=""130px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(RateCardItem.Destination)"" HeaderText=""Destination"" Width=""115px"" AllowEditing=""false"" />
        <GridColumn Field=""@nameof(RateCardItem.Category)"" HeaderText=""Category"" Width=""125px"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(RateCardItem.Unit)"" HeaderText=""Unit"" Width=""75px"" TextAlign=""TextAlign.Center"" AllowEditing=""true"" />
        <GridColumn Field=""@nameof(RateCardItem.Rate)"" HeaderText=""Rate"" Width=""100px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" AllowEditing=""true"" SelectAllOnEdit=""true"" Format=""C2"" />
        <GridColumn Field=""@nameof(RateCardItem.MarginPercent)"" HeaderText=""Margin %"" Width=""90px"" Type=""ColumnType.Number"" TextAlign=""TextAlign.Right"" AllowEditing=""true"" SelectAllOnEdit=""true"" />
        <GridColumn Field=""@nameof(RateCardItem.Supplier)"" HeaderText=""Supplier"" Width=""200px"" AllowEditing=""true"" />
    </GridColumnsBase>
</GridControl>
<p class=""result"">@_saveCount @(_saveCount == 1 ? ""cell"" : ""cells"") saved@(_last is null ? """" : $""; last: {_last}"")</p>";
        public const string EditCs = @"private List<RateCardItem> _lines = [];

private int _saveCount;

private string? _last;

private readonly EditSettings _editSettings = new()
{
    AllowEditing = true,
    Mode = EditMode.Batch
};

private readonly GridControlEvents<RateCardItem> _events = new();

protected override void OnInitialized()
{
    _lines = BenchData.RateCard.ToList();

    _events.OnCellSave = EventCallback.Factory.Create<CellSaveArgs<RateCardItem>>(this, args =>
    {
        _saveCount++;
        _last = $""{args.ColumnName} = {args.Value} on {args.Data.Code}"";
    });
}

// Data/BenchModels.cs
public sealed class RateCardItem
{
    public string Code { get; set; } = string.Empty;
    public string Region { get; set; } = string.Empty;
    public string Destination { get; set; } = string.Empty;
    public string Category { get; set; } = string.Empty;
    public string Supplier { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public string Unit { get; set; } = string.Empty;
    public decimal Rate { get; set; }
    public int MarginPercent { get; set; }
    public string Season { get; set; } = string.Empty;
    public bool Bookable { get; set; } = true;
    public string Notes { get; set; } = string.Empty;
}";
    }

