        };
        public static readonly ApiRow[] Strip =
        {
            new("Items", "Tabs, in order.", "List&lt;TabStripItem&gt;", "empty"),
            new("SelectedIndex", "Active tab. Two-way with <code>@bind-SelectedIndex</code>. Not clamped when items are removed; clamp it yourself.", "int", "0"),
