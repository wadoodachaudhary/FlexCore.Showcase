@page "/demo/sliders"
@using FlexCore.Showcase.Components.Shared

@* 2026-10-12: new page on FeatureDemoLayout; two examples (slider, range slider). Facts checked against SliderControl.razor(.css),
   RangeSliderControl.razor(.css), NumericRange.cs and FlexControlBase.cs (FlexCore 0.2.48). SliderControl was moved here from UI elements. *@

<PageTitle>Blazor Slider and Range Slider — FlexCore</PageTitle>

<FeatureDemoLayout Title="Sliders" Category="Components" ControlName="SliderControl · RangeSliderControl"
                   Tagline="Pick one number, or a lower and upper bound, by dragging or with the arrow keys."
                   SourcePath="SliderControl.razor; RangeSliderControl.razor">
    <Overview>
        <p>
            <code>SliderControl</code> is a styled native <code>&lt;input type="range"&gt;</code>: <code>Min</code>, <code>Max</code> and
            <code>Step</code> map straight onto the input, and <code>Value</code> binds two ways. <code>ValueChanged</code> fires while the
            thumb is dragged and once more on release, so a bound page updates live. <code>RangeSliderControl</code> stacks two sliders for a
            <code>NumericRange</code> and keeps <code>Start</code> at or below <code>End</code>.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="slider" Title="Slider" RazorCode="@Code.Slider" CSharpCode="@Code.SliderCs">
            <Description><p><code>Step="0.5"</code> gives half-percent markup. <code>ShowValue="false"</code> hides the built-in readout so the page can format its own; the disabled slider keeps the default readout. Unmatched attributes such as <code>aria-label</code> land on the input.</p></Description>
            <Demo>
                <div class="field">
                    <span class="field-label">Markup</span>
                    <SliderControl @bind-Value="_markup" Min="0" Max="50" Step="0.5" ShowValue="false" aria-label="Markup percent" />
                    <span class="readout">@_markup.ToString("0.#")%</span>
                </div>
                <p class="result">Cost @_cost.ToString("$#,##0") + @_markup.ToString("0.#")% markup = <strong>@Sell.ToString("$#,##0")</strong></p>
                <div class="field">
                    <span class="field-label">Tax rate</span>
                    <SliderControl Value="8.25" Min="0" Max="20" Step="0.25" Disabled="true" aria-label="Tax rate, fixed" />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="range" Title="Range slider" RazorCode="@Code.Range" CSharpCode="@Code.RangeCs">
            <Description><p>One <code>NumericRange</code> binds both thumbs. <code>Format</code> shapes the readout; <code>StartLabel</code> and <code>EndLabel</code> name the two inputs. Dragging the start past the end stops at the end, and the other way round. The list below filters as the range moves.</p></Description>
            <Demo>
                <div class="range-row">
                    <RangeSliderControl @bind-Value="_budget" Min="0" Max="2000" Step="50" Format="$#,##0"
                                        StartLabel="At least" EndLabel="At most" AriaLabel="Budget" />
                    <div class="matches">
                        <span class="result">@Matches.Count of @_options.Length options in budget</span>
                        <ul>
                            @foreach (var o in Matches)
                            {
                                <li><span>@o.Name</span><span class="price">@o.Price.ToString("$#,##0")</span></li>
                            }
                        </ul>
                    </div>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-slidercontrol-parameters" Title="SliderControl parameters" Count='@DocSection.Label(Vocab.Slider.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="SliderControl parameters" Rows="Vocab.Slider" />
            </DocSection>
            <DocSection Id="doc-rangeslidercontrol-parameters" Title="RangeSliderControl parameters" Count='@DocSection.Label(Vocab.Range.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="RangeSliderControl parameters" Rows="Vocab.Range" />
            </DocSection>
            <DocSection Id="doc-numericrange" Title="NumericRange" Count='@DocSection.Label(Vocab.RangeType.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="NumericRange" Rows="Vocab.RangeType" />
            </DocSection>
            <DocSection Id="doc-methods" Title="Methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="Methods" Rows="Vocab.Methods" />
            </DocSection>
            <DocSection Id="doc-css-classes" Title="CSS classes" Count='@DocSection.Label(Vocab.Css.Length, "classes")'>
                <ApiTable Kind="ApiKind.CssClasses" Title="CSS classes" Rows="Vocab.Css" />
                <p>Neither stylesheet reads a <code>--fx-*</code> variable: the track is <code>#e2e8f0</code> and the thumb <code>#2563eb</code>. Recolour with <code>CssClass</code> and a scoped <code>::deep</code> rule on <code>.fx-slider-range</code>.</p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard (native range input)" Rows="Vocab.Keys" />
        <ul>
            <li>The slider is a native range input, so the browser exposes <code>role="slider"</code> with the current, minimum and maximum values. Name it with <code>aria-label</code>, which passes through to the input.</li>
            <li>The <code>ShowValue</code> readout is plain text next to the input; it is not linked with <code>aria-describedby</code>.</li>
            <li><code>RangeSliderControl</code> renders <code>role="group"</code> with <code>AriaLabel</code>; each thumb is named by <code>StartLabel</code> or <code>EndLabel</code>.</li>
            <li><code>Disabled</code> sets the input's <code>disabled</code> attribute and adds <code>pointer-events: none</code> to the host, so a disabled slider is skipped by Tab.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>Typed numbers with a minimum, maximum and step: <code>NumericTextBoxControl</code> on <a href="demo/text-inputs#details">Text inputs</a>.</li>
            <li>Other small inputs: switches and rating on <a href="demo/checks">Checks &amp; switches</a>, the <a href="demo/security-code">security code</a>, the time-span picker on <a href="demo/date-time">Date &amp; time</a>. Pressed-state choices: <a href="demo/toggle-buttons">Toggle buttons</a>.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Slider
    private double _markup = 12.5;
    private const double _cost = 10_000;
    private double Sell => _cost * (1 + _markup / 100);

    // Range slider
    private NumericRange _budget = new(250, 1250);
    private readonly record struct Option(string Name, double Price);
    private readonly Option[] _options =
    {
        new("Under-cabinet lighting", 220), new("Tile backsplash", 350), new("Laminate counters", 450),
        new("Butcher-block counters", 900), new("Quartz counters", 1600), new("Granite counters", 1850),
    };
    private List<Option> Matches => _options.Where(o => o.Price >= _budget.Start && o.Price <= _budget.End).ToList();

    // Vocabulary rows, one per public member (0.2.48). Base-class parameters marked (base).
    private static class Vocab
    {
        public static readonly ApiRow[] Slider =
        {
            new("Value", "Current number. Two-way with <code>@bind-Value</code>.", "double", "0"),
            new("ValueChanged", "Fires on every <code>input</code> event while dragging and again on <code>change</code> at release.", "EventCallback&lt;double&gt;"),
            new("Min / Max", "Bounds, written to the input's <code>min</code> and <code>max</code>.", "double", "0 / 100"),
            new("Step", "Increment for dragging and the arrow keys.", "double", "1"),
            new("ShowValue", "Renders the raw <code>Value</code> after the track. No format option; hide it to format your own.", "bool", "true"),
