        public const string TaskCs = @"// A task: a sticky progress toast, replaced by the outcome
// Notifications is the injected NotificationService, as in the first example.
private bool _saving, _failSaves;
private Guid? _lastError;
private int _saved, _failed;
private async Task SaveAsync()
{
    _saving = true;
    if (_lastError is Guid old) Notifications.Dismiss(old);   // a new attempt replaces the last error
    _lastError = null;
    Notifications.Info(""Saving receipt for PO-2291…"", durationMs: 0);
    var progress = Notifications.Notifications.First(n => n.Message == ""Saving receipt for PO-2291…"").Id;
    await Task.Delay(1500);   // stands in for the call that saves
    Notifications.Dismiss(progress);
    if (_failSaves)
    {
        _failed++;
        Notifications.Error(""Could not save receipt for PO-2291"", ""The warehouse system did not answer. Try again."", durationMs: 0);
        _lastError = Notifications.Notifications.Last(n => n.Message == ""Could not save receipt for PO-2291"").Id;
    }
    else
    {
        _saved++;
        Notifications.Success(""Receipt for PO-2291 saved"");
    }
    _saving = false;
