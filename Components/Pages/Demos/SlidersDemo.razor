        {
            new("RangeSliderControl.SetValueAsync(range)", "Sets both bounds at once, raises <code>ValueChanged</code> and notifies the <code>EditContext</code>. Ignored when disabled, read-only or unchanged; throws <code>ArgumentOutOfRangeException</code> outside <code>Min</code>..<code>Max</code>.", "Task"),
        };
