@page "/demo/rich-text-editor"
@using System.Net
@using System.Text.RegularExpressions

@* 2026-10-25: new page on FeatureDemoLayout (SC-347). Facts from Editor*.razor/.cs, FormatControl.razor and its stylesheet,
   wwwroot/editor-control.js (FlexCore 0.2.49, main 58a62e0). Nothing in the library calls FormatControl; the wiring follows its
   titles and EditorControl's public methods. The letter uses one-word font names: the browser writes multi-word families in
   double quotes, and the read-back (editor-control.js safeStyleValue) drops a style value containing one: the font is lost.
   2026-11-15: the light editor example saves booking notes; note added that sanitizing happens in the browser (editor-control.js).
   2026-11-15: example story moved to the Project management theme.
   2026-11-16: pre-deploy review fixes. *@

<PageTitle>Blazor Rich Text Editor — FlexCore</PageTitle>

<FeatureDemoLayout Title="Rich text editor" Category="Components" ControlName="EditorControl · FormatControl · EditorLiteControl"
                   Tagline="Let users write letters and long documents, or quick formatted notes, inside your app."
                   SourcePath="Editor/EditorControl.razor.cs; Editor/EditorControl.Commands.cs; Editor/FormatControl.razor; Editor/EditorLiteControl.razor.cs; wwwroot/editor-control.js">
    <Overview>
        <p>
            <code>EditorControl</code> is a Blazor editor for letters and long documents: paragraphs, two heading levels, images and page breaks, with undo and find and replace. Use it for proposals, contracts or client letters written in the app; <code>FormatControl</code> is the formatting toolbar you connect to it, and <code>EditorLiteControl</code> binds a short note to an HTML string.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="document" Title="A document with its formatting toolbar" RazorCode="@Code.Document" CSharpCode="@Code.DocumentCs">
            <Description><p>Select text and use the toolbar; Undo, Redo and Find and replace (Ctrl+F) are the editor's own, and the line below recounts on every change. Two limits show here: S draws a strike the editor does not read back, so it is not counted and the next Undo removes it; and Font, Size and Line show your last pick, not the format of the selection, so to apply the value already shown, pick another value first.</p></Description>
            <Demo>
                <div class="doc">
                    <div class="doc-bar">
                        <ButtonControl Disabled="@(!_history.CanUndo)" OnClick="Undo">Undo (@_history.UndoCount)</ButtonControl>
                        <ButtonControl Disabled="@(!_history.CanRedo)" OnClick="Redo">Redo (@_history.RedoCount)</ButtonControl>
                        <ButtonControl OnClick="FindReplace">Find and replace</ButtonControl>
                        <ButtonControl OnClick="StartOver">Start over</ButtonControl>
                    </div>
                    <FormatControl FontFamily="@_font" FontSizePx="_size" PageWidth="@_width.ToString()" LineHeight="@_line"
                                   FontFamilyOptions="Fonts" FontSizeOptions="Sizes" PageWidthOptions="Widths" LineHeightOptions="Lines"
                                   OnFontFamilyChanged="PickFont" OnFontSizeChanged="PickSize"
                                   OnPageWidthChanged="PickWidth" OnLineHeightChanged="PickLine"
                                   OnBoldClicked='() => Format("bold")' OnItalicClicked='() => Format("italic")'
                                   OnUnderlineClicked='() => Format("underline")' OnStrikeClicked='() => Format("strikeThrough")'
                                   OnHeading1Clicked="() => Heading(26)" OnHeading2Clicked="() => Heading(20)"
                                   OnAlignLeftClicked="() => Align(EditorAlignment.Left)" OnAlignCenterClicked="() => Align(EditorAlignment.Center)"
                                   OnAlignRightClicked="() => Align(EditorAlignment.Right)" OnAlignJustifyClicked="() => Align(EditorAlignment.Justify)" />
                    <div class="doc-page">
                        <EditorControl @ref="_editor" Blocks="Letter" PageWidth="_width" FontFamily="Georgia" FontSizePx="16" LineHeight="1.6"
                                       EnableHistory="true" HistoryChanged="h => _history = h" OnBlocksChanged="LetterChanged"
                                       AriaLabel="Status letter to Green Fork Cafe" />
                    </div>
                    <p class="doc-status">Words: @_words · Blocks: @_blocks · OnBlocksChanged calls: @_changes</p>
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="comment" Title="A light editor for short text" RazorCode="@Code.Comment" CSharpCode="@Code.CommentCs">
            <Description><p>Type a note with some bold or a list and save it to the task; every keystroke raises <code>ValueChanged</code> with the sanitized HTML shown under Value, and a saved note is drawn from that same HTML.</p></Description>
            <Demo>
                <div class="rt">
                    <div class="note-label">Task WEB-117 · Order form · a note for Hermione Ranger</div>
                    <EditorLiteControl @bind-Value="_note" MinHeight="120px"
                                       Placeholder="What changed, how to test it, what is still open…" />
                    <div class="note-bar">
                        <ButtonControl CssClass="btn-primary btn-sm" Disabled="@NoteEmpty" OnClick="SaveNote">Save note</ButtonControl>
                        <span class="note-count" role="status">@_saved.Count note@(_saved.Count == 1 ? "" : "s") on the task</span>
                    </div>
                    <ul class="note-list">
                        @foreach (var saved in _saved)
                        {
                            <li>@((MarkupString)saved)</li>
                        }
                    </ul>
                    <div class="note-label">Value</div>
                    <pre class="note-out">@(_note.Length > 0 ? _note : "(empty)")</pre>
                </div>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-editorcontrol-parameters" Title="EditorControl parameters" Count='@DocSection.Label(Vocab.Editor.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="EditorControl parameters" Rows="Vocab.Editor" />
                <p>
                    <code>EditorHistoryState</code> is <code>(bool CanUndo, bool CanRedo, int UndoCount, int RedoCount)</code>.
                    <code>EditorSelectionInfo</code> is <code>(string Text, string BlockId, double Top, double Left, double Width, double Bottom)</code>;
                    <code>Top</code> and <code>Bottom</code> include that ancestor's scroll offset.
                </p>
            </DocSection>
            <DocSection Id="doc-editorcontrol-methods" Title="EditorControl methods" Count='@DocSection.Label(Vocab.Methods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="EditorControl methods" Rows="Vocab.Methods" />
                <p>
                    <code>EditorSearchMatch</code> is <code>(int Index, string BlockId, int Start, int Length, string Text, string Preview)</code>, with
                    <code>Start</code> and <code>Length</code> counted in characters of the block's text, not its HTML. <code>EditorCaretInfo</code> is
                    <code>(string BlockId, int Offset)</code>.
                </p>
            </DocSection>
            <DocSection Id="doc-editorblock" Title="EditorBlock" Count='@DocSection.Label(Vocab.Block.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditorBlock" Rows="Vocab.Block" />
            </DocSection>
            <DocSection Id="doc-formatcontrol-parameters" Title="FormatControl parameters" Count='@DocSection.Label(Vocab.Format.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="FormatControl parameters" Rows="Vocab.Format" />
                <p>
                    The B, I, U, S and alignment groups are always drawn. The stylesheet takes its colors from <code>--surface</code>,
                    <code>--border</code>, <code>--ink</code>, <code>--accent</code> and <code>--muted</code>, with built-in fallbacks; the first example sets
                    them on its wrapper, and <code>EditorControl</code> reads <code>--ink</code> and <code>--accent-2</code> (section headings)
                    the same way.
                </p>
            </DocSection>
            <DocSection Id="doc-editorlitecontrol-parameters" Title="EditorLiteControl parameters" Count='@DocSection.Label(Vocab.Lite.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="EditorLiteControl parameters" Rows="Vocab.Lite" />
            </DocSection>
            <DocSection Id="doc-editorlitecontrol-methods" Title="EditorLiteControl methods" Count='@DocSection.Label(Vocab.LiteMethods.Length, "methods")'>
                <ApiTable Kind="ApiKind.Methods" Title="EditorLiteControl methods" Rows="Vocab.LiteMethods" />
                <p>
                    Pasted HTML goes through the same sanitizer as <code>Value</code> before it is inserted; pasted plain text is escaped, with its line
                    breaks kept as <code>br</code>.
                </p>
                <p>
                    The sanitizer runs in the editor's script in the browser, so a tampered client can still send any HTML. Showing your own note back,
                    as the second example does, is safe; sanitize again on the server before you store HTML or show it to other users.
                </p>
                <p>
                    On Blazor Server each change sends every read-back format, several times the size of the HTML, in one SignalR message. Under the
                    default 32 KB limit (<code>HubOptions.MaximumReceiveMessageSize</code>), a note longer than about 4 KB of HTML stops updating
                    <code>Value</code>, with no error on the page: the connection drops and reconnects, and only the browser console shows it. Raise the limit in <code>Program.cs</code> if notes can be longer.
                </p>
            </DocSection>
            <DocSection Id="doc-editorlitevalue" Title="EditorLiteValue" Count='@DocSection.Label(Vocab.LiteValue.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="EditorLiteValue" Rows="Vocab.LiteValue" />
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ApiTable Kind="ApiKind.Keyboard" Title="Keyboard" Rows="Vocab.Keys" />
        <ul>
            <li><code>EditorControl</code>'s editable element is a <code>div</code> with <code>role="textbox"</code>, <code>aria-multiline="true"</code>, <code>aria-readonly</code> and <code>tabindex="0"</code>, named by <code>AriaLabel</code> (default "Document editor"). Focus draws a 2px blue outline. With <code>EnableHistory</code> on, the browser's own Undo and Redo commands also go to the control's history.</li>
            <li>The search panel is <code>role="search"</code>, named "Search document". Its text boxes are named "Find text" and "Replacement text", and the match count is a <code>role="status"</code> element.</li>
            <li><code>FormatControl</code>'s buttons sit in groups named "Text formatting", "Heading styles" and "Paragraph alignment"; the icon-only alignment buttons are named by their titles. The drop-downs are native <code>select</code> elements inside labels reading Font, Size, Width and Line.</li>
            <li>The editor remembers the last selection made inside it, and each formatting call restores that selection before it runs, so a toolbar button reached with Tab still acts on the text selected before.</li>
            <li><code>EditorLiteControl</code>'s toolbar is <code>role="toolbar"</code>, named by <code>ToolbarLabel</code> (default "Editor formatting"). Its buttons carry <code>aria-label</code> and <code>title</code>, the text style list is named by its title, and Tab moves through each of them in turn.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li><a href="demo/toolbar">Toolbar</a>: <code>ToolbarControl</code>, which <code>ShowToolbar</code> draws, on a page of its own.</li>
            <li><a href="demo/forms">Forms</a>: single-line inputs and form layout.</li>
            <li><a href="demo/buttons">Buttons</a>: the <code>ButtonControl</code> used for the history row.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Document (needs @using Fx.ControlKit.Editor, System.Net and System.Text.RegularExpressions)
    private EditorControl? _editor;
    private EditorHistoryState _history = new(false, false, 0, 0);
    private EditorPageWidth _width = EditorPageWidth.Normal;
    private string _font = "Georgia";
    private int _size = 16;
    private string _line = "1.6";
    private int _words = Words(Letter), _blocks = Letter.Length, _changes;

    private static EditorBlock P(string id, string html) => new(id, EditorBlockKind.Paragraph, html, Html: html);

    private static readonly EditorBlock[] Letter =
    {
        new("title", EditorBlockKind.ChapterHeading, "Website relaunch: Sprint 8 update"),
        P("greeting", "Dear Albus,"),
        P("intro", "Sprint 8 of the <b>Website relaunch</b> for Green Fork Cafe is underway. Here is where the four milestones stand and what we need from you."),
        new("milestones", EditorBlockKind.SectionHeading, "Milestone by milestone"),
        P("design", "<b>Discovery and Design.</b> Both milestones are complete: you signed off on the style guide and the refreshed logo."),
        P("build", "<b>Build.</b> The order form and the menu copy are in review, the order emails and the photo gallery are in progress, and the payment setup has not started."),
        P("launch", "<b>Launch.</b> Once Build is done, we will go through the launch checklist with you and switch the new site on while the cafe is closed."),
        new("next", EditorBlockKind.SectionHeading, "What we need from you"),
        P("provider", "Please choose a payment provider so that we can start the payment setup, and send us any menu changes so that the menu copy is right before you approve it."),
        P("signoff", "Kind regards,<br>The Scope Creep Studio team"),
    };

    private static readonly EditorDropDownControl.EditorDropDownOption[] Fonts = { new("Georgia", "Georgia"), new("Arial", "Arial"), new("Verdana", "Verdana") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Sizes = { new("14", "14"), new("16", "16"), new("18", "18"), new("20", "20"), new("24", "24") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Widths = { new("Narrow", "Narrow"), new("Normal", "Normal"), new("Full", "Full") };
    private static readonly EditorDropDownControl.EditorDropDownOption[] Lines = { new("1.4", "1.4"), new("1.6", "1.6"), new("2", "2") };

    private Task Format(string command) => _editor!.ExecFormatCommandAsync(command);
    private Task Heading(int px) => _editor!.ApplyHeadingStyleAsync("Georgia", px);
    private Task Align(EditorAlignment alignment) => _editor!.SetBlockAlignmentAsync(alignment);
    private Task Undo() => _editor!.UndoAsync();
    private Task Redo() => _editor!.RedoAsync();
    private Task FindReplace() => _editor!.OpenSearchAsync();

    private async Task PickFont(string font)
    {
        _font = font;
        await _editor!.ApplyInlineStyleAsync("font-family", font);
    }

    private async Task PickSize(string size)
    {
        _size = int.Parse(size);
        await _editor!.ApplyInlineStyleAsync("font-size", size + "px");
    }

    private void PickWidth(string width) => _width = Enum.Parse<EditorPageWidth>(width);

    private async Task PickLine(string line)
    {
        _line = line;
        await _editor!.ApplyBlockStyleAsync("line-height", line);
    }

    private async Task StartOver()
    {
        await _editor!.PushAsync();
        (_words, _blocks, _changes) = (Words(Letter), Letter.Length, 0);
        (_font, _size, _line, _width) = ("Georgia", 16, "1.6", EditorPageWidth.Normal);
    }

    private void LetterChanged(IReadOnlyList<EditorBlock> blocks)
    {
        _words = Words(blocks);
        _blocks = blocks.Count;
        _changes++;
    }

    private static int Words(IEnumerable<EditorBlock> blocks) =>
        blocks.Sum(b => Regex.Count(WebUtility.HtmlDecode(Regex.Replace(Regex.Replace(b.Text, @"<br\s*/?>", " "), "<[^>]+>", "")), @"\S+"));

    // Task note: Value is sanitized HTML, so a saved note can be shown as markup
    private string _note = "";
    private readonly List<string> _saved = new();
    // An emptied editor can still hold <br>, so test the visible text.
    private bool NoteEmpty => string.IsNullOrWhiteSpace(WebUtility.HtmlDecode(Regex.Replace(_note, "<[^>]+>", "")));
    private void SaveNote()
    {
        _saved.Insert(0, _note);
        _note = "";   // a changed Value is written back into the editor
    }

    // Vocabulary rows, one per public member (FlexCore 0.2.49).
    private static class Vocab
    {
