<!-- ── Complete Component Directory (Syncfusion Multi-Column) ─ -->
<section class="catalog-directory-section" id="components">
    <div class="directory-header">
        <h2 class="directory-title">Blazor UI &amp; Data Visualization Components</h2>
        <p class="directory-subtitle">
            70+ Blazor controls for business apps: data grids, charts, maps, reports, scheduling and forms. They render in C# and SVG and need nothing from npm.
        </p>

        <div class="catalog-search-wrapper">
            <span class="bi bi-search catalog-search-icon"></span>
            <input type="text" class="catalog-search-input"
                   placeholder="Filter components (e.g. grid, chart, date, dialog, form)..."
                   @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button type="button" class="btn-clear-search" @onclick="@(() => _searchTerm = "")" title="Clear search">
                    <span class="bi bi-x"></span>
                </button>
            }
        </div>
    </div>

    <div class="directory-columns-container">
        <!-- ── Column 1 ────────────────────────── -->
        <div class="directory-col">
            @if (MatchesCategory("DATA MANAGEMENT", _dataManagement))
            {
                <div class="cat-group" id="cat-data">
                    <h3 class="cat-title">DATA MANAGEMENT</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_dataManagement))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("FILE VIEWERS & EDITORS", _fileViewers))
            {
                <div class="cat-group" id="cat-files">
                    <h3 class="cat-title">FILE VIEWERS &amp; EDITORS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_fileViewers))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("LAYOUT & WORKSPACE", _layoutWorkspace))
            {
                <div class="cat-group" id="cat-layout">
                    <h3 class="cat-title">LAYOUT &amp; WORKSPACE</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_layoutWorkspace))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- ── Column 2 ────────────────────────── -->
        <div class="directory-col">
            @if (MatchesCategory("DATA VISUALIZATION", _dataVis))
            {
                <div class="cat-group" id="cat-viz">
                    <h3 class="cat-title">DATA VISUALIZATION</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_dataVis))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("DIAGRAMS & WORKFLOWS", _diagrams))
            {
                <div class="cat-group" id="cat-diagrams">
                    <h3 class="cat-title">DIAGRAMS &amp; WORKFLOWS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_diagrams))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("BUTTONS & ACTIONS", _buttonsActions))
            {
                <div class="cat-group" id="cat-buttons">
                    <h3 class="cat-title">BUTTONS &amp; ACTIONS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_buttonsActions))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- ── Column 3 ────────────────────────── -->
        <div class="directory-col">
            @if (MatchesCategory("SCHEDULING & CALENDARS", _scheduling))
            {
                <div class="cat-group" id="cat-scheduling">
                    <h3 class="cat-title">SCHEDULING &amp; CALENDARS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_scheduling))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("INPUTS & EDITORS", _inputs))
            {
                <div class="cat-group" id="cat-inputs">
                    <h3 class="cat-title">INPUTS &amp; EDITORS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_inputs))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("FORMS & VALIDATION", _forms))
            {
                <div class="cat-group" id="cat-forms">
                    <h3 class="cat-title">FORMS &amp; VALIDATION</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_forms))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- ── Column 4 ────────────────────────── -->
        <div class="directory-col">
            @if (MatchesCategory("DROPDOWNS & SELECTORS", _dropdowns))
            {
                <div class="cat-group" id="cat-dropdowns">
                    <h3 class="cat-title">DROPDOWNS &amp; SELECTORS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_dropdowns))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("NAVIGATION & COMMANDS", _navigation))
            {
                <div class="cat-group" id="cat-nav">
                    <h3 class="cat-title">NAVIGATION &amp; COMMANDS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_navigation))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("FEEDBACK & NOTIFICATIONS", _feedback))
            {
                <div class="cat-group" id="cat-feedback">
                    <h3 class="cat-title">FEEDBACK &amp; NOTIFICATIONS</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_feedback))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }

            @if (MatchesCategory("INTERACTIVE AI & ASSIST", _aiAssist))
            {
                <div class="cat-group" id="cat-ai">
                    <h3 class="cat-title">INTERACTIVE AI &amp; ASSIST</h3>
                    <ul class="comp-list">
                        @foreach (var item in FilterItems(_aiAssist))
                        {
                            <li><MiniIcon Name="@item.Icon" /><a href="@item.Href">@item.Name</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _searchTerm = "";

    // Tier orders a category (Baaria, 2026-10-26): 1 is the category's lead control (Data Grid always first), 2 the core controls,
    // 3 the specialist ones; within a tier, A to Z. FilterItems applies it, so the arrays may be written in any order.
    record DirectoryItem(string Icon, string Name, string Href, int Tier = 2);

    // Href rule (developer meeting, 2026-10-19): a control with its own page links to the page; a control that is one
    // example on a shared page links to that example's anchor (the DemoExample Id). Rows whose control has no demo
    // yet keep their old target (Baaria, 2026-10-20).

    private readonly DirectoryItem[] _dataManagement =
    [
        // 2026-10-25 (Baaria, catalog audit SC-345): Picklist Dropdown (no such control) and Speed Dial (a second FAB row) removed; icons
        // now fit their rows; Report Parameter Dialog lands on the report, whose toolbar Parameters button opens the dialog.
        // SC-347: TextBox, Numeric TextBox and TextArea point at Text inputs; DropDownList, DropDownGrid and ListBox at Lists & dropdowns;
        // Rich Text Editor and Format at the editor page; Diagram, Scheduler and Property Grid (Forms) at their new examples; Grid Layout,
        // Progress Bar and Carousel at the third examples on Page layouts, UI elements and Cards.
        // 2026-10-26 (Baaria, SC-350): one row per component, named the way Syncfusion, Telerik, MudBlazor and Radzen name theirs. Grid
        // features (live updates, batch editing, frozen columns, virtualization, master-detail, reordering…), sub-parts (report parameter
        // dialog, format control, card group, form item and group, LLM result card) and variants (pill buttons, the Financial & gauges
        // page) left the directory; none of the four lists those as components, and every one of those pages stays in the top menu. The
        // four gauge rows are one (one GaugeControl), the three validation rows one; DateRangePicker added.
        new("grid", "Data Grid", "demo/grid", Tier: 1),
        new("pivot", "Pivot Table", "demo/pivot"),
        new("tree-grid", "Tree Grid", "demo/grid/tree-grid"),
        new("data-control", "Data Control", "demo/data-control", Tier: 3)
    ];

    private readonly DirectoryItem[] _fileViewers =
    [
        new("pdf", "PDF Viewer", "demo/pdf-viewer"),
        new("report", "Report Writer", "demo/reports/package-costs"),
        new("editor", "Rich Text Editor", "demo/rich-text-editor")
    ];

    private readonly DirectoryItem[] _layoutWorkspace =
    [
        new("card", "Card", "demo/cards#card"),
        new("dashboard", "Dashboard Layout", "demo/layout#dashboard"),
        new("dock", "Dock Manager", "demo/dock-manager"),
        new("grid", "Grid Layout", "demo/layout#grid"),
        new("splitter", "Splitter", "demo/layout#shell"),
        new("page-control", "Page Navigation", "demo/page-navigation", Tier: 3),
        new("timeline", "Timeline", "demo/new-components#content", Tier: 3)
    ];

    private readonly DirectoryItem[] _dataVis =
    [
        new("chart-bar", "Charts", "demo/charts", Tier: 1),
        new("gauge-circular", "Gauges", "demo/gauges#gauges"),
        new("map-story", "Map", "demo/charts/map-story"),
        new("sparkline", "Sparkline Charts", "demo/charts?tab=sparkline#gallery"),
        new("stock", "Stock Chart", "demo/gauges#stock"),
        new("sunburst", "Sunburst Chart", "demo/charts/sunburst"),
        new("barcode", "Barcode Generator", "demo/barcodes#barcode", Tier: 3),
        new("qrcode", "QR Code Generator", "demo/barcodes#qr", Tier: 3)
    ];

    private readonly DirectoryItem[] _diagrams =
    [
        new("diagram", "Diagram", "demo/diagram", Tier: 1),
        new("property-grid", "Property Grid", "demo/forms#property-grid"),
        new("treeview", "TreeView", "demo/tree/treeview-explorer")
    ];

    // Pill deep-links to the Button page's Themes and pill variants example; Split and Toggle have their own pages (2026-10-12).
    private readonly DirectoryItem[] _buttonsActions =
    [
        new("button", "Button", "demo/buttons", Tier: 1),
        new("fab", "Floating Action Button", "demo/fab#menu"),
        new("split-button", "Split Button", "demo/split-button"),
        new("toggle-button", "Toggle Button", "demo/toggle-buttons")
    ];

    private readonly DirectoryItem[] _scheduling =
    [
        new("gantt", "Gantt Chart", "demo/gantt", Tier: 1),
        new("scheduler", "Scheduler", "demo/scheduler", Tier: 1),
        new("calendar", "Calendar", "demo/date-time#calendar"),
        new("datepicker", "DatePicker", "demo/date-time#appointment"),
        new("daterange", "DateRangePicker", "demo/date-time#range"),
        new("timepicker", "TimePicker", "demo/date-time#appointment"),
        new("timespan", "TimeSpan Picker", "demo/date-time#appointment", Tier: 3)
    ];

    private readonly DirectoryItem[] _inputs =
    [
        new("input-text", "TextBox", "demo/text-inputs#details", Tier: 1),
        new("checkbox", "Checkbox", "demo/checks#checks"),
        new("input-number", "Numeric TextBox", "demo/text-inputs#details"),
        new("radio", "Radio Group", "demo/checks#radio"),
        new("slider", "Slider & Range Slider", "demo/sliders"),
        new("switch", "Switch", "demo/checks#radio"),
        new("textarea", "TextArea", "demo/text-inputs#notes"),
        new("palette", "Color Palette", "demo/pickers#palette", Tier: 3),
        new("otp", "OTP Input", "demo/security-code", Tier: 3),
        new("rating", "Rating", "demo/checks#rating", Tier: 3)
    ];

    private readonly DirectoryItem[] _forms =
    [
        new("form", "Form", "demo/forms#generated", Tier: 1),
        new("validation", "Validation", "demo/forms#generated")
    ];

    private readonly DirectoryItem[] _dropdowns =
    [
        new("dropdown", "DropDownList", "demo/lists-dropdowns#dropdown", Tier: 1),
        new("autocomplete", "AutoComplete", "demo/pickers#suggest"),
        new("dropdowngrid", "DropDownGrid", "demo/lists-dropdowns#lookup"),
        new("listbox", "ListBox", "demo/lists-dropdowns#listbox")
    ];

    private readonly DirectoryItem[] _navigation =
    [
        new("tab", "Tabs", "demo/tabs-accordion#tabs", Tier: 1),
        new("accordion", "Accordion", "demo/tabs-accordion#accordion"),
        new("appbar", "AppBar", "demo/ai-prompt#app-bar"),
        new("breadcrumb", "Breadcrumb", "demo/new-components#content"),
        new("ribbon", "Ribbon", "?tab=ribbon#live-showcase"),   // the home hero, opened on its Ribbon tab (base href is the site root)
        new("toolbar", "Toolbar", "demo/ai-prompt#app-bar"),
        new("carousel", "Carousel", "demo/cards#carousel", Tier: 3),
        new("stepper", "Stepper", "demo/pickers#steps", Tier: 3)
    ];

    private readonly DirectoryItem[] _feedback =
    [
        new("dialog", "Dialog", "demo/dialog#modal", Tier: 1),
        new("alert", "Alert", "demo/new-components#status"),
        new("progress", "Progress Bar", "demo/new-components#progress"),
        new("toast", "Toast", "demo/notifications"),
        new("badge", "Badge", "demo/new-components#status", Tier: 3),
        new("skeleton", "Skeleton", "demo/new-components#status", Tier: 3)
    ];

    private readonly DirectoryItem[] _aiAssist =
    [
        new("ai-prompt", "AI Prompt", "demo/ai-prompt#prompt", Tier: 1)
    ];

    private bool MatchesCategory(string catName, DirectoryItem[] items)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        if (catName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) return true;
        return items.Any(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<DirectoryItem> FilterItems(DirectoryItem[] items)
    {
        var ordered = items.OrderBy(i => i.Tier).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(_searchTerm)) return ordered;
        var term = _searchTerm.Trim();
        return ordered.Where(i => i.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
    }
}
