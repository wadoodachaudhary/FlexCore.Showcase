<PageTitle>Blazor AI Prompt Component — FlexCore</PageTitle>

<FeatureDemoLayout Title="AI prompt" Category="Components" ControlName="AIPromptControl"
                   Tagline="Give users a prompt box with suggestions, commands and history; plug in any model."
                   SourcePath="AI/AIPromptControl.razor; AI/AIPromptModels.cs; Editor/LlmResultCard.razor">
    <Overview>
        <p>
            <code>AIPromptControl</code> is a Blazor prompt panel: users type or pick a prompt, generate an answer, run commands such as Shorten, and reuse the result. Use it to draft replies or summaries inside your app: it calls no service itself, and your <code>Generate</code> delegate turns the prompt and command into text, so any model plugs in. The examples use a stub that returns canned text, so no model is called.
        </p>
    </Overview>

    <Examples>
        <DemoExample Id="prompt" Title="Prompt, suggestions and commands" RazorCode="@Code.Prompt" CSharpCode="@Code.PromptCs">
            <Description><p>Click a suggestion, then Generate or one of the commands; Use in draft copies the response below, and the history buttons bring earlier ones back.</p></Description>
            <Demo>
                <div class="ai">
                    <p class="ai-request"><strong>Ticket TKT-1042</strong> Albus Door · Router keeps restarting · every evening since Monday · wants a technician visit on Saturday</p>
                    <AIPromptControl @bind-Prompt="_prompt" Suggestions="_suggestions" Commands="_commands" Generate="StubGenerateAsync"
                                     Rows="3" AriaLabel="Ask about TKT-1042" Placeholder="Ask about this ticket…" ApplyLabel="Use in draft"
                                     Apply="r => _draft = r.Output" Generated="r => _responses++" />
                    <p class="ai-note">Responses so far: @_responses</p>
                    <div class="ai-label">Draft for ticket TKT-1042</div>
                    <TextBoxControl @bind-Value="_draft" Multiline="true" Rows="5" Width="100%" aria-label="Draft for ticket TKT-1042"
                                    Placeholder="Use in draft puts the response here; edit it as you like." />
                </div>
            </Demo>
        </DemoExample>

        <DemoExample Id="host" Title="Driving the prompt from the page" RazorCode="@Code.Host" CSharpCode="@Code.HostCs">
            <Description><p>Use the page's own buttons: they call <code>GenerateAsync</code> and <code>CancelAsync</code> on the control. The stub takes two and a half seconds, so Stop has time to work; turn on Billing system is down and the next request fails with the message in the card; turn on Ticket solved and <code>Enabled</code> locks the prompt, Generate and the commands, and the card's Add to the ticket button then does nothing. The history buttons show each response's time and prompt, not its command, so a shortened note is captioned like the full one.</p></Description>
            <Demo>
                <div class="demo-row">
                    <ButtonControl CssClass="btn-primary btn-sm" Disabled="_solved" OnClick="() => _ai!.GenerateAsync()">Write the refund note</ButtonControl>
                    <ButtonControl CssClass="btn-sm" Disabled="_solved" OnClick="() => _ai!.GenerateAsync(_hostCommands[0])">Shorten it</ButtonControl>
                    <ButtonControl CssClass="btn-sm" OnClick="() => _ai!.CancelAsync()">Stop</ButtonControl>
                    <SwitchControl @bind-Checked="_billingDown" Label="Billing system is down" />
                    <SwitchControl @bind-Checked="_solved" Label="Ticket solved" />
                </div>
                <div class="ai">
                    <AIPromptControl @ref="_ai" @bind-Prompt="_hostPrompt" Commands="_hostCommands" Generate="RefundNoteAsync" MaxHistory="3" Rows="2" AriaLabel="Refund note for TKT-1043"
                                     Enabled="@(!_solved)" ApplyLabel="Add to the ticket" Apply="r => _refundNote = r.Output">
                        <FooterContent><p class="ai-note">Keeps the last three responses. The answers are canned, so no model is called.</p></FooterContent>
                    </AIPromptControl>
                </div>
                <p class="ai-note" role="status">Note on Hermione Ranger's ticket TKT-1043: @(_refundNote ?? "none yet")</p>
            </Demo>
        </DemoExample>
    </Examples>

    <Vocabulary>
        <DocSections>
            <DocSection Id="doc-aipromptcontrol-parameters" Title="AIPromptControl parameters" Count='@DocSection.Label(Vocab.Prompt.Length, "parameters")' Open="true">
                <ApiTable Kind="ApiKind.Parameters" Title="AIPromptControl parameters" Rows="Vocab.Prompt" />
            </DocSection>
            <DocSection Id="doc-aipromptcontrol-events" Title="AIPromptControl events" Count='@DocSection.Label(Vocab.PromptEvents.Length, "events")'>
                <ApiTable Kind="ApiKind.Events" Title="AIPromptControl events" Rows="Vocab.PromptEvents" />
            </DocSection>
            <DocSection Id="doc-aipromptcontrol-methods" Title="AIPromptControl methods and read-only properties" Count='@DocSection.Label(Vocab.PromptMethods.Length, "members")'>
                <ApiTable Kind="ApiKind.Methods" Title="AIPromptControl methods and read-only properties" Rows="Vocab.PromptMethods" />
            </DocSection>
            <DocSection Id="doc-aipromptmodels" Title="Request, command and result" Count='@DocSection.Label(Vocab.Request.Length + Vocab.Command.Length + Vocab.Result.Length, "properties")'>
                <ApiTable Kind="ApiKind.Properties" Title="AIPromptRequest" Rows="Vocab.Request" />
                <ApiTable Kind="ApiKind.Properties" Title="AIPromptCommand" Rows="Vocab.Command" />
                <ApiTable Kind="ApiKind.Properties" Title="AIPromptResult" Rows="Vocab.Result" />
                <p>All three are sealed positional records in <code>Fx.ControlKit.AI</code>, so they compare by value and are built with <code>new(…)</code>.</p>
            </DocSection>
            <DocSection Id="doc-llmresultcard-parameters" Title="LlmResultCard parameters" Count='@DocSection.Label(Vocab.Card.Length, "parameters")'>
                <ApiTable Kind="ApiKind.Parameters" Title="LlmResultCard parameters" Rows="Vocab.Card" />
                <p>
                    <code>AIPromptControl</code> sets <code>OutputText</code>, <code>OriginalText</code>, <code>OperationLabel</code>, <code>IsBusy</code>,
                    <code>ErrorMessage</code>, <code>OnApply</code>, <code>OnDismiss</code> and <code>ApplyLabel</code>; the other parameters are for hosts that
                    place the card (namespace <code>Fx.ControlKit.Editor</code>) themselves. After a failed request the card shows only the error, with no
                    Dismiss button. Picking a response in the history row shows it under the error with the apply button and Dismiss, and Dismiss
                    clears both. Otherwise the next request clears the error.
                </p>
                <p>
                    <code>ResultAction</code> is <code>(string Label, EventCallback OnClick, bool IsPrimary = false, bool Disabled = false, string? Title = null,
                    string? IconSvg = null)</code>: <code>IsPrimary</code> picks the filled style, <code>Title</code> the tooltip, and <code>IconSvg</code> is
                    inserted before the label as raw markup, so pass only markup you trust. <code>Variant</code> is <code>(string Label, string Text)</code>.
                    Both records are nested in <code>LlmResultCard</code>.
                </p>
                <p>
                    The header's copy button copies the text selected inside the card, or else the whole response, as plain text. It calls
                    <code>fxClipboard.copyFromCard</code> from the library's <code>editor-control.js</code>, which only <code>EditorControl</code> and
                    <code>EditorLiteControl</code> import; on a page with neither editor the call fails silently and nothing is copied.
                </p>
                <p>
                    The stylesheet reads <code>--panel</code>, <code>--panel-2</code>, <code>--border</code>, <code>--ink</code>, <code>--muted</code>,
                    <code>--accent</code>, <code>--accent-strong</code> and <code>--accent-2</code>, with warm built-in fallbacks; the examples set them on
                    their wrapper. The response body's background (<code>#fef7ef</code>), the error box and the echo banner have fixed colors; the
                    examples override the body's by class.
                </p>
            </DocSection>
        </DocSections>
    </Vocabulary>

    <Accessibility>
        <ul>
            <li><code>AIPromptControl</code> renders a <code>&lt;section&gt;</code> named by <code>AriaLabel</code> (default "AI prompt"), and the prompt's text area carries the same <code>aria-label</code>. Give each prompt on a page its own <code>AriaLabel</code>.</li>
            <li>Every action is a native button, and Generate, the commands and Cancel sit in a <code>role="toolbar"</code>. Tab moves from the prompt through the suggestions to Generate, the commands and, while a request runs, Cancel; Enter or Space presses the focused button.</li>
            <li>Each history button carries <code>aria-pressed</code>, "true" on the response on show and "false" on the others.</li>
            <li>In the response card, the copy button is named by its <code>title</code>, the busy row reads "Generating…", and Original text is a native <code>&lt;details&gt;</code> that Enter or Space opens.</li>
            <li>To tell screen reader users that a response has arrived, write a short message into a <code>role="status"</code> element of your own from the <code>Generated</code> callback.</li>
        </ul>
    </Accessibility>

    <Related>
        <ul>
            <li>A row of command buttons under an app bar: <a href="demo/toolbar#app-bar">Toolbar</a>.</li>
            <li>A long document with its own toolbar: <a href="demo/rich-text-editor">Rich text editor</a>.</li>
            <li><code>ChatControl</code>, <code>InlineAIPromptControl</code>, <code>PromptBoxControl</code>, <code>SmartPasteButtonControl</code> and <code>SpeechToTextButtonControl</code> are separate controls in <code>Fx.ControlKit.AI</code>, not covered here.</li>
        </ul>
    </Related>
</FeatureDemoLayout>

@code {
    // Prompt
    private string _prompt = "Draft a reply with three steps to try";
    private string _draft = "";
    private int _responses;
    private readonly string[] _suggestions =
    {
        "Draft a reply with three steps to try",
        "Summarize this ticket for the technician",
        "Write a polite reply declining the Saturday visit",
    };
    private readonly AIPromptCommand[] _commands =
    {
        new("shorten", "Shorten", "Reduce the answer to one sentence."),
        new("expand", "Expand", "Add one practical detail."),
        new("friendlier", "Friendlier tone", "Use a warmer, more personal tone."),
    };

    // Stub provider: no model is called. An application passes its own provider to Generate.
    private static readonly string[] Steps =
    {
        "Step 1: check that the power cable clicks firmly into the back of the router.",
        "Step 2: plug it straight into a wall outlet, not an extension cord.",
        "Step 3: leave space around it, because a router that overheats restarts itself.",
        "Tip: write down the time of the next restart, so we can check it against the line log.",
    };
    private static readonly string[] Summary =
    {
        "Albus Door's router has restarted every evening since Monday.",
        "The ticket came in by phone to the Hardware queue, and the customer wants a technician visit on Saturday.",
        "Open question: does the power light go out during a restart? The call notes do not say.",
        "Line log: no outage in the customer's area this week.",
    };
    private static readonly string[] Decline =
    {
        "We are sorry, but we cannot send a technician this Saturday.",
        "Every visit slot that day is taken.",
        "We can offer next Monday between 8 AM and noon, or a call with a technician today.",
        "If you reply by Friday, we will hold the Monday slot for you.",
    };
    private static async Task<string> StubGenerateAsync(AIPromptRequest request, CancellationToken token)
    {
        await Task.Delay(1200, token);   // Cancel stops the wait
        var prompt = request.Prompt.ToLowerInvariant();
        var lines = prompt.Contains("steps") ? Steps
            : prompt.Contains("summar") ? Summary
            : prompt.Contains("declin") ? Decline
            : null;
        if (lines is null)
            return $"(Stub) No canned answer for \"{request.Prompt}\". Try a suggestion; an application would send the prompt to its own provider.";
        var body = string.Join("\n", lines[..3]);
        return request.Command?.Key switch
        {
            "shorten" => lines[0],
            "expand" => body + "\n" + lines[3],
            "friendlier" => lines == Summary
                ? "Thanks for picking this one up!\n" + body
                : "Hello, and thank you for bearing with us!\n" + body + "\nWe will stay on this until your connection is steady.",
            _ => body,
        };
    }

    // Driving the prompt from the page: the buttons call the control's methods through @ref
    private AIPromptControl? _ai;
    private string _hostPrompt = "Write a refund note for the duplicate charge";
    private bool _billingDown, _solved;
    private string? _refundNote;
    private readonly AIPromptCommand[] _hostCommands =
    {
        new("shorten", "Shorten", "Reduce the answer to one sentence."),
    };
    // Slow enough to stop; throws while the billing system is down, which the control shows as an error.
    private async Task<string> RefundNoteAsync(AIPromptRequest request, CancellationToken token)
    {
        await Task.Delay(2500, token);
        if (_billingDown) throw new InvalidOperationException("The billing system did not answer. Try again in a minute.");
        return request.Command?.Key == "shorten"
            ? "Charged $59 twice on October 3; the duplicate is refunded within five business days."
            : "The October bill of $59 was charged to the same card twice on October 3.\nThe duplicate charge of $59 is refunded and reaches the card within five business days.";
    }

